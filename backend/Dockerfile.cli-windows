# Optional cross-toolchain for the local Windows HTTP/source CLI.
# Use the Base host slot and an owned temporary Compose project.
FROM rust:1.88.0-bookworm@sha256:af306cfa71d987911a781c37b59d7d67d934f49684058f96cf72079c3626bfe0
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc-mingw-w64-x86-64-posix \
 && rm -rf /var/lib/apt/lists/* \
 && rustup target add x86_64-pc-windows-gnu
ENV CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER=x86_64-w64-mingw32-gcc
ENV CC_x86_64_pc_windows_gnu=x86_64-w64-mingw32-gcc
ENV CARGO_BUILD_JOBS=2
