diff --git a/backend/infra/src/source_snapshot.rs b/backend/infra/src/source_snapshot.rs
new file mode 100644
index 0000000..d589cbc
--- /dev/null
+++ b/backend/infra/src/source_snapshot.rs
@@ -0,0 +1,79 @@
+//! Source scope joins do not require an environment or a pre-existing Bug task.
+use sqlx::{PgConnection, Row};
+use uuid::Uuid;
+
+#[derive(PartialEq, Eq)]
+pub struct SourceBinding {
+    pub command: serde_json::Value,
+    pub storage_name: String,
+    pub public_name: String,
+}
+
+/// A source reader is a machine principal, never a human project membership.
+/// Require both scopes from the current token row in the same short transaction.
+pub async fn authorize_git_reader(
+    conn: &mut PgConnection,
+    token_id: Option<Uuid>,
+    subject: Uuid,
+    configuration: Uuid,
+) -> Result<bool, sqlx::Error> {
+    Ok(sqlx::query_scalar::<_, Uuid>(
+        "SELECT t.id FROM api_tokens t JOIN service_accounts sa ON sa.id=t.service_account_id \
+         WHERE t.id=$1 AND sa.id=$2 AND t.project_id=$3 AND t.principal_type='service_account' \
+         AND sa.enabled AND t.revoked_at IS NULL AND (t.expires_at IS NULL OR t.expires_at>clock_timestamp()) \
+         AND 'api:read'=ANY(t.scopes) AND 'git:read'=ANY(t.scopes) FOR SHARE OF t,sa",
+    ).bind(token_id).bind(subject).bind(configuration).fetch_optional(conn).await?.is_some())
+}
+
+pub async fn lock_git_binding(
+    conn: &mut PgConnection,
+    configuration: Uuid,
+    storage: &str,
+) -> Result<Option<SourceBinding>, sqlx::Error> {
+    let row = sqlx::query(
+        "SELECT nb.command,r.storage_name,g.slug||'/'||r.slug AS public_name FROM projects p \
+         JOIN repository_catalog r ON r.id=p.repository_id \
+         JOIN git_groups g ON g.id=r.group_id \
+         JOIN forge_namespace_bindings nb ON nb.resource_id=g.id \
+         JOIN forge_workspace_projects w ON w.registry_instance_id=nb.registry_instance_id AND w.namespace_id=nb.namespace_id \
+         WHERE p.id=$1 AND r.storage_name=$2 \
+         AND r.ready AND r.kind='hosted' AND g.namespace_managed AND nb.state='active' AND w.state='active' \
+         FOR SHARE OF p,r,g,nb,w",
+    ).bind(configuration).bind(storage).fetch_optional(conn).await?;
+    row.map(|row| {
+        Ok(SourceBinding {
+            command: row.try_get("command")?,
+            storage_name: row.try_get("storage_name")?,
+            public_name: row.try_get("public_name")?,
+        })
+    })
+    .transpose()
+}
+
+pub async fn lock_binding(
+    conn: &mut PgConnection,
+    configuration: Uuid,
+    repository: Uuid,
+    tracker_instance: Uuid,
+    tracker_project: Uuid,
+) -> Result<Option<SourceBinding>, sqlx::Error> {
+    let row = sqlx::query(
+        "SELECT nb.command,r.storage_name,g.slug||'/'||r.slug AS public_name FROM projects p \
+         JOIN repository_catalog r ON r.id=p.repository_id \
+         JOIN git_groups g ON g.id=r.group_id \
+         JOIN forge_namespace_bindings nb ON nb.resource_id=g.id \
+         JOIN forge_workspace_projects w ON w.registry_instance_id=nb.registry_instance_id AND w.namespace_id=nb.namespace_id \
+         WHERE p.id=$1 AND r.id=$2 AND w.tracker_instance_id=$3 AND w.tracker_project_id=$4 \
+         AND r.ready AND r.kind='hosted' AND g.namespace_managed AND nb.state='active' AND w.state='active' \
+         FOR SHARE OF p,r,g,nb,w",
+    ).bind(configuration).bind(repository).bind(tracker_instance).bind(tracker_project)
+        .fetch_optional(conn).await?;
+    row.map(|row| {
+        Ok(SourceBinding {
+            command: row.try_get("command")?,
+            storage_name: row.try_get("storage_name")?,
+            public_name: row.try_get("public_name")?,
+        })
+    })
+    .transpose()
+}
diff --git a/backend/migrations/0096_bug_work_publications.sql b/backend/migrations/0096_bug_work_publications.sql
new file mode 100644
index 0000000..53d9f6f
--- /dev/null
+++ b/backend/migrations/0096_bug_work_publications.sql
@@ -0,0 +1,127 @@
+-- Closed Issue purpose on the existing immutable operation ledger. No Task surrogate or queue.
+ALTER TABLE sdlc_workspace_operations
+ ADD COLUMN purpose text NOT NULL DEFAULT 'task',
+ ADD COLUMN operation_phase text NOT NULL DEFAULT 'task',
+ ADD COLUMN parent_intent_id uuid REFERENCES sdlc_workspace_operations(id) ON DELETE RESTRICT,
+ ADD COLUMN bug_id uuid,
+ ADD COLUMN bug_work_repository_id uuid REFERENCES repository_catalog(id) ON DELETE RESTRICT,
+ ADD COLUMN pipeline_id uuid REFERENCES pipelines(id) ON DELETE RESTRICT;
+
+-- Keep every original CHECK expression intact on legacy Task rows. Unknown
+-- future CHECKs are retained too; no original0040 SQL/checksum/data is rewritten.
+DO $$ DECLARE c record; BEGIN
+ FOR c IN SELECT conname,pg_get_expr(conbin,conrelid) AS expression
+  FROM pg_constraint WHERE conrelid='sdlc_workspace_operations'::regclass AND contype='c'
+ LOOP
+  EXECUTE format('ALTER TABLE sdlc_workspace_operations DROP CONSTRAINT %I',c.conname);
+  EXECUTE format('ALTER TABLE sdlc_workspace_operations ADD CONSTRAINT %I CHECK ((purpose=''bug_work'' OR (%s)) IS TRUE)',c.conname,c.expression);
+ END LOOP;
+END $$;
+
+ALTER TABLE sdlc_workspace_operations
+ ALTER COLUMN task_id DROP NOT NULL,
+ ALTER COLUMN root_task_id DROP NOT NULL,
+ ALTER COLUMN execution_id DROP NOT NULL,
+ ALTER COLUMN lease_id DROP NOT NULL,
+ ALTER COLUMN attempt_id DROP NOT NULL,
+ ALTER COLUMN workspace_generation DROP NOT NULL,
+ ALTER COLUMN repository_id DROP NOT NULL,
+ ADD CONSTRAINT workspace_operation_purpose CHECK(purpose IN('task','bug_work')),
+ ADD CONSTRAINT workspace_operation_phase CHECK(
+   (purpose='task' AND operation_phase='task' AND parent_intent_id IS NULL AND bug_id IS NULL AND bug_work_repository_id IS NULL AND pipeline_id IS NULL
+     AND task_id IS NOT NULL AND root_task_id IS NOT NULL AND execution_id IS NOT NULL AND lease_id IS NOT NULL
+     AND attempt_id IS NOT NULL AND workspace_generation IS NOT NULL AND repository_id IS NOT NULL)
+   OR (purpose='bug_work' AND operation_phase IN('intent','accepted')
+     AND task_id IS NULL AND root_task_id IS NULL AND execution_id IS NULL AND lease_id IS NULL
+     AND attempt_id IS NULL AND workspace_generation IS NULL AND repository_id IS NULL
+     AND bug_id IS NOT NULL AND bug_id<>'00000000-0000-0000-0000-000000000000'::uuid
+     AND bug_work_repository_id IS NOT NULL
+     AND ((operation_phase='intent' AND parent_intent_id IS NULL AND pipeline_id IS NULL)
+       OR (operation_phase='accepted' AND parent_intent_id IS NOT NULL AND pipeline_id IS NOT NULL)))),
+ ADD CONSTRAINT bug_work_operation_closed CHECK(purpose='task' OR ((
+   id<>'00000000-0000-0000-0000-000000000000'::uuid
+   AND assignment_id<>'00000000-0000-0000-0000-000000000000'::uuid
+   AND operation_key ~ '^[A-Za-z0-9_.:-]{1,128}$'
+   AND request_hash ~ '^[0-9a-f]{64}$'
+   AND fencing_token BETWEEN 1 AND 9007199254740991
+   AND source_commit ~ '^([0-9a-f]{40}|[0-9a-f]{64})$'
+   AND jsonb_typeof(receipt)='object' AND octet_length(receipt::text)<=32768
+   AND receipt->>'configurationId'=project_id::text
+   AND receipt->'request'->>'contractVersion'='1'
+   AND jsonb_typeof(receipt->'request'->'contractVersion')='number'
+   AND (receipt#>>'{request,project,trackerInstanceId}')::uuid<>'00000000-0000-0000-0000-000000000000'::uuid
+   AND (receipt#>>'{request,project,projectId}')::uuid<>'00000000-0000-0000-0000-000000000000'::uuid
+   AND ((receipt#>'{request,project}')-ARRAY['trackerInstanceId','projectId'])='{}'::jsonb
+   AND receipt->'request'->>'operationKey'=operation_key
+   AND receipt->'request'->>'repositoryId'=bug_work_repository_id::text
+   AND receipt#>>'{request,bugWork,bugId}'=bug_id::text
+   AND receipt#>>'{request,bugWork,assignmentId}'=assignment_id::text
+   AND receipt#>>'{request,bugWork,fence}'=fencing_token::text
+   AND jsonb_typeof(receipt#>'{request,bugWork,fence}')='number'
+   AND jsonb_typeof(receipt#>'{request,bugWork,ownerSubject}')='string'
+   AND length(btrim(receipt#>>'{request,bugWork,ownerSubject}')) BETWEEN 1 AND 256
+   AND receipt#>>'{request,bugWork,candidateCommitSha}'=source_commit
+   AND receipt#>>'{request,bugWork,baseCommitSha}'<>source_commit
+   AND receipt#>>'{request,bugWork,baseCommitSha}' ~ '^([0-9a-f]{40}|[0-9a-f]{64})$'
+   AND receipt->'request'->>'candidateTreeId' ~ '^([0-9a-f]{40}|[0-9a-f]{64})$'
+   AND receipt#>>'{request,bugWork,assignmentSha256}' ~ '^[0-9a-f]{64}$'
+   AND receipt#>>'{request,bugWork,runtimeBindingSha256}' ~ '^[0-9a-f]{64}$'
+   AND receipt#>>'{request,bugWork,sourceContextSha256}' ~ '^[0-9a-f]{64}$'
+   AND receipt#>>'{request,bugWork,verificationBasisSha256}' ~ '^[0-9a-f]{64}$'
+   AND receipt#>>'{request,bugWork,canonicalBasisSha256}' ~ '^[0-9a-f]{64}$'
+   AND receipt->'request'->>'bundleSha256' ~ '^[0-9a-f]{64}$'
+   AND (receipt->'request'->>'bundleSizeBytes')::bigint BETWEEN 1 AND 33554432
+   AND jsonb_typeof(receipt->'request'->'bundleSizeBytes')='number'
+   AND ((receipt->'request')-ARRAY['contractVersion','operationKey','project','bugWork','repositoryId','candidateTreeId','bundleSha256','bundleSizeBytes'])='{}'::jsonb
+   AND ((receipt#>'{request,bugWork}')-ARRAY['bugId','assignmentId','assignmentSha256','fence','ownerSubject','runtimeBindingSha256','sourceContextSha256','verificationBasisSha256','canonicalBasisSha256','baseCommitSha','candidateCommitSha'])='{}'::jsonb
+   AND ((operation_phase='intent'
+      AND receipt->>'schema'='forge/bug-work-operation-intent/v1'
+      AND receipt->>'operationId'=id::text AND receipt->>'requestSha256'=request_hash)
+     OR (operation_phase='accepted'
+      AND receipt->>'schema'='forge/bug-work-operation-accepted/v1'
+      AND receipt#>>'{operation,operationId}'=id::text
+      AND receipt#>>'{operation,operationKey}'=operation_key
+      AND receipt#>>'{operation,requestSha256}'=request_hash
+      AND receipt->>'intentOperationId'=parent_intent_id::text
+      AND receipt#>>'{pipeline,pipelineId}'=pipeline_id::text
+      AND receipt#>>'{pipeline,configSha256}' ~ '^[0-9a-f]{64}$'
+      AND receipt#>>'{pipeline,planSha256}' ~ '^[0-9a-f]{64}$'
+      AND receipt->>'candidateRef'='refs/fleet/bug-work/'||assignment_id::text||'/'||source_commit))
+ ) IS TRUE));
+
+-- One logical external key across legacy Task/Issue intents; Accepted is a
+-- second immutable phase of that SAME key, never an UPDATE or a second build.
+ALTER TABLE sdlc_workspace_operations DROP CONSTRAINT sdlc_workspace_operations_project_id_operation_key_key;
+CREATE UNIQUE INDEX workspace_operation_logical_key ON sdlc_workspace_operations(project_id,operation_key)
+ WHERE operation_phase IN('task','intent');
+CREATE UNIQUE INDEX workspace_operation_phase_key ON sdlc_workspace_operations(project_id,operation_key,operation_phase);
+CREATE UNIQUE INDEX bug_work_one_accepted ON sdlc_workspace_operations(parent_intent_id)
+ WHERE purpose='bug_work' AND operation_phase='accepted';
+CREATE INDEX bug_work_original_binding ON sdlc_workspace_operations(project_id,assignment_id,fencing_token)
+ WHERE purpose='bug_work';
+
+CREATE FUNCTION guard_bug_work_operation_parent() RETURNS trigger LANGUAGE plpgsql AS $$
+DECLARE original sdlc_workspace_operations%ROWTYPE; actual pipelines%ROWTYPE; plan pipeline_plans%ROWTYPE;
+BEGIN
+ IF NEW.purpose<>'bug_work' THEN RETURN NEW; END IF;
+ PERFORM id FROM projects WHERE id=NEW.project_id AND repository_id=NEW.bug_work_repository_id FOR SHARE;
+ IF NOT FOUND THEN RAISE EXCEPTION 'bug_work_configuration_repository_mismatch' USING ERRCODE='23514'; END IF;
+ IF NEW.operation_phase<>'accepted' THEN RETURN NEW; END IF;
+ SELECT * INTO original FROM sdlc_workspace_operations WHERE id=NEW.parent_intent_id FOR SHARE;
+ IF NOT FOUND OR original.purpose<>'bug_work' OR original.operation_phase<>'intent'
+   OR (NEW.project_id,NEW.service_account_id,NEW.operation_key,NEW.request_hash,NEW.assignment_id,NEW.fencing_token,NEW.bug_id,NEW.bug_work_repository_id,NEW.source_commit)
+      IS DISTINCT FROM (original.project_id,original.service_account_id,original.operation_key,original.request_hash,original.assignment_id,original.fencing_token,original.bug_id,original.bug_work_repository_id,original.source_commit)
+   OR NEW.receipt->'request' IS DISTINCT FROM original.receipt->'request'
+ THEN RAISE EXCEPTION 'bug_work_original_intent_mismatch' USING ERRCODE='23514'; END IF;
+ SELECT * INTO actual FROM pipelines WHERE id=NEW.pipeline_id FOR SHARE;
+ IF NOT FOUND OR actual.project_id<>NEW.project_id OR actual.commit_sha IS DISTINCT FROM NEW.source_commit
+ THEN RAISE EXCEPTION 'bug_work_actual_pipeline_mismatch' USING ERRCODE='23514'; END IF;
+ SELECT * INTO plan FROM pipeline_plans WHERE pipeline_id=NEW.pipeline_id FOR SHARE;
+ IF NOT FOUND OR plan.config_source<>'repository' OR plan.resolved_commit_sha IS DISTINCT FROM NEW.source_commit
+   OR plan.config_sha256 IS DISTINCT FROM NEW.receipt#>>'{pipeline,configSha256}'
+   OR plan.plan_sha256 IS DISTINCT FROM NEW.receipt#>>'{pipeline,planSha256}'
+ THEN RAISE EXCEPTION 'bug_work_actual_plan_mismatch' USING ERRCODE='23514'; END IF;
+ RETURN NEW;
+END $$;
+CREATE TRIGGER bug_work_operation_parent BEFORE INSERT ON sdlc_workspace_operations
+ FOR EACH ROW EXECUTE FUNCTION guard_bug_work_operation_parent();
diff --git a/backend/src/api/bug_work_operations.rs b/backend/src/api/bug_work_operations.rs
new file mode 100644
index 0000000..d0a63e3
--- /dev/null
+++ b/backend/src/api/bug_work_operations.rs
@@ -0,0 +1,473 @@
+//! Existing-Issue import/pipeline admission. Accepted is never delivered.
+use super::{ApiError, ApiResult, AppState, pool};
+use crate::{
+    auth::AccessClaims,
+    domain::bug_work_publication::*,
+    store,
+    task_delivery::{bug_work_authority as owner, bug_work_source as source},
+};
+use axum::{
+    Extension, Json, Router,
+    body::Body,
+    extract::{DefaultBodyLimit, Path, Query, State},
+    routing::{get, post, put},
+};
+use serde::Deserialize;
+use std::{
+    path::PathBuf,
+    sync::{Arc, OnceLock},
+};
+use tokio::sync::Semaphore;
+use uuid::Uuid;
+
+#[derive(Deserialize, utoipa::IntoParams)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct OriginalQuery {
+    pub(super) request_sha256: String,
+    pub(super) assignment_id: Uuid,
+    pub(super) assignment_sha256: String,
+    pub(super) expected_fence: i64,
+    pub(super) candidate_commit_sha: String,
+}
+pub(super) fn matches(
+    original: &BugWorkOperationIntent,
+    query: &OriginalQuery,
+) -> Result<(), ApiError> {
+    let b = &original.request.bug_work;
+    if original.request_sha256 != query.request_sha256
+        || b.assignment_id != query.assignment_id
+        || b.assignment_sha256 != query.assignment_sha256
+        || b.fence != query.expected_fence
+        || b.candidate_commit_sha != query.candidate_commit_sha
+    {
+        return Err(ApiError::conflict(
+            "Исходная операция относится к другому исправлению",
+        ));
+    }
+    Ok(())
+}
+pub(crate) fn routes() -> Router<Arc<AppState>> {
+    Router::new()
+        .route("/api/v1/projects/{project_id}/bug-work-operations/{operation_key}/delivery-proof/{target_ref}", get(super::bug_work_proofs::read))
+        .route(
+            "/api/v1/projects/{project_id}/bug-work-operations",
+            post(prepare).layer(DefaultBodyLimit::max(16 * 1024)),
+        )
+        .route(
+            "/api/v1/projects/{project_id}/bug-work-operations/{operation_key}",
+            get(read),
+        )
+        .route(
+            "/api/v1/projects/{project_id}/bug-work-operations/{operation_key}/source-bundle",
+            put(import).layer(DefaultBodyLimit::max(MAX_BUNDLE_BYTES as usize)),
+        )
+        .layer(axum::middleware::map_response(
+            |mut response: axum::response::Response| async move {
+                response.headers_mut().insert(
+                    "cache-control",
+                    axum::http::HeaderValue::from_static("no-store"),
+                );
+                response
+            },
+        ))
+}
+pub(crate) async fn authorize(
+    conn: &mut sqlx::PgConnection,
+    state: &AppState,
+    claims: &AccessClaims,
+    configuration: Uuid,
+    write: bool,
+) -> Result<(), ApiError> {
+    let subject = state
+        .config
+        .sdlc_workspace
+        .bug_work
+        .producer_subject
+        .ok_or_else(|| ApiError::service_unavailable("Производитель исправлений не настроен"))?;
+    if subject != claims.sub
+        || configuration.is_nil()
+        || claims.role != "service_account"
+        || claims.service_account_name.is_none()
+        || claims.sid.is_some()
+        || claims.token_project_id != Some(configuration)
+    {
+        return Err(ApiError::forbidden());
+    }
+    let valid=sqlx::query_scalar::<_,Uuid>("SELECT t.id FROM api_tokens t JOIN service_accounts sa ON sa.id=t.service_account_id WHERE t.id=$1 AND sa.id=$2 AND t.project_id=$3 AND t.principal_type='service_account' AND sa.enabled AND t.revoked_at IS NULL AND (t.expires_at IS NULL OR t.expires_at>clock_timestamp()) AND 'api:read'=ANY(t.scopes) AND (NOT $4 OR 'api:write'=ANY(t.scopes)) FOR SHARE OF t,sa")
+        .bind(claims.token_id).bind(subject).bind(configuration).bind(write).fetch_optional(conn).await.map_err(ApiError::internal)?;
+    if valid.is_none() {
+        return Err(ApiError::forbidden());
+    }
+    Ok(())
+}
+async fn local_binding(
+    conn: &mut sqlx::PgConnection,
+    configuration: Uuid,
+    r: &BugWorkOperationRequest,
+) -> Result<store::source_snapshot::SourceBinding, ApiError> {
+    let binding = store::source_snapshot::lock_binding(
+        conn,
+        configuration,
+        r.repository_id,
+        r.project.tracker_instance_id,
+        r.project.project_id,
+    )
+    .await
+    .map_err(ApiError::internal)?
+    .ok_or_else(ApiError::forbidden)?;
+    let command: pdlc_shared::resource_context::OwnerCommand =
+        serde_json::from_value(binding.command.clone()).map_err(|_| {
+            ApiError::service_unavailable("Проекция пространства исходников некорректна")
+        })?;
+    crate::namespace::validate_projection(&command)?;
+    Ok(binding)
+}
+fn storage(
+    state: &AppState,
+    binding: &store::source_snapshot::SourceBinding,
+    authority: &owner::FreshAuthority,
+) -> Result<PathBuf, ApiError> {
+    let (group, slug) = binding
+        .public_name
+        .split_once('/')
+        .ok_or_else(ApiError::forbidden)?;
+    let url = crate::repository_catalog::public_git_url(group, slug)?;
+    use sha2::{Digest, Sha256};
+    if format!("{:x}", Sha256::digest(url.as_bytes())) != authority.clone_url_sha256
+        || !crate::domain::source_snapshot::valid_branch_ref(&authority.branch_ref)
+        || crate::git_host::validate_repo_name(&binding.storage_name).as_deref()
+            != Ok(binding.storage_name.as_str())
+    {
+        return Err(ApiError::conflict(
+            "Исходный репозиторий или адрес изменился",
+        ));
+    }
+    let path = state.git.root.join(format!("{}.git", binding.storage_name));
+    // Helpers repeat no-link checks for the full ancestor chain before Git I/O.
+    let canonical = std::fs::canonicalize(&path)
+        .map_err(|_| ApiError::service_unavailable("Хранилище исходников недоступно"))?;
+    let root = std::fs::canonicalize(&state.git.root)
+        .map_err(|_| ApiError::service_unavailable("Корень исходников недоступен"))?;
+    if canonical != root.join(format!("{}.git", binding.storage_name)) {
+        return Err(ApiError::forbidden());
+    }
+    source::canonical_repository(&path).map_err(|_| ApiError::forbidden())
+}
+fn enabled(state: &AppState) -> Result<(), ApiError> {
+    if !state.config.sdlc_workspace.bug_work.enabled {
+        return Err(ApiError::service_unavailable(
+            "Приём новых исправлений выключен",
+        ));
+    }
+    Ok(())
+}
+async fn retained(
+    state: &AppState,
+    claims: &AccessClaims,
+    configuration: Uuid,
+    key: &str,
+) -> Result<BugWorkOperationReadback, ApiError> {
+    if !operation_key(key) {
+        return Err(ApiError::bad_request("Некорректный ключ операции"));
+    }
+    let mut tx = pool(state)?.begin().await.map_err(ApiError::internal)?;
+    authorize(&mut tx, state, claims, configuration, false).await?;
+    let (subject, intent) = store::bug_work_publication::intent(&mut tx, configuration, key)
+        .await
+        .map_err(ApiError::internal)?
+        .ok_or_else(|| ApiError::not_found_named("операция исправления"))?;
+    if subject != claims.sub {
+        return Err(ApiError::forbidden());
+    }
+    let accepted = store::bug_work_publication::accepted(&mut tx, configuration, key)
+        .await
+        .map_err(ApiError::internal)?;
+    if accepted
+        .as_ref()
+        .is_some_and(|(subject, _)| *subject != claims.sub)
+    {
+        return Err(ApiError::forbidden());
+    }
+    tx.commit().await.map_err(ApiError::internal)?;
+    Ok(BugWorkOperationReadback {
+        intent,
+        accepted: accepted.map(|(_, r)| r),
+    })
+}
+
+#[utoipa::path(get,path="/api/v1/projects/{project_id}/bug-work-operations/{operation_key}",tag="Bug work publications",params(("project_id"=Uuid,Path),("operation_key"=String,Path),OriginalQuery),responses((status=200,body=BugWorkOperationReadback),(status=401),(status=403),(status=404),(status=409)))]
+pub(crate) async fn read(
+    State(state): State<Arc<AppState>>,
+    Extension(claims): Extension<AccessClaims>,
+    Path((configuration, key)): Path<(Uuid, String)>,
+    Query(query): Query<OriginalQuery>,
+) -> ApiResult<BugWorkOperationReadback> {
+    let r = retained(&state, &claims, configuration, &key).await?;
+    matches(&r.intent, &query)?;
+    Ok(Json(r))
+}
+#[utoipa::path(post,path="/api/v1/projects/{project_id}/bug-work-operations",tag="Bug work publications",params(("project_id"=Uuid,Path)),request_body=BugWorkOperationRequest,responses((status=200,body=BugWorkOperationReadback),(status=400),(status=401),(status=403),(status=409),(status=413),(status=422),(status=503)))]
+pub(crate) async fn prepare(
+    State(state): State<Arc<AppState>>,
+    Extension(claims): Extension<AccessClaims>,
+    Path(configuration): Path<Uuid>,
+    Json(request): Json<BugWorkOperationRequest>,
+) -> ApiResult<BugWorkOperationReadback> {
+    request.validate().map_err(ApiError::bad_request)?;
+    let hash = owner::canonical_hash(
+        &serde_json::to_value(&request)
+            .map_err(|_| ApiError::bad_request("Некорректная заявка"))?,
+    )
+    .map_err(|_| ApiError::bad_request("Некорректная заявка"))?;
+    // Protective exact original replay precedes new-effect gates and remote grants.
+    let mut tx = pool(&state)?.begin().await.map_err(ApiError::internal)?;
+    authorize(&mut tx, &state, &claims, configuration, false).await?;
+    let original =
+        store::bug_work_publication::intent(&mut tx, configuration, &request.operation_key)
+            .await
+            .map_err(ApiError::internal)?;
+    tx.commit().await.map_err(ApiError::internal)?;
+    if let Some((subject, old)) = original {
+        if subject != claims.sub {
+            return Err(ApiError::forbidden());
+        }
+        if old.request != request || old.request_sha256 != hash {
+            return Err(ApiError::conflict("Ключ уже связан с другой заявкой"));
+        }
+        return Ok(Json(
+            retained(&state, &claims, configuration, &request.operation_key).await?,
+        ));
+    }
+    enabled(&state)?;
+    let authority = owner::read_current(
+        &state.config.sdlc_workspace.bug_work,
+        configuration,
+        &request,
+    )
+    .await
+    .map_err(|_| {
+        ApiError::service_unavailable("Tracker не подтвердил действующую привязку исправления")
+    })?;
+    let mut tx = pool(&state)?.begin().await.map_err(ApiError::internal)?;
+    authorize(&mut tx, &state, &claims, configuration, true).await?;
+    store::bug_work_publication::lock_operation(&mut tx, configuration, &request.operation_key)
+        .await
+        .map_err(ApiError::internal)?;
+    if let Some((subject, old)) =
+        store::bug_work_publication::intent(&mut tx, configuration, &request.operation_key)
+            .await
+            .map_err(ApiError::internal)?
+    {
+        if subject != claims.sub {
+            return Err(ApiError::forbidden());
+        }
+        if old.request != request || old.request_sha256 != hash {
+            return Err(ApiError::conflict("Ключ уже связан с другой заявкой"));
+        }
+        tx.commit().await.map_err(ApiError::internal)?;
+        return Ok(Json(
+            retained(&state, &claims, configuration, &request.operation_key).await?,
+        ));
+    }
+    if store::bug_work_publication::logical_key_exists(
+        &mut tx,
+        configuration,
+        &request.operation_key,
+    )
+    .await
+    .map_err(ApiError::internal)?
+    {
+        return Err(ApiError::conflict("Ключ занят другой операцией"));
+    }
+    let binding = local_binding(&mut tx, configuration, &request).await?;
+    storage(&state, &binding, &authority)?;
+    authority
+        .require_current(configuration, &request)
+        .map_err(|_| ApiError::conflict("Срок проверки прав истёк"))?;
+    let intent = BugWorkOperationIntent {
+        schema: "forge/bug-work-operation-intent/v1".into(),
+        operation_id: Uuid::new_v4(),
+        configuration_id: configuration,
+        request_sha256: hash,
+        request,
+        recorded_at: chrono::Utc::now(),
+    };
+    store::bug_work_publication::append_intent(&mut tx, claims.sub, &intent)
+        .await
+        .map_err(ApiError::internal)?;
+    tx.commit().await.map_err(ApiError::internal)?;
+    Ok(Json(BugWorkOperationReadback {
+        intent,
+        accepted: None,
+    }))
+}
+
+#[utoipa::path(put,path="/api/v1/projects/{project_id}/bug-work-operations/{operation_key}/source-bundle",tag="Bug work publications",params(("project_id"=Uuid,Path),("operation_key"=String,Path),OriginalQuery),request_body(content=String,content_type="application/octet-stream"),responses((status=200,body=BugWorkOperationReadback),(status=400),(status=401),(status=403),(status=409),(status=413),(status=422),(status=503)))]
+pub(crate) async fn import(
+    State(state): State<Arc<AppState>>,
+    Extension(claims): Extension<AccessClaims>,
+    Path((configuration, key)): Path<(Uuid, String)>,
+    Query(query): Query<OriginalQuery>,
+    body: Body,
+) -> ApiResult<BugWorkOperationReadback> {
+    let original = retained(&state, &claims, configuration, &key).await?;
+    matches(&original.intent, &query)?;
+    static IMPORTS: OnceLock<Semaphore> = OnceLock::new();
+    let _permit = IMPORTS
+        .get_or_init(|| Semaphore::new(2))
+        .try_acquire()
+        .map_err(|_| ApiError::service_unavailable("Лимит импорта исходников занят"))?;
+    let body = tokio::time::timeout(
+        std::time::Duration::from_secs(10),
+        axum::body::to_bytes(body, MAX_BUNDLE_BYTES as usize),
+    )
+    .await
+    .map_err(|_| ApiError {
+        status: axum::http::StatusCode::REQUEST_TIMEOUT,
+        message: "Срок загрузки пакета истёк".into(),
+    })?
+    .map_err(|_| ApiError {
+        status: axum::http::StatusCode::PAYLOAD_TOO_LARGE,
+        message: "Пакет превышает допустимый размер или недоступен".into(),
+    })?;
+    let request = &original.intent.request;
+    use sha2::{Digest, Sha256};
+    if body.len() as u64 != request.bundle_size_bytes
+        || format!("{:x}", Sha256::digest(&body)) != request.bundle_sha256
+    {
+        return Err(ApiError::conflict(
+            "Git-пакет отличается от исходной заявки",
+        ));
+    }
+    // Exact accepted replay is custody only, even after new effects are disabled.
+    if original.accepted.is_some() {
+        return Ok(Json(original));
+    }
+    enabled(&state)?;
+
+    let authority = owner::read_current(
+        &state.config.sdlc_workspace.bug_work,
+        configuration,
+        request,
+    )
+    .await
+    .map_err(|_| ApiError::service_unavailable("Tracker не подтвердил права на импорт"))?;
+    let mut tx = pool(&state)?.begin().await.map_err(ApiError::internal)?;
+    authorize(&mut tx, &state, &claims, configuration, true).await?;
+    let binding = local_binding(&mut tx, configuration, request).await?;
+    tx.commit().await.map_err(ApiError::internal)?;
+    let repository = storage(&state, &binding, &authority)?;
+    let controller = state
+        .config
+        .sdlc_workspace
+        .bug_work
+        .controller_root
+        .as_ref()
+        .ok_or_else(ApiError::forbidden)?;
+    let controller = std::fs::canonicalize(controller)
+        .map_err(|_| ApiError::service_unavailable("Защищённое хранилище импорта недоступно"))?;
+    for root in [&state.git.root, &state.config.artifacts.root] {
+        let root = std::fs::canonicalize(root)
+            .map_err(|_| ApiError::service_unavailable("Корень хранилища недоступен"))?;
+        if controller.starts_with(&root) || root.starts_with(&controller) {
+            return Err(ApiError::forbidden());
+        }
+    }
+    let prepared = source::prepare(
+        &controller,
+        &repository,
+        &original.intent,
+        &body,
+        &authority,
+    )
+    .await
+    .map_err(|_| {
+        ApiError::conflict("Git-пакет отклонён или импорт занят; проверьте исходную операцию")
+    })?;
+    // Quarantine validation may take time: refresh BOTH authorities before exposing a ref.
+    let authority = owner::read_current(
+        &state.config.sdlc_workspace.bug_work,
+        configuration,
+        request,
+    )
+    .await
+    .map_err(|_| {
+        ApiError::service_unavailable("Tracker не подтвердил права на публикацию исходников")
+    })?;
+    let mut tx = pool(&state)?.begin().await.map_err(ApiError::internal)?;
+    authorize(&mut tx, &state, &claims, configuration, true).await?;
+    let current = local_binding(&mut tx, configuration, request).await?;
+    if current != binding {
+        return Err(ApiError::conflict("Пространство исходников изменилось"));
+    }
+    tx.commit().await.map_err(ApiError::internal)?;
+    prepared
+        .publish_ref(request, &authority)
+        .await
+        .map_err(|_| ApiError::conflict("Публикация исходной ссылки не подтверждена"))?;
+    let pipeline =
+        super::pipelines_routes::PreparedBugWorkPipeline::read(&repository, request).await?;
+    let authority = owner::read_current(
+        &state.config.sdlc_workspace.bug_work,
+        configuration,
+        request,
+    )
+    .await
+    .map_err(|_| ApiError::service_unavailable("Tracker не подтвердил права на запуск сборки"))?;
+    let mut tx = pool(&state)?.begin().await.map_err(ApiError::internal)?;
+    authorize(&mut tx, &state, &claims, configuration, true).await?;
+    store::bug_work_publication::lock_operation(&mut tx, configuration, &key)
+        .await
+        .map_err(ApiError::internal)?;
+    if let Some((subject, accepted)) =
+        store::bug_work_publication::accepted(&mut tx, configuration, &key)
+            .await
+            .map_err(ApiError::internal)?
+    {
+        if subject != claims.sub || accepted.request != *request {
+            return Err(ApiError::conflict("Исходная операция изменилась"));
+        }
+        tx.commit().await.map_err(ApiError::internal)?;
+        return Ok(Json(BugWorkOperationReadback {
+            intent: original.intent,
+            accepted: Some(accepted),
+        }));
+    }
+    let current = local_binding(&mut tx, configuration, request).await?;
+    if current != binding {
+        return Err(ApiError::conflict("Пространство исходников изменилось"));
+    }
+    authority
+        .require_current(configuration, request)
+        .map_err(|_| ApiError::conflict("Срок проверки прав истёк"))?;
+    let identity = super::pipelines_routes::insert_bug_work_pipeline(
+        &mut tx,
+        configuration,
+        original.intent.operation_id,
+        &pipeline,
+    )
+    .await?;
+    let accepted = BugWorkOperationAccepted {
+        schema: "forge/bug-work-operation-accepted/v1".into(),
+        operation: BugWorkOperationIdentity {
+            operation_id: Uuid::new_v4(),
+            operation_key: key,
+            request_sha256: original.intent.request_sha256.clone(),
+        },
+        intent_operation_id: original.intent.operation_id,
+        configuration_id: configuration,
+        request: request.clone(),
+        candidate_ref: request.candidate_ref(),
+        pipeline: identity,
+        accepted_at: chrono::Utc::now(),
+    };
+    store::bug_work_publication::append_accepted(&mut tx, claims.sub, &accepted)
+        .await
+        .map_err(ApiError::internal)?;
+    tx.commit().await.map_err(ApiError::internal)?;
+    crate::dispatch_signal::notify_runner_work_available();
+    Ok(Json(BugWorkOperationReadback {
+        intent: original.intent,
+        accepted: Some(accepted),
+    }))
+}
diff --git a/backend/src/api/bug_work_proofs.rs b/backend/src/api/bug_work_proofs.rs
new file mode 100644
index 0000000..4f80000
--- /dev/null
+++ b/backend/src/api/bug_work_proofs.rs
@@ -0,0 +1,203 @@
+//! Fixed owner readback. Caller locators select retained evidence, never supply it.
+use super::{
+    ApiError, ApiResult, AppState,
+    bug_work_operations::{OriginalQuery, matches},
+    pool,
+};
+use crate::{
+    auth::AccessClaims,
+    domain::bug_work_publication::*,
+    store,
+    task_delivery::{bug_work_delivery as owner, delivered_target as targets},
+};
+use axum::{
+    Extension, Json,
+    extract::{Path, Query, State},
+};
+use std::sync::{Arc, OnceLock};
+use tokio::sync::Semaphore;
+use uuid::Uuid;
+async fn authorize(
+    state: &AppState,
+    claims: &AccessClaims,
+    configuration: Uuid,
+    mapping: &targets::TargetMapping,
+    original: &BugWorkOperationAccepted,
+    manifest: Option<&BugWorkStaticManifest>,
+) -> Result<serde_json::Value, ApiError> {
+    if state.config.sdlc_workspace.delivered_target_subject != Some(claims.sub)
+        || claims.role != "service_account"
+        || claims.service_account_name.is_none()
+        || claims.sid.is_some()
+        || claims.token_project_id != Some(configuration)
+    {
+        return Err(ApiError::forbidden());
+    }
+    let mut tx = pool(state)?.begin().await.map_err(ApiError::internal)?;
+    if !store::delivered_target::authorize_reader(
+        &mut tx,
+        claims.token_id,
+        claims.sub,
+        configuration,
+    )
+    .await
+    .map_err(ApiError::internal)?
+    {
+        return Err(ApiError::forbidden());
+    }
+    if mapping.repository_id != original.request.repository_id {
+        return Err(ApiError::forbidden());
+    }
+    let projection = store::delivered_target::lock_binding(
+        &mut tx,
+        configuration,
+        mapping.repository_id,
+        mapping.environment_id,
+        original.request.project.tracker_instance_id,
+        original.request.project.project_id,
+    )
+    .await
+    .map_err(ApiError::internal)?
+    .ok_or_else(ApiError::forbidden)?;
+    let command: pdlc_shared::resource_context::OwnerCommand =
+        serde_json::from_value(projection.clone()).map_err(|_| ApiError::forbidden())?;
+    crate::namespace::validate_projection(&command)?;
+    let accepted = store::bug_work_publication::accepted(
+        &mut tx,
+        configuration,
+        &original.operation.operation_key,
+    )
+    .await
+    .map_err(ApiError::internal)?
+    .ok_or_else(ApiError::forbidden)?;
+    if serde_json::to_vec(&accepted.1).ok() != serde_json::to_vec(original).ok() {
+        return Err(ApiError::forbidden());
+    }
+    if let Some(m) = manifest {
+        if !store::bug_work_publication::matches_artifact(&mut tx, m)
+            .await
+            .map_err(ApiError::internal)?
+        {
+            return Err(ApiError::conflict("Исходный артефакт изменился"));
+        }
+    }
+    tx.commit().await.map_err(ApiError::internal)?;
+    Ok(projection)
+}
+#[utoipa::path(get,path="/api/v1/projects/{project_id}/bug-work-operations/{operation_key}/delivery-proof/{target_ref}",tag="Bug work publications",params(("project_id"=Uuid,Path),("operation_key"=String,Path),("target_ref"=String,Path),OriginalQuery),responses((status=200,body=BugWorkDeliveryProof),(status=400),(status=401),(status=403),(status=404),(status=409),(status=503)))]
+pub(crate) async fn read(
+    State(state): State<Arc<AppState>>,
+    claims: Option<Extension<AccessClaims>>,
+    Path((configuration, key, target)): Path<(Uuid, String, String)>,
+    Query(query): Query<OriginalQuery>,
+) -> ApiResult<BugWorkDeliveryProof> {
+    let claims = claims.ok_or_else(ApiError::unauthorized)?.0;
+    if state.config.sdlc_workspace.delivered_target_subject != Some(claims.sub)
+        || claims.role != "service_account"
+        || claims.service_account_name.is_none()
+        || claims.sid.is_some()
+        || claims.token_project_id != Some(configuration)
+    {
+        return Err(ApiError::forbidden());
+    }
+    if !operation_key(&key) || !crate::domain::delivered_target::valid_target_ref(&target) {
+        return Err(ApiError::bad_request("Некорректный локатор доставки"));
+    }
+    let mut tx = pool(&state)?.begin().await.map_err(ApiError::internal)?;
+    if !store::delivered_target::authorize_reader(
+        &mut tx,
+        claims.token_id,
+        claims.sub,
+        configuration,
+    )
+    .await
+    .map_err(ApiError::internal)?
+    {
+        return Err(ApiError::forbidden());
+    }
+    let (_, intent) = store::bug_work_publication::intent(&mut tx, configuration, &key)
+        .await
+        .map_err(ApiError::internal)?
+        .ok_or_else(|| ApiError::not_found_named("операция исправления"))?;
+    matches(&intent, &query)?;
+    let (_, original) = store::bug_work_publication::accepted(&mut tx, configuration, &key)
+        .await
+        .map_err(ApiError::internal)?
+        .ok_or_else(|| ApiError::service_unavailable("Исходный pipeline ещё не принят"))?;
+    tx.commit().await.map_err(ApiError::internal)?;
+    let mapping_path = state
+        .config
+        .sdlc_workspace
+        .delivered_targets
+        .as_ref()
+        .ok_or_else(|| ApiError::service_unavailable("Целевые среды не настроены"))?;
+    let mapping = targets::mapping(mapping_path, configuration, &target)
+        .map_err(|_| ApiError::not_found_named("настроенная среда"))?;
+    let projection = authorize(&state, &claims, configuration, &mapping, &original, None).await?;
+    static OBSERVERS: OnceLock<Arc<Semaphore>> = OnceLock::new();
+    let permit = Arc::new(
+        OBSERVERS
+            .get_or_init(|| Arc::new(Semaphore::new(2)))
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| ApiError::service_unavailable("Лимит проверки доставки занят"))?,
+    );
+    let worker_permit = permit.clone();
+    let worker_state = state.clone();
+    let worker_mapping = mapping.clone();
+    let worker_original = original.clone();
+    let prepared = tokio::time::timeout(
+        std::time::Duration::from_secs(3),
+        tokio::task::spawn_blocking(move || {
+            let _permit = worker_permit;
+            owner::prepare_proof(&worker_state, &worker_mapping, &worker_original)
+        }),
+    )
+    .await;
+    let (mut result, manifest) = match prepared {
+        Ok(Ok(Ok(observation))) => {
+            let manifest = observation.manifest.clone();
+            if authorize(
+                &state,
+                &claims,
+                configuration,
+                &mapping,
+                &original,
+                Some(&manifest),
+            )
+            .await?
+                != projection
+            {
+                return Err(ApiError::forbidden());
+            }
+            (
+                owner::observe_proof(&mapping, observation).await,
+                Some(manifest),
+            )
+        }
+        _ => (
+            owner::unavailable(
+                &mapping,
+                &original,
+                "versioned_candidate_delivery_unavailable",
+            ),
+            None,
+        ),
+    };
+    if authorize(
+        &state,
+        &claims,
+        configuration,
+        &mapping,
+        &original,
+        manifest.as_ref(),
+    )
+    .await?
+        != projection
+        || !targets::mapping(mapping_path, configuration, &target).is_ok_and(|m| m == mapping)
+    {
+        result = owner::unavailable(&mapping, &original, "delivery_owner_binding_changed");
+        result.status = crate::domain::delivered_target::DeliveredTargetStatus::Changed;
+    }
+    Ok(Json(result))
+}
diff --git a/backend/src/api/delivered_targets.rs b/backend/src/api/delivered_targets.rs
new file mode 100644
index 0000000..1df0e57
--- /dev/null
+++ b/backend/src/api/delivered_targets.rs
@@ -0,0 +1,342 @@
+use super::{ApiError, ApiResult, AppState};
+use crate::{
+    auth::AccessClaims, domain::delivered_target::*, store::delivered_target as store,
+    task_delivery::delivered_target as owner,
+};
+use axum::{
+    Extension, Json, Router,
+    extract::{Path, Query, State},
+    routing::get,
+};
+use serde::Deserialize;
+use std::{
+    sync::{Arc, OnceLock},
+    time::Duration,
+};
+use tokio::sync::Semaphore;
+use uuid::Uuid;
+
+#[derive(Deserialize, utoipa::IntoParams)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct DeliveredTargetQuery {
+    tracker_instance_id: Uuid,
+    project_id: Uuid,
+    repository_id: Uuid,
+}
+
+pub(crate) fn routes() -> Router<Arc<AppState>> {
+    Router::new()
+        .route(
+            "/api/v1/projects/{project_id}/delivered-targets/{target_ref}",
+            get(read),
+        )
+        .layer(axum::middleware::map_response(
+            |mut response: axum::response::Response| async move {
+                response.headers_mut().insert(
+                    "cache-control",
+                    axum::http::HeaderValue::from_static("no-store"),
+                );
+                response
+            },
+        ))
+}
+
+#[utoipa::path(get, path="/api/v1/projects/{project_id}/delivered-targets/{target_ref}",
+    tag="Delivered targets", params(("project_id"=Uuid,Path,description="Forge configuration UUID, not Tracker project"),
+        ("target_ref"=String,Path), DeliveredTargetQuery),
+    responses((status=200,body=DeliveredTargetReadback),(status=400),(status=401),(status=403),(status=404),(status=503)))]
+pub(crate) async fn read(
+    State(state): State<Arc<AppState>>,
+    claims: Option<Extension<AccessClaims>>,
+    Path((configuration, target_ref)): Path<(Uuid, String)>,
+    Query(query): Query<DeliveredTargetQuery>,
+) -> ApiResult<DeliveredTargetReadback> {
+    let claims = claims.ok_or_else(ApiError::unauthorized)?.0;
+    let subject = state
+        .config
+        .sdlc_workspace
+        .delivered_target_subject
+        .ok_or_else(|| ApiError::service_unavailable("Чтение доставленной версии не настроено"))?;
+    if claims.sub != subject
+        || claims.role != "service_account"
+        || claims.service_account_name.is_none()
+        || claims.token_project_id != Some(configuration)
+        || claims.sid.is_some()
+    {
+        return Err(ApiError::forbidden());
+    }
+    if configuration.is_nil()
+        || query.tracker_instance_id.is_nil()
+        || query.project_id.is_nil()
+        || query.repository_id.is_nil()
+        || !valid_target_ref(&target_ref)
+    {
+        return Err(ApiError::bad_request(
+            "Некорректная ссылка на доставленную версию",
+        ));
+    }
+    let mut tx = state
+        .pool
+        .as_ref()
+        .ok_or_else(|| ApiError::service_unavailable("База владельца недоступна"))?
+        .begin()
+        .await
+        .map_err(ApiError::internal)?;
+    if !store::authorize_reader(&mut tx, claims.token_id, subject, configuration)
+        .await
+        .map_err(ApiError::internal)?
+    {
+        return Err(ApiError::forbidden());
+    }
+    let mapping_path = state
+        .config
+        .sdlc_workspace
+        .delivered_targets
+        .as_ref()
+        .ok_or_else(|| ApiError::service_unavailable("Целевые среды не настроены"))?;
+    let mapping = owner::mapping(mapping_path, configuration, &target_ref)
+        .map_err(|_| ApiError::not_found_named("настроенная доставленная версия"))?;
+    if mapping.repository_id != query.repository_id {
+        return Err(ApiError::forbidden());
+    }
+    let Some(projection) = store::lock_binding(
+        &mut tx,
+        configuration,
+        mapping.repository_id,
+        mapping.environment_id,
+        query.tracker_instance_id,
+        query.project_id,
+    )
+    .await
+    .map_err(ApiError::internal)?
+    else {
+        return Err(ApiError::forbidden());
+    };
+    let retained_projection = projection.clone();
+    let projection: pdlc_shared::resource_context::OwnerCommand =
+        serde_json::from_value(projection)
+            .map_err(|_| ApiError::service_unavailable("Некорректная проекция пространства"))?;
+    crate::namespace::validate_projection(&projection)?;
+    // Slow filesystem work and owner probes never retain authorization locks.
+    tx.commit().await.map_err(ApiError::internal)?;
+    static OBSERVERS: OnceLock<Arc<Semaphore>> = OnceLock::new();
+    let permit = Arc::new(
+        OBSERVERS
+            .get_or_init(|| Arc::new(Semaphore::new(2)))
+            .clone()
+            .try_acquire_owned()
+            .map_err(|_| {
+                ApiError::service_unavailable("Нет свободного слота проверки доставленной версии")
+            })?,
+    );
+    let project = DeliveredProjectRef {
+        tracker_instance_id: query.tracker_instance_id,
+        project_id: query.project_id,
+    };
+    let worker_mapping = mapping.clone();
+    let worker_state = state.clone();
+    let worker_project = project.clone();
+    let worker_permit = permit.clone();
+    let prepared = tokio::time::timeout(
+        Duration::from_secs(3),
+        tokio::task::spawn_blocking(move || {
+            let _permit = worker_permit;
+            owner::prepare(&worker_mapping, &worker_state, &worker_project)
+        }),
+    )
+    .await;
+    let mut observed_manifest = None;
+    let mut observed_bug_manifest = None;
+    let mut result = match prepared {
+        Ok(Ok(Ok(observation))) => {
+            observed_manifest = Some(observation.manifest.clone());
+            if recheck_owner(
+                &state,
+                &claims,
+                configuration,
+                &mapping,
+                &query,
+                &retained_projection,
+                observed_manifest.as_ref().map(ObservedManifest::Task),
+            )
+            .await?
+            {
+                owner::observe(&mapping, project.clone(), observation).await
+            } else {
+                owner::unavailable(
+                    &mapping,
+                    project.clone(),
+                    "delivered_source_binding_unavailable",
+                )
+            }
+        }
+        _ => {
+            let mapping_copy = mapping.clone();
+            let state_copy = state.clone();
+            let project_copy = project.clone();
+            let held_permit = permit.clone();
+            let prepared = tokio::time::timeout(
+                Duration::from_secs(3),
+                tokio::task::spawn_blocking(move || {
+                    let _permit = held_permit;
+                    crate::task_delivery::bug_work_delivery::prepare_current_target(
+                        &state_copy,
+                        &mapping_copy,
+                        &project_copy,
+                    )
+                }),
+            )
+            .await;
+            if let Ok(Ok(Ok(observation))) = prepared {
+                observed_bug_manifest = Some(observation.manifest.clone());
+                if recheck_owner(
+                    &state,
+                    &claims,
+                    configuration,
+                    &mapping,
+                    &query,
+                    &retained_projection,
+                    observed_bug_manifest
+                        .as_ref()
+                        .map(ObservedManifest::BugWork),
+                )
+                .await?
+                {
+                    let origin =
+                        crate::task_delivery::bug_work_delivery::target_origin(&observation);
+                    let proof = crate::task_delivery::bug_work_delivery::observe_proof(
+                        &mapping,
+                        observation,
+                    )
+                    .await;
+                    crate::task_delivery::bug_work_delivery::as_delivered_target(proof, origin)
+                } else {
+                    owner::unavailable(
+                        &mapping,
+                        project.clone(),
+                        "delivered_source_binding_unavailable",
+                    )
+                }
+            } else {
+                owner::unavailable(
+                    &mapping,
+                    project.clone(),
+                    "versioned_confirmed_delivery_unavailable",
+                )
+            }
+        }
+    };
+    if !recheck_owner(
+        &state,
+        &claims,
+        configuration,
+        &mapping,
+        &query,
+        &retained_projection,
+        observed_bug_manifest
+            .as_ref()
+            .map(ObservedManifest::BugWork)
+            .or_else(|| observed_manifest.as_ref().map(ObservedManifest::Task)),
+    )
+    .await?
+    {
+        result = owner::unavailable(&mapping, project.clone(), "delivered_owner_binding_changed");
+        result.status = DeliveredTargetStatus::Changed;
+    }
+    if !owner::mapping(mapping_path, configuration, &target_ref)
+        .is_ok_and(|current| current == mapping)
+    {
+        result = owner::unavailable(&mapping, project, "target_configuration_changed");
+        result.status = DeliveredTargetStatus::Changed;
+    }
+    drop(permit);
+    Ok(Json(result))
+}
+
+enum ObservedManifest<'a> {
+    Task(&'a crate::domain::task_delivery::DeliveryManifest),
+    BugWork(&'a crate::domain::bug_work_publication::BugWorkStaticManifest),
+}
+
+/// Short fresh transactions bracket the complete probe flow. A revocation can
+/// commit during HTTP and is observed before any confirmed identity is returned.
+async fn recheck_owner(
+    state: &AppState,
+    claims: &AccessClaims,
+    configuration: Uuid,
+    mapping: &owner::TargetMapping,
+    query: &DeliveredTargetQuery,
+    expected: &serde_json::Value,
+    manifest: Option<ObservedManifest<'_>>,
+) -> Result<bool, ApiError> {
+    let mut tx = state
+        .pool
+        .as_ref()
+        .ok_or_else(ApiError::unavailable)?
+        .begin()
+        .await
+        .map_err(ApiError::internal)?;
+    if !store::authorize_reader(&mut tx, claims.token_id, claims.sub, configuration)
+        .await
+        .map_err(ApiError::internal)?
+    {
+        return Err(ApiError::forbidden());
+    }
+    let current = store::lock_binding(
+        &mut tx,
+        configuration,
+        mapping.repository_id,
+        mapping.environment_id,
+        query.tracker_instance_id,
+        query.project_id,
+    )
+    .await
+    .map_err(ApiError::internal)?
+    .ok_or_else(ApiError::forbidden)?;
+    let projection: pdlc_shared::resource_context::OwnerCommand =
+        serde_json::from_value(current.clone())
+            .map_err(|_| ApiError::service_unavailable("Некорректная проекция пространства"))?;
+    crate::namespace::validate_projection(&projection)?;
+    let source = match manifest {
+        Some(ObservedManifest::Task(manifest)) => store::matches_manifest_source(&mut tx, manifest)
+            .await
+            .map_err(ApiError::internal)?,
+        Some(ObservedManifest::BugWork(manifest)) => {
+            crate::store::bug_work_publication::matches_artifact(&mut tx, manifest)
+                .await
+                .map_err(ApiError::internal)?
+        }
+        None => true,
+    };
+    tx.commit().await.map_err(ApiError::internal)?;
+    Ok(current == *expected && source)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn generation_keeps_u64_precision_and_caller_flags_are_rejected() {
+        let value = serde_json::json!({
+            "deliveryRef":"forge:delivered:sample", "operationKey":"deliver:1",
+            "generation":u64::MAX.to_string(), "manifestSha256":"a".repeat(64),
+            "commitSha":"b".repeat(40), "artifactId":Uuid::new_v4(),
+            "artifactDigest":format!("sha256:{}", "c".repeat(64)), "targetUrl":"http://qa.invalid",
+            "servingIdentity":{"versionBodySha256":"a".repeat(64),"artifactBodySha256":"c".repeat(64),"observedAt":chrono::Utc::now()}
+        });
+        let target: DeliveredTarget = serde_json::from_value(value.clone()).unwrap();
+        assert_eq!(target.generation, u64::MAX.to_string());
+        let mut foreign = value;
+        foreign["verified"] = true.into();
+        assert!(serde_json::from_value::<DeliveredTarget>(foreign).is_err());
+    }
+
+    #[test]
+    fn query_does_not_accept_proof_urls_or_caller_verified_flags() {
+        let mut value = serde_json::json!({"tracker_instance_id":Uuid::new_v4(),"project_id":Uuid::new_v4(),"repository_id":Uuid::new_v4()});
+        assert!(serde_json::from_value::<DeliveredTargetQuery>(value.clone()).is_ok());
+        value["verified"] = true.into();
+        assert!(serde_json::from_value::<DeliveredTargetQuery>(value).is_err());
+    }
+}
