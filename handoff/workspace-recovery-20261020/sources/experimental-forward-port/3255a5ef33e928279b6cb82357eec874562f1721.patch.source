diff --git a/backend/src/bug_work_authority.rs b/backend/src/bug_work_authority.rs
new file mode 100644
index 0000000..9f429d4
--- /dev/null
+++ b/backend/src/bug_work_authority.rs
@@ -0,0 +1,787 @@
+//! Fresh fixed-owner103/104 authority. No caller URLs, grant flags, or typed rehashing.
+use super::files;
+use crate::{config::BugWorkPublicationConfig, domain::bug_work_publication::*};
+use anyhow::{Context, ensure};
+use serde_json::Value;
+use sha2::{Digest, Sha256};
+use std::time::{Duration, Instant};
+use uuid::Uuid;
+
+/// Only this module can construct freshness. The original immutable request still
+/// has to be checked against local namespace/repository/token state in the effect TX.
+pub(crate) struct FreshAuthority {
+    checked_at: Instant,
+    configuration_id: Uuid,
+    request_sha256: String,
+    pub(crate) branch_ref: String,
+    pub(crate) clone_url_sha256: String,
+}
+impl FreshAuthority {
+    #[cfg(test)]
+    pub(super) fn for_request(configuration_id: Uuid, request: &BugWorkOperationRequest) -> Self {
+        Self {
+            checked_at: Instant::now(),
+            configuration_id,
+            request_sha256: canonical_hash(&serde_json::to_value(request).unwrap()).unwrap(),
+            branch_ref: "refs/heads/main".into(),
+            clone_url_sha256: "f".repeat(64),
+        }
+    }
+
+    pub(crate) fn require_current(
+        &self,
+        configuration_id: Uuid,
+        request: &BugWorkOperationRequest,
+    ) -> anyhow::Result<()> {
+        ensure!(
+            self.configuration_id == configuration_id
+                && self.checked_at.elapsed() <= Duration::from_secs(5)
+                && self.request_sha256 == canonical_hash(&serde_json::to_value(request)?)?,
+            "Bug work authority expired or request changed"
+        );
+        Ok(())
+    }
+}
+
+pub(crate) fn canonical_hash(v: &Value) -> anyhow::Result<String> {
+    fn sorted(v: &Value) -> anyhow::Result<Value> {
+        Ok(match v {
+            Value::Object(m) => {
+                let mut keys: Vec<_> = m.keys().collect();
+                keys.sort();
+                let mut result = serde_json::Map::new();
+                for key in keys {
+                    result.insert(key.clone(), sorted(&m[key])?);
+                }
+                Value::Object(result)
+            }
+            Value::Array(a) => Value::Array(a.iter().map(sorted).collect::<anyhow::Result<_>>()?),
+            Value::Number(n) => {
+                ensure!(n.is_i64() || n.is_u64(), "floating owner value denied");
+                v.clone()
+            }
+            _ => v.clone(),
+        })
+    }
+    Ok(format!(
+        "{:x}",
+        Sha256::digest(serde_json::to_vec(&sorted(v)?)?)
+    ))
+}
+fn closed<'a>(
+    v: &'a Value,
+    required: &[&str],
+    optional: &[&str],
+) -> anyhow::Result<&'a serde_json::Map<String, Value>> {
+    let m = v.as_object().context("owner object required")?;
+    ensure!(
+        required.iter().all(|k| m.contains_key(*k))
+            && m.keys()
+                .all(|k| required.contains(&k.as_str()) || optional.contains(&k.as_str())),
+        "closed owner shape differs"
+    );
+    Ok(m)
+}
+fn string(v: &Value) -> anyhow::Result<&str> {
+    v.as_str().context("owner string required")
+}
+fn id(v: &Value) -> anyhow::Result<Uuid> {
+    let id = Uuid::parse_str(string(v)?)?;
+    ensure!(!id.is_nil(), "nil owner identity");
+    Ok(id)
+}
+fn revision(v: &Value) -> anyhow::Result<i64> {
+    let n = v.as_i64().context("owner integer required")?;
+    ensure!(
+        (1..=MAX_SAFE_REVISION).contains(&n),
+        "owner revision invalid"
+    );
+    Ok(n)
+}
+fn text(v: &Value, max: usize) -> anyhow::Result<&str> {
+    let s = string(v)?;
+    ensure!(
+        !s.trim().is_empty() && s.len() <= max && !s.chars().any(char::is_control),
+        "owner text invalid"
+    );
+    Ok(s)
+}
+fn opaque(v: &Value, max: usize) -> anyhow::Result<&str> {
+    let s = string(v)?;
+    ensure!(
+        !s.trim().is_empty() && s.len() <= max && !s.contains('\0'),
+        "owner opaque text invalid"
+    );
+    Ok(s)
+}
+fn strings(v: &Value, max: usize, limit: usize) -> anyhow::Result<()> {
+    let a = v.as_array().context("owner array required")?;
+    ensure!(a.len() <= limit, "owner array exceeds bound");
+    for s in a {
+        text(s, max)?;
+    }
+    Ok(())
+}
+
+/// Exact raw objects are hashed BEFORE any timestamp/type normalization. This
+/// reader never claims that an assignment, source snapshot or binding is verified
+/// merely because the producer supplied a boolean.
+fn validate_current(
+    configuration: Uuid,
+    request: &BugWorkOperationRequest,
+    state: &Value,
+    origin: &Value,
+) -> anyhow::Result<(String, String)> {
+    request.validate().map_err(anyhow::Error::msg)?;
+    let b = &request.bug_work;
+    closed(
+        state,
+        &[
+            "assignment",
+            "assignment_sha256",
+            "binding",
+            "closure",
+            "capacity_held",
+            "can_take_bugs",
+            "blocked_reasons",
+        ],
+        &[],
+    )?;
+    ensure!(
+        state["closure"].is_null()
+            && state["capacity_held"] == true
+            && state["can_take_bugs"].is_boolean(),
+        "assignment does not hold capacity"
+    );
+    strings(&state["blocked_reasons"], 512, 64)?;
+    let a = &state["assignment"];
+    closed(
+        a,
+        &[
+            "contract_version",
+            "assignment_id",
+            "tracker_instance_id",
+            "tracker_instance_uuid",
+            "project_id",
+            "bug_id",
+            "owner_subject",
+            "machine_subject",
+            "worker_runtime",
+            "fleet_journal_ref",
+            "preference_revision",
+            "fence",
+            "purpose",
+            "role",
+            "mode",
+            "source_identity",
+            "source_sha256",
+            "verification_basis",
+            "verification_basis_sha256",
+            "canonical_basis_sha256",
+            "created_at",
+        ],
+        &["origin"],
+    )?;
+    ensure!(
+        a["contract_version"] == 1
+            && id(&a["assignment_id"])? == b.assignment_id
+            && id(&a["bug_id"])? == b.bug_id
+            && id(&a["project_id"])? == request.project.project_id
+            && id(&a["tracker_instance_uuid"])? == request.project.tracker_instance_id
+            && string(&a["owner_subject"])? == b.owner_subject
+            && revision(&a["fence"])? == b.fence
+            && a["purpose"] == "bug_fix"
+            && a["role"] == "developer"
+            && a["mode"] == "initial"
+            && state["assignment_sha256"] == b.assignment_sha256
+            && canonical_hash(a)? == b.assignment_sha256,
+        "assignment differs from original candidate"
+    );
+    opaque(&a["tracker_instance_id"], 128)?;
+    text(&a["machine_subject"], 512)?;
+    ensure!(
+        a["machine_subject"] != a["owner_subject"],
+        "machine cannot be owner"
+    );
+    text(&a["fleet_journal_ref"], 512)?;
+    revision(&a["preference_revision"])?;
+    chrono::DateTime::parse_from_rfc3339(string(&a["created_at"])?)?;
+    let w = &a["worker_runtime"];
+    closed(
+        w,
+        &["fleet_instance_id", "agent_id", "agent_config_revision"],
+        &[],
+    )?;
+    id(&w["fleet_instance_id"])?;
+    id(&w["agent_id"])?;
+    revision(&w["agent_config_revision"])?;
+    let binding = &state["binding"];
+    closed(
+        binding,
+        &[
+            "runtime_context_id",
+            "runtime_generation",
+            "session_id",
+            "session_run_id",
+            "hermes_run_ref",
+            "workflow_task_id",
+            "workflow_assignment_revision",
+            "workflow_operation_key",
+            "workflow_binding_ref",
+        ],
+        &[],
+    )?;
+    for k in [
+        "runtime_context_id",
+        "runtime_generation",
+        "session_id",
+        "session_run_id",
+    ] {
+        id(&binding[k])?;
+    }
+    for k in [
+        "hermes_run_ref",
+        "workflow_operation_key",
+        "workflow_binding_ref",
+    ] {
+        text(&binding[k], 512)?;
+    }
+    revision(&binding["workflow_task_id"])?;
+    revision(&binding["workflow_assignment_revision"])?;
+    ensure!(
+        canonical_hash(binding)? == b.runtime_binding_sha256,
+        "actual runtime binding differs"
+    );
+    let source = &a["source_identity"];
+    closed(
+        source,
+        &[
+            "schema_version",
+            "producer",
+            "rule_key",
+            "stable_defect_key",
+        ],
+        &["repository_id"],
+    )?;
+    ensure!(
+        source["schema_version"] == 1
+            && id(&source["repository_id"])? == request.repository_id
+            && a["source_sha256"] == canonical_hash(source)?,
+        "source repository differs"
+    );
+    text(&source["producer"], 128)?;
+    text(&source["rule_key"], 256)?;
+    text(&source["stable_defect_key"], 512)?;
+    let report = &a["verification_basis"];
+    closed(
+        report,
+        &[
+            "title",
+            "basis",
+            "expected",
+            "actual",
+            "reproducer",
+            "checked_version",
+            "evidence_refs",
+        ],
+        &[],
+    )?;
+    for (k, max) in [
+        ("title", 500),
+        ("basis", 8192),
+        ("expected", 8192),
+        ("actual", 8192),
+        ("reproducer", 16384),
+        ("checked_version", 512),
+    ] {
+        opaque(&report[k], max)?;
+    }
+    let evidence = report["evidence_refs"]
+        .as_array()
+        .context("owner evidence array required")?;
+    ensure!(evidence.len() <= 32, "owner evidence exceeds bound");
+    for item in evidence {
+        opaque(item, 1024)?;
+    }
+    ensure!(
+        serde_json::to_vec_pretty(report)?.len() <= 65536,
+        "owner report exceeds bound"
+    );
+    ensure!(
+        report["checked_version"] == b.base_commit_sha
+            && a["verification_basis_sha256"] == b.verification_basis_sha256
+            && canonical_hash(report)? == b.verification_basis_sha256
+            && a["canonical_basis_sha256"] == b.canonical_basis_sha256,
+        "verification basis differs"
+    );
+    let origin_ref = &a["origin"];
+    closed(
+        origin_ref,
+        &[
+            "contract_version",
+            "execution_id",
+            "finding_id",
+            "snapshot_sha256",
+            "source_context_sha256",
+        ],
+        &[],
+    )?;
+    id(&origin_ref["execution_id"])?;
+    id(&origin_ref["finding_id"])?;
+    ensure!(
+        origin_ref["contract_version"] == 1
+            && sha256(string(&origin_ref["snapshot_sha256"])?)
+            && origin_ref["source_context_sha256"] == b.source_context_sha256,
+        "source origin missing"
+    );
+    closed(
+        origin,
+        &[
+            "contract_version",
+            "assignment_id",
+            "assignment_sha256",
+            "origin",
+            "source_context",
+        ],
+        &[],
+    )?;
+    ensure!(
+        origin["contract_version"] == 1
+            && id(&origin["assignment_id"])? == b.assignment_id
+            && origin["assignment_sha256"] == b.assignment_sha256
+            && origin["origin"] == *origin_ref,
+        "origin readback differs"
+    );
+    let context = &origin["source_context"];
+    closed(
+        context,
+        &[
+            "contract_version",
+            "project",
+            "mode",
+            "targets",
+            "scope",
+            "excluded_paths",
+        ],
+        &[],
+    )?;
+    closed(
+        &context["project"],
+        &["tracker_instance_id", "project_id"],
+        &[],
+    )?;
+    ensure!(
+        context["contract_version"] == 1
+            && context["project"]["tracker_instance_id"] == a["tracker_instance_id"]
+            && id(&context["project"]["project_id"])? == request.project.project_id
+            && canonical_hash(context)? == b.source_context_sha256
+            && matches!(string(&context["mode"])?, "source_only" | "qa"),
+        "source context differs"
+    );
+    for paths in [&context["scope"], &context["excluded_paths"]] {
+        strings(paths, 512, 128)?;
+        for item in paths.as_array().unwrap() {
+            let s = string(item)?;
+            ensure!(
+                !s.starts_with('/')
+                    && !s.contains(['\\', ':'])
+                    && !s.split('/').any(|part| part == ".."),
+                "source path invalid"
+            );
+        }
+    }
+    let targets = context["targets"]
+        .as_array()
+        .context("source targets missing")?;
+    ensure!(
+        !targets.is_empty() && targets.len() <= 16,
+        "source targets exceed bound"
+    );
+    let mut matched = None;
+    let mut matched_identity: Option<Value> = None;
+    for target in targets {
+        closed(
+            target,
+            &[
+                "repository_ref",
+                "commit_sha",
+                "target_ref",
+                "deployment_ref",
+            ],
+            &["source"],
+        )?;
+        text(&target["repository_ref"], 512)?;
+        ensure!(
+            commit(string(&target["commit_sha"])?),
+            "source target commit invalid"
+        );
+        for key in ["target_ref", "deployment_ref"] {
+            if !target[key].is_null() {
+                text(&target[key], 512)?;
+            }
+        }
+        if context["mode"] == "qa" {
+            ensure!(
+                !target["target_ref"].is_null() && !target["deployment_ref"].is_null(),
+                "QA target unresolved"
+            );
+        }
+        if target["source"].is_null() {
+            continue;
+        }
+        let pin = &target["source"];
+        closed(
+            pin,
+            &[
+                "contract_version",
+                "schema",
+                "producer_version",
+                "project",
+                "configuration_id",
+                "repository_id",
+                "branch_ref",
+                "observed_head_sha",
+                "clone_url_sha256",
+            ],
+            &[],
+        )?;
+        closed(&pin["project"], &["tracker_instance_id", "project_id"], &[])?;
+        ensure!(
+            pin["contract_version"] == 1
+                && pin["schema"] == "forge/source-snapshot/v1"
+                && id(&pin["project"]["tracker_instance_id"])?
+                    == request.project.tracker_instance_id
+                && id(&pin["project"]["project_id"])? == request.project.project_id
+                && crate::domain::source_snapshot::valid_branch_ref(string(&pin["branch_ref"])?)
+                && commit(string(&pin["observed_head_sha"])?)
+                && sha256(string(&pin["clone_url_sha256"])?),
+            "source provenance invalid"
+        );
+        text(&pin["producer_version"], 128)?;
+        if context["mode"] == "source_only" {
+            ensure!(
+                pin["observed_head_sha"] == target["commit_sha"],
+                "original source-only commit differs"
+            );
+        }
+        if id(&pin["repository_id"])? == request.repository_id
+            && target["commit_sha"] == b.base_commit_sha
+        {
+            let identity = serde_json::json!({
+                "repository_ref":target["repository_ref"], "commit_sha":target["commit_sha"], "source":pin,
+            });
+            ensure!(
+                id(&pin["configuration_id"])? == configuration
+                    && matched_identity
+                        .as_ref()
+                        .is_none_or(|original| original == &identity),
+                "candidate configuration ambiguous"
+            );
+            matched_identity = Some(identity);
+            matched = Some((
+                string(&pin["branch_ref"])?.to_owned(),
+                string(&pin["clone_url_sha256"])?.to_owned(),
+            ));
+        }
+    }
+    matched.context("original repository/base source not found")
+}
+
+// Duplicate keys would make the raw hash ambiguous across owner languages.
+// The recursive visitor also excludes JSON floats before retaining any authority.
+fn parse_owner(bytes: &[u8]) -> anyhow::Result<Value> {
+    struct Exact(Value);
+    impl<'de> serde::Deserialize<'de> for Exact {
+        fn deserialize<D: serde::Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
+            struct Visitor;
+            impl<'de> serde::de::Visitor<'de> for Visitor {
+                type Value = Exact;
+                fn expecting(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                    f.write_str("closed integer JSON")
+                }
+                fn visit_bool<E: serde::de::Error>(self, v: bool) -> Result<Exact, E> {
+                    Ok(Exact(v.into()))
+                }
+                fn visit_i64<E: serde::de::Error>(self, v: i64) -> Result<Exact, E> {
+                    Ok(Exact(v.into()))
+                }
+                fn visit_u64<E: serde::de::Error>(self, v: u64) -> Result<Exact, E> {
+                    Ok(Exact(v.into()))
+                }
+                fn visit_str<E: serde::de::Error>(self, v: &str) -> Result<Exact, E> {
+                    Ok(Exact(v.into()))
+                }
+                fn visit_string<E: serde::de::Error>(self, v: String) -> Result<Exact, E> {
+                    Ok(Exact(v.into()))
+                }
+                fn visit_unit<E: serde::de::Error>(self) -> Result<Exact, E> {
+                    Ok(Exact(Value::Null))
+                }
+                fn visit_none<E: serde::de::Error>(self) -> Result<Exact, E> {
+                    Ok(Exact(Value::Null))
+                }
+                fn visit_seq<A: serde::de::SeqAccess<'de>>(
+                    self,
+                    mut a: A,
+                ) -> Result<Exact, A::Error> {
+                    let mut out = Vec::new();
+                    while let Some(Exact(v)) = a.next_element()? {
+                        out.push(v);
+                    }
+                    Ok(Exact(Value::Array(out)))
+                }
+                fn visit_map<A: serde::de::MapAccess<'de>>(
+                    self,
+                    mut a: A,
+                ) -> Result<Exact, A::Error> {
+                    let mut out = serde_json::Map::new();
+                    while let Some((k, Exact(v))) = a.next_entry::<String, Exact>()? {
+                        if out.insert(k, v).is_some() {
+                            return Err(serde::de::Error::custom("duplicate owner key"));
+                        }
+                    }
+                    Ok(Exact(Value::Object(out)))
+                }
+            }
+            d.deserialize_any(Visitor)
+        }
+    }
+    Ok(serde_json::from_slice::<Exact>(bytes)?.0)
+}
+
+pub(crate) async fn read_current(
+    config: &BugWorkPublicationConfig,
+    configuration: Uuid,
+    request: &BugWorkOperationRequest,
+) -> anyhow::Result<FreshAuthority> {
+    static READERS: std::sync::OnceLock<tokio::sync::Semaphore> = std::sync::OnceLock::new();
+    let _permit = READERS
+        .get_or_init(|| tokio::sync::Semaphore::new(2))
+        .try_acquire()
+        .map_err(|_| anyhow::anyhow!("owner read capacity unavailable"))?;
+    let root = config
+        .tracker_origin
+        .as_deref()
+        .context("Tracker reader not configured")?;
+    let token_path = config
+        .tracker_reader_token_file
+        .as_ref()
+        .context("Tracker credential not configured")?
+        .clone();
+    let bytes = tokio::task::spawn_blocking(move || files::read_bytes(&token_path, 8192)).await??;
+    let token = std::str::from_utf8(&bytes)?.trim();
+    ensure!(
+        !token.is_empty() && !token.chars().any(char::is_whitespace),
+        "invalid owner credential file"
+    );
+    let mut auth = reqwest::header::HeaderValue::from_str(&format!("Bearer {token}"))?;
+    auth.set_sensitive(true);
+    let client = reqwest::Client::builder()
+        .no_proxy()
+        .redirect(reqwest::redirect::Policy::none())
+        .timeout(Duration::from_secs(5))
+        .build()?;
+    let prefix = format!(
+        "{}/api/v1/projects/{}/sdlc/bug-intake/assignments/{}",
+        root.trim_end_matches('/'),
+        request.project.project_id,
+        request.bug_work.assignment_id
+    );
+    async fn get(
+        client: &reqwest::Client,
+        url: String,
+        auth: &reqwest::header::HeaderValue,
+        limit: usize,
+    ) -> anyhow::Result<Value> {
+        let mut r = client
+            .get(url)
+            .header(reqwest::header::AUTHORIZATION, auth)
+            .header(reqwest::header::ACCEPT_ENCODING, "identity")
+            .send()
+            .await
+            .map_err(|_| anyhow::anyhow!("Tracker owner unavailable"))?;
+        ensure!(
+            r.status() == reqwest::StatusCode::OK,
+            "Tracker owner authority denied"
+        );
+        ensure!(
+            r.headers()
+                .get(reqwest::header::CONTENT_ENCODING)
+                .is_none_or(|v| v == "identity")
+                && r.content_length().is_none_or(|n| n <= limit as u64),
+            "owner encoding/size denied"
+        );
+        let mut body = Vec::new();
+        while let Some(chunk) = r
+            .chunk()
+            .await
+            .map_err(|_| anyhow::anyhow!("Tracker owner read unavailable"))?
+        {
+            ensure!(
+                body.len() + chunk.len() <= limit,
+                "owner response exceeds bound"
+            );
+            body.extend_from_slice(&chunk);
+        }
+        parse_owner(&body)
+    }
+    let checked_at = Instant::now();
+    let (state, origin) = tokio::time::timeout(Duration::from_secs(5), async {
+        let state = get(&client, format!("{prefix}/grant"), &auth, 128 * 1024).await?;
+        let origin = get(&client, format!("{prefix}/origin"), &auth, 64 * 1024).await?;
+        Ok::<_, anyhow::Error>((state, origin))
+    })
+    .await
+    .context("Tracker owner deadline exceeded")??;
+    let (branch_ref, clone_url_sha256) = validate_current(configuration, request, &state, &origin)?;
+    Ok(FreshAuthority {
+        checked_at,
+        configuration_id: configuration,
+        request_sha256: canonical_hash(&serde_json::to_value(request)?)?,
+        branch_ref,
+        clone_url_sha256,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn fixture() -> (Value, Value, BugWorkOperationRequest, Uuid) {
+        let v: Value = serde_json::from_str(include_str!(
+            "../domain/tests/fixtures/bug-work-delivery-v1.json"
+        ))
+        .unwrap();
+        let proof = &v["proof"];
+        let r = BugWorkOperationRequest {
+            contract_version: 1,
+            operation_key: "fix:1".into(),
+            project: serde_json::from_value(proof["project"].clone()).unwrap(),
+            bug_work: serde_json::from_value(proof["bugWork"].clone()).unwrap(),
+            repository_id: id(&proof["repositoryId"]).unwrap(),
+            candidate_tree_id: "c".repeat(40),
+            bundle_sha256: "d".repeat(64),
+            bundle_size_bytes: 123,
+        };
+        let origin = serde_json::json!({"contract_version":1,"assignment_id":r.bug_work.assignment_id,"assignment_sha256":r.bug_work.assignment_sha256,"origin":v["state"]["assignment"]["origin"],"source_context":v["source"]});
+        (
+            v["state"].clone(),
+            origin,
+            r,
+            id(&proof["configurationId"]).unwrap(),
+        )
+    }
+    #[test]
+    fn raw_golden_owner_binding_rejects_foreign_source_revoke_and_fabricated_flags() {
+        let (state, origin, request, configuration) = fixture();
+        validate_current(configuration, &request, &state, &origin).unwrap();
+        for n in 0..12 {
+            let (mut s, mut o, mut r) = (state.clone(), origin.clone(), request.clone());
+            match n {
+                0 => s["capacity_held"] = false.into(),
+                1 => s["closure"] = serde_json::json!({"kind":"actual_terminal"}),
+                2 => r.bug_work.runtime_binding_sha256 = "0".repeat(64),
+                3 => r.project.project_id = Uuid::new_v4(),
+                4 => r.repository_id = Uuid::new_v4(),
+                5 => r.bug_work.base_commit_sha = "f".repeat(40),
+                6 => s["verified"] = true.into(),
+                7 => o["source_context"]["verified"] = true.into(),
+                8 => {
+                    o["source_context"]["targets"][0]["source"]["repository_id"] =
+                        Uuid::new_v4().to_string().into()
+                }
+                9 => r.bug_work.assignment_sha256 = "a".repeat(64),
+                10 => r.bug_work.fence += 1,
+                _ => r.bug_work.source_context_sha256 = "1".repeat(64),
+            }
+            assert!(
+                validate_current(configuration, &r, &s, &o).is_err(),
+                "mutation {n}"
+            );
+        }
+        let authority = FreshAuthority {
+            checked_at: Instant::now() - Duration::from_secs(6),
+            configuration_id: configuration,
+            request_sha256: canonical_hash(&serde_json::to_value(&request).unwrap()).unwrap(),
+            branch_ref: "refs/heads/main".into(),
+            clone_url_sha256: "f".repeat(64),
+        };
+        assert!(authority.require_current(configuration, &request).is_err());
+    }
+    #[test]
+    fn owner_multiline_report_and_opaque_alias_are_hashed_without_sanitizing() {
+        let (mut state, mut origin, mut request, configuration) = fixture();
+        state["assignment"]["tracker_instance_id"] = "исходный Tracker\r\nopaque".into();
+        origin["source_context"]["project"]["tracker_instance_id"] =
+            state["assignment"]["tracker_instance_id"].clone();
+        state["assignment"]["verification_basis"]["reproducer"] =
+            "1. Open\n2. Check\tresult".into();
+        state["assignment"]["verification_basis"]["basis"] = "code:\n\treturn false;".into();
+        request.bug_work.verification_basis_sha256 =
+            canonical_hash(&state["assignment"]["verification_basis"]).unwrap();
+        state["assignment"]["verification_basis_sha256"] =
+            request.bug_work.verification_basis_sha256.clone().into();
+        request.bug_work.source_context_sha256 = canonical_hash(&origin["source_context"]).unwrap();
+        state["assignment"]["origin"]["source_context_sha256"] =
+            request.bug_work.source_context_sha256.clone().into();
+        origin["origin"] = state["assignment"]["origin"].clone();
+        request.bug_work.assignment_sha256 = canonical_hash(&state["assignment"]).unwrap();
+        state["assignment_sha256"] = request.bug_work.assignment_sha256.clone().into();
+        origin["assignment_sha256"] = request.bug_work.assignment_sha256.clone().into();
+        validate_current(configuration, &request, &state, &origin).unwrap();
+        assert_eq!(
+            origin["source_context"]["project"]["tracker_instance_id"],
+            state["assignment"]["tracker_instance_id"]
+        );
+    }
+    #[test]
+    fn repeated_exact_source_across_qa_targets_coalesces_but_changed_original_source_does_not() {
+        let (mut state, mut origin, mut request, configuration) = fixture();
+        origin["source_context"]["mode"] = "qa".into();
+        origin["source_context"]["targets"][0]["target_ref"] = "qa:first".into();
+        origin["source_context"]["targets"][0]["deployment_ref"] = "delivery:first".into();
+        let mut second = origin["source_context"]["targets"][0].clone();
+        second["target_ref"] = "qa:second".into();
+        second["deployment_ref"] = "delivery:second".into();
+        origin["source_context"]["targets"]
+            .as_array_mut()
+            .unwrap()
+            .push(second);
+        let rehash = |s: &mut Value, o: &mut Value, r: &mut BugWorkOperationRequest| {
+            r.bug_work.source_context_sha256 = canonical_hash(&o["source_context"]).unwrap();
+            s["assignment"]["origin"]["source_context_sha256"] =
+                r.bug_work.source_context_sha256.clone().into();
+            o["origin"] = s["assignment"]["origin"].clone();
+            r.bug_work.assignment_sha256 = canonical_hash(&s["assignment"]).unwrap();
+            s["assignment_sha256"] = r.bug_work.assignment_sha256.clone().into();
+            o["assignment_sha256"] = r.bug_work.assignment_sha256.clone().into();
+        };
+        rehash(&mut state, &mut origin, &mut request);
+        validate_current(configuration, &request, &state, &origin).unwrap();
+        for field in [
+            "repository_ref",
+            "branch_ref",
+            "configuration_id",
+            "clone_url_sha256",
+        ] {
+            let (mut s, mut o, mut r) = (state.clone(), origin.clone(), request.clone());
+            let second = &mut o["source_context"]["targets"][1];
+            match field {
+                "repository_ref" => second[field] = "catalog:foreign-ref".into(),
+                "branch_ref" => second["source"][field] = "refs/heads/foreign".into(),
+                "configuration_id" => second["source"][field] = Uuid::new_v4().to_string().into(),
+                _ => second["source"][field] = "f".repeat(64).into(),
+            }
+            rehash(&mut s, &mut o, &mut r);
+            assert!(
+                validate_current(configuration, &r, &s, &o).is_err(),
+                "{field}"
+            );
+        }
+    }
+    #[test]
+    fn raw_owner_parser_rejects_nested_duplicate_fields_and_floats() {
+        assert!(parse_owner(br#"{"assignment":{"fence":1,"fence":2}}"#).is_err());
+        assert!(parse_owner(br#"{"fence":1.0}"#).is_err());
+        assert!(parse_owner(br#"{"fence":1,"origin":{"fence":2}}"#).is_ok());
+    }
+}
diff --git a/backend/src/bug_work_config.rs b/backend/src/bug_work_config.rs
new file mode 100644
index 0000000..3c3af90
--- /dev/null
+++ b/backend/src/bug_work_config.rs
@@ -0,0 +1,113 @@
+//! Operator-owned locators. Configuration never asserts owner authority or delivery.
+use super::{ConfigError, bool_from_env, optional_trimmed};
+use std::path::PathBuf;
+use uuid::Uuid;
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct BugWorkPublicationConfig {
+    /// Gates new intent/import/build effects only; original custody reads remain available.
+    pub enabled: bool,
+    pub producer_subject: Option<Uuid>,
+    pub tracker_origin: Option<String>,
+    pub tracker_reader_token_file: Option<PathBuf>,
+    pub controller_root: Option<PathBuf>,
+}
+impl BugWorkPublicationConfig {
+    pub(super) fn from_source(
+        get: &mut impl FnMut(&str) -> Option<String>,
+    ) -> Result<Self, ConfigError> {
+        let subject = optional_trimmed(get("CICD_BUG_WORK_PRODUCER_SUBJECT"))
+            .map(|v| {
+                v.parse::<Uuid>()
+                    .ok()
+                    .filter(|v| !v.is_nil())
+                    .ok_or_else(|| {
+                        ConfigError::invalid(
+                            "CICD_BUG_WORK_PRODUCER_SUBJECT",
+                            "expected non-nil UUID",
+                        )
+                    })
+            })
+            .transpose()?;
+        let origin = optional_trimmed(get("CICD_BUG_WORK_TRACKER_ORIGIN"));
+        if let Some(value) = &origin {
+            let url = reqwest::Url::parse(value).map_err(|_| {
+                ConfigError::invalid("CICD_BUG_WORK_TRACKER_ORIGIN", "expected fixed HTTP origin")
+            })?;
+            if !matches!(url.scheme(), "http" | "https")
+                || url.host_str().is_none()
+                || !url.username().is_empty()
+                || url.password().is_some()
+                || url.query().is_some()
+                || url.fragment().is_some()
+                || url.path() != "/"
+            {
+                return Err(ConfigError::invalid(
+                    "CICD_BUG_WORK_TRACKER_ORIGIN",
+                    "expected credential-free HTTP origin without path",
+                ));
+            }
+        }
+        fn path(
+            get: &mut impl FnMut(&str) -> Option<String>,
+            name: &'static str,
+        ) -> Result<Option<PathBuf>, ConfigError> {
+            optional_trimmed(get(name))
+                .map(|v| {
+                    let p = PathBuf::from(v);
+                    if !p.is_absolute() {
+                        return Err(ConfigError::invalid(
+                            name,
+                            "expected protected absolute path",
+                        ));
+                    }
+                    Ok(p)
+                })
+                .transpose()
+        }
+        let result = Self {
+            enabled: bool_from_env("CICD_BUG_WORK_ENABLED", get("CICD_BUG_WORK_ENABLED"), false)?,
+            producer_subject: subject,
+            tracker_origin: origin,
+            tracker_reader_token_file: path(get, "CICD_BUG_WORK_TRACKER_READER_TOKEN_FILE")?,
+            controller_root: path(get, "CICD_BUG_WORK_CONTROLLER_ROOT")?,
+        };
+        if result.enabled
+            && (result.producer_subject.is_none()
+                || result.tracker_origin.is_none()
+                || result.tracker_reader_token_file.is_none()
+                || result.controller_root.is_none())
+        {
+            return Err(ConfigError::invalid(
+                "CICD_BUG_WORK_ENABLED",
+                "new effects require all explicit producer/owner/controller locators",
+            ));
+        }
+        Ok(result)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn absent_defaults_and_partial_or_caller_url_configuration_fail_closed() {
+        let mut empty = |_: &str| None;
+        assert_eq!(
+            BugWorkPublicationConfig::from_source(&mut empty).unwrap(),
+            BugWorkPublicationConfig::default()
+        );
+        let mut enabled = |name: &str| (name == "CICD_BUG_WORK_ENABLED").then(|| "true".into());
+        assert!(BugWorkPublicationConfig::from_source(&mut enabled).is_err());
+        for origin in [
+            "https://u:p@tracker/",
+            "https://tracker/api/",
+            "https://tracker/?url=x",
+            "file:///tmp/x",
+        ] {
+            let mut get =
+                |name: &str| (name == "CICD_BUG_WORK_TRACKER_ORIGIN").then(|| origin.to_owned());
+            assert!(BugWorkPublicationConfig::from_source(&mut get).is_err());
+        }
+    }
+}
diff --git a/backend/src/bug_work_delivery.rs b/backend/src/bug_work_delivery.rs
new file mode 100644
index 0000000..1cdc4ca
--- /dev/null
+++ b/backend/src/bug_work_delivery.rs
@@ -0,0 +1,874 @@
+//! BugWork carrier on the existing static owner target/probes/versioned publication.
+//! It contains an actual immutable Accepted/pipeline, never a synthetic Task lease.
+use super::*;
+use crate::{domain::bug_work_publication::*, store::bug_work_publication as journal};
+
+#[derive(Serialize, Deserialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(super) struct PublishIntent {
+    schema: String,
+    receipt: BugWorkPublishReceipt,
+    manifest: BugWorkStaticManifest,
+    policy_sha256: String,
+    previous_pointer: Option<Pointer>,
+}
+pub(super) fn require_settled(path: &Path, intent: &PublishIntent) -> anyhow::Result<()> {
+    let result = optional::<BugWorkPublishReceipt>(&path.join("reconciled.json"))?
+        .or(optional::<BugWorkPublishReceipt>(
+            &path.join("result.json"),
+        )?)
+        .context("unreconciled Bug publication holds target")?;
+    same_result(intent, &result)?;
+    ensure!(
+        result.status != DeliveryStatus::Unknown,
+        "unreconciled Bug publication holds target"
+    );
+    Ok(())
+}
+fn same_result(intent: &PublishIntent, result: &BugWorkPublishReceipt) -> anyhow::Result<()> {
+    ensure!(
+        intent.schema == "forge/bug-work-publication-intent/v1"
+            && result.schema == "forge/bug-work-publication/v1"
+            && result.command_sha256 == sha(&serde_json::to_vec(&result.command)?)
+            && result.command_sha256 == intent.receipt.command_sha256
+            && serde_json::to_vec(&result.original_operation)?
+                == serde_json::to_vec(&intent.receipt.original_operation)?
+            && result.manifest_sha256 == sha(&serde_json::to_vec(&intent.manifest)?)
+            && result.manifest_sha256 == intent.receipt.manifest_sha256
+            && result.previous_manifest_sha256 == intent.receipt.previous_manifest_sha256,
+        "Bug publication result differs from immutable intent"
+    );
+    Ok(())
+}
+fn manifest(target: &Target, hash: &str) -> anyhow::Result<BugWorkStaticManifest> {
+    ensure!(digest(hash), "invalid manifest hash");
+    let bytes = read_bytes(
+        &target.root.join("manifests").join(format!("{hash}.json")),
+        128 * 1024,
+    )?;
+    ensure!(sha(&bytes) == hash, "manifest hash differs");
+    let m: BugWorkStaticManifest = serde_json::from_slice(&bytes)?;
+    m.operation_receipt.validate().map_err(anyhow::Error::msg)?;
+    ensure!(
+        m.schema == "forge/bug-work-static-manifest/v1"
+            && m.operation_receipt.configuration_id == target.project_id
+            && m.target_policy_sha256 == target.policy_sha256
+            && m.pipeline_id == m.operation_receipt.pipeline.pipeline_id
+            && m.config_sha256 == m.operation_receipt.pipeline.config_sha256
+            && m.plan_sha256 == m.operation_receipt.pipeline.plan_sha256
+            && digest(&m.artifact.sha256)
+            && m.artifact.size_bytes > 0
+            && !m.artifact.artifact_id.is_nil()
+            && !m.artifact.job_id.is_nil()
+            && !m.artifact.attempt_id.is_nil(),
+        "manifest authority differs"
+    );
+    let bytes = read_bytes(
+        &target.root.join("objects").join(&m.artifact.sha256),
+        32 * 1024 * 1024,
+    )?;
+    ensure!(
+        bytes.len() as i64 == m.artifact.size_bytes && sha(&bytes) == m.artifact.sha256,
+        "published artifact changed"
+    );
+    Ok(m)
+}
+fn open_target(
+    state: &AppState,
+    mapping: &delivered_target::TargetMapping,
+    create: bool,
+) -> anyhow::Result<Target> {
+    let root = if mapping.root.exists() {
+        files::plain(&mapping.root)?;
+        mapping.root.canonicalize()?
+    } else {
+        let parent = mapping.root.parent().context("target parent missing")?;
+        files::plain(parent)?;
+        parent
+            .canonicalize()?
+            .join(mapping.root.file_name().context("target name missing")?)
+    };
+    for protected in [&state.git.root, &state.config.artifacts.root] {
+        let protected = protected.canonicalize()?;
+        ensure!(
+            !root.starts_with(&protected) && !protected.starts_with(&root),
+            "target overlaps protected storage"
+        );
+    }
+    let policy: DeliveryPolicy = read(&mapping.policy)?;
+    Target::open(&mapping.root, mapping.configuration_id, policy, create)
+}
+
+pub(crate) struct ProofObservation {
+    target: Target,
+    pointer: Pointer,
+    pub(crate) manifest: BugWorkStaticManifest,
+    receipt: BugWorkPublishReceipt,
+}
+/// Generic delivered-target reads may encounter either closed manifest purpose.
+/// Discover only the current owner pointer; never scan history or caller refs.
+pub(crate) fn prepare_current_target(
+    state: &AppState,
+    mapping: &delivered_target::TargetMapping,
+    project: &crate::domain::delivered_target::DeliveredProjectRef,
+) -> anyhow::Result<ProofObservation> {
+    let target = open_target(state, mapping, false)?;
+    let pointer = read_pointer(&target.root, "current.json")?.context("target unavailable")?;
+    let m = manifest(&target, &pointer.manifest_sha256)?;
+    ensure!(
+        &m.operation_receipt.request.project == project,
+        "delivered Bug source project differs"
+    );
+    prepare_proof(state, mapping, &m.operation_receipt)
+}
+pub(crate) fn target_origin(observation: &ProofObservation) -> String {
+    observation.target.policy.origin.clone()
+}
+pub(crate) fn as_delivered_target(
+    proof: BugWorkDeliveryProof,
+    origin: String,
+) -> crate::domain::delivered_target::DeliveredTargetReadback {
+    use crate::domain::delivered_target::{DeliveredTarget, DeliveredTargetReadback};
+    DeliveredTargetReadback {
+        schema: "forge/delivered-target/v1".into(),
+        producer_version: proof.producer_version,
+        project: proof.project,
+        configuration_id: proof.configuration_id,
+        repository_id: proof.repository_id,
+        environment_id: proof.environment_id,
+        target_ref: proof.target_ref,
+        status: proof.status,
+        observed_at: proof.observed_at,
+        blocked_reasons: proof.blocked_reasons,
+        target: proof.delivery.map(|d| DeliveredTarget {
+            delivery_ref: d.delivery_ref,
+            operation_key: d.operation_key,
+            generation: d.generation,
+            manifest_sha256: d.manifest_sha256,
+            commit_sha: d.commit_sha,
+            artifact_id: d.artifact_id,
+            artifact_digest: d.artifact_digest,
+            target_url: origin,
+            serving_identity: d.serving_identity,
+        }),
+    }
+}
+pub(crate) fn prepare_proof(
+    state: &AppState,
+    mapping: &delivered_target::TargetMapping,
+    original: &BugWorkOperationAccepted,
+) -> anyhow::Result<ProofObservation> {
+    let target = open_target(state, mapping, false)?;
+    let pointer =
+        read_pointer(&target.root, "current.json")?.context("current publication unavailable")?;
+    ensure!(
+        pointer.generation.is_some_and(|g| g > 0) && pointer.operation_key.is_some(),
+        "versioned publication required"
+    );
+    let key = pointer.operation_key.as_ref().unwrap();
+    ensure!(
+        files::pointer(&target.root, "confirmed.json")?.as_ref() == Some(&pointer.manifest_sha256),
+        "publication not confirmed"
+    );
+    let m = manifest(&target, &pointer.manifest_sha256)?;
+    ensure!(
+        serde_json::to_vec(&m.operation_receipt)? == serde_json::to_vec(original)?
+            && mapping.configuration_id == original.configuration_id
+            && mapping.repository_id == original.request.repository_id,
+        "published candidate differs"
+    );
+    let dir = operation_dir(&target.root, key);
+    let intent: PublishIntent = read(&dir.join("intent.json"))?;
+    ensure!(
+        intent.receipt.command.operation_key == *key
+            && intent.receipt.command.target_ref == mapping.target_ref
+            && serde_json::to_vec(&intent.manifest)? == serde_json::to_vec(&m)?,
+        "publication pointer/journal differs"
+    );
+    let result = readback(&target, &intent.receipt.command, original)?;
+    ensure!(
+        !result.reconciliation_needed
+            && result.receipt.status == DeliveryStatus::Verified
+            && result.receipt.manifest_sha256 == pointer.manifest_sha256,
+        "publication journal not confirmed"
+    );
+    Ok(ProofObservation {
+        target,
+        pointer,
+        manifest: m,
+        receipt: result.receipt,
+    })
+}
+pub(crate) fn unavailable(
+    mapping: &delivered_target::TargetMapping,
+    original: &BugWorkOperationAccepted,
+    reason: &str,
+) -> BugWorkDeliveryProof {
+    BugWorkDeliveryProof {
+        schema: "forge/bug-work-delivery-proof/v1".into(),
+        producer_version: env!("CARGO_PKG_VERSION").into(),
+        observed_at: Utc::now(),
+        project: original.request.project.clone(),
+        configuration_id: original.configuration_id,
+        repository_id: original.request.repository_id,
+        environment_id: mapping.environment_id,
+        target_ref: mapping.target_ref.clone(),
+        operation: original.operation.clone(),
+        bug_work: original.request.bug_work.clone(),
+        pipeline: original.pipeline.clone(),
+        artifact: None,
+        delivery: None,
+        status: crate::domain::delivered_target::DeliveredTargetStatus::Unavailable,
+        blocked_reasons: vec![reason.into()],
+    }
+}
+pub(crate) async fn observe_proof(
+    mapping: &delivered_target::TargetMapping,
+    observation: ProofObservation,
+) -> BugWorkDeliveryProof {
+    use crate::domain::delivered_target::{DeliveredTargetStatus, ServingIdentity};
+    let original = &observation.manifest.operation_receipt;
+    let mut proof = unavailable(mapping, original, "fresh_owner_probe_unavailable");
+    let fresh = observe(
+        &observation.target,
+        observation.receipt,
+        &observation.manifest,
+    )
+    .await;
+    proof.observed_at = Utc::now();
+    let current = read_pointer(&observation.target.root, "current.json");
+    let confirmed = files::pointer(&observation.target.root, "confirmed.json");
+    if !matches!(current,Ok(Some(ref p)) if p==&observation.pointer)
+        || !matches!(confirmed,Ok(Some(ref h)) if *h==observation.pointer.manifest_sha256)
+        || !read::<DeliveryPolicy>(&mapping.policy)
+            .and_then(|p| p.sha256())
+            .is_ok_and(|h| h == observation.target.policy_sha256)
+    {
+        proof.status = DeliveredTargetStatus::Changed;
+        proof.blocked_reasons = vec!["target_generation_changed".into()];
+        return proof;
+    }
+    if fresh.status != DeliveryStatus::Verified {
+        if fresh.status == DeliveryStatus::Failed {
+            proof.status = DeliveredTargetStatus::Changed;
+            proof.blocked_reasons = vec!["served_identity_changed".into()];
+        }
+        return proof;
+    }
+    let version = fresh.version.unwrap();
+    let artifact = fresh.served_artifact.unwrap();
+    let version_hash = version.body_sha256.unwrap();
+    let artifact_hash = artifact.body_sha256.unwrap();
+    if version_hash != observation.pointer.manifest_sha256
+        || artifact_hash != observation.manifest.artifact.sha256
+    {
+        return proof;
+    }
+    let generation = observation.pointer.generation.unwrap().to_string();
+    let key = observation.pointer.operation_key.unwrap();
+    let binding = serde_json::to_vec(&(
+        &proof.project,
+        mapping.configuration_id,
+        mapping.repository_id,
+        mapping.environment_id,
+        &mapping.target_ref,
+        &key,
+        &generation,
+        &version_hash,
+        &artifact_hash,
+        &original.request.bug_work.candidate_commit_sha,
+    ))
+    .expect("serving tuple serializable");
+    proof.artifact = Some(observation.manifest.artifact);
+    proof.delivery = Some(BugWorkDeliveryIdentity {
+        delivery_ref: format!("forge:delivered:{}", sha(&binding)),
+        operation_key: key,
+        generation,
+        manifest_sha256: observation.pointer.manifest_sha256,
+        commit_sha: original.request.bug_work.candidate_commit_sha.clone(),
+        artifact_id: proof.artifact.as_ref().unwrap().artifact_id,
+        artifact_digest: format!("sha256:{artifact_hash}"),
+        serving_identity: ServingIdentity {
+            version_body_sha256: version_hash,
+            artifact_body_sha256: artifact_hash,
+            observed_at: version.observed_at,
+        },
+    });
+    proof.status = DeliveredTargetStatus::Confirmed;
+    proof.blocked_reasons.clear();
+    if proof.require_confirmed(original).is_err() {
+        return unavailable(mapping, original, "exact_delivery_identity_invalid");
+    }
+    proof
+}
+
+async fn observe(
+    target: &Target,
+    mut receipt: BugWorkPublishReceipt,
+    m: &BugWorkStaticManifest,
+) -> BugWorkPublishReceipt {
+    let checks = target
+        .observe_static(&receipt.manifest_sha256, &m.artifact.sha256)
+        .await;
+    receipt.status = checks.status;
+    receipt.version = Some(checks.version);
+    receipt.served_artifact = Some(checks.served_artifact);
+    receipt.health = Some(checks.health);
+    receipt.acceptance = Some(checks.acceptance);
+    receipt.recorded_at = Utc::now();
+    receipt
+}
+fn readback(
+    target: &Target,
+    command: &BugWorkPublishCommand,
+    original: &BugWorkOperationAccepted,
+) -> anyhow::Result<BugWorkPublishReadback> {
+    let dir = operation_dir(&target.root, &command.operation_key);
+    let intent: PublishIntent = read(&dir.join("intent.json"))?;
+    ensure!(
+        intent.policy_sha256 == target.policy_sha256
+            && intent.receipt.command_sha256 == sha(&serde_json::to_vec(command)?)
+            && serde_json::to_vec(&intent.receipt.original_operation)?
+                == serde_json::to_vec(original)?,
+        "original Bug publication input differs"
+    );
+    let receipt = optional::<BugWorkPublishReceipt>(&dir.join("reconciled.json"))?
+        .or(optional::<BugWorkPublishReceipt>(&dir.join("result.json"))?)
+        .unwrap_or(intent.receipt.clone());
+    same_result(&intent, &receipt)?;
+    if receipt.status == DeliveryStatus::Verified {
+        for (probe, hash) in [
+            (&receipt.version, &receipt.manifest_sha256),
+            (&receipt.served_artifact, &intent.manifest.artifact.sha256),
+            (&receipt.health, &target.policy.health_body_sha256),
+            (&receipt.acceptance, &target.policy.acceptance_body_sha256),
+        ] {
+            ensure!(
+                probe
+                    .as_ref()
+                    .is_some_and(|p| p.status == DeliveryStatus::Verified
+                        && p.http_status == Some(200)
+                        && p.body_sha256.as_ref() == Some(hash)),
+                "verified publication lacks exact owner evidence"
+            );
+        }
+    }
+
+    Ok(BugWorkPublishReadback {
+        reconciliation_needed: receipt.status == DeliveryStatus::Unknown,
+        receipt,
+        current_manifest_sha256: pointer(&target.root, "current.json")?,
+    })
+}
+async fn candidate(
+    state: &AppState,
+    accepted: &BugWorkOperationAccepted,
+    artifact_id: Uuid,
+    policy: String,
+) -> anyhow::Result<(BugWorkStaticManifest, PathBuf)> {
+    let db = state.pool.as_ref().context("owner database unavailable")?;
+    let mut tx = db.begin().await?;
+    let pipeline = journal::candidate_pipeline(&mut tx, accepted)
+        .await?
+        .context("original pipeline unavailable")?;
+    let jobs = ledger::candidate_jobs(&mut tx, pipeline.pipeline_id).await?;
+    let artifacts = ledger::candidate_artifacts(&mut tx, pipeline.pipeline_id).await?;
+    tx.commit().await?;
+    ensure!(
+        pipeline.status == "success"
+            && pipeline.finished_at.is_some()
+            && !jobs.is_empty()
+            && jobs.len() <= 1000
+            && jobs
+                .iter()
+                .all(|j| j.terminal_acknowledged && j.artifacts_complete)
+            && pipeline.commit_sha.as_deref()
+                == Some(&accepted.request.bug_work.candidate_commit_sha)
+            && pipeline.resolved_commit_sha == pipeline.commit_sha
+            && pipeline.config_source.as_deref() == Some("repository")
+            && pipeline.config_sha256.as_deref() == Some(&accepted.pipeline.config_sha256)
+            && pipeline.plan_sha256.as_deref() == Some(&accepted.pipeline.plan_sha256),
+        "actual pipeline gates are not complete"
+    );
+    ensure!(
+        !artifacts.is_empty() && artifacts.len() <= 32,
+        "artifact inventory exceeds bound"
+    );
+    let row = artifacts
+        .into_iter()
+        .find(|a| a.artifact_id == artifact_id)
+        .context("selected artifact missing")?;
+    let attempt = row.attempt_id.context("artifact attempt missing")?;
+    let hash = row.sha256.context("artifact digest missing")?;
+    ensure!(
+        row.retained
+            && row.size_bytes > 0
+            && jobs.iter().any(|j| j.job_id == row.job_id
+                && j.attempt_id == Some(attempt)
+                && j.terminal_acknowledged),
+        "artifact attempt not acknowledged"
+    );
+    let repository = crate::git_host::validate_repo_name(&pipeline.repository_name)
+        .map_err(anyhow::Error::msg)?;
+    let repository = state.git.root.join(format!("{repository}.git"));
+    files::plain(&repository)?;
+    let config = crate::runner_workspace::preparation::repository_pipeline_config(
+        &repository,
+        &accepted.request.bug_work.candidate_commit_sha,
+    )
+    .await?;
+    ensure!(
+        sha(&config) == accepted.pipeline.config_sha256
+            && pipeline
+                .raw_config
+                .as_ref()
+                .is_some_and(|raw| raw.as_bytes() == config)
+            && pipeline
+                .plan
+                .as_ref()
+                .is_some_and(|p| serde_json::to_vec(p)
+                    .is_ok_and(|b| sha(&b) == accepted.pipeline.plan_sha256)),
+        "original config/plan bytes differ"
+    );
+    let path = PathBuf::from(row.storage_path);
+    crate::candidate_evidence::verify_artifact(
+        &state.config.artifacts.root,
+        &path,
+        &hash,
+        row.size_bytes,
+    )
+    .await?;
+    Ok((
+        BugWorkStaticManifest {
+            schema: "forge/bug-work-static-manifest/v1".into(),
+            operation_receipt: accepted.clone(),
+            pipeline_id: accepted.pipeline.pipeline_id,
+            artifact: BugWorkArtifactIdentity {
+                artifact_id,
+                job_id: row.job_id,
+                attempt_id: attempt,
+                sha256: hash,
+                size_bytes: row.size_bytes,
+            },
+            config_sha256: accepted.pipeline.config_sha256.clone(),
+            plan_sha256: accepted.pipeline.plan_sha256.clone(),
+            target_policy_sha256: policy,
+        },
+        path,
+    ))
+}
+
+/// Fresh local authority for an actual pointer mutation. No filesystem/network
+/// staging or probes retain SQL locks; callers mutate the pointer immediately.
+async fn publication_authority(
+    state: &AppState,
+    claims: &crate::auth::AccessClaims,
+    mapping: &delivered_target::TargetMapping,
+    original: &BugWorkOperationAccepted,
+    projection: &serde_json::Value,
+    policy_sha256: &str,
+    m: &BugWorkStaticManifest,
+) -> anyhow::Result<std::time::Instant> {
+    let path = state
+        .config
+        .sdlc_workspace
+        .delivered_targets
+        .as_ref()
+        .context("target mapping unavailable")?;
+    ensure!(
+        delivered_target::mapping(path, mapping.configuration_id, &mapping.target_ref)? == *mapping,
+        "target mapping changed"
+    );
+    ensure!(
+        read::<DeliveryPolicy>(&mapping.policy)?.sha256()? == policy_sha256,
+        "target policy changed"
+    );
+    let db = state.pool.as_ref().context("owner database unavailable")?;
+    let mut tx = db.begin().await?;
+    crate::api::bug_work_operations::authorize(
+        &mut tx,
+        state,
+        claims,
+        mapping.configuration_id,
+        true,
+    )
+    .await
+    .map_err(|_| anyhow::anyhow!("fresh publication credential denied"))?;
+    ensure!(
+        crate::store::delivered_target::lock_binding(
+            &mut tx,
+            mapping.configuration_id,
+            mapping.repository_id,
+            mapping.environment_id,
+            original.request.project.tracker_instance_id,
+            original.request.project.project_id
+        )
+        .await?
+        .as_ref()
+            == Some(projection),
+        "target namespace changed"
+    );
+    ensure!(
+        journal::matches_artifact(&mut tx, m).await?,
+        "original accepted artifact changed"
+    );
+    tx.commit().await?;
+    Ok(std::time::Instant::now())
+}
+fn fresh_pointer(observed: std::time::Instant) -> anyhow::Result<()> {
+    ensure!(
+        observed.elapsed() <= std::time::Duration::from_secs(5),
+        "pointer mutation authority expired"
+    );
+    Ok(())
+}
+
+// Deterministic owned-file latch for the existing integration harness only.
+// Production binaries do not contain this test boundary or inspect these files.
+async fn integration_boundary(root: &Path, phase: &str) -> anyhow::Result<()> {
+    #[cfg(feature = "integration")]
+    {
+        let controls = root.parent().context("test target parent missing")?;
+        let gate = controls.join(format!("block-bug-work-{phase}"));
+        if gate.exists() {
+            std::fs::write(
+                controls.join(format!("entered-bug-work-{phase}")),
+                b"entered",
+            )?;
+            let deadline = std::time::Instant::now() + std::time::Duration::from_secs(20);
+            while gate.exists() {
+                ensure!(
+                    std::time::Instant::now() < deadline,
+                    "integration publication boundary deadline"
+                );
+                tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+            }
+        }
+    }
+    #[cfg(not(feature = "integration"))]
+    let _ = (root, phase);
+    Ok(())
+}
+
+/// Existing privileged owner CLI, separate closed command; no remote deployment
+/// or caller-provided candidate proof. A completed Accepted pipeline owns build
+/// custody even after the SDK worker/Tracker103 capacity has legitimately closed.
+pub async fn local_command(
+    state: Arc<AppState>,
+    configuration: Uuid,
+    token: &str,
+    command: BugWorkPublishCommand,
+    reconcile: bool,
+    read_only: bool,
+) -> anyhow::Result<BugWorkPublishReadback> {
+    command.validate().map_err(anyhow::Error::msg)?;
+    if !read_only {
+        ensure!(
+            state.config.sdlc_workspace.bug_work.enabled
+                && std::env::var("CICD_LOCAL_DELIVERY_MODE").ok().as_deref()
+                    == Some("local-verification"),
+            "explicit owner publication mode required"
+        );
+    }
+    ensure!(
+        token.starts_with("forge_sat_"),
+        "project machine credential required"
+    );
+    let db = state.pool.as_ref().context("owner database unavailable")?;
+    let claims = crate::api::identity_for_bearer_token(
+        db,
+        state
+            .auth_secret
+            .as_deref()
+            .context("owner auth unavailable")?,
+        token,
+    )
+    .await
+    .map_err(|_| anyhow::anyhow!("owner credential rejected"))?;
+    let mut tx = db.begin().await?;
+    crate::api::bug_work_operations::authorize(&mut tx, &state, &claims, configuration, !read_only)
+        .await
+        .map_err(|_| anyhow::anyhow!("publication producer denied"))?;
+    let (subject, original) =
+        journal::accepted(&mut tx, configuration, &command.original_operation_key)
+            .await?
+            .context("original Accepted unavailable")?;
+    ensure!(
+        subject == claims.sub
+            && original.operation.request_sha256 == command.original_request_sha256,
+        "original producer/request differs"
+    );
+    let mapping_path = state
+        .config
+        .sdlc_workspace
+        .delivered_targets
+        .as_ref()
+        .context("target mapping unavailable")?;
+    let mapping = delivered_target::mapping(mapping_path, configuration, &command.target_ref)?;
+    ensure!(
+        mapping.repository_id == original.request.repository_id,
+        "target repository differs"
+    );
+    let projection = crate::store::delivered_target::lock_binding(
+        &mut tx,
+        configuration,
+        mapping.repository_id,
+        mapping.environment_id,
+        original.request.project.tracker_instance_id,
+        original.request.project.project_id,
+    )
+    .await?
+    .context("target namespace unavailable")?;
+    let owner: pdlc_shared::resource_context::OwnerCommand =
+        serde_json::from_value(projection.clone())?;
+    crate::namespace::validate_projection(&owner)
+        .map_err(|_| anyhow::anyhow!("target namespace changed"))?;
+    tx.commit().await?;
+    let target = open_target(&state, &mapping, !read_only)?;
+    let dir = operation_dir(&target.root, &command.operation_key);
+    if read_only {
+        return readback(&target, &command, &original);
+    }
+    let observed = if dir.exists() {
+        None
+    } else {
+        Some(
+            candidate(
+                &state,
+                &original,
+                command.artifact_id,
+                target.policy_sha256.clone(),
+            )
+            .await?,
+        )
+    };
+    // No HTTP or artifact I/O while local authorization locks are held.
+    let mut tx = db.begin().await?;
+    crate::api::bug_work_operations::authorize(&mut tx, &state, &claims, configuration, true)
+        .await
+        .map_err(|_| anyhow::anyhow!("fresh publication authorization denied"))?;
+    ensure!(
+        crate::store::delivered_target::lock_binding(
+            &mut tx,
+            configuration,
+            mapping.repository_id,
+            mapping.environment_id,
+            original.request.project.tracker_instance_id,
+            original.request.project.project_id
+        )
+        .await?
+            == Some(projection.clone()),
+        "target namespace changed"
+    );
+    if let Some((m, _)) = &observed {
+        ensure!(
+            journal::matches_artifact(&mut tx, m).await?,
+            "artifact retention changed"
+        );
+    }
+    tx.commit().await?;
+    ensure!(
+        delivered_target::mapping(mapping_path, configuration, &command.target_ref)? == mapping,
+        "target mapping changed"
+    );
+    let _lock = Lock::acquire(&target.root)?;
+    if dir.exists() {
+        let old = readback(&target, &command, &original)?;
+        if !reconcile || !old.reconciliation_needed {
+            return Ok(old);
+        }
+        let intent: PublishIntent = read(&dir.join("intent.json"))?;
+        let current = read_pointer(&target.root, "current.json")?;
+        if current.as_ref().is_some_and(|p| {
+            p.manifest_sha256 == old.receipt.manifest_sha256
+                && p.operation_key.as_deref() == Some(command.operation_key.as_str())
+        }) {
+            let m = manifest(&target, &old.receipt.manifest_sha256)?;
+            let published_pointer = read_pointer(&target.root, "current.json")?;
+            let receipt = observe(&target, intent.receipt, &m).await;
+            integration_boundary(&target.root, "probe").await?;
+            if receipt.status != DeliveryStatus::Unknown {
+                if receipt.status == DeliveryStatus::Verified {
+                    fresh_pointer(
+                        publication_authority(
+                            &state,
+                            &claims,
+                            &mapping,
+                            &original,
+                            &projection,
+                            &target.policy_sha256,
+                            &m,
+                        )
+                        .await?,
+                    )?;
+                    ensure!(
+                        read_pointer(&target.root, "current.json")? == published_pointer,
+                        "publication generation changed during probes"
+                    );
+                    replace_pointer(&target.root, "confirmed.json", &receipt.manifest_sha256)?;
+                }
+                immutable(&dir.join("reconciled.json"), &receipt)?;
+            }
+        } else if current == intent.previous_pointer {
+            // Full generation/key equality proves this original publication did
+            // not apply. No new operation key/build, and no inferred ABA rollback.
+            let (m, path) = candidate(
+                &state,
+                &original,
+                command.artifact_id,
+                target.policy_sha256.clone(),
+            )
+            .await?;
+            ensure!(
+                serde_json::to_vec(&m)? == serde_json::to_vec(&intent.manifest)?,
+                "original candidate bytes changed"
+            );
+            ensure!(
+                target.stage_static(
+                    &serde_json::to_vec(&m)?,
+                    &m.artifact.sha256,
+                    m.artifact.size_bytes,
+                    Some(&path)
+                )? == intent.receipt.manifest_sha256,
+                "original stage differs"
+            );
+            manifest(&target, &intent.receipt.manifest_sha256)?;
+            integration_boundary(&target.root, "stage").await?;
+            fresh_pointer(
+                publication_authority(
+                    &state,
+                    &claims,
+                    &mapping,
+                    &original,
+                    &projection,
+                    &target.policy_sha256,
+                    &m,
+                )
+                .await?,
+            )?;
+            ensure!(
+                read_pointer(&target.root, "current.json")? == intent.previous_pointer,
+                "prepublication pointer changed"
+            );
+            publish_current(
+                &target.root,
+                &intent.receipt.manifest_sha256,
+                &command.operation_key,
+            )?;
+            let published_pointer = read_pointer(&target.root, "current.json")?;
+            let receipt = observe(&target, intent.receipt, &m).await;
+            integration_boundary(&target.root, "probe").await?;
+            if receipt.status != DeliveryStatus::Unknown {
+                if receipt.status == DeliveryStatus::Verified {
+                    fresh_pointer(
+                        publication_authority(
+                            &state,
+                            &claims,
+                            &mapping,
+                            &original,
+                            &projection,
+                            &target.policy_sha256,
+                            &m,
+                        )
+                        .await?,
+                    )?;
+                    ensure!(
+                        read_pointer(&target.root, "current.json")? == published_pointer,
+                        "publication generation changed during probes"
+                    );
+                    replace_pointer(&target.root, "confirmed.json", &receipt.manifest_sha256)?;
+                }
+                immutable(&dir.join("reconciled.json"), &receipt)?;
+            }
+        }
+        return readback(&target, &command, &original);
+    }
+    ensure!(!reconcile, "original publication missing");
+    target.ensure_idle(&command.operation_key)?;
+    let previous_pointer = read_pointer(&target.root, "current.json")?;
+    let previous = previous_pointer.as_ref().map(|p| p.manifest_sha256.clone());
+    ensure!(
+        previous == command.expected_manifest_sha256,
+        "target manifest CAS differs"
+    );
+    let (m, path) = observed.context("actual completed candidate unavailable")?;
+    let hash = sha(&serde_json::to_vec(&m)?);
+    let receipt = BugWorkPublishReceipt {
+        schema: "forge/bug-work-publication/v1".into(),
+        command: command.clone(),
+        command_sha256: sha(&serde_json::to_vec(&command)?),
+        original_operation: original.clone(),
+        manifest_sha256: hash.clone(),
+        previous_manifest_sha256: previous,
+        status: DeliveryStatus::Unknown,
+        version: None,
+        served_artifact: None,
+        health: None,
+        acceptance: None,
+        recorded_at: Utc::now(),
+    };
+    directory(&dir)?;
+    immutable(
+        &dir.join("intent.json"),
+        &PublishIntent {
+            schema: "forge/bug-work-publication-intent/v1".into(),
+            receipt: receipt.clone(),
+            manifest: m.clone(),
+            policy_sha256: target.policy_sha256.clone(),
+            previous_pointer: previous_pointer.clone(),
+        },
+    )?;
+    immutable(&dir.join("active.json"), &receipt.command_sha256)?;
+    ensure!(
+        target.stage_static(
+            &serde_json::to_vec(&m)?,
+            &m.artifact.sha256,
+            m.artifact.size_bytes,
+            Some(&path)
+        )? == hash,
+        "staged manifest differs"
+    );
+    manifest(&target, &hash)?;
+    integration_boundary(&target.root, "stage").await?;
+    fresh_pointer(
+        publication_authority(
+            &state,
+            &claims,
+            &mapping,
+            &original,
+            &projection,
+            &target.policy_sha256,
+            &m,
+        )
+        .await?,
+    )?;
+    ensure!(
+        read_pointer(&target.root, "current.json")? == previous_pointer,
+        "original target generation changed"
+    );
+    publish_current(&target.root, &hash, &command.operation_key)?;
+    let published_pointer = read_pointer(&target.root, "current.json")?;
+    let receipt = observe(&target, receipt, &m).await;
+    integration_boundary(&target.root, "probe").await?;
+    if receipt.status == DeliveryStatus::Verified {
+        fresh_pointer(
+            publication_authority(
+                &state,
+                &claims,
+                &mapping,
+                &original,
+                &projection,
+                &target.policy_sha256,
+                &m,
+            )
+            .await?,
+        )?;
+        ensure!(
+            read_pointer(&target.root, "current.json")? == published_pointer,
+            "publication generation changed during probes"
+        );
+        replace_pointer(&target.root, "confirmed.json", &hash)?;
+    }
+    immutable(&dir.join("result.json"), &receipt)?;
+    readback(&target, &command, &original)
+}
diff --git a/backend/src/bug_work_source.rs b/backend/src/bug_work_source.rs
new file mode 100644
index 0000000..5b0e81f
--- /dev/null
+++ b/backend/src/bug_work_source.rs
@@ -0,0 +1,715 @@
+//! Operation-scoped quarantine import into an owner bare repository. No receive-pack,
+//! hooks, network, arbitrary refs, caller paths, or unbounded hidden pack objects.
+use super::{bug_work_authority::FreshAuthority, files};
+use crate::domain::bug_work_publication::*;
+use anyhow::{Context, ensure};
+use serde::{Deserialize, Serialize};
+use std::{
+    path::{Path, PathBuf},
+    process::Stdio,
+    time::Duration,
+};
+use tokio::io::AsyncReadExt;
+
+const EXPANDED_BYTES: u64 = 512 * 1024 * 1024;
+const MAX_OBJECT_BYTES: u64 = 128 * 1024 * 1024;
+const MAX_OBJECTS: usize = 100_000;
+
+#[derive(Serialize, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub(crate) struct ImportedSource {
+    pub(crate) schema: String,
+    pub(crate) intent_operation_id: uuid::Uuid,
+    pub(crate) request_sha256: String,
+    pub(crate) candidate_commit_sha: String,
+    pub(crate) candidate_tree_id: String,
+    pub(crate) candidate_ref: String,
+    pub(crate) pack_sha: String,
+}
+
+pub(crate) fn canonical_repository(path: &Path) -> anyhow::Result<PathBuf> {
+    files::plain(path)?;
+    let canonical = path.canonicalize()?;
+    ensure!(canonical.is_dir(), "owner bare repository required");
+    Ok(canonical)
+}
+
+fn bundle_header(bytes: &[u8], request: &BugWorkOperationRequest) -> anyhow::Result<()> {
+    ensure!(
+        bytes.len() as u64 == request.bundle_size_bytes
+            && files::sha(bytes) == request.bundle_sha256,
+        "bundle bytes differ from immutable intent"
+    );
+    let end = bytes
+        .windows(2)
+        .take(64 * 1024)
+        .position(|w| w == b"\n\n")
+        .context("bundle header exceeds bound")?;
+    let text = std::str::from_utf8(&bytes[..end])?;
+    let mut lines = text.lines();
+    let version = lines.next().context("bundle version missing")?;
+    ensure!(
+        matches!(version, "# v2 git bundle" | "# v3 git bundle"),
+        "bundle protocol unsupported"
+    );
+    let mut prerequisite = false;
+    let mut head = false;
+    let mut format = false;
+    for line in lines {
+        if let Some(capability) = line.strip_prefix('@') {
+            ensure!(
+                version == "# v3 git bundle"
+                    && !format
+                    && capability
+                        == format!(
+                            "object-format={}",
+                            if request.bug_work.candidate_commit_sha.len() == 40 {
+                                "sha1"
+                            } else {
+                                "sha256"
+                            }
+                        ),
+                "bundle capability denied"
+            );
+            format = true;
+        } else if let Some(base) = line.strip_prefix('-') {
+            ensure!(
+                !prerequisite
+                    && base
+                        .split_once(' ')
+                        .is_some_and(|(sha, _)| sha == request.bug_work.base_commit_sha),
+                "bundle prerequisite differs"
+            );
+            prerequisite = true;
+        } else {
+            ensure!(
+                !head
+                    && line
+                        == format!(
+                            "{} {}",
+                            request.bug_work.candidate_commit_sha,
+                            request.candidate_ref()
+                        ),
+                "bundle contains foreign or extra ref"
+            );
+            head = true;
+        }
+    }
+    ensure!(
+        prerequisite && head && (request.bug_work.candidate_commit_sha.len() == 40 || format),
+        "bundle must pin exactly original base and candidate"
+    );
+    Ok(())
+}
+
+/// Resource limits apply also to index-pack spawned by bundle unbundle. Capped
+/// stdout is drained concurrently with process execution; timeout kills the group.
+async fn git(repository: &Path, args: &[&str], cap: u64) -> anyhow::Result<Vec<u8>> {
+    let mut command = tokio::process::Command::new("git");
+    command
+        .env_clear()
+        .env("PATH", std::env::var_os("PATH").unwrap_or_default())
+        .env("GIT_CONFIG_NOSYSTEM", "1")
+        .env("GIT_CONFIG_GLOBAL", "/dev/null")
+        .env("GIT_NO_REPLACE_OBJECTS", "1")
+        .env("GIT_TERMINAL_PROMPT", "0")
+        .args([
+            "-c",
+            "core.hooksPath=/dev/null",
+            "-c",
+            "protocol.allow=never",
+            "-c",
+            "pack.threads=1",
+            "-c",
+            "pack.windowMemory=64m",
+            "-c",
+            "pack.deltaCacheSize=64m",
+        ])
+        .arg(format!("--git-dir={}", repository.display()))
+        .args(args)
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .kill_on_drop(true);
+    #[cfg(unix)]
+    unsafe {
+        command.pre_exec(|| {
+            if libc::setpgid(0, 0) != 0 {
+                return Err(std::io::Error::last_os_error());
+            }
+            for (resource, size) in [
+                (libc::RLIMIT_AS, 1024 * 1024 * 1024u64),
+                (libc::RLIMIT_FSIZE, EXPANDED_BYTES),
+                (libc::RLIMIT_CPU, 10),
+            ] {
+                let bound = libc::rlimit {
+                    rlim_cur: size as libc::rlim_t,
+                    rlim_max: size as libc::rlim_t,
+                };
+                if libc::setrlimit(resource, &bound) != 0 {
+                    return Err(std::io::Error::last_os_error());
+                }
+            }
+            Ok(())
+        });
+    }
+    #[cfg(not(unix))]
+    anyhow::bail!("bounded candidate import requires Unix process/filesystem semantics");
+    #[allow(unreachable_code)]
+    {
+        let mut child = command.spawn().context("bounded Git unavailable")?;
+        let pid = child.id();
+        struct Group(Option<u32>);
+        impl Drop for Group {
+            fn drop(&mut self) {
+                #[cfg(unix)]
+                if let Some(pid) = self.0 {
+                    unsafe {
+                        libc::kill(-(pid as i32), libc::SIGKILL);
+                    }
+                }
+            }
+        }
+        let mut group = Group(pid);
+
+        let result = tokio::time::timeout(Duration::from_secs(15), async {
+            let mut out = Vec::new();
+            child
+                .stdout
+                .take()
+                .context("Git stdout missing")?
+                .take(cap + 1)
+                .read_to_end(&mut out)
+                .await?;
+            ensure!(out.len() as u64 <= cap, "Git output exceeds bound");
+            ensure!(
+                child.wait().await?.success(),
+                "Git candidate validation rejected"
+            );
+            Ok::<_, anyhow::Error>(out)
+        })
+        .await;
+        match result {
+            Ok(Ok(out)) => {
+                group.0 = None;
+                Ok(out)
+            }
+            other => {
+                #[cfg(unix)]
+                if let Some(pid) = pid {
+                    unsafe {
+                        libc::kill(-(pid as i32), libc::SIGKILL);
+                    }
+                }
+                let _ = child.kill().await;
+                match other {
+                    Ok(Err(error)) => Err(error),
+                    _ => anyhow::bail!("bounded Git deadline exceeded"),
+                }
+            }
+        }
+    }
+}
+fn pack_bound(output: &[u8]) -> anyhow::Result<()> {
+    let mut count = 0usize;
+    let mut total = 0u64;
+    for line in std::str::from_utf8(output)?.lines() {
+        let columns: Vec<_> = line.split_whitespace().collect();
+        if columns.len() < 5 || !commit(columns[0]) {
+            continue;
+        }
+        ensure!(
+            matches!(columns[1], "commit" | "tree" | "blob" | "tag"),
+            "unknown pack object type"
+        );
+        let size: u64 = columns[2].parse()?;
+        count += 1;
+        total = total.checked_add(size).context("expanded pack overflow")?;
+        ensure!(
+            count <= MAX_OBJECTS && size <= MAX_OBJECT_BYTES && total <= EXPANDED_BYTES,
+            "expanded pack objects exceed bound"
+        );
+    }
+    ensure!(count > 0, "pack contains no objects");
+    Ok(())
+}
+fn copy_pack(source: &Path, destination: &Path, max: u64) -> anyhow::Result<()> {
+    use std::io::{Read, Write};
+    files::plain(source)?;
+    let parent = destination.parent().context("pack parent missing")?;
+    files::plain(parent)?;
+    let mut input = std::fs::File::open(source)?;
+    ensure!(
+        input.metadata()?.is_file() && input.metadata()?.len() <= max,
+        "pack file exceeds bound"
+    );
+    struct Temp(PathBuf);
+    impl Drop for Temp {
+        fn drop(&mut self) {
+            let _ = std::fs::remove_file(&self.0);
+        }
+    }
+    let staged = Temp(parent.join(format!(".forge-import-{}", uuid::Uuid::new_v4())));
+    let mut options = std::fs::OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600).custom_flags(libc::O_NOFOLLOW);
+    }
+    let mut output = options.open(&staged.0)?;
+    let copied = std::io::copy(&mut Read::take(&mut input, max + 1), &mut output)?;
+    ensure!(copied <= max, "pack changed beyond bound");
+    output.flush()?;
+    output.sync_all()?;
+    drop(output);
+    match std::fs::hard_link(&staged.0, destination) {
+        Ok(()) => files::sync_dir(parent)?,
+        Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => {
+            files::plain(destination)?;
+            let mut original = std::fs::File::open(destination)?;
+            let mut staged_file = std::fs::File::open(&staged.0)?;
+            let mut a = [0u8; 65536];
+            let mut b = [0u8; 65536];
+            loop {
+                let n = staged_file.read(&mut a)?;
+                let m = original.read(&mut b)?;
+                ensure!(n == m && a[..n] == b[..m], "existing pack differs");
+                if n == 0 {
+                    break;
+                }
+            }
+        }
+        Err(e) => return Err(e.into()),
+    }
+    // A crash can leave only this owned dot-temp, never a partially published pack/index.
+    drop(staged);
+    files::sync_dir(parent)
+}
+
+/// Caller has already COMMITTED the immutable intent and authenticated the exact
+/// original producer. Fresh authority is required for both new import and ref CAS.
+pub(crate) async fn prepare(
+    root: &Path,
+    repository: &Path,
+    intent: &BugWorkOperationIntent,
+    bytes: &[u8],
+    authority: &FreshAuthority,
+) -> anyhow::Result<PreparedImport> {
+    let request = &intent.request;
+    request.validate().map_err(anyhow::Error::msg)?;
+    authority.require_current(intent.configuration_id, request)?;
+    ensure!(
+        root.is_absolute() && repository.is_absolute(),
+        "explicit owner paths required"
+    );
+    files::plain(root)?;
+    files::plain(repository)?;
+    let root = std::fs::canonicalize(root)?;
+    let repository = std::fs::canonicalize(repository)?;
+    ensure!(
+        !root.starts_with(&repository) && !repository.starts_with(&root),
+        "controller/repository roots overlap"
+    );
+    bundle_header(bytes, request)?;
+    let operation = root.join(intent.operation_id.to_string());
+    files::directory(&operation)?;
+    let _lock = files::Lock::acquire(&operation)?;
+    let bundle = operation.join("source.bundle");
+    files::immutable_bytes(&bundle, bytes)?;
+    let quarantine = operation.join("quarantine.git");
+    if !quarantine.exists() {
+        git(
+            &quarantine,
+            &[
+                "init",
+                "--bare",
+                if request.bug_work.candidate_commit_sha.len() == 40 {
+                    "--object-format=sha1"
+                } else {
+                    "--object-format=sha256"
+                },
+            ],
+            1024,
+        )
+        .await?;
+    }
+    files::plain(&quarantine)?;
+    let alternate = quarantine.join("objects/info/alternates");
+    let objects = repository.join("objects");
+    files::plain(&objects)?;
+    let objects = objects.to_str().context("owner objects path is not UTF8")?;
+    ensure!(
+        !objects.contains(['\n', '\r']),
+        "owner alternate path invalid"
+    );
+    files::immutable_bytes(&alternate, format!("{objects}\n").as_bytes())?;
+    git(
+        &quarantine,
+        &[
+            "bundle",
+            "unbundle",
+            bundle.to_str().context("owner bundle path invalid")?,
+        ],
+        1024,
+    )
+    .await?;
+    let pack_dir = quarantine.join("objects/pack");
+    files::plain(&pack_dir)?;
+    let mut packs = Vec::<PathBuf>::new();
+    for entry in std::fs::read_dir(&pack_dir)? {
+        let path = entry?.path();
+        files::plain(&path)?;
+        if path.extension().is_some_and(|v| v == "idx") {
+            packs.push(path);
+        }
+    }
+    ensure!(packs.len() == 1, "quarantine must retain exactly one pack");
+    let index = &packs[0];
+    pack_bound(
+        &git(
+            &quarantine,
+            &[
+                "verify-pack",
+                "-v",
+                index.to_str().context("pack path invalid")?,
+            ],
+            20 * 1024 * 1024,
+        )
+        .await?,
+    )?;
+    git(
+        &quarantine,
+        &[
+            "index-pack",
+            "--strict",
+            "--verify",
+            index
+                .with_extension("pack")
+                .to_str()
+                .context("pack path invalid")?,
+        ],
+        1024,
+    )
+    .await?;
+    git(
+        &quarantine,
+        &[
+            "merge-base",
+            "--is-ancestor",
+            &request.bug_work.base_commit_sha,
+            &request.bug_work.candidate_commit_sha,
+        ],
+        1024,
+    )
+    .await?;
+    let tree = git(
+        &quarantine,
+        &[
+            "rev-parse",
+            "--verify",
+            "--end-of-options",
+            &format!("{}^{{tree}}", request.bug_work.candidate_commit_sha),
+        ],
+        128,
+    )
+    .await?;
+    ensure!(
+        std::str::from_utf8(&tree)?.trim() == request.candidate_tree_id,
+        "candidate tree differs"
+    );
+    let name = index
+        .file_stem()
+        .and_then(|v| v.to_str())
+        .and_then(|v| v.strip_prefix("pack-"))
+        .context("pack name invalid")?;
+    ensure!(commit(name), "pack digest invalid");
+    let receipt = ImportedSource {
+        schema: "forge/bug-work-source-import/v1".into(),
+        intent_operation_id: intent.operation_id,
+        request_sha256: intent.request_sha256.clone(),
+        candidate_commit_sha: request.bug_work.candidate_commit_sha.clone(),
+        candidate_tree_id: request.candidate_tree_id.clone(),
+        candidate_ref: request.candidate_ref(),
+        pack_sha: name.to_owned(),
+    };
+    Ok(PreparedImport {
+        repository,
+        operation,
+        index: index.clone(),
+        configuration_id: intent.configuration_id,
+        receipt,
+        _lock,
+    })
+}
+
+/// The lock keeps the original operation stable while the caller performs fresh
+/// fixed-owner and local authority checks outside any SQL transaction.
+pub(crate) struct PreparedImport {
+    repository: PathBuf,
+    operation: PathBuf,
+    index: PathBuf,
+    configuration_id: uuid::Uuid,
+    receipt: ImportedSource,
+    _lock: files::Lock,
+}
+impl PreparedImport {
+    pub(crate) async fn publish_ref(
+        self,
+        request: &BugWorkOperationRequest,
+        authority: &FreshAuthority,
+    ) -> anyhow::Result<ImportedSource> {
+        authority.require_current(self.configuration_id, request)?;
+        ensure!(
+            self.receipt.candidate_commit_sha == request.bug_work.candidate_commit_sha
+                && self.receipt.candidate_tree_id == request.candidate_tree_id
+                && self.receipt.candidate_ref == request.candidate_ref(),
+            "prepared import changed"
+        );
+        files::plain(&self.repository)?;
+        // Serialize this purpose's installs per actual repository. Native Git
+        // readers/receive-pack remain safe through no-clobber pack publication
+        // and Git's own update-ref CAS lock, not through this advisory flock.
+        let _repository_lock = files::Lock::acquire(&self.repository)?;
+        let destination = self.repository.join("objects/pack");
+        files::directory(&destination)?;
+        for (extension, max) in [("pack", EXPANDED_BYTES), ("idx", 16 * 1024 * 1024)] {
+            authority.require_current(self.configuration_id, request)?;
+            copy_pack(
+                &self.index.with_extension(extension),
+                &destination.join(format!("pack-{}.{}", self.receipt.pack_sha, extension)),
+                max,
+            )?;
+        }
+
+        let existing = git(
+            &self.repository,
+            &[
+                "for-each-ref",
+                "--format=%(objectname)",
+                &request.candidate_ref(),
+            ],
+            128,
+        )
+        .await?;
+        let existing = std::str::from_utf8(&existing)?.trim();
+        if existing.is_empty() {
+            authority.require_current(self.configuration_id, request)?;
+            git(
+                &self.repository,
+                &[
+                    "update-ref",
+                    "--no-deref",
+                    &request.candidate_ref(),
+                    &request.bug_work.candidate_commit_sha,
+                    &"0".repeat(request.bug_work.candidate_commit_sha.len()),
+                ],
+                128,
+            )
+            .await?;
+        } else {
+            ensure!(
+                existing == request.bug_work.candidate_commit_sha,
+                "candidate ref belongs to another commit"
+            );
+        }
+        files::immutable(&self.operation.join("imported.json"), &self.receipt)?;
+        Ok(self.receipt)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn expanded_bound_includes_hidden_objects_and_rejects_object_count_and_bomb() {
+        let object = "a".repeat(40);
+        pack_bound(format!("{object} blob 123 23 1\n").as_bytes()).unwrap();
+        assert!(
+            pack_bound(format!("{object} blob {} 23 1\n", MAX_OBJECT_BYTES + 1).as_bytes())
+                .is_err()
+        );
+        let hidden = format!("{object} blob {} 23 1\n", MAX_OBJECT_BYTES).repeat(5);
+        assert!(pack_bound(hidden.as_bytes()).is_err());
+        let many = format!("{object} blob 1 1 1\n").repeat(MAX_OBJECTS + 1);
+        assert!(pack_bound(many.as_bytes()).is_err());
+    }
+    #[cfg(unix)]
+    #[tokio::test]
+    async fn actual_git_quarantine_then_fresh_publish_keeps_base_and_exact_unknown_replay() {
+        struct Scratch(PathBuf);
+        impl Drop for Scratch {
+            fn drop(&mut self) {
+                let _ = std::fs::remove_dir_all(&self.0);
+            }
+        }
+        let scratch = Scratch(
+            std::env::temp_dir().join(format!("forge-bug-bundle-{}", uuid::Uuid::new_v4())),
+        );
+        std::fs::create_dir(&scratch.0).unwrap();
+        let work = scratch.0.join("work");
+        std::fs::create_dir(&work).unwrap();
+        async fn run(path: &Path, args: &[&str]) -> String {
+            let out = tokio::process::Command::new("git")
+                .current_dir(path)
+                .args(args)
+                .env("GIT_CONFIG_NOSYSTEM", "1")
+                .env("GIT_CONFIG_GLOBAL", "/dev/null")
+                .output()
+                .await
+                .unwrap();
+            assert!(
+                out.status.success(),
+                "Git fixture operation failed: {}",
+                String::from_utf8_lossy(&out.stderr)
+            );
+            String::from_utf8(out.stdout).unwrap().trim().into()
+        }
+        run(&work, &["init", "-q"]).await;
+        run(&work, &["config", "user.name", "Synthetic QA"]).await;
+        run(&work, &["config", "user.email", "qa@example.invalid"]).await;
+        std::fs::write(work.join("app.txt"), "original A").unwrap();
+        run(&work, &["add", "app.txt"]).await;
+        run(&work, &["commit", "-qm", "A"]).await;
+        let base = run(&work, &["rev-parse", "HEAD"]).await;
+        let bare = scratch.0.join("owner.git");
+        run(&work, &["clone", "--bare", ".", bare.to_str().unwrap()]).await;
+        std::fs::write(work.join("app.txt"), "actual fixed B").unwrap();
+        run(&work, &["commit", "-qam", "B"]).await;
+        let commit = run(&work, &["rev-parse", "HEAD"]).await;
+        let tree = run(&work, &["rev-parse", "HEAD^{tree}"]).await;
+        let vector: serde_json::Value = serde_json::from_str(include_str!(
+            "../domain/tests/fixtures/bug-work-delivery-v1.json"
+        ))
+        .unwrap();
+        let mut binding: BugWorkPublicationBinding =
+            serde_json::from_value(vector["proof"]["bugWork"].clone()).unwrap();
+        binding.base_commit_sha = base.clone();
+        binding.candidate_commit_sha = commit.clone();
+        let mut request = BugWorkOperationRequest {
+            contract_version: 1,
+            operation_key: "real-bundle".into(),
+            project: serde_json::from_value(vector["proof"]["project"].clone()).unwrap(),
+            bug_work: binding,
+            repository_id: uuid::Uuid::new_v4(),
+            candidate_tree_id: tree,
+            bundle_sha256: "d".repeat(64),
+            bundle_size_bytes: 1,
+        };
+        run(&work, &["update-ref", &request.candidate_ref(), &commit]).await;
+        let bundle = scratch.0.join("candidate.bundle");
+        run(
+            &work,
+            &[
+                "bundle",
+                "create",
+                bundle.to_str().unwrap(),
+                &request.candidate_ref(),
+                &format!("^{base}"),
+            ],
+        )
+        .await;
+        let bytes = std::fs::read(&bundle).unwrap();
+        request.bundle_sha256 = files::sha(&bytes);
+        request.bundle_size_bytes = bytes.len() as u64;
+        let intent = BugWorkOperationIntent {
+            schema: "forge/bug-work-operation-intent/v1".into(),
+            operation_id: uuid::Uuid::new_v4(),
+            configuration_id: uuid::Uuid::new_v4(),
+            request_sha256: super::super::bug_work_authority::canonical_hash(
+                &serde_json::to_value(&request).unwrap(),
+            )
+            .unwrap(),
+            request,
+            recorded_at: chrono::Utc::now(),
+        };
+        let controller = scratch.0.join("controller");
+        std::fs::create_dir(&controller).unwrap();
+        let prepared = prepare(
+            &controller,
+            &bare,
+            &intent,
+            &bytes,
+            &FreshAuthority::for_request(intent.configuration_id, &intent.request),
+        )
+        .await
+        .unwrap();
+        assert!(
+            !bare.join("refs/fleet/bug-work").exists(),
+            "quarantine cannot expose shared refs"
+        );
+        let packs = std::fs::read_dir(bare.join("objects/pack"))
+            .unwrap()
+            .count();
+        assert_eq!(packs, 0, "quarantine cannot publish shared packs");
+        let imported = prepared
+            .publish_ref(
+                &intent.request,
+                &FreshAuthority::for_request(intent.configuration_id, &intent.request),
+            )
+            .await
+            .unwrap();
+        assert_eq!(imported.candidate_commit_sha, commit);
+        assert_eq!(
+            run(
+                &work,
+                &[
+                    "--git-dir",
+                    bare.to_str().unwrap(),
+                    "rev-parse",
+                    &intent.request.candidate_ref()
+                ]
+            )
+            .await,
+            commit
+        );
+        assert_eq!(
+            run(
+                &work,
+                &["--git-dir", bare.to_str().unwrap(), "rev-parse", "HEAD"]
+            )
+            .await,
+            base,
+            "feature/default ref unchanged"
+        );
+        let retry = prepare(
+            &controller,
+            &bare,
+            &intent,
+            &bytes,
+            &FreshAuthority::for_request(intent.configuration_id, &intent.request),
+        )
+        .await
+        .unwrap()
+        .publish_ref(
+            &intent.request,
+            &FreshAuthority::for_request(intent.configuration_id, &intent.request),
+        )
+        .await
+        .unwrap();
+        assert_eq!(
+            serde_json::to_value(imported).unwrap(),
+            serde_json::to_value(retry).unwrap()
+        );
+    }
+    #[cfg(unix)]
+    #[test]
+    fn atomic_pack_copy_never_leaves_partial_final_on_bound_failure_and_replays_exact() {
+        let root = std::env::temp_dir().join(format!("forge-pack-copy-{}", uuid::Uuid::new_v4()));
+        std::fs::create_dir(&root).unwrap();
+        let source = root.join("source");
+        let target = root.join("pack-a.pack");
+        std::fs::write(&source, b"real pack bytes").unwrap();
+        assert!(copy_pack(&source, &target, 1).is_err());
+        assert!(!target.exists());
+        copy_pack(&source, &target, 100).unwrap();
+        copy_pack(&source, &target, 100).unwrap();
+        assert_eq!(std::fs::read(&target).unwrap(), b"real pack bytes");
+        assert_eq!(
+            std::fs::read_dir(&root).unwrap().count(),
+            2,
+            "own staging files cleaned"
+        );
+        std::fs::remove_dir_all(root).unwrap();
+    }
+}
