+/// Caller holds the existing publication lock. Every publication, including rollback
+/// to identical bytes, advances the generation. Readback/reconciliation never call this.
+pub(super) fn publish_current(
+    root: &Path,
+    digest: &str,
+    operation_key: &str,
+) -> anyhow::Result<()> {
+    ensure!(
+        crate::domain::task_delivery::digest(digest)
+            && crate::domain::delivered_target::valid_target_ref(operation_key),
+        "invalid publication identity"
+    );
+    let generation = read_pointer(root, "current.json")?
+        .and_then(|p| p.generation)
+        .unwrap_or(0)
+        .checked_add(1)
+        .context("publication generation exhausted")?;
+    write_pointer(
+        root,
+        "current.json",
         &Pointer {
             manifest_sha256: digest.into(),
+            generation: Some(generation),
+            operation_key: Some(operation_key.into()),
         },
-    )?;
+    )
+}
+
+fn write_pointer(root: &Path, name: &str, value: &Pointer) -> anyhow::Result<()> {
+    let staged = root.join(format!(".pointer-{}", Uuid::new_v4().simple()));
+    immutable(&staged, value)?;
     // Rename is the sole publication effect; no children, shell commands or orchestrator retry.
     fs::rename(&staged, root.join(name))?;
     sync_dir(root)
@@ -219,3 +277,77 @@ impl Lock {
 pub(super) fn operation_dir(root: &Path, key: &str) -> PathBuf {
     root.join("operations").join(sha(key.as_bytes()))
 }
+
+#[cfg(all(test, unix))]
+mod versioned_pointer_tests {
+    use super::*;
+
+    struct Scratch(PathBuf);
+    impl Scratch {
+        fn new() -> Self {
+            let path =
+                std::env::temp_dir().join(format!("forge-versioned-pointer-{}", Uuid::new_v4()));
+            fs::create_dir(&path).unwrap();
+            Self(path)
+        }
+    }
+    impl Drop for Scratch {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.0);
+        }
+    }
+
+    #[test]
+    fn publication_generation_detects_same_bytes_and_rollback_aba() {
+        let root = Scratch::new();
+        let _lock = Lock::acquire(&root.0).unwrap();
+        let first = "a".repeat(64);
+        let second = "b".repeat(64);
+        replace_pointer(&root.0, "current.json", &first).unwrap();
+        assert!(
+            read_pointer(&root.0, "current.json")
+                .unwrap()
+                .unwrap()
+                .generation
+                .is_none()
+        );
+        for (digest, key, generation) in [
+            (&first, "deploy:one", 1),
+            (&first, "deploy:same", 2),
+            (&second, "deploy:two", 3),
+            (&first, "rollback:one", 4),
+        ] {
+            publish_current(&root.0, digest, key).unwrap();
+            let value = read_pointer(&root.0, "current.json").unwrap().unwrap();
+            assert_eq!(value.generation, Some(generation));
+            assert_eq!(value.operation_key.as_deref(), Some(key));
+            assert_eq!(
+                pointer(&root.0, "current.json").unwrap().as_ref(),
+                Some(digest)
+            );
+        }
+        let before = read_bytes(&root.0.join("current.json"), 1024).unwrap();
+        replace_pointer(&root.0, "confirmed.json", &first).unwrap();
+        assert_eq!(
+            before,
+            read_bytes(&root.0.join("current.json"), 1024).unwrap()
+        );
+    }
+
+    #[test]
+    fn malformed_or_exhausted_pointer_cannot_reset_a_generation() {
+        let root = Scratch::new();
+        let _lock = Lock::acquire(&root.0).unwrap();
+        let pointer_path = root.0.join("current.json");
+        for value in [
+            serde_json::json!({"manifestSha256":"a".repeat(64),"generation":0,"operationKey":"a"}),
+            serde_json::json!({"manifestSha256":"a".repeat(64),"generation":1}),
+            serde_json::json!({"manifestSha256":"a".repeat(64),"generation":u64::MAX,"operationKey":"a"}),
+        ] {
+            fs::write(&pointer_path, serde_json::to_vec(&value).unwrap()).unwrap();
+            let before = fs::read(&pointer_path).unwrap();
+            assert!(publish_current(&root.0, &"b".repeat(64), "deploy:next").is_err());
+            assert_eq!(before, fs::read(&pointer_path).unwrap());
+        }
+    }
+}
