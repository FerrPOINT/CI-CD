+fn git_service_command(service: &str, hooks: Option<&receive_hooks::ReceiveHooks>) -> Command {
+    let mut command = Command::new("git");
+    if service == "upload-pack" {
+        // Exact historical commit pins need reachable history after HEAD moves.
+        // Do not enable arbitrary dangling-object reads (allowAnySHA1InWant).
+        command.args([
+            "-c",
+            "uploadpack.allowAnySHA1InWant=false",
+            "-c",
+            "uploadpack.allowTipSHA1InWant=false",
+            "-c",
+            "uploadpack.allowReachableSHA1InWant=true",
+        ]);
+    }
+    if let Some(hooks) = hooks { command.arg("-c").arg(hooks.config()); }
+    command.arg(service);
+    command
+}
