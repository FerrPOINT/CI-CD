+/// Only exact owner bare-Git config, prepared before the caller opens SQL locks.
+pub(crate) struct PreparedBugWorkPipeline {
+    snapshot: PipelinePlanSnapshot,
+    parsed: ParsedPipelineConfig,
+}
+impl PreparedBugWorkPipeline {
+    pub(crate) async fn read(
+        repository: &FsPath,
+        request: &crate::domain::bug_work_publication::BugWorkOperationRequest,
+    ) -> Result<Self, ApiError> {
+        request.validate().map_err(ApiError::bad_request)?;
+        let raw = tokio::time::timeout(
+            std::time::Duration::from_secs(3),
+            crate::runner_workspace::preparation::repository_pipeline_config(
+                repository,
+                &request.bug_work.candidate_commit_sha,
+            ),
+        )
+        .await
+        .map_err(|_| {
+            ApiError::service_unavailable("Конфигурация точного candidate commit недоступна")
+        })?
+        .map_err(|_| {
+            ApiError::service_unavailable("Конфигурация точного candidate commit недоступна")
+        })?;
+        let raw = String::from_utf8(raw)
+            .map_err(|_| ApiError::bad_request("Конфигурация candidate должна быть UTF-8"))?;
+        let parsed = parse_pipeline_config(Some(&raw)).map_err(ApiError::bad_request)?;
+        if parsed.has_image_build() || parsed.has_workspace_deploy() {
+            return Err(ApiError::bad_request("image_build/workspace_deploy требуют отдельный task pipeline"));
+        }
+        let snapshot = build_pipeline_plan_snapshot(
+            &request.candidate_ref(),
+            Some(&request.bug_work.candidate_commit_sha),
+            "repository",
+            raw,
+            &parsed,
+        );
+        Ok(Self { snapshot, parsed })
+    }
+    pub(crate) fn identity(
+        &self,
+        pipeline_id: Uuid,
+    ) -> crate::domain::bug_work_publication::BugWorkPipelineIdentity {
+        crate::domain::bug_work_publication::BugWorkPipelineIdentity {
+            pipeline_id,
+            config_sha256: self.snapshot.config_sha256.clone(),
+            plan_sha256: self.snapshot.plan_sha256.clone(),
+        }
+    }
+}
+
+/// Caller retains original intent and imports source before this transaction.
+/// It appends Accepted BEFORE committing, so no orphan build can be acknowledged.
+pub(crate) async fn insert_bug_work_pipeline(
+    conn: &mut sqlx::Transaction<'_, sqlx::Postgres>,
+    configuration: Uuid,
+    intent: Uuid,
+    prepared: &PreparedBugWorkPipeline,
+) -> Result<crate::domain::bug_work_publication::BugWorkPipelineIdentity, ApiError> {
+    let source = "bug-work";
+    let key = intent.to_string();
+    let variables = serde_json::json!({});
+    let fingerprint = pipeline_trigger_fingerprint(&prepared.snapshot.git_ref, &variables);
+    sqlx::query("SELECT pg_advisory_xact_lock(hashtextextended($1,0))")
+        .bind(format!("pipeline-trigger:{configuration}:{source}:{key}"))
+        .execute(&mut **conn)
+        .await
+        .map_err(ApiError::internal)?;
+    if let Some((pipeline,hash,commit,config,plan))=sqlx::query_as::<_,(Uuid,String,Option<String>,String,String)>(
+        "SELECT t.pipeline_id,t.request_fingerprint,p.commit_sha,pp.config_sha256,pp.plan_sha256 FROM pipeline_triggers t JOIN pipelines p ON p.id=t.pipeline_id JOIN pipeline_plans pp ON pp.pipeline_id=p.id WHERE t.project_id=$1 AND t.source=$2 AND t.idempotency_key=$3")
+        .bind(configuration).bind(source).bind(&key).fetch_optional(&mut **conn).await.map_err(ApiError::internal)? {
+        if hash!=fingerprint || commit!=prepared.snapshot.resolved_commit_sha || config!=prepared.snapshot.config_sha256 || plan!=prepared.snapshot.plan_sha256 {
+            return Err(ApiError::conflict("Исходный candidate pipeline относится к другой версии"));
+        }
+        return Ok(prepared.identity(pipeline));
+    }
+    let pipeline = insert_pipeline_rows(
+        conn,
+        configuration,
+        &prepared.snapshot.git_ref,
+        prepared.snapshot.resolved_commit_sha.as_deref(),
+        &variables,
+        &prepared.snapshot,
+        &prepared.parsed,
+    )
+    .await?;
+    sqlx::query("INSERT INTO pipeline_triggers(id,project_id,source,idempotency_key,request_fingerprint,pipeline_id) VALUES($1,$2,$3,$4,$5,$6)")
+        .bind(Uuid::new_v4()).bind(configuration).bind(source).bind(key).bind(fingerprint).bind(pipeline.id).execute(&mut **conn).await.map_err(ApiError::internal)?;
+    Ok(prepared.identity(pipeline.id))
+}
+
 #[derive(Debug)]
 struct ParsedPipelineConfig {
     stages: Vec<CiStage>,
