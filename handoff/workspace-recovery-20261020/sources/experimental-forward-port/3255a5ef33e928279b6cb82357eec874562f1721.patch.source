diff --git a/backend/tests/support/bug_work_actual_chain.rs b/backend/tests/support/bug_work_actual_chain.rs
new file mode 100644
index 0000000..6d1fa24
--- /dev/null
+++ b/backend/tests/support/bug_work_actual_chain.rs
@@ -0,0 +1,491 @@
+//! Actual CI HTTP admission/import -> runner -> artifact -> privileged static
+//! publisher -> serving proof. Only the external Tracker103/104 peer is synthetic.
+//! No intent/Accepted/pipeline/artifact for the checked operation is seeded.
+use super::*;
+use axum::{Json, Router, extract::State, http::HeaderMap, routing::get};
+use cicd::domain::bug_work_publication::*;
+use cicd::domain::delivered_target::DeliveredProjectRef;
+use serde_json::{Value, json};
+use std::sync::{
+    Arc,
+    atomic::{AtomicUsize, Ordering},
+};
+
+fn canonical(v: &Value) -> String {
+    fn sorted(v: &Value) -> Value {
+        match v {
+            Value::Object(m) => Value::Object(
+                m.iter()
+                    .map(|(key, value)| (key.clone(), sorted(value)))
+                    .collect::<std::collections::BTreeMap<_, _>>()
+                    .into_iter()
+                    .collect(),
+            ),
+            Value::Array(a) => Value::Array(a.iter().map(sorted).collect()),
+            _ => v.clone(),
+        }
+    }
+    hash(&serde_json::to_vec(&sorted(v)).unwrap())
+}
+
+struct Tracker {
+    grant: Value,
+    origin: Value,
+    reads: AtomicUsize,
+}
+async fn grant(State(s): State<Arc<Tracker>>, headers: HeaderMap) -> Json<Value> {
+    assert_eq!(headers["authorization"], "Bearer synthetic-tracker-reader");
+    s.reads.fetch_add(1, Ordering::SeqCst);
+    Json(s.grant.clone())
+}
+async fn source_origin(State(s): State<Arc<Tracker>>, headers: HeaderMap) -> Json<Value> {
+    assert_eq!(headers["authorization"], "Bearer synthetic-tracker-reader");
+    s.reads.fetch_add(1, Ordering::SeqCst);
+    Json(s.origin.clone())
+}
+struct Peer(tokio::task::JoinHandle<()>);
+impl Drop for Peer {
+    fn drop(&mut self) {
+        self.0.abort();
+    }
+}
+
+async fn serve_tracker(
+    t: &ActualDelivery,
+    tracker: Uuid,
+    project: Uuid,
+    repository: Uuid,
+    base: &str,
+    clone_url: &str,
+) -> (
+    Arc<Tracker>,
+    Peer,
+    String,
+    PathBuf,
+    BugWorkPublicationBinding,
+) {
+    let mut vector: Value = serde_json::from_str(include_str!(
+        "../../domain/tests/fixtures/bug-work-delivery-v1.json"
+    ))
+    .unwrap();
+    let a = &mut vector["state"]["assignment"];
+    a["tracker_instance_uuid"] = json!(tracker);
+    a["project_id"] = json!(project);
+    a["machine_subject"] = json!(t.f.subject);
+    a["source_identity"]["repository_id"] = json!(repository);
+    a["source_sha256"] = json!(canonical(&a["source_identity"]));
+    a["verification_basis"]["checked_version"] = json!(base);
+    a["verification_basis_sha256"] = json!(canonical(&a["verification_basis"]));
+    let source = &mut vector["source"];
+    source["project"]["project_id"] = json!(project);
+    source["scope"] = json!(["."]);
+    source["targets"][0]["commit_sha"] = json!(base);
+    let pin = &mut source["targets"][0]["source"];
+    pin["project"] = json!({"tracker_instance_id":tracker,"project_id":project});
+    pin["configuration_id"] = json!(t.f.project);
+    pin["repository_id"] = json!(repository);
+    pin["observed_head_sha"] = json!(base);
+    pin["clone_url_sha256"] = json!(hash(clone_url.as_bytes()));
+    let source_sha = canonical(source);
+    vector["state"]["assignment"]["origin"]["source_context_sha256"] = json!(source_sha);
+    let assignment_sha = canonical(&vector["state"]["assignment"]);
+    vector["state"]["assignment_sha256"] = json!(assignment_sha);
+    let a = &vector["state"]["assignment"];
+    let binding = BugWorkPublicationBinding {
+        bug_id: serde_json::from_value(a["bug_id"].clone()).unwrap(),
+        assignment_id: serde_json::from_value(a["assignment_id"].clone()).unwrap(),
+        assignment_sha256: assignment_sha,
+        fence: a["fence"].as_i64().unwrap(),
+        owner_subject: a["owner_subject"].as_str().unwrap().into(),
+        runtime_binding_sha256: canonical(&vector["state"]["binding"]),
+        source_context_sha256: source_sha,
+        verification_basis_sha256: a["verification_basis_sha256"].as_str().unwrap().into(),
+        canonical_basis_sha256: a["canonical_basis_sha256"].as_str().unwrap().into(),
+        base_commit_sha: base.into(),
+        // The caller replaces this only after creating the actual descendant B.
+        candidate_commit_sha: "b".repeat(40),
+    };
+    let origin = json!({"contract_version":1,"assignment_id":binding.assignment_id,
+        "assignment_sha256":binding.assignment_sha256,"origin":a["origin"],
+        "source_context":vector["source"]});
+    let state = Arc::new(Tracker {
+        grant: vector["state"].clone(),
+        origin,
+        reads: AtomicUsize::new(0),
+    });
+    let prefix = format!(
+        "/api/v1/projects/{project}/sdlc/bug-intake/assignments/{}",
+        binding.assignment_id
+    );
+    let app = Router::new()
+        .route(&format!("{prefix}/grant"), get(grant))
+        .route(&format!("{prefix}/origin"), get(source_origin))
+        .with_state(state.clone());
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let origin = format!("http://{}", listener.local_addr().unwrap());
+    let peer = Peer(tokio::spawn(async move {
+        axum::serve(listener, app).await.unwrap();
+    }));
+    let credential = t.temp.join("synthetic-tracker-reader.token");
+    std::fs::write(&credential, "synthetic-tracker-reader").unwrap();
+    (state, peer, origin, credential, binding)
+}
+
+fn original_url(
+    t: &ActualDelivery,
+    request: &BugWorkOperationRequest,
+    bundle: bool,
+) -> reqwest::Url {
+    let mut url = reqwest::Url::parse(&format!(
+        "http://{}/api/v1/projects/{}/bug-work-operations/{}{}",
+        t.address,
+        t.f.project,
+        request.operation_key,
+        if bundle { "/source-bundle" } else { "" }
+    ))
+    .unwrap();
+    url.query_pairs_mut()
+        .append_pair("request_sha256", &canonical(&json!(request)))
+        .append_pair("assignment_id", &request.bug_work.assignment_id.to_string())
+        .append_pair("assignment_sha256", &request.bug_work.assignment_sha256)
+        .append_pair("expected_fence", &request.bug_work.fence.to_string())
+        .append_pair(
+            "candidate_commit_sha",
+            &request.bug_work.candidate_commit_sha,
+        );
+    url
+}
+async fn json_response(response: reqwest::Response) -> Value {
+    let status = response.status();
+    let raw: Value = response.json().await.unwrap();
+    assert!(status.is_success(), "synthetic CI response {status}: {raw}");
+    raw
+}
+
+#[tokio::test]
+async fn bug_work_actual_http_import_runner_publish_proof_and_original_replay_without_ledger_seed()
+{
+    let (mut t, tracker, project, repository) = bug_work_publisher::fixture().await;
+    let reader = Uuid::new_v4();
+    let reader_token = format!("forge_sat_{}", Uuid::new_v4().simple());
+    sqlx::query("INSERT INTO service_accounts(id,name) VALUES($1,$2)")
+        .bind(reader)
+        .bind(format!("actual-bug-chain-{reader}"))
+        .execute(&t.f.pool)
+        .await
+        .unwrap();
+    sqlx::query("INSERT INTO api_tokens(id,name,token_hash,token_hint,project_id,scopes,principal_type,service_account_id) VALUES($1,'actual chain read',$2,'qa-only',$3,ARRAY['api:read'],'service_account',$4)")
+        .bind(Uuid::new_v4()).bind(cicd::auth::hash_token(&reader_token)).bind(t.f.project).bind(reader)
+        .execute(&t.f.pool).await.unwrap();
+    let http = reqwest::Client::builder()
+        .no_proxy()
+        .redirect(reqwest::redirect::Policy::none())
+        .timeout(Duration::from_secs(30))
+        .build()
+        .unwrap();
+    // Read the genuine original A and clone URL through the configured source
+    // reader, before B is created or imported. No caller URL becomes authority.
+    let mut config = cicd::config::RuntimeConfig::test_default()
+        .with_auth_secret(Some("workspace-test-secret".into()));
+    config.sdlc_workspace.operation_subject = Some(t.f.subject);
+    config.sdlc_workspace.source_reader_subject = Some(reader);
+    config.sdlc_workspace.delivered_target_subject = Some(reader);
+    config.sdlc_workspace.delivered_targets = Some(t.temp.join("delivered-targets.json"));
+    config.sdlc_workspace.local_delivery_root = Some(t.target_root.clone());
+    config.sdlc_workspace.local_delivery_policy = Some(t.policy_file.clone());
+    config.artifacts.root = t.artifact_root.clone();
+    let replace_app = |config| {
+        cicd::api::app_with_git_and_config(
+            Some(t.f.pool.clone()),
+            cicd::git_host::GitConfig {
+                root: t.git_root.clone(),
+                token: None,
+                internal_token: None,
+            },
+            None,
+            config,
+        )
+        .unwrap()
+    };
+    t.f.app = replace_app(config.clone());
+    t.server.abort();
+    let _ = (&mut t.server).await;
+    let listener = tokio::net::TcpListener::bind(t.address).await.unwrap();
+    let app = t.f.app.clone();
+    t.server = tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+    let source = json_response(
+        http.get(format!(
+            "http://{}/api/v1/projects/{}/source-snapshot",
+            t.address, t.f.project
+        ))
+        .query(&[
+            ("tracker_instance_id", tracker.to_string()),
+            ("project_id", project.to_string()),
+            ("repository_id", repository.to_string()),
+            ("branch_ref", "refs/heads/main".into()),
+        ])
+        .bearer_auth(&reader_token)
+        .send()
+        .await
+        .unwrap(),
+    )
+    .await;
+    let base = source["commitSha"].as_str().unwrap().to_owned();
+    assert_eq!(base, physical_git(&t.source, &["rev-parse", "HEAD"]));
+    let (peer_state, _peer, tracker_origin, credential, mut binding) = serve_tracker(
+        &t,
+        tracker,
+        project,
+        repository,
+        &base,
+        source["cloneUrl"].as_str().unwrap(),
+    )
+    .await;
+    let controller = t.temp.join("actual-bug-import-controller");
+    std::fs::create_dir(&controller).unwrap();
+    config.sdlc_workspace.bug_work = cicd::config::BugWorkPublicationConfig {
+        enabled: true,
+        producer_subject: Some(t.f.subject),
+        tracker_origin: Some(tracker_origin),
+        tracker_reader_token_file: Some(credential),
+        controller_root: Some(controller),
+    };
+    t.f.app = replace_app(config);
+    t.server.abort();
+    let _ = (&mut t.server).await;
+    let listener = tokio::net::TcpListener::bind(t.address).await.unwrap();
+    let app = t.f.app.clone();
+    t.server = tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+
+    let payload = b"version=B\nhealth=ok\nacceptance=ok\n";
+    let yaml = serde_yaml::to_string(&json!({"version":1,"jobs":{"build":{"tags":[t.tag],"commands":["printf 'version=B\\nhealth=ok\\nacceptance=ok\\n' > product.txt"],"artifacts":{"paths":["product.txt"]}}}})).unwrap();
+    std::fs::write(t.source.join(".forge-ci.yml"), yaml).unwrap();
+    physical_git(&t.source, &["add", "."]);
+    physical_git(
+        &t.source,
+        &[
+            "-c",
+            "user.name=QA",
+            "-c",
+            "user.email=qa@example.invalid",
+            "commit",
+            "-m",
+            "actual Bug B",
+        ],
+    );
+    binding.candidate_commit_sha = physical_git(&t.source, &["rev-parse", "HEAD"]);
+    let candidate_ref = format!(
+        "refs/fleet/bug-work/{}/{}",
+        binding.assignment_id, binding.candidate_commit_sha
+    );
+    physical_git(
+        &t.source,
+        &["update-ref", &candidate_ref, &binding.candidate_commit_sha],
+    );
+    let bundle_path = t.temp.join("actual-bug-source.bundle");
+    physical_git(
+        &t.source,
+        &[
+            "bundle",
+            "create",
+            bundle_path.to_str().unwrap(),
+            &candidate_ref,
+            &format!("^{base}"),
+        ],
+    );
+    let bundle = std::fs::read(bundle_path).unwrap();
+    let request = BugWorkOperationRequest {
+        contract_version: 1,
+        operation_key: "bug:actual-http-chain".into(),
+        project: DeliveredProjectRef {
+            tracker_instance_id: tracker,
+            project_id: project,
+        },
+        bug_work: binding,
+        repository_id: repository,
+        candidate_tree_id: physical_git(&t.source, &["rev-parse", "HEAD^{tree}"]),
+        bundle_sha256: hash(&bundle),
+        bundle_size_bytes: bundle.len() as u64,
+    };
+    request.validate().unwrap();
+    let count_before: i64 =
+        sqlx::query_scalar("SELECT count(*) FROM pipelines WHERE project_id=$1")
+            .bind(t.f.project)
+            .fetch_one(&t.f.pool)
+            .await
+            .unwrap();
+    let prepare = format!(
+        "http://{}/api/v1/projects/{}/bug-work-operations",
+        t.address, t.f.project
+    );
+    let intent = json_response(
+        http.post(&prepare)
+            .bearer_auth(&t.f.token)
+            .json(&request)
+            .send()
+            .await
+            .unwrap(),
+    )
+    .await;
+    assert!(intent["accepted"].is_null());
+    assert_eq!(
+        intent["intent"]["requestSha256"],
+        canonical(&json!(request))
+    );
+    let original = original_url(&t, &request, false);
+    assert_eq!(
+        json_response(
+            http.get(original.clone())
+                .bearer_auth(&t.f.token)
+                .send()
+                .await
+                .unwrap()
+        )
+        .await,
+        intent
+    );
+    let imported = json_response(
+        http.put(original_url(&t, &request, true))
+            .bearer_auth(&t.f.token)
+            .header("content-type", "application/octet-stream")
+            .body(bundle.clone())
+            .send()
+            .await
+            .unwrap(),
+    )
+    .await;
+    let accepted: BugWorkOperationAccepted =
+        serde_json::from_value(imported["accepted"].clone()).unwrap();
+    accepted.validate().unwrap();
+    assert_eq!(
+        accepted.intent_operation_id,
+        serde_json::from_value::<Uuid>(intent["intent"]["operationId"].clone()).unwrap()
+    );
+    assert_eq!(accepted.request, request);
+    assert_eq!(accepted.candidate_ref, candidate_ref);
+    // Main remains A; only the operation-scoped actual imported candidate ref is B.
+    assert_eq!(
+        physical_git(&t.bare, &["rev-parse", "refs/heads/main"]),
+        base
+    );
+    assert_eq!(
+        physical_git(&t.bare, &["rev-parse", &candidate_ref]),
+        request.bug_work.candidate_commit_sha
+    );
+    let pipeline = accepted.pipeline.pipeline_id;
+    let child = t.spawn_delivery_runner("actual-http-bug-work").await;
+    let out = tokio::time::timeout(Duration::from_secs(30), child.wait_with_output())
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(out.status.success(), "actual runner failed: {out:?}");
+    let (artifact,digest,size):(Uuid,String,i64)=sqlx::query_as("SELECT a.id,a.sha256,a.size_bytes FROM artifacts a JOIN jobs j ON j.id=a.job_id JOIN stages s ON s.id=j.stage_id WHERE s.pipeline_id=$1 AND a.purged_at IS NULL AND a.expires_at>clock_timestamp() ORDER BY a.id LIMIT 1").bind(pipeline).fetch_one(&t.f.pool).await.unwrap();
+    assert_eq!(digest, hash(payload));
+    assert_eq!(size, payload.len() as i64);
+    let command = BugWorkPublishCommand {
+        schema: "forge/bug-work-publication-command/v1".into(),
+        operation_key: "publish:actual-http-bug".into(),
+        original_operation_key: request.operation_key.clone(),
+        original_request_sha256: canonical(&json!(request)),
+        target_ref: "qa:app".into(),
+        artifact_id: artifact,
+        expected_manifest_sha256: None,
+    };
+    let published = bug_work_publisher::execute(&t, &command, true).await;
+    assert_eq!(published["receipt"]["status"], "verified");
+    let pointer = std::fs::read(t.target_root.join("current.json")).unwrap();
+    let mut proof_url = original.clone();
+    proof_url.set_path(&format!("{}/delivery-proof/qa:app", original.path()));
+    let proof = json_response(
+        http.get(proof_url.clone())
+            .bearer_auth(&reader_token)
+            .send()
+            .await
+            .unwrap(),
+    )
+    .await;
+    assert_eq!(proof["status"], "confirmed");
+    assert_eq!(
+        proof["operation"]["operationId"],
+        json!(accepted.operation.operation_id)
+    );
+    assert_eq!(proof["pipeline"]["pipelineId"], json!(pipeline));
+    assert_eq!(
+        proof["delivery"]["commitSha"],
+        json!(request.bug_work.candidate_commit_sha)
+    );
+    assert_eq!(proof["artifact"]["artifactId"], json!(artifact));
+    assert_eq!(
+        proof["delivery"]["servingIdentity"]["artifactBodySha256"],
+        digest
+    );
+    assert_eq!(
+        proof["delivery"]["servingIdentity"]["versionBodySha256"],
+        proof["delivery"]["manifestSha256"]
+    );
+    // Simulate losing both HTTP acknowledgements at the consumer: original GET,
+    // POST and PUT replay must return the same actual Accepted and no new build.
+    for observed in [
+        json_response(
+            http.get(original)
+                .bearer_auth(&t.f.token)
+                .send()
+                .await
+                .unwrap(),
+        )
+        .await,
+        json_response(
+            http.post(&prepare)
+                .bearer_auth(&t.f.token)
+                .json(&request)
+                .send()
+                .await
+                .unwrap(),
+        )
+        .await,
+        json_response(
+            http.put(original_url(&t, &request, true))
+                .bearer_auth(&t.f.token)
+                .body(bundle)
+                .send()
+                .await
+                .unwrap(),
+        )
+        .await,
+    ] {
+        assert_eq!(observed, imported);
+    }
+    let replay = bug_work_publisher::execute(&t, &command, true).await;
+    assert_eq!(replay["receipt"], published["receipt"]);
+    assert_eq!(
+        std::fs::read(t.target_root.join("current.json")).unwrap(),
+        pointer
+    );
+    let replay_proof = json_response(
+        http.get(proof_url)
+            .bearer_auth(&reader_token)
+            .send()
+            .await
+            .unwrap(),
+    )
+    .await;
+    assert_eq!(
+        replay_proof["delivery"]["generation"],
+        proof["delivery"]["generation"]
+    );
+    let count_after: i64 = sqlx::query_scalar("SELECT count(*) FROM pipelines WHERE project_id=$1")
+        .bind(t.f.project)
+        .fetch_one(&t.f.pool)
+        .await
+        .unwrap();
+    assert_eq!(count_after, count_before + 1);
+    let phases:(i64,i64)=sqlx::query_as("SELECT count(*) FILTER (WHERE operation_phase='intent'),count(*) FILTER (WHERE operation_phase='accepted') FROM sdlc_workspace_operations WHERE project_id=$1 AND operation_key=$2").bind(t.f.project).bind(&request.operation_key).fetch_one(&t.f.pool).await.unwrap();
+    assert_eq!(phases, (1, 1));
+    assert!(
+        peer_state.reads.load(Ordering::SeqCst) >= 8,
+        "new intent/import must actually read external103/104 authority"
+    );
+    println!(
+        "BUG_WORK_ACTUAL_HTTP_CHAIN=passed;accepted_http=true;runner_artifact=true;publisher_probes=true;one_pipeline=true;tracker_peer=synthetic"
+    );
+}
diff --git a/backend/tests/support/bug_work_publication.rs b/backend/tests/support/bug_work_publication.rs
new file mode 100644
index 0000000..796951e
--- /dev/null
+++ b/backend/tests/support/bug_work_publication.rs
@@ -0,0 +1,345 @@
+//! Real synthetic-PG constraints/transaction tests. Owner HTTP/Git qualification
+//! is separate; inserting a fixture intent is not an execution or deployment proof.
+use super::*;
+use cicd::{domain::bug_work_publication::*, store::bug_work_publication as ledger};
+use sha2::{Digest, Sha256};
+fn request(f: &Fixture, key: &str) -> BugWorkOperationRequest {
+    let golden: serde_json::Value = serde_json::from_str(include_str!(
+        "../../domain/tests/fixtures/bug-work-delivery-v1.json"
+    ))
+    .unwrap();
+    BugWorkOperationRequest {
+        contract_version: 1,
+        operation_key: key.into(),
+        project: serde_json::from_value(golden["proof"]["project"].clone()).unwrap(),
+        bug_work: serde_json::from_value(golden["proof"]["bugWork"].clone()).unwrap(),
+        repository_id: f.request.repository_id,
+        candidate_tree_id: "c".repeat(40),
+        bundle_sha256: "d".repeat(64),
+        bundle_size_bytes: 1024,
+    }
+}
+fn intent(f: &Fixture, key: &str) -> BugWorkOperationIntent {
+    let request = request(f, key);
+    let value = serde_json::to_value(&request).unwrap();
+    BugWorkOperationIntent {
+        schema: "forge/bug-work-operation-intent/v1".into(),
+        operation_id: Uuid::new_v4(),
+        configuration_id: f.project,
+        request_sha256: format!("{:x}", Sha256::digest(serde_json::to_vec(&value).unwrap())),
+        request,
+        recorded_at: chrono::Utc::now(),
+    }
+}
+#[tokio::test]
+async fn bug_work_0096_legacy_constraints_exact_original_and_repository_mapping() {
+    let f = Fixture::new().await;
+    let (status, legacy) = call(
+        &f.app,
+        "POST",
+        &format!("/api/v1/projects/{}/sdlc/workspace-operations", f.project),
+        &f.token,
+        serde_json::to_string(&f.request).unwrap(),
+    )
+    .await;
+    assert_eq!(status, StatusCode::OK, "{legacy}");
+    let original: serde_json::Value = sqlx::query_scalar(
+        "SELECT receipt FROM sdlc_workspace_operations WHERE project_id=$1 AND operation_key=$2",
+    )
+    .bind(f.project)
+    .bind(&f.request.operation_key)
+    .fetch_one(&f.pool)
+    .await
+    .unwrap();
+    assert_eq!(original, legacy);
+    let old_nulls:bool=sqlx::query_scalar("SELECT task_id IS NOT NULL AND root_task_id IS NOT NULL AND lease_id IS NOT NULL AND execution_id IS NOT NULL AND repository_id IS NOT NULL AND purpose='task' AND operation_phase='task' AND parent_intent_id IS NULL AND bug_id IS NULL AND bug_work_repository_id IS NULL AND pipeline_id IS NULL FROM sdlc_workspace_operations WHERE project_id=$1 AND operation_key=$2").bind(f.project).bind(&f.request.operation_key).fetch_one(&f.pool).await.unwrap();
+    assert!(old_nulls);
+    let mut tx = f.pool.begin().await.unwrap();
+    ledger::lock_operation(&mut tx, f.project, &f.request.operation_key)
+        .await
+        .unwrap();
+    assert!(
+        ledger::logical_key_exists(&mut tx, f.project, &f.request.operation_key)
+            .await
+            .unwrap()
+    );
+    let collision = intent(&f, &f.request.operation_key);
+    assert!(
+        ledger::append_intent(&mut tx, f.subject, &collision)
+            .await
+            .is_err()
+    );
+    tx.rollback().await.unwrap();
+    let foreign = Fixture::new().await;
+    let mut bad = intent(&f, "foreign-repository");
+    bad.request.repository_id = foreign.request.repository_id;
+    let mut tx = f.pool.begin().await.unwrap();
+    assert!(
+        ledger::append_intent(&mut tx, f.subject, &bad)
+            .await
+            .is_err()
+    );
+    tx.rollback().await.unwrap();
+    let good = intent(&f, "actual-bug-intent");
+    let mut tx = f.pool.begin().await.unwrap();
+    ledger::append_intent(&mut tx, f.subject, &good)
+        .await
+        .unwrap();
+    tx.commit().await.unwrap();
+    let row:(bool,serde_json::Value)=sqlx::query_as("SELECT task_id IS NULL AND root_task_id IS NULL AND execution_id IS NULL AND lease_id IS NULL AND attempt_id IS NULL AND workspace_generation IS NULL AND repository_id IS NULL,receipt FROM sdlc_workspace_operations WHERE id=$1").bind(good.operation_id).fetch_one(&f.pool).await.unwrap();
+    assert!(row.0);
+    assert_eq!(row.1, serde_json::to_value(&good).unwrap());
+    let old_again: serde_json::Value = sqlx::query_scalar(
+        "SELECT receipt FROM sdlc_workspace_operations WHERE project_id=$1 AND operation_key=$2",
+    )
+    .bind(f.project)
+    .bind(&f.request.operation_key)
+    .fetch_one(&f.pool)
+    .await
+    .unwrap();
+    assert_eq!(old_again, original);
+    assert!(
+        sqlx::query("UPDATE sdlc_workspace_operations SET task_id=NULL WHERE project_id=$1")
+            .bind(f.project)
+            .execute(&f.pool)
+            .await
+            .is_err()
+    );
+    for field in ["project", "bugWork", "bundleSha256"] {
+        let mut altered = serde_json::to_value(&good).unwrap();
+        altered["operationId"] = Uuid::new_v4().to_string().into();
+        let changed_key = format!("null-field-{field}");
+        altered["request"]["operationKey"] = changed_key.clone().into();
+        altered["request"][field] = serde_json::Value::Null;
+        let mut tx = f.pool.begin().await.unwrap();
+        let result=sqlx::query("INSERT INTO sdlc_workspace_operations(id,project_id,service_account_id,operation_key,request_hash,assignment_id,fencing_token,source_commit,receipt,recorded_at,purpose,operation_phase,bug_id,bug_work_repository_id) VALUES($1,$2,$3,$4,$5,$6,$7,$8,$9,now(),'bug_work','intent',$10,$11)")
+            .bind(Uuid::parse_str(altered["operationId"].as_str().unwrap()).unwrap()).bind(f.project).bind(f.subject).bind(&changed_key).bind(&good.request_sha256).bind(good.request.bug_work.assignment_id).bind(good.request.bug_work.fence).bind(&good.request.bug_work.candidate_commit_sha).bind(sqlx::types::Json(altered)).bind(good.request.bug_work.bug_id).bind(good.request.repository_id).execute(&mut *tx).await;
+        assert!(result.is_err(), "missing {field}");
+        tx.rollback().await.unwrap();
+    }
+}
+#[tokio::test]
+async fn bug_work_0096_accepted_pipeline_same_transaction_no_orphan_build_or_duplicate_ack() {
+    let f = Fixture::new().await;
+    let original = intent(&f, "atomic-build");
+    let mut tx = f.pool.begin().await.unwrap();
+    ledger::append_intent(&mut tx, f.subject, &original)
+        .await
+        .unwrap();
+    tx.commit().await.unwrap();
+    let pipeline = Uuid::new_v4();
+    let config = "a".repeat(64);
+    let plan = "b".repeat(64);
+    let make = || BugWorkOperationAccepted {
+        schema: "forge/bug-work-operation-accepted/v1".into(),
+        operation: BugWorkOperationIdentity {
+            operation_id: Uuid::new_v4(),
+            operation_key: original.request.operation_key.clone(),
+            request_sha256: original.request_sha256.clone(),
+        },
+        intent_operation_id: original.operation_id,
+        configuration_id: f.project,
+        request: original.request.clone(),
+        candidate_ref: original.request.candidate_ref(),
+        pipeline: BugWorkPipelineIdentity {
+            pipeline_id: pipeline,
+            config_sha256: config.clone(),
+            plan_sha256: plan.clone(),
+        },
+        accepted_at: chrono::Utc::now(),
+    };
+    let mut tx = f.pool.begin().await.unwrap();
+    let missing = make();
+    assert!(
+        ledger::append_accepted(&mut tx, f.subject, &missing)
+            .await
+            .is_err()
+    );
+    tx.rollback().await.unwrap();
+    let mut tx = f.pool.begin().await.unwrap();
+    sqlx::query("INSERT INTO pipelines(id,project_id,git_ref,commit_sha,status) VALUES($1,$2,$3,$4,'queued')").bind(pipeline).bind(f.project).bind(original.request.candidate_ref()).bind(&original.request.bug_work.candidate_commit_sha).execute(&mut *tx).await.unwrap();
+    sqlx::query("INSERT INTO pipeline_plans(pipeline_id,config_source,parser_version,git_ref,resolved_commit_sha,config_sha256,plan_sha256,raw_config,plan) VALUES($1,'repository','legacy-linear-v1',$2,$3,$4,$5,'fixture','{}'::jsonb)").bind(pipeline).bind(original.request.candidate_ref()).bind(&original.request.bug_work.candidate_commit_sha).bind(&config).bind(&plan).execute(&mut *tx).await.unwrap();
+    let accepted = make();
+    ledger::append_accepted(&mut tx, f.subject, &accepted)
+        .await
+        .unwrap();
+    // Simulate transaction loss: neither Accepted nor its real pipeline can escape.
+    tx.rollback().await.unwrap();
+    assert!(
+        !sqlx::query_scalar::<_, bool>("SELECT EXISTS(SELECT 1 FROM pipelines WHERE id=$1)")
+            .bind(pipeline)
+            .fetch_one(&f.pool)
+            .await
+            .unwrap()
+    );
+    let mut c = f.pool.acquire().await.unwrap();
+    assert!(
+        ledger::accepted(&mut c, f.project, &original.request.operation_key)
+            .await
+            .unwrap()
+            .is_none()
+    );
+    assert!(
+        ledger::intent(&mut c, f.project, &original.request.operation_key)
+            .await
+            .unwrap()
+            .is_some()
+    );
+    drop(c);
+    let mut tx = f.pool.begin().await.unwrap();
+    sqlx::query("INSERT INTO pipelines(id,project_id,git_ref,commit_sha,status) VALUES($1,$2,$3,$4,'queued')").bind(pipeline).bind(f.project).bind(original.request.candidate_ref()).bind(&original.request.bug_work.candidate_commit_sha).execute(&mut *tx).await.unwrap();
+    sqlx::query("INSERT INTO pipeline_plans(pipeline_id,config_source,parser_version,git_ref,resolved_commit_sha,config_sha256,plan_sha256,raw_config,plan) VALUES($1,'repository','legacy-linear-v1',$2,$3,$4,$5,'fixture','{}'::jsonb)").bind(pipeline).bind(original.request.candidate_ref()).bind(&original.request.bug_work.candidate_commit_sha).bind(&config).bind(&plan).execute(&mut *tx).await.unwrap();
+    let accepted = make();
+    ledger::append_accepted(&mut tx, f.subject, &accepted)
+        .await
+        .unwrap();
+    tx.commit().await.unwrap();
+    let mut conn = f.pool.acquire().await.unwrap();
+    let replay = ledger::accepted(&mut conn, f.project, &original.request.operation_key)
+        .await
+        .unwrap()
+        .unwrap();
+    assert_eq!(
+        serde_json::to_value(replay.1).unwrap(),
+        serde_json::to_value(&accepted).unwrap()
+    );
+    drop(conn);
+    let mut tx = f.pool.begin().await.unwrap();
+    let duplicate = make();
+    assert!(
+        ledger::append_accepted(&mut tx, f.subject, &duplicate)
+            .await
+            .is_err()
+    );
+    tx.rollback().await.unwrap();
+    let count:i64=sqlx::query_scalar("SELECT count(*) FROM sdlc_workspace_operations WHERE project_id=$1 AND operation_key=$2 AND operation_phase='accepted'").bind(f.project).bind(&original.request.operation_key).fetch_one(&f.pool).await.unwrap();
+    assert_eq!(count, 1);
+}
+
+#[tokio::test]
+async fn bug_work_http_default_off_original_custody_replay_closed_dto_and_machine_scope() {
+    let mut f = Fixture::new().await;
+    let mut config = cicd::config::RuntimeConfig::test_default()
+        .with_auth_secret(Some("workspace-test-secret".into()));
+    config.sdlc_workspace.bug_work.producer_subject = Some(f.subject);
+    f.app = cicd::api::app_with_git_and_config(
+        Some(f.pool.clone()),
+        cicd::git_host::GitConfig::default(),
+        None,
+        config,
+    )
+    .unwrap();
+    let good = intent(&f, "original-http");
+    let path = format!("/api/v1/projects/{}/bug-work-operations", f.project);
+    let (status, _) = call(
+        &f.app,
+        "POST",
+        &path,
+        &f.token,
+        serde_json::to_string(&good.request).unwrap(),
+    )
+    .await;
+    assert_eq!(status, StatusCode::SERVICE_UNAVAILABLE);
+    let mut conn = f.pool.acquire().await.unwrap();
+    ledger::append_intent(&mut conn, f.subject, &good)
+        .await
+        .unwrap();
+    drop(conn);
+    let (status, body) = call(
+        &f.app,
+        "POST",
+        &path,
+        &f.token,
+        serde_json::to_string(&good.request).unwrap(),
+    )
+    .await;
+    assert_eq!(status, StatusCode::OK, "{body}");
+    assert_eq!(body["intent"], serde_json::to_value(&good).unwrap());
+    assert!(body["accepted"].is_null());
+    let b = &good.request.bug_work;
+    let url = format!(
+        "{}/{}?request_sha256={}&assignment_id={}&assignment_sha256={}&expected_fence={}&candidate_commit_sha={}",
+        path,
+        good.request.operation_key,
+        good.request_sha256,
+        b.assignment_id,
+        b.assignment_sha256,
+        b.fence,
+        b.candidate_commit_sha
+    );
+    assert_eq!(
+        call(&f.app, "GET", &url, &f.read_token, String::new())
+            .await
+            .0,
+        StatusCode::OK
+    );
+    assert_eq!(
+        call(
+            &f.app,
+            "GET",
+            &url.replace(&good.request_sha256, &"0".repeat(64)),
+            &f.token,
+            String::new()
+        )
+        .await
+        .0,
+        StatusCode::CONFLICT
+    );
+    assert_eq!(
+        call(
+            &f.app,
+            "GET",
+            &format!("{url}&verified=true"),
+            &f.token,
+            String::new()
+        )
+        .await
+        .0,
+        StatusCode::BAD_REQUEST
+    );
+    for key in ["verified", "taskId", "candidateUrl"] {
+        let mut unknown = serde_json::to_value(&good.request).unwrap();
+        unknown[key] = true.into();
+        assert_eq!(
+            call(&f.app, "POST", &path, &f.token, unknown.to_string())
+                .await
+                .0,
+            StatusCode::UNPROCESSABLE_ENTITY
+        );
+    }
+    let mut changed = good.request.clone();
+    changed.candidate_tree_id = "f".repeat(40);
+    assert_eq!(
+        call(
+            &f.app,
+            "POST",
+            &path,
+            &f.token,
+            serde_json::to_string(&changed).unwrap()
+        )
+        .await
+        .0,
+        StatusCode::CONFLICT
+    );
+    let other = Fixture::new().await;
+    assert_eq!(
+        call(&f.app, "GET", &url, &other.token, String::new())
+            .await
+            .0,
+        StatusCode::FORBIDDEN
+    );
+    assert_eq!(
+        call(&f.app, "GET", &url, "", String::new()).await.0,
+        StatusCode::UNAUTHORIZED
+    );
+    assert!(
+        ledger::accepted(
+            &mut *f.pool.acquire().await.unwrap(),
+            f.project,
+            &good.request.operation_key
+        )
+        .await
+        .unwrap()
+        .is_none()
+    );
+}
diff --git a/backend/tests/support/bug_work_publisher.rs b/backend/tests/support/bug_work_publisher.rs
new file mode 100644
index 0000000..d644f01
--- /dev/null
+++ b/backend/tests/support/bug_work_publisher.rs
@@ -0,0 +1,381 @@
+//! Fault boundaries on actual runner artifact + existing static publisher.
+//! The attached remote Bug metadata is synthetic SQL input, not Tracker authority qualification.
+use super::*;
+use cicd::{domain::bug_work_publication::*, store::bug_work_publication as bug_ledger};
+
+pub(super) async fn fixture() -> (ActualDelivery, Uuid, Uuid, Uuid) {
+    // The QA driver supplies this process-only origin; reserve it before the
+    // fixture creates any ephemeral servers. Never mutate process environment.
+    let origin = reqwest::Url::parse(
+        &std::env::var("CICD_NAMESPACE__PUBLIC_GIT_ORIGIN")
+            .expect("owned loopback public Git origin required"),
+    )
+    .unwrap();
+    assert_eq!(origin.scheme(), "http");
+    assert_eq!(origin.host_str(), Some("127.0.0.1"));
+    assert_eq!(origin.path(), "/");
+    assert!(origin.username().is_empty() && origin.password().is_none());
+    assert!(origin.query().is_none() && origin.fragment().is_none());
+    let listener = tokio::net::TcpListener::bind(("127.0.0.1", origin.port().unwrap()))
+        .await
+        .unwrap();
+    let mut t = ActualDelivery::new().await;
+    let tracker = Uuid::new_v4();
+    t.f.request.binding.tracker_instance_id = tracker.to_string();
+    let project = t.f.request.binding.tracker_project_id;
+    let repository = t.f.request.repository_id;
+    let group = Uuid::new_v4();
+    let registry: Uuid = std::env::var("CICD_NAMESPACE__REGISTRY_INSTANCE_ID")
+        .unwrap()
+        .parse()
+        .unwrap();
+    let namespace = Uuid::new_v4();
+    let environment = Uuid::new_v4();
+    let reader = Uuid::new_v4();
+    let token_id = Uuid::new_v4();
+    let token = format!("forge_sat_{}", Uuid::new_v4().simple());
+    sqlx::query(
+        "INSERT INTO git_groups(id,slug,name,namespace_managed) VALUES($1,$2,'Delivered QA',true)",
+    )
+    .bind(group)
+    .bind(format!("qa-{}", group.simple()))
+    .execute(&t.f.pool)
+    .await
+    .unwrap();
+    let command = serde_json::json!({
+        "schema_version":1,"namespace":{"registry_instance_id":registry,"namespace_id":namespace},
+        "resource":{"instance_id":std::env::var("CICD_NAMESPACE__INSTANCE_ID").unwrap(),"kind":"git_group","resource_id":group},
+        "operation_id":Uuid::new_v4(),"generation":1,"state":"active","create_spec":null
+    });
+    sqlx::query("INSERT INTO forge_namespace_bindings(resource_id,registry_instance_id,namespace_id,generation,state,command) VALUES($1,$2,$3,1,'active',$4)")
+        .bind(group).bind(registry).bind(namespace).bind(command).execute(&t.f.pool).await.unwrap();
+    sqlx::query("UPDATE repository_catalog SET group_id=$2 WHERE id=$1")
+        .bind(repository)
+        .bind(group)
+        .execute(&t.f.pool)
+        .await
+        .unwrap();
+    // Normal public Smart HTTP checkout of synthetic source, not an auth bypass.
+    // The grouped alias resolves to the fixture's unchanged immutable storage.
+    sqlx::query("UPDATE repositories SET visibility='public' WHERE id=$1")
+        .bind(repository)
+        .execute(&t.f.pool)
+        .await
+        .unwrap();
+    sqlx::query("INSERT INTO repository_aliases(alias,repository_id) SELECT g.slug||'/'||r.slug,r.id FROM repository_catalog r JOIN git_groups g ON g.id=r.group_id WHERE r.id=$1")
+        .bind(repository).execute(&t.f.pool).await.unwrap();
+    sqlx::query("INSERT INTO forge_workspace_projects(registry_instance_id,namespace_id,tracker_instance_id,tracker_project_id,generation,name,project_key,state,observed_at) VALUES($1,$2,$3,$4,1,'Delivered QA','QA','active',now())")
+        .bind(registry).bind(namespace).bind(tracker).bind(project).execute(&t.f.pool).await.unwrap();
+    sqlx::query("INSERT INTO environments(id,project_id,name) VALUES($1,$2,'QA delivered target')")
+        .bind(environment)
+        .bind(t.f.project)
+        .execute(&t.f.pool)
+        .await
+        .unwrap();
+    sqlx::query("INSERT INTO service_accounts(id,name) VALUES($1,$2)")
+        .bind(reader)
+        .bind(format!("delivered-reader-{reader}"))
+        .execute(&t.f.pool)
+        .await
+        .unwrap();
+    sqlx::query("INSERT INTO api_tokens(id,name,token_hash,token_hint,project_id,scopes,principal_type,service_account_id) VALUES($1,'delivered reader',$2,'qa-only',$3,ARRAY['api:read'],'service_account',$4)")
+        .bind(token_id).bind(cicd::auth::hash_token(&token)).bind(t.f.project).bind(reader).execute(&t.f.pool).await.unwrap();
+    let mapping = t.temp.join("delivered-targets.json");
+    std::fs::write(
+        &mapping,
+        serde_json::to_vec(&serde_json::json!({
+            "schema":"forge/delivered-targets-config/v1", "targets":[{
+                "configurationId":t.f.project,"repositoryId":repository,"environmentId":environment,
+                "targetRef":"qa:app","root":t.target_root,"policy":t.policy_file,
+            }]
+        }))
+        .unwrap(),
+    )
+    .unwrap();
+    let mut config = cicd::config::RuntimeConfig::test_default()
+        .with_auth_secret(Some("workspace-test-secret".into()));
+    config.sdlc_workspace.operation_subject = Some(t.f.subject);
+    config.sdlc_workspace.local_delivery_root = Some(t.target_root.clone());
+    config.sdlc_workspace.local_delivery_policy = Some(t.policy_file.clone());
+    config.sdlc_workspace.delivered_target_subject = Some(reader);
+    config.sdlc_workspace.source_reader_subject = Some(reader);
+    config.sdlc_workspace.delivered_targets = Some(mapping);
+    config.artifacts.root = t.artifact_root.clone();
+    t.f.app = cicd::api::app_with_git_and_config(
+        Some(t.f.pool.clone()),
+        cicd::git_host::GitConfig {
+            root: t.git_root.clone(),
+            token: None,
+            internal_token: None,
+        },
+        None,
+        config,
+    )
+    .unwrap();
+    // Exercise the same configured AppState through real runner HTTP and curl.
+    t.server.abort();
+    t.address = listener.local_addr().unwrap();
+    let app = t.f.app.clone();
+    t.server = tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+    (t, tracker, project, repository)
+}
+
+async fn accepted(
+    t: &ActualDelivery,
+    tracker: Uuid,
+    project: Uuid,
+    repository: Uuid,
+    artifact: Uuid,
+) -> BugWorkOperationAccepted {
+    let vector: serde_json::Value = serde_json::from_str(include_str!(
+        "../../domain/tests/fixtures/bug-work-delivery-v1.json"
+    ))
+    .unwrap();
+    let mut binding: BugWorkPublicationBinding =
+        serde_json::from_value(vector["proof"]["bugWork"].clone()).unwrap();
+    binding.base_commit_sha = physical_git(&t.source, &["rev-parse", "HEAD^"]);
+    binding.candidate_commit_sha = t.f.request.source_commit.clone();
+    let (pipeline,config,plan):(Uuid,String,String)=sqlx::query_as("SELECT p.id,pp.config_sha256,pp.plan_sha256 FROM artifacts a JOIN jobs j ON j.id=a.job_id JOIN stages s ON s.id=j.stage_id JOIN pipelines p ON p.id=s.pipeline_id JOIN pipeline_plans pp ON pp.pipeline_id=p.id WHERE a.id=$1").bind(artifact).fetch_one(&t.f.pool).await.unwrap();
+    let request = BugWorkOperationRequest {
+        contract_version: 1,
+        operation_key: "bug:actual-artifact".into(),
+        project: cicd::domain::delivered_target::DeliveredProjectRef {
+            tracker_instance_id: tracker,
+            project_id: project,
+        },
+        bug_work: binding,
+        repository_id: repository,
+        candidate_tree_id: physical_git(&t.source, &["rev-parse", "HEAD^{tree}"]),
+        bundle_sha256: "b".repeat(64),
+        bundle_size_bytes: 128,
+    };
+    let intent = BugWorkOperationIntent {
+        schema: "forge/bug-work-operation-intent/v1".into(),
+        operation_id: Uuid::new_v4(),
+        configuration_id: t.f.project,
+        request_sha256: hash(
+            &serde_json::to_vec(&serde_json::to_value(&request).unwrap()).unwrap(),
+        ),
+        request: request.clone(),
+        recorded_at: chrono::Utc::now(),
+    };
+    let accepted = BugWorkOperationAccepted {
+        schema: "forge/bug-work-operation-accepted/v1".into(),
+        operation: BugWorkOperationIdentity {
+            operation_id: Uuid::new_v4(),
+            operation_key: request.operation_key.clone(),
+            request_sha256: intent.request_sha256.clone(),
+        },
+        intent_operation_id: intent.operation_id,
+        configuration_id: t.f.project,
+        candidate_ref: request.candidate_ref(),
+        request,
+        pipeline: BugWorkPipelineIdentity {
+            pipeline_id: pipeline,
+            config_sha256: config,
+            plan_sha256: plan,
+        },
+        accepted_at: chrono::Utc::now(),
+    };
+    let mut tx = t.f.pool.begin().await.unwrap();
+    bug_ledger::append_intent(&mut tx, t.f.subject, &intent)
+        .await
+        .unwrap();
+    bug_ledger::append_accepted(&mut tx, t.f.subject, &accepted)
+        .await
+        .unwrap();
+    tx.commit().await.unwrap();
+    accepted
+}
+
+fn process(
+    t: &ActualDelivery,
+    command: &BugWorkPublishCommand,
+    reconcile: bool,
+) -> tokio::process::Command {
+    let file = t.temp.join(format!(
+        "bug-command-{}.json",
+        hash(command.operation_key.as_bytes())
+    ));
+    std::fs::write(&file, serde_json::to_vec(command).unwrap()).unwrap();
+    let token = t.temp.join("unused-owner-reader.token");
+    std::fs::write(&token, "sdlc_pat_synthetic-never-sent").unwrap();
+    let mut child = tokio::process::Command::new(env!("CARGO_BIN_EXE_forge-delivery"));
+    child
+        .kill_on_drop(true)
+        .args([
+            "--bug-work",
+            "--project-id",
+            &t.f.project.to_string(),
+            "--command-file",
+        ])
+        .arg(file)
+        .env("CICD_DATABASE_URL", &t.database_url)
+        .env("CICD_AUTH_SECRET", "workspace-test-secret")
+        .env("CICD_GIT_ROOT", &t.git_root)
+        .env("CICD_ARTIFACTS_DIR", &t.artifact_root)
+        .env("CICD_BUG_WORK_ENABLED", "true")
+        .env("CICD_BUG_WORK_PRODUCER_SUBJECT", t.f.subject.to_string())
+        .env("CICD_BUG_WORK_TRACKER_ORIGIN", "http://127.0.0.1:9/")
+        .env("CICD_BUG_WORK_TRACKER_READER_TOKEN_FILE", token)
+        .env("CICD_BUG_WORK_CONTROLLER_ROOT", &t.temp)
+        .env(
+            "CICD_DELIVERED_TARGETS",
+            t.temp.join("delivered-targets.json"),
+        )
+        .env("CICD_LOCAL_DELIVERY_MODE", "local-verification")
+        .env("CICD_LOCAL_DELIVERY_TOKEN", &t.f.token)
+        .env_remove("CICD_AUTH__CENTRAL_JWKS_URI")
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::piped());
+    if reconcile {
+        child.arg("--reconcile");
+    }
+    child
+}
+pub(super) async fn execute(
+    t: &ActualDelivery,
+    command: &BugWorkPublishCommand,
+    reconcile: bool,
+) -> serde_json::Value {
+    let out = tokio::time::timeout(
+        Duration::from_secs(25),
+        process(t, command, reconcile).output(),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert!(
+        out.status.success(),
+        "{}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+    serde_json::from_slice(&out.stdout).unwrap()
+}
+async fn entered(t: &ActualDelivery, phase: &str) {
+    let deadline = Instant::now() + Duration::from_secs(15);
+    while !t.temp.join(format!("entered-bug-work-{phase}")).exists() {
+        assert!(Instant::now() < deadline, "publication boundary {phase}");
+        tokio::time::sleep(Duration::from_millis(10)).await;
+    }
+}
+async fn revoke(t: &ActualDelivery) {
+    let changed = sqlx::query(
+        "UPDATE api_tokens SET revoked_at=now() WHERE token_hash=$1 AND revoked_at IS NULL",
+    )
+    .bind(cicd::auth::hash_token(&t.f.token))
+    .execute(&t.f.pool)
+    .await
+    .unwrap();
+    assert_eq!(changed.rows_affected(), 1);
+}
+async fn rotate(t: &mut ActualDelivery) {
+    let token = format!("forge_sat_{}", Uuid::new_v4().simple());
+    sqlx::query("INSERT INTO api_tokens(id,name,token_hash,token_hint,project_id,scopes,principal_type,service_account_id) VALUES($1,'replacement publication producer',$2,'qa-only',$3,ARRAY['api:read','api:write'],'service_account',$4)")
+        .bind(Uuid::new_v4()).bind(cicd::auth::hash_token(&token)).bind(t.f.project).bind(t.f.subject).execute(&t.f.pool).await.unwrap();
+    t.f.token = token;
+}
+
+#[tokio::test]
+async fn bug_work_actual_publisher_stage_and_probe_revocation_and_original_key_crash_recovery() {
+    let (mut t, tracker, project, repository) = fixture().await;
+    let (built, _) = t
+        .build(
+            "bugwork-publisher-B",
+            "version=B\nhealth=ok\nacceptance=ok\n",
+        )
+        .await;
+    let original = accepted(&t, tracker, project, repository, built.artifact_id.unwrap()).await;
+    let command = BugWorkPublishCommand {
+        schema: "forge/bug-work-publication-command/v1".into(),
+        operation_key: "publish:bug-stage".into(),
+        original_operation_key: original.operation.operation_key.clone(),
+        original_request_sha256: original.operation.request_sha256.clone(),
+        target_ref: "qa:app".into(),
+        artifact_id: built.artifact_id.unwrap(),
+        expected_manifest_sha256: None,
+    };
+    let stage = t.temp.join("block-bug-work-stage");
+    std::fs::write(&stage, b"hold").unwrap();
+    let child = process(&t, &command, false).spawn().unwrap();
+    entered(&t, "stage").await;
+    revoke(&t).await;
+    std::fs::remove_file(&stage).unwrap();
+    let failed = tokio::time::timeout(Duration::from_secs(10), child.wait_with_output())
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(!failed.status.success());
+    assert!(
+        !t.target_root.join("current.json").exists(),
+        "revocation after real stage prevents publication"
+    );
+    rotate(&mut t).await;
+    let first = execute(&t, &command, true).await;
+    assert_eq!(first["receipt"]["status"], "verified");
+    let first_pointer = std::fs::read(t.target_root.join("current.json")).unwrap();
+    let confirmed = std::fs::read(t.target_root.join("confirmed.json")).unwrap();
+    let manifest = first["currentManifestSha256"].as_str().unwrap().to_owned();
+    // Genuine serving probes finish first, then fresh producer revocation must
+    // prevent a new confirmation/result. Published bytes are not rolled back.
+    let mut probe = command.clone();
+    probe.operation_key = "publish:bug-probe".into();
+    probe.expected_manifest_sha256 = Some(manifest.clone());
+    std::fs::write(t.temp.join("block-bug-work-probe"), b"hold").unwrap();
+    let child = process(&t, &probe, false).spawn().unwrap();
+    entered(&t, "probe").await;
+    revoke(&t).await;
+    std::fs::remove_file(t.temp.join("block-bug-work-probe")).unwrap();
+    let failed = tokio::time::timeout(Duration::from_secs(10), child.wait_with_output())
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(!failed.status.success());
+    assert_eq!(
+        std::fs::read(t.target_root.join("confirmed.json")).unwrap(),
+        confirmed
+    );
+    assert!(
+        !t.target_root
+            .join("operations")
+            .join(hash(probe.operation_key.as_bytes()))
+            .join("result.json")
+            .exists()
+    );
+    rotate(&mut t).await;
+    assert_eq!(
+        execute(&t, &probe, true).await["receipt"]["status"],
+        "verified"
+    );
+    assert_ne!(
+        std::fs::read(t.target_root.join("current.json")).unwrap(),
+        first_pointer
+    );
+    // Kill after durable intent+real staging but before the pointer. Original
+    // recovery reuses the same Accepted pipeline/body and does not mint a build.
+    let mut crash = command.clone();
+    crash.operation_key = "publish:bug-crash".into();
+    crash.expected_manifest_sha256 = Some(manifest.clone());
+    std::fs::remove_file(t.temp.join("entered-bug-work-stage")).unwrap();
+    std::fs::write(&stage, b"hold").unwrap();
+    let before = std::fs::read(t.target_root.join("current.json")).unwrap();
+    let mut child = process(&t, &crash, false).spawn().unwrap();
+    entered(&t, "stage").await;
+    child.kill().await.unwrap();
+    std::fs::remove_file(&stage).unwrap();
+    assert_eq!(
+        std::fs::read(t.target_root.join("current.json")).unwrap(),
+        before
+    );
+    let recovered = execute(&t, &crash, true).await;
+    assert_eq!(recovered["receipt"]["status"], "verified");
+    let mut next = crash.clone();
+    next.operation_key = "publish:bug-after-recovery".into();
+    assert_eq!(
+        execute(&t, &next, false).await["receipt"]["status"],
+        "verified",
+        "target must be settled after original recovery"
+    );
+    let builds:i64=sqlx::query_scalar("SELECT count(*) FROM sdlc_workspace_operations WHERE project_id=$1 AND operation_key=$2 AND operation_phase='accepted'").bind(t.f.project).bind(&original.operation.operation_key).fetch_one(&t.f.pool).await.unwrap();
+    assert_eq!(builds, 1);
+}
diff --git a/backend/tests/support/delivered_targets.rs b/backend/tests/support/delivered_targets.rs
new file mode 100644
index 0000000..05d9cec
--- /dev/null
+++ b/backend/tests/support/delivered_targets.rs
@@ -0,0 +1,576 @@
+//! Uses the existing real runner/candidate/delivery fixture, never synthetic success metadata.
+use super::*;
+
+#[tokio::test]
+async fn delivered_target_actual_publication_scoped_authority_generation_and_legacy_readback() {
+    // The QA driver supplies this process-only origin; reserve it before the
+    // fixture creates any ephemeral servers. Never mutate process environment.
+    let origin = reqwest::Url::parse(
+        &std::env::var("CICD_NAMESPACE__PUBLIC_GIT_ORIGIN")
+            .expect("owned loopback public Git origin required"),
+    )
+    .unwrap();
+    assert_eq!(origin.scheme(), "http");
+    assert_eq!(origin.host_str(), Some("127.0.0.1"));
+    assert_eq!(origin.path(), "/");
+    assert!(origin.username().is_empty() && origin.password().is_none());
+    assert!(origin.query().is_none() && origin.fragment().is_none());
+    let listener = tokio::net::TcpListener::bind(("127.0.0.1", origin.port().unwrap()))
+        .await
+        .unwrap();
+    let mut t = ActualDelivery::new().await;
+    let tracker = Uuid::new_v4();
+    t.f.request.binding.tracker_instance_id = tracker.to_string();
+    let project = t.f.request.binding.tracker_project_id;
+    let repository = t.f.request.repository_id;
+    let group = Uuid::new_v4();
+    let registry: Uuid = std::env::var("CICD_NAMESPACE__REGISTRY_INSTANCE_ID")
+        .unwrap()
+        .parse()
+        .unwrap();
+    let namespace = Uuid::new_v4();
+    let environment = Uuid::new_v4();
+    let reader = Uuid::new_v4();
+    let token_id = Uuid::new_v4();
+    let token = format!("forge_sat_{}", Uuid::new_v4().simple());
+    sqlx::query(
+        "INSERT INTO git_groups(id,slug,name,namespace_managed) VALUES($1,$2,'Delivered QA',true)",
+    )
+    .bind(group)
+    .bind(format!("qa-{}", group.simple()))
+    .execute(&t.f.pool)
+    .await
+    .unwrap();
+    let command = serde_json::json!({
+        "schema_version":1,"namespace":{"registry_instance_id":registry,"namespace_id":namespace},
+        "resource":{"instance_id":std::env::var("CICD_NAMESPACE__INSTANCE_ID").unwrap(),"kind":"git_group","resource_id":group},
+        "operation_id":Uuid::new_v4(),"generation":1,"state":"active","create_spec":null
+    });
+    sqlx::query("INSERT INTO forge_namespace_bindings(resource_id,registry_instance_id,namespace_id,generation,state,command) VALUES($1,$2,$3,1,'active',$4)")
+        .bind(group).bind(registry).bind(namespace).bind(command).execute(&t.f.pool).await.unwrap();
+    sqlx::query("UPDATE repository_catalog SET group_id=$2 WHERE id=$1")
+        .bind(repository)
+        .bind(group)
+        .execute(&t.f.pool)
+        .await
+        .unwrap();
+    // Normal public Smart HTTP checkout of synthetic source, not an auth bypass.
+    // The grouped alias resolves to the fixture's unchanged immutable storage.
+    sqlx::query("UPDATE repositories SET visibility='public' WHERE id=$1")
+        .bind(repository)
+        .execute(&t.f.pool)
+        .await
+        .unwrap();
+    sqlx::query("INSERT INTO repository_aliases(alias,repository_id) SELECT g.slug||'/'||r.slug,r.id FROM repository_catalog r JOIN git_groups g ON g.id=r.group_id WHERE r.id=$1")
+        .bind(repository).execute(&t.f.pool).await.unwrap();
+    sqlx::query("INSERT INTO forge_workspace_projects(registry_instance_id,namespace_id,tracker_instance_id,tracker_project_id,generation,name,project_key,state,observed_at) VALUES($1,$2,$3,$4,1,'Delivered QA','QA','active',now())")
+        .bind(registry).bind(namespace).bind(tracker).bind(project).execute(&t.f.pool).await.unwrap();
+    sqlx::query("INSERT INTO environments(id,project_id,name) VALUES($1,$2,'QA delivered target')")
+        .bind(environment)
+        .bind(t.f.project)
+        .execute(&t.f.pool)
+        .await
+        .unwrap();
+    sqlx::query("INSERT INTO service_accounts(id,name) VALUES($1,$2)")
+        .bind(reader)
+        .bind(format!("delivered-reader-{reader}"))
+        .execute(&t.f.pool)
+        .await
+        .unwrap();
+    sqlx::query("INSERT INTO api_tokens(id,name,token_hash,token_hint,project_id,scopes,principal_type,service_account_id) VALUES($1,'delivered reader',$2,'qa-only',$3,ARRAY['api:read'],'service_account',$4)")
+        .bind(token_id).bind(cicd::auth::hash_token(&token)).bind(t.f.project).bind(reader).execute(&t.f.pool).await.unwrap();
+    let mapping = t.temp.join("delivered-targets.json");
+    std::fs::write(
+        &mapping,
+        serde_json::to_vec(&serde_json::json!({
+            "schema":"forge/delivered-targets-config/v1", "targets":[{
+                "configurationId":t.f.project,"repositoryId":repository,"environmentId":environment,
+                "targetRef":"qa:app","root":t.target_root,"policy":t.policy_file,
+            }]
+        }))
+        .unwrap(),
+    )
+    .unwrap();
+    let mut config = cicd::config::RuntimeConfig::test_default()
+        .with_auth_secret(Some("workspace-test-secret".into()));
+    config.sdlc_workspace.operation_subject = Some(t.f.subject);
+    config.sdlc_workspace.local_delivery_root = Some(t.target_root.clone());
+    config.sdlc_workspace.local_delivery_policy = Some(t.policy_file.clone());
+    config.sdlc_workspace.delivered_target_subject = Some(reader);
+    config.sdlc_workspace.source_reader_subject = Some(reader);
+    config.sdlc_workspace.delivered_targets = Some(mapping);
+    config.artifacts.root = t.artifact_root.clone();
+    t.f.app = cicd::api::app_with_git_and_config(
+        Some(t.f.pool.clone()),
+        cicd::git_host::GitConfig {
+            root: t.git_root.clone(),
+            token: None,
+            internal_token: None,
+        },
+        None,
+        config,
+    )
+    .unwrap();
+    // Exercise the same configured AppState through real runner HTTP and curl.
+    t.server.abort();
+    t.address = listener.local_addr().unwrap();
+    let app = t.f.app.clone();
+    t.server = tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+    let url = format!(
+        "/api/v1/projects/{}/delivered-targets/qa:app?tracker_instance_id={tracker}&project_id={project}&repository_id={repository}",
+        t.f.project
+    );
+
+    // A pipeline/candidate by itself is unavailable serving authority.
+    let (a, original) = t
+        .build(
+            "delivered-target-A",
+            "version=A\nhealth=ok\nacceptance=ok\n",
+        )
+        .await;
+    // Source authority works before publication and needs no Bug/task lease.
+    let source_url = format!(
+        "/api/v1/projects/{}/source-snapshot?tracker_instance_id={tracker}&project_id={project}&repository_id={repository}&branch_ref=refs%2Fheads%2Fmain",
+        t.f.project
+    );
+    let (source_status, source) = t.curl_with_token("GET", &source_url, None, &token).await;
+    assert_eq!(source_status, 200, "{source}");
+    assert_eq!(source["schema"], "forge/source-snapshot/v1");
+    assert_eq!(source["repositoryId"], repository.to_string());
+    assert_eq!(source["commitSha"], t.f.request.source_commit);
+    assert_eq!(source["branchRef"], "refs/heads/main");
+    assert!(
+        source["cloneUrl"]
+            .as_str()
+            .unwrap()
+            .starts_with(origin.as_str())
+    );
+    for bad in [
+        source_url.replace(&project.to_string(), &Uuid::new_v4().to_string()),
+        source_url.replace(&repository.to_string(), &Uuid::new_v4().to_string()),
+        source_url.replace(&tracker.to_string(), &Uuid::new_v4().to_string()),
+    ] {
+        assert_eq!(
+            call(&t.f.app, "GET", &bad, &token, String::new()).await.0,
+            StatusCode::FORBIDDEN
+        );
+    }
+    for extra in ["&caller_url=http://localhost/", "&verified=true"] {
+        assert_eq!(
+            call(
+                &t.f.app,
+                "GET",
+                &format!("{source_url}{extra}"),
+                &token,
+                String::new()
+            )
+            .await
+            .0,
+            StatusCode::BAD_REQUEST
+        );
+    }
+    let expression = source_url.replace("refs%2Fheads%2Fmain", "HEAD%5E%7Bcommit%7D");
+    assert_eq!(
+        call(&t.f.app, "GET", &expression, &token, String::new())
+            .await
+            .0,
+        StatusCode::BAD_REQUEST
+    );
+    let missing = source_url.replace("refs%2Fheads%2Fmain", "refs%2Fheads%2Fmissing-qa");
+    assert_eq!(
+        call(&t.f.app, "GET", &missing, &token, String::new())
+            .await
+            .0,
+        StatusCode::NOT_FOUND
+    );
+    #[cfg(unix)]
+    {
+        let relocated = t.git_root.join("relocated-qa.git");
+        std::fs::rename(&t.bare, &relocated).unwrap();
+        std::os::unix::fs::symlink(&relocated, &t.bare).unwrap();
+        let code = call(&t.f.app, "GET", &source_url, &token, String::new())
+            .await
+            .0;
+        std::fs::remove_file(&t.bare).unwrap();
+        std::fs::rename(&relocated, &t.bare).unwrap();
+        assert_eq!(code, StatusCode::SERVICE_UNAVAILABLE);
+    }
+    let (status, before) = call(&t.f.app, "GET", &url, &token, String::new()).await;
+    assert_eq!(status, StatusCode::OK, "{before}");
+    assert_eq!(before["status"], "unavailable");
+    assert!(before["target"].is_null());
+    let (code, delivered) = t.execute(&a, None).await;
+    assert_eq!(code, 0, "{delivered:?}");
+    let first = t.curl_with_token("GET", &url, None, &token).await;
+    assert_eq!(first.0, 200, "{}", first.1);
+    assert_eq!(first.1["status"], "confirmed", "{}", first.1);
+    assert_eq!(first.1["target"]["generation"], "1");
+    assert_eq!(first.1["target"]["commitSha"], t.f.request.source_commit);
+    assert_eq!(
+        first.1["target"]["artifactDigest"],
+        format!("sha256:{}", hash(b"version=A\nhealth=ok\nacceptance=ok\n"))
+    );
+    assert_eq!(
+        first.1["target"]["servingIdentity"]["artifactBodySha256"],
+        hash(b"version=A\nhealth=ok\nacceptance=ok\n")
+    );
+    assert_eq!(
+        call(&t.f.app, "GET", &url, &token, String::new()).await.1["target"]["deliveryRef"],
+        first.1["target"]["deliveryRef"]
+    );
+    // Actual owner HTTP is deliberately paused. Revocation must commit while
+    // the probe is in flight, and that request must not return confirmed data.
+    let controls = t.target_root.parent().unwrap();
+    let block = controls.join("block-health");
+    let entered = controls.join("entered-block-health");
+    std::fs::write(&block, b"hold").unwrap();
+    let (probe_app, probe_url, probe_token) = (t.f.app.clone(), url.clone(), token.clone());
+    let pending = tokio::spawn(async move {
+        call(&probe_app, "GET", &probe_url, &probe_token, String::new()).await
+    });
+    let deadline = Instant::now() + Duration::from_secs(5);
+    while !entered.exists() {
+        assert!(
+            Instant::now() < deadline,
+            "delivered read did not reach actual health probe"
+        );
+        tokio::time::sleep(Duration::from_millis(10)).await;
+    }
+    let revoked = tokio::time::timeout(
+        Duration::from_secs(1),
+        sqlx::query("UPDATE api_tokens SET revoked_at=now() WHERE id=$1")
+            .bind(token_id)
+            .execute(&t.f.pool),
+    )
+    .await;
+    std::fs::remove_file(&block).unwrap();
+    let denied = tokio::time::timeout(Duration::from_secs(10), pending)
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(
+        revoked.is_ok_and(|result| result.is_ok()),
+        "reader SQL lock must not span owner HTTP probes"
+    );
+    assert_eq!(
+        denied.0,
+        StatusCode::FORBIDDEN,
+        "a mid-probe revoked read must not return confirmed target"
+    );
+    sqlx::query("UPDATE api_tokens SET revoked_at=NULL WHERE id=$1")
+        .bind(token_id)
+        .execute(&t.f.pool)
+        .await
+        .unwrap();
+    assert_eq!(
+        call(&t.f.app, "GET", &url, &t.f.token, String::new())
+            .await
+            .0,
+        StatusCode::FORBIDDEN
+    );
+    let human = Uuid::new_v4();
+    let human_pat = format!("cicd_{}", Uuid::new_v4().simple());
+    sqlx::query("INSERT INTO users(id,username,role) VALUES($1,$2,'admin')")
+        .bind(human)
+        .bind(format!("delivered-human-{human}"))
+        .execute(&t.f.pool)
+        .await
+        .unwrap();
+    sqlx::query("INSERT INTO api_tokens(id,name,user_id,token_hash,token_hint,project_id,scopes) VALUES($1,'human reader',$2,$3,'qa-only',$4,ARRAY['api:read'])")
+        .bind(Uuid::new_v4()).bind(human).bind(cicd::auth::hash_token(&human_pat)).bind(t.f.project).execute(&t.f.pool).await.unwrap();
+    assert_eq!(
+        call(&t.f.app, "GET", &url, &human_pat, String::new())
+            .await
+            .0,
+        StatusCode::FORBIDDEN
+    );
+    let global_pat = format!("forge_sat_{}", Uuid::new_v4().simple());
+    sqlx::query("INSERT INTO api_tokens(id,name,token_hash,token_hint,scopes,principal_type,service_account_id) VALUES($1,'global reader',$2,'qa-only',ARRAY['api:read'],'service_account',$3)")
+        .bind(Uuid::new_v4()).bind(cicd::auth::hash_token(&global_pat)).bind(reader).execute(&t.f.pool).await.unwrap();
+    assert_eq!(
+        call(&t.f.app, "GET", &url, &global_pat, String::new())
+            .await
+            .0,
+        StatusCode::FORBIDDEN
+    );
+    for credential in [&human_pat, &global_pat, &t.f.token] {
+        assert_eq!(
+            call(&t.f.app, "GET", &source_url, credential, String::new())
+                .await
+                .0,
+            StatusCode::FORBIDDEN
+        );
+    }
+    assert_eq!(
+        call(
+            &t.f.app,
+            "GET",
+            &url.replace(
+                &format!("project_id={project}"),
+                &format!("project_id={}", Uuid::new_v4())
+            ),
+            &token,
+            String::new()
+        )
+        .await
+        .0,
+        StatusCode::FORBIDDEN
+    );
+    assert_eq!(
+        call(
+            &t.f.app,
+            "GET",
+            &format!("{url}&verified=true"),
+            &token,
+            String::new()
+        )
+        .await
+        .0,
+        StatusCode::BAD_REQUEST
+    );
+    assert_eq!(
+        call(
+            &t.f.app,
+            "GET",
+            &format!("{url}&url=http://attacker.invalid"),
+            &token,
+            String::new()
+        )
+        .await
+        .0,
+        StatusCode::BAD_REQUEST
+    );
+    let before_pointer = std::fs::read(t.target_root.join("current.json")).unwrap();
+    assert_eq!(t.execute(&a, Some("--readback")).await.0, 0);
+    assert_eq!(t.execute(&a, None).await.0, 0);
+    assert_eq!(t.execute(&a, Some("--reconcile")).await.0, 0);
+    assert_eq!(
+        before_pointer,
+        std::fs::read(t.target_root.join("current.json")).unwrap()
+    );
+    let mut rollback = a.clone();
+    rollback.operation_key = "rollback:identical".into();
+    rollback.action = DeliveryAction::Rollback;
+    rollback.artifact_id = None;
+    rollback.expected_manifest_sha256 = first.1["target"]["manifestSha256"]
+        .as_str()
+        .map(str::to_owned);
+    assert_eq!(t.execute(&rollback, None).await.0, 0);
+    let second = call(&t.f.app, "GET", &url, &token, String::new()).await.1;
+    assert_eq!(second["status"], "confirmed", "{second}");
+    assert_eq!(second["target"]["generation"], "2");
+    assert_ne!(
+        second["target"]["deliveryRef"],
+        first.1["target"]["deliveryRef"]
+    );
+    assert_eq!(
+        second["target"]["manifestSha256"],
+        first.1["target"]["manifestSha256"]
+    );
+    let versioned_pointer = std::fs::read(t.target_root.join("current.json")).unwrap();
+    std::fs::write(
+        t.target_root.join("current.json"),
+        serde_json::to_vec(
+            &serde_json::json!({"manifestSha256":second["target"]["manifestSha256"]}),
+        )
+        .unwrap(),
+    )
+    .unwrap();
+    assert_eq!(
+        call(&t.f.app, "GET", &url, &token, String::new()).await.1["status"],
+        "unavailable"
+    );
+    assert_eq!(
+        t.read_http(&a, &original).await["receipt"]["status"],
+        "verified"
+    );
+    std::fs::write(t.target_root.join("current.json"), versioned_pointer).unwrap();
+
+    // The serving commit stays A while the source branch advances to B. Exercise
+    // the real private Smart HTTP owner, not a fake successful checkout carrier.
+    let serving_commit = physical_git(&t.source, &["rev-parse", "HEAD"]);
+    std::fs::write(t.source.join("README.md"), "source branch ahead of QA\n").unwrap();
+    physical_git(&t.source, &["add", "README.md"]);
+    physical_git(
+        &t.source,
+        &[
+            "-c",
+            "user.name=QA",
+            "-c",
+            "user.email=qa@example.invalid",
+            "commit",
+            "-m",
+            "advance after delivery",
+        ],
+    );
+    physical_git(
+        &t.source,
+        &["push", t.bare.to_str().unwrap(), "HEAD:refs/heads/main"],
+    );
+    let advanced = call(&t.f.app, "GET", &source_url, &token, String::new())
+        .await
+        .1;
+    assert_ne!(advanced["commitSha"], serving_commit);
+    assert_eq!(
+        call(&t.f.app, "GET", &url, &token, String::new()).await.1["target"]["commitSha"],
+        serving_commit
+    );
+    sqlx::query("UPDATE repositories SET visibility='private' WHERE id=$1")
+        .bind(repository)
+        .execute(&t.f.pool)
+        .await
+        .unwrap();
+    let checkout = t.temp.join("private-reader-checkout");
+    std::fs::create_dir(&checkout).unwrap();
+    physical_git(&checkout, &["init", "--quiet"]);
+    async fn fetch_pin(
+        directory: &std::path::Path,
+        clone_url: &str,
+        credential: &str,
+        commit: &str,
+    ) -> bool {
+        let mut command = tokio::process::Command::new("git");
+        command
+            .current_dir(directory)
+            .env_clear()
+            .env("PATH", std::env::var_os("PATH").unwrap())
+            .env("HOME", "/nonexistent")
+            .env("GIT_CONFIG_NOSYSTEM", "1")
+            .env("GIT_CONFIG_GLOBAL", "/dev/null")
+            .env("GIT_TERMINAL_PROMPT", "0")
+            .env("GIT_CONFIG_COUNT", "1")
+            .env("GIT_CONFIG_KEY_0", "http.extraHeader")
+            .env(
+                "GIT_CONFIG_VALUE_0",
+                format!("Authorization: Bearer {credential}"),
+            )
+            .args([
+                "-c",
+                "credential.helper=",
+                "-c",
+                "http.followRedirects=false",
+                "-c",
+                "http.proxy=",
+                "fetch",
+                "--quiet",
+                "--depth=1",
+                "--no-tags",
+                "--no-recurse-submodules",
+                "--",
+                clone_url,
+                commit,
+            ])
+            .stdin(std::process::Stdio::null())
+            .kill_on_drop(true);
+        let output = tokio::time::timeout(std::time::Duration::from_secs(15), command.output())
+            .await
+            .expect("private Git fixture request exceeded bounded deadline")
+            .unwrap();
+        output.status.success()
+    }
+    let clone_url = advanced["cloneUrl"].as_str().unwrap();
+    assert!(
+        !fetch_pin(&checkout, clone_url, &token, &serving_commit).await,
+        "api:read does not authorize private Git"
+    );
+    sqlx::query("UPDATE api_tokens SET scopes=ARRAY['api:read','git:read'] WHERE id=$1")
+        .bind(token_id)
+        .execute(&t.f.pool)
+        .await
+        .unwrap();
+    assert!(
+        fetch_pin(&checkout, clone_url, &token, &serving_commit).await,
+        "configured project reader must fetch reachable historical SHA"
+    );
+    assert_eq!(
+        physical_git(&checkout, &["rev-parse", "FETCH_HEAD"]),
+        serving_commit
+    );
+    // Command-level policy must override even an overly broad stored setting.
+    physical_git(
+        &t.bare,
+        &["config", "uploadpack.allowAnySHA1InWant", "true"],
+    );
+    let dangling = physical_git(
+        &t.bare,
+        &[
+            "-c",
+            "user.name=QA",
+            "-c",
+            "user.email=qa@example.invalid",
+            "commit-tree",
+            "HEAD^{tree}",
+            "-p",
+            "HEAD",
+            "-m",
+            "unreachable synthetic commit",
+        ],
+    );
+    assert!(
+        !fetch_pin(&checkout, clone_url, &token, &dangling).await,
+        "reachable history support must not authorize arbitrary dangling objects"
+    );
+    assert!(
+        !std::fs::read_to_string(checkout.join(".git/config"))
+            .unwrap()
+            .contains(&token)
+    );
+    assert!(
+        !std::fs::read_to_string(checkout.join(".git/FETCH_HEAD"))
+            .unwrap()
+            .contains(&token)
+    );
+    let foreign_reader = Uuid::new_v4();
+    let foreign_token = format!("forge_sat_{}", Uuid::new_v4().simple());
+    sqlx::query("INSERT INTO service_accounts(id,name) VALUES($1,$2)")
+        .bind(foreign_reader)
+        .bind(format!("foreign-source-reader-{foreign_reader}"))
+        .execute(&t.f.pool)
+        .await
+        .unwrap();
+    sqlx::query("INSERT INTO users(id,username,role) VALUES($1,$2,'admin')")
+        .bind(foreign_reader)
+        .bind(format!("colliding-human-{foreign_reader}"))
+        .execute(&t.f.pool)
+        .await
+        .unwrap();
+    sqlx::query(
+        "INSERT INTO project_memberships(project_id,user_id,role) VALUES($1,$2,'maintainer')",
+    )
+    .bind(t.f.project)
+    .bind(foreign_reader)
+    .execute(&t.f.pool)
+    .await
+    .unwrap();
+    sqlx::query("INSERT INTO api_tokens(id,name,token_hash,token_hint,project_id,scopes,principal_type,service_account_id) VALUES($1,'foreign source reader',$2,'qa-only',$3,ARRAY['api:read','git:read'],'service_account',$4)")
+        .bind(Uuid::new_v4()).bind(cicd::auth::hash_token(&foreign_token)).bind(t.f.project).bind(foreign_reader).execute(&t.f.pool).await.unwrap();
+    assert!(
+        !fetch_pin(&checkout, clone_url, &foreign_token, &serving_commit).await,
+        "same project scopes and a colliding human membership cannot grant source-reader identity"
+    );
+    sqlx::query("UPDATE forge_namespace_bindings SET state='archived',command=jsonb_set(command,'{state}','\"archived\"') WHERE resource_id=$1")
+        .bind(group).execute(&t.f.pool).await.unwrap();
+    assert_eq!(
+        call(&t.f.app, "GET", &url, &token, String::new()).await.0,
+        StatusCode::FORBIDDEN
+    );
+    assert!(
+        !fetch_pin(&checkout, clone_url, &token, &serving_commit).await,
+        "archived namespace closes private Git reads too"
+    );
+    sqlx::query("UPDATE api_tokens SET revoked_at=now() WHERE id=$1")
+        .bind(token_id)
+        .execute(&t.f.pool)
+        .await
+        .unwrap();
+    assert_eq!(
+        call(&t.f.app, "GET", &url, &token, String::new()).await.0,
+        StatusCode::UNAUTHORIZED
+    );
+    assert_eq!(
+        call(&t.f.app, "GET", &source_url, &token, String::new())
+            .await
+            .0,
+        StatusCode::UNAUTHORIZED
+    );
+}
diff --git a/backend/tests/support/sdlc_workspace.rs b/backend/tests/support/sdlc_workspace.rs
index d8e54bd..24486e9 100644
--- a/backend/tests/support/sdlc_workspace.rs
+++ b/backend/tests/support/sdlc_workspace.rs
@@ -1,6 +1,8 @@
 use super::*;
 use cicd::domain::sdlc_workspace::*;
 
+#[path = "bug_work_publication.rs"]
+mod bug_work_publication;
 #[path = "candidate_evidence.rs"]
 mod candidate_evidence;
 #[cfg(unix)]
diff --git a/backend/tests/support/task_delivery.rs b/backend/tests/support/task_delivery.rs
index c685cec..dbb31a0 100644
--- a/backend/tests/support/task_delivery.rs
+++ b/backend/tests/support/task_delivery.rs
@@ -180,6 +180,35 @@ impl ActualDelivery {
         }
     }
 
+    /// Launch the existing real runner against already-admitted jobs.
+    /// This helper never creates a pipeline or an SDLC workspace operation.
+    async fn spawn_delivery_runner(&self, version: &str) -> tokio::process::Child {
+        let runner_id = Uuid::new_v4();
+        let credential = format!("cicd_runner_{}", runner_id.simple());
+        sqlx::query("INSERT INTO runners(id,name,tags,status,last_seen_at,credential_hash,credential_expires_at,capabilities) VALUES($1,$2,$3,'online',now(),$4,now()+interval '1 hour','{}')").bind(runner_id).bind(format!("delivery-{runner_id}")).bind(vec![self.tag.clone()]).bind(cicd::auth::hash_token(&credential)).execute(&self.f.pool).await.unwrap();
+        tokio::process::Command::new(env!("CARGO_BIN_EXE_forge-runner"))
+            .kill_on_drop(true)
+            .args([
+                "--api-url",
+                &format!("http://{}", self.address),
+                "--name",
+                &format!("delivery-{runner_id}"),
+                "--tags",
+                &self.tag,
+                "--once",
+                "--keep-workspace",
+                "--work-dir",
+            ])
+            .arg(self.temp.join(format!("workspaces-{version}")))
+            .env("CICD_RUNNER_CREDENTIAL", credential)
+            .env_remove("CICD_RUNNER_REGISTRATION_TOKEN")
+            .env_remove("CICD_RUNNER_NO_CHECKOUT")
+            .env_remove("CICD_RUNNER_INSPECT_WORKSPACES")
+            .env_remove("CICD_RUNNER_RECONCILE_WORKSPACES")
+            .spawn()
+            .unwrap()
+    }
+
     async fn build(
         &mut self,
         version: &str,
@@ -247,30 +276,7 @@ impl ActualDelivery {
         assert_eq!(status, StatusCode::OK, "{pipeline}");
