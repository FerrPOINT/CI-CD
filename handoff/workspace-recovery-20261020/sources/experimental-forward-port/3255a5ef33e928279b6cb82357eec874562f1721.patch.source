diff --git a/backend/domain/src/source_snapshot.rs b/backend/domain/src/source_snapshot.rs
new file mode 100644
index 0000000..8d22e9b
--- /dev/null
+++ b/backend/domain/src/source_snapshot.rs
@@ -0,0 +1,68 @@
+//! Exact hosted source identity. This readback grants no workspace or execution lease.
+use crate::delivered_target::DeliveredProjectRef;
+use chrono::{DateTime, Utc};
+use serde::{Deserialize, Serialize};
+use uuid::Uuid;
+
+#[derive(Clone, Debug, Serialize, Deserialize, utoipa::ToSchema)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct SourceSnapshot {
+    pub schema: String,
+    pub producer_version: String,
+    pub project: DeliveredProjectRef,
+    pub configuration_id: Uuid,
+    pub repository_id: Uuid,
+    pub branch_ref: String,
+    pub commit_sha: String,
+    /// Catalog-owned URL with no credentials. Consumers must pin the returned commit.
+    pub clone_url: String,
+    pub observed_at: DateTime<Utc>,
+}
+
+/// Only a full branch name, never an arbitrary Git revision expression.
+pub fn valid_branch_ref(value: &str) -> bool {
+    let Some(name) = value.strip_prefix("refs/heads/") else {
+        return false;
+    };
+    !name.is_empty()
+        && name.len() <= 256
+        && name
+            .bytes()
+            .all(|c| c.is_ascii_alphanumeric() || matches!(c, b'-' | b'_' | b'/' | b'.'))
+        && !name.contains("..")
+        && name.split('/').all(|part| {
+            !part.is_empty()
+                && !part.starts_with('.')
+                && !part.ends_with('.')
+                && !part.ends_with(".lock")
+        })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn source_branch_is_not_a_revision_expression() {
+        for good in [
+            "refs/heads/main",
+            "refs/heads/feature/bug-123",
+            "refs/heads/release_1.2",
+        ] {
+            assert!(valid_branch_ref(good));
+        }
+        for bad in [
+            "main",
+            "HEAD",
+            "refs/tags/v1",
+            "refs/heads/",
+            "refs/heads/../main",
+            "refs/heads/-c x",
+            "refs/heads/main^{commit}",
+            "refs/heads/a.lock",
+            "refs/heads/a/",
+            "refs/heads/.a",
+        ] {
+            assert!(!valid_branch_ref(bad), "{bad}");
+        }
+    }
+}
