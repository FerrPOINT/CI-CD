//! Row-locked pipeline lifecycle storage. Host commits terminal facts and fanout.
use chrono::{DateTime, Utc};
use sqlx::{Postgres, Transaction};
use uuid::Uuid;

pub async fn stage_pipeline(pool: &sqlx::PgPool, stage: Uuid) -> Result<Option<Uuid>, sqlx::Error> {
    sqlx::query_scalar("SELECT pipeline_id FROM stages WHERE id=$1")
        .bind(stage)
        .fetch_optional(pool)
        .await
}
pub async fn recoverable_pipelines(pool: &sqlx::PgPool) -> Result<Vec<Uuid>, sqlx::Error> {
    // Active old pipelines must not starve newer completed work behind the batch limit.
    sqlx::query_scalar("SELECT p.id FROM pipelines p WHERE p.status IN ('queued','running') AND EXISTS(SELECT 1 FROM stages s JOIN jobs j ON j.stage_id=s.id WHERE s.pipeline_id=p.id) AND (EXISTS(SELECT 1 FROM stages s JOIN jobs j ON j.stage_id=s.id WHERE s.pipeline_id=p.id AND j.status='failed' AND NOT j.allow_failure) OR NOT EXISTS(SELECT 1 FROM stages s JOIN jobs j ON j.stage_id=s.id WHERE s.pipeline_id=p.id AND j.status IN ('queued','running')) OR (EXISTS(SELECT 1 FROM stages s JOIN jobs j ON j.stage_id=s.id WHERE s.pipeline_id=p.id AND j.status='canceled') AND NOT EXISTS(SELECT 1 FROM stages s JOIN jobs j ON j.stage_id=s.id WHERE s.pipeline_id=p.id AND j.status='running')) OR (p.status='queued' AND EXISTS(SELECT 1 FROM stages s JOIN jobs j ON j.stage_id=s.id WHERE s.pipeline_id=p.id AND j.status='running'))) ORDER BY p.created_at LIMIT 100").fetch_all(pool).await
}

pub struct Completion {
    pub project_id: Uuid,
    pub pipeline_id: Uuid,
    pub sequence: i64,
    pub status: String,
    pub finished_at: DateTime<Utc>,
}
pub async fn supersede_job_lease(
    tx: &mut Transaction<'_, Postgres>,
    job: Uuid,
) -> Result<(), sqlx::Error> {
    sqlx::query("UPDATE job_leases SET lease_status='canceled',completed_at=COALESCE(completed_at,now()),terminal_status='canceled',error_tail=COALESCE(error_tail,'job retry superseded canceled lease') WHERE job_id=$1 AND lease_status='active'").bind(job).execute(&mut **tx).await?;
    sqlx::query("UPDATE job_queue SET state='canceled',completed_at=COALESCE(completed_at,now()),updated_at=now() WHERE job_id=$1 AND state IN ('queued','leased')").bind(job).execute(&mut **tx).await?;
    Ok(())
}
pub async fn lock(
    tx: &mut Transaction<'_, Postgres>,
    id: Uuid,
) -> Result<Option<String>, sqlx::Error> {
    sqlx::query_scalar("SELECT status FROM pipelines WHERE id=$1 FOR UPDATE")
        .bind(id)
        .fetch_optional(&mut **tx)
        .await
}

/// Caller already holds the pipeline row lock. Terminal states cannot be rewritten.
pub async fn set_status(
    tx: &mut Transaction<'_, Postgres>,
    id: Uuid,
    previous: &str,
    next: &str,
) -> Result<Option<Completion>, sqlx::Error> {
    if matches!(previous, "success" | "failed" | "canceled") {
        return Ok(None);
    }
    // Preserve the live deployment projection in the same lifecycle transaction.
    let deployment_status = match next {
        "success" => "success",
        "failed" | "canceled" => "failed",
        "running" => "running",
        _ => "pending",
    };
    sqlx::query(
        "UPDATE deployments SET status=$2 WHERE pipeline_id=$1 AND status IN ('pending','running')",
    )
    .bind(id)
    .bind(deployment_status)
    .execute(&mut **tx)
    .await?;
    if matches!(next, "success" | "failed" | "canceled") {
        let row:(Uuid,i64,DateTime<Utc>)=sqlx::query_as("UPDATE pipelines SET status=$2,finished_at=now(),terminal_event_seq=terminal_event_seq+1 WHERE id=$1 RETURNING project_id,terminal_event_seq,finished_at").bind(id).bind(next).fetch_one(&mut **tx).await?;
        Ok(Some(Completion {
            project_id: row.0,
            pipeline_id: id,
            sequence: row.1,
            status: next.into(),
            finished_at: row.2,
        }))
    } else {
        sqlx::query("UPDATE pipelines SET status=$2,started_at=CASE WHEN $2='running' THEN COALESCE(started_at,now()) ELSE started_at END WHERE id=$1").bind(id).bind(next).execute(&mut **tx).await?;
        Ok(None)
    }
}

pub async fn refresh(
    tx: &mut Transaction<'_, Postgres>,
    id: Uuid,
) -> Result<Option<Completion>, sqlx::Error> {
    let Some(previous) = lock(tx, id).await? else {
        return Ok(None);
    };
    if matches!(previous.as_str(), "success" | "failed" | "canceled") {
        return Ok(None);
    }
    // Recompute all stages from jobs, so recovery does not depend on a stale stage row.
    sqlx::query("UPDATE stages s SET status=a.status FROM (SELECT stage_id,CASE WHEN bool_or(status='failed' AND NOT allow_failure) THEN 'failed' WHEN bool_and(status='success' OR (status='failed' AND allow_failure)) THEN 'success' WHEN bool_or(status='running') THEN 'running' WHEN bool_or(status='canceled') THEN 'canceled' ELSE 'queued' END AS status FROM jobs WHERE stage_id IN (SELECT id FROM stages WHERE pipeline_id=$1) GROUP BY stage_id) a WHERE s.id=a.stage_id").bind(id).execute(&mut **tx).await?;
    let next:String=sqlx::query_scalar("SELECT CASE WHEN bool_or(status='failed') THEN 'failed' WHEN bool_and(status='success') THEN 'success' WHEN bool_or(status='running') THEN 'running' WHEN bool_or(status='canceled') THEN 'canceled' ELSE 'queued' END FROM stages WHERE pipeline_id=$1").bind(id).fetch_one(&mut **tx).await?;
    set_status(tx, id, &previous, &next).await
}

/// Keep external cancellation signalling distinct from embedded lease completion.
pub async fn cancel_leases(
    tx: &mut Transaction<'_, Postgres>,
    id: Uuid,
    force: bool,
) -> Result<(), sqlx::Error> {
    if !force {
        sqlx::query("UPDATE job_leases SET cancel_requested_at=COALESCE(cancel_requested_at,now()),error_tail=COALESCE(error_tail,'pipeline canceled') WHERE lease_status='active' AND runner_id IS NOT NULL AND lease_token_hash IS NOT NULL AND job_id IN (SELECT j.id FROM jobs j JOIN stages s ON s.id=j.stage_id WHERE s.pipeline_id=$1)").bind(id).execute(&mut **tx).await?;
    }
    sqlx::query("UPDATE job_leases SET lease_status='canceled',completed_at=COALESCE(completed_at,now()),terminal_status='canceled',error_tail=COALESCE(error_tail,'pipeline canceled') WHERE lease_status='active' AND ($2 OR NOT(runner_id IS NOT NULL AND lease_token_hash IS NOT NULL)) AND job_id IN (SELECT j.id FROM jobs j JOIN stages s ON s.id=j.stage_id WHERE s.pipeline_id=$1)").bind(id).bind(force).execute(&mut **tx).await?;
    sqlx::query("UPDATE job_queue SET state='canceled',completed_at=COALESCE(completed_at,now()),updated_at=now() WHERE pipeline_id=$1 AND state IN ('queued','leased')").bind(id).execute(&mut **tx).await?;
    Ok(())
}
