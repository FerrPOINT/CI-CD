diff --git a/scripts/tests/test_verify_docs.py b/scripts/tests/test_verify_docs.py
index f8cedef..41b3ea9 100644
--- a/scripts/tests/test_verify_docs.py
+++ b/scripts/tests/test_verify_docs.py
@@ -4,8 +4,10 @@
 from __future__ import annotations
 
 import importlib.util
+import tempfile
 import unittest
 from pathlib import Path
+from unittest.mock import patch
 
 SCRIPT = Path(__file__).resolve().parents[1] / "verify_docs.py"
 SPEC = importlib.util.spec_from_file_location("verify_docs", SCRIPT)
@@ -63,5 +65,43 @@ class CapabilityStatusRegressionTests(unittest.TestCase):
             readme.write_bytes(original)
 
 
+class FrontendCiScriptRegressionTests(unittest.TestCase):
+    def setUp(self) -> None:
+        verify_docs.problems.clear()
+        self.directory = tempfile.TemporaryDirectory(prefix="forge-docs-ci-")
+        self.addCleanup(self.directory.cleanup)
+        self.root = Path(self.directory.name)
+        self.workflow = self.root / ".github/workflows/ci.yml"
+        self.workflow.parent.mkdir(parents=True)
+        self.patched_root = patch.object(verify_docs, "ROOT", self.root)
+        self.patched_root.start()
+        self.addCleanup(self.patched_root.stop)
+
+    def test_pinned_base_install_directory_is_not_a_package_script(self) -> None:
+        self.workflow.write_text(
+            "run: pnpm --dir ../../services-base/frontend install --frozen-lockfile\n"
+            "run: pnpm ui:check\n", encoding="utf-8",
+        )
+        verify_docs.check_frontend_ci_scripts({"ui:check": "node validator.mjs"})
+        self.assertEqual(verify_docs.problems, [])
+
+    def test_run_and_directory_options_still_reject_unknown_scripts(self) -> None:
+        self.workflow.write_text("run: pnpm --dir '.' run missing:check\n", encoding="utf-8")
+        verify_docs.check_frontend_ci_scripts({"ui:check": "node validator.mjs"})
+        self.assertTrue(any("missing:check" in problem for problem in verify_docs.problems))
+        self.assertFalse(any("pnpm --dir" in problem for problem in verify_docs.problems))
+
+    def test_directory_script_is_checked_against_its_own_package(self) -> None:
+        target = self.root / "validator-package"
+        target.mkdir()
+        (target / "package.json").write_text('{"scripts":{"own:check":"node check.mjs"}}', encoding="utf-8")
+        self.workflow.write_text("run: pnpm --dir ../validator-package run own:check\n", encoding="utf-8")
+        verify_docs.check_frontend_ci_scripts({})
+        self.assertEqual(verify_docs.problems, [])
+        self.workflow.write_text("run: pnpm --dir ../validator-package run ui:check\n", encoding="utf-8")
+        verify_docs.check_frontend_ci_scripts({"ui:check": "node product-check.mjs"})
+        self.assertTrue(any("ui:check" in problem for problem in verify_docs.problems))
+
+
 if __name__ == "__main__":
     unittest.main()
diff --git a/scripts/verify_docs.py b/scripts/verify_docs.py
index 6a5c5b0..554d3f5 100644
--- a/scripts/verify_docs.py
+++ b/scripts/verify_docs.py
@@ -15,6 +15,7 @@ import argparse
 import hashlib
 import json
 import re
+import shlex
 import struct
 import sys
 from urllib.parse import unquote
@@ -440,13 +441,31 @@ def check_frontend_ci_scripts(scripts: dict) -> None:
     if not workflow.exists():
         fail(".github/workflows/ci.yml missing")
         return
-    commands = set()
-    for match in re.finditer(r"\bpnpm\s+([A-Za-z0-9:_-]+)\b", read_text(workflow)):
-        command = match.group(1)
-        if command not in PNPM_BUILTINS:
-            commands.add(command)
-    for command in sorted(commands):
-        if command not in scripts:
+    pattern = (
+        r"\bpnpm\s+(?:(?:--dir(?:=|\s+)|-C\s+)"
+        r"(?P<directory>\"[^\"]*\"|'[^']*'|\S+)\s+)?"
+        r"(?P<run>run\s+)?(?P<command>[A-Za-z0-9:_-]+)\b"
+    )
+    frontend = (ROOT / "frontend").resolve()
+    for match in re.finditer(pattern, read_text(workflow)):
+        command = match.group("command")
+        if not match.group("run") and command in PNPM_BUILTINS:
+            continue
+        available = scripts
+        directory = match.group("directory")
+        if directory is not None:
+            target = (frontend / shlex.split(directory)[0]).resolve()
+            if target != frontend:
+                package = target / "package.json"
+                if not package.is_file():
+                    fail(f"CI package script target is missing: {directory}")
+                    continue
+                try:
+                    available = json.loads(read_text(package)).get("scripts", {})
+                except (ValueError, AttributeError):
+                    fail(f"CI package script target is invalid: {directory}")
+                    continue
+        if not isinstance(available, dict) or command not in available:
             fail(f"CI references missing frontend package script: pnpm {command}")
 
 
