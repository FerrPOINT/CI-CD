diff --git a/.gitattributes b/.gitattributes
index 856bb85..0d050b8 100644
--- a/.gitattributes
+++ b/.gitattributes
@@ -23,3 +23,5 @@ frontend/** text=auto eol=lf
 *.rs text eol=lf
 Cargo.toml text eol=lf
 Cargo.lock text eol=lf
+# Shell maintenance helpers must execute identically in Windows build contexts and Linux.
+*.sh text eol=lf
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index 365683e..a7a6add 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -41,7 +41,7 @@ jobs:
         working-directory: CI-CD/backend
     services:
       postgres:
-        image: postgres:17-alpine
+        image: postgres:17.6-alpine
         env:
           POSTGRES_USER: forge_owner
           POSTGRES_PASSWORD: forge_test_owner
