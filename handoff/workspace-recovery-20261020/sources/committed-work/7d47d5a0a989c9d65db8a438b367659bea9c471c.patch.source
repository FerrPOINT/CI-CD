diff --git a/frontend/src/pages/pull-request-detail/resource-state.test.tsx b/frontend/src/pages/pull-request-detail/resource-state.test.tsx
new file mode 100644
index 0000000..89cfd72
--- /dev/null
+++ b/frontend/src/pages/pull-request-detail/resource-state.test.tsx
@@ -0,0 +1,100 @@
+import { render, screen } from "@testing-library/react";
+import { MemoryRouter, Route, Routes } from "react-router";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import { ApiError } from "@/api/client";
+import { PullRequestDetailPage } from "./index";
+
+const mocks = vi.hoisted(() => ({ usePullRequest: vi.fn() }));
+
+vi.mock("react-i18next", () => ({
+  useTranslation: () => ({ t: (key: string) => key, i18n: { language: "ru" } }),
+}));
+vi.mock("@/api/hooks", () => ({
+  usePullRequest: mocks.usePullRequest,
+  useRepositoryComparison: () => ({
+    data: undefined,
+    isLoading: false,
+    isError: false,
+  }),
+}));
+
+function renderDetail(number = "1") {
+  return render(
+    <MemoryRouter initialEntries={[`/repositories/synthetic/pulls/${number}`]}>
+      <Routes>
+        <Route
+          path="/repositories/:repo/pulls/:number"
+          element={<PullRequestDetailPage />}
+        />
+      </Routes>
+    </MemoryRouter>,
+  );
+}
+
+beforeEach(() => {
+  vi.clearAllMocks();
+});
+
+describe("pull request resource failures", () => {
+  it.each([
+    [403, "permission-denied"],
+    [404, "not-found"],
+  ] as const)(
+    "renders HTTP %s without pull request actions",
+    (status, state) => {
+      mocks.usePullRequest.mockReturnValue({
+        data: undefined,
+        isLoading: false,
+        error: new ApiError({
+          kind: "api",
+          status,
+          message: "Synthetic unavailable resource",
+        }),
+        refetch: vi.fn(),
+      });
+      const { container } = renderDetail();
+      expect(
+        container.querySelector(`[data-page-state="${state}"]`),
+      ).toBeVisible();
+      expect(screen.queryByText("pulls.actions")).not.toBeInTheDocument();
+      expect(
+        screen.queryByRole("button", { name: "common.retry" }),
+      ).not.toBeInTheDocument();
+    },
+  );
+
+  it("keeps retry for a recoverable service failure", () => {
+    mocks.usePullRequest.mockReturnValue({
+      data: undefined,
+      isLoading: false,
+      error: new ApiError({
+        kind: "api",
+        status: 503,
+        message: "Synthetic unavailable service",
+      }),
+      refetch: vi.fn(),
+    });
+    const { container } = renderDetail();
+    expect(screen.getByRole("alert")).toHaveTextContent(
+      "Synthetic unavailable service",
+    );
+    expect(screen.getByRole("button", { name: "common.retry" })).toBeVisible();
+    expect(container.querySelector("[data-page-state]")).toBeNull();
+    expect(screen.queryByText("pulls.actions")).not.toBeInTheDocument();
+  });
+
+  it("treats an invalid pull request number as not-found", () => {
+    mocks.usePullRequest.mockReturnValue({
+      data: undefined,
+      isLoading: false,
+      error: null,
+      refetch: vi.fn(),
+    });
+    const { container } = renderDetail("invalid");
+    expect(
+      container.querySelector('[data-page-state="not-found"]'),
+    ).toBeVisible();
+    expect(mocks.usePullRequest).toHaveBeenCalledWith("synthetic", undefined);
+    expect(screen.queryByText("pulls.actions")).not.toBeInTheDocument();
+  });
+});
diff --git a/frontend/src/shared/lib/use-project-pipelines.test.tsx b/frontend/src/shared/lib/use-project-pipelines.test.tsx
new file mode 100644
index 0000000..33307bd
--- /dev/null
+++ b/frontend/src/shared/lib/use-project-pipelines.test.tsx
@@ -0,0 +1,55 @@
+import { renderHook } from "@testing-library/react";
+import { useQueries } from "@tanstack/react-query";
+import { describe, expect, it, vi } from "vitest";
+import { ApiError } from "@/api/client";
+import { useProjectPipelines } from "./use-project-pipelines";
+
+vi.mock("@tanstack/react-query", () => ({ useQueries: vi.fn() }));
+
+describe("project pipeline summaries", () => {
+  it.each([403, 404])(
+    "omits cached runs for HTTP %s while retaining allowed projects",
+    (status) => {
+      const allowed = { id: "allowed", project_id: "visible" };
+      const denied = { id: "private", project_id: "hidden" };
+      vi.mocked(useQueries).mockReturnValue([
+        { data: [allowed], isPending: false, error: null, refetch: vi.fn() },
+        {
+          data: [denied],
+          isPending: false,
+          error: new ApiError({
+            kind: "api",
+            status,
+            message: "Synthetic unavailable project",
+          }),
+          refetch: vi.fn(),
+        },
+      ] as unknown as ReturnType<typeof useQueries>);
+      const { result } = renderHook(() => useProjectPipelines([]));
+      expect(result.current.runs).toEqual([allowed]);
+      expect(result.current.hasData).toBe(true);
+      expect(result.current.failedCount).toBe(1);
+    },
+  );
+
+  it("retains a recoverable cached run and exposes its retry", async () => {
+    const refetch = vi.fn();
+    vi.mocked(useQueries).mockReturnValue([
+      {
+        data: [{ id: "cached" }],
+        isPending: false,
+        error: new ApiError({
+          kind: "api",
+          status: 503,
+          message: "Synthetic unavailable service",
+        }),
+        refetch,
+      },
+    ] as unknown as ReturnType<typeof useQueries>);
+    const { result } = renderHook(() => useProjectPipelines([]));
+    expect(result.current.runs).toEqual([{ id: "cached" }]);
+    expect(result.current.hasData).toBe(true);
+    await result.current.refetch();
+    expect(refetch).toHaveBeenCalledOnce();
+  });
+});
diff --git a/frontend/src/shared/lib/use-project-pipelines.ts b/frontend/src/shared/lib/use-project-pipelines.ts
index 0b1bb33..8a8aa14 100644
