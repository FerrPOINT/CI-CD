diff --git a/frontend/AGENTS.md b/frontend/AGENTS.md
index 0adfc50..2f99e28 100644
--- a/frontend/AGENTS.md
+++ b/frontend/AGENTS.md
@@ -5,8 +5,10 @@
   принадлежат продукту; страницы входа Auth не требуют доступности Admin.
 - Описать маршруты, роли, состояния и layout modes в route contract. Приватный
   operational route сохраняет SSO; fixtures используют synthetic данные.
-- Перед коммитом выполнить route/acceptance gates и матрицу viewport, тем,
-  direct/reload, keyboard/focus, geometry, console/network.
+- До source-коммита выполнить route contract и соответствующие unit/build gates.
+  Затем собрать candidate image из committed source SHA и сохранить browser
+  evidence отдельным коммитом. До review readiness обязательны acceptance gates
+  и матрица viewport/тем, direct/reload, keyboard/focus, geometry, console/network.
 - Browser evidence относится к committed source SHA и реальному candidate image.
   После evidence допускаются документационные коммиты, если runtime fingerprints
   не изменились. Secrets и реальные пользовательские данные исключить.
diff --git a/frontend/src/api/client.ts b/frontend/src/api/client.ts
index 3c2e32e..eac70a2 100644
--- a/frontend/src/api/client.ts
+++ b/frontend/src/api/client.ts
@@ -40,6 +40,11 @@ export class ApiError extends Error {
   }
 }
 
+/** A refresh may retain cached data, but denied or deleted resources must hide it. */
+export function isTerminalResourceError(error: unknown): error is ApiError {
+  return error instanceof ApiError && (error.status === 403 || error.status === 404)
+}
+
 type TerminalAuthHandler = () => void
 let terminalAuthHandler: TerminalAuthHandler | null = null
 
