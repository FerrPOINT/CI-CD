+    async fn immutable_sources(&self) -> io::Result<String> {
+        let source = std::env::var("CICD_RUNNER_SHARED_SOURCES_VOLUME").unwrap_or_default();
+        if !source
+            .bytes()
+            .next()
+            .is_some_and(|byte| byte.is_ascii_alphanumeric())
+            || source
+                .bytes()
+                .any(|byte| !(byte.is_ascii_alphanumeric() || b"_.-".contains(&byte)))
+        {
+            return Err(invalid("explicit immutable source volume name is required"));
+        }
+        let volume: Value =
+            serde_json::from_str(&self.run(&["volume", "inspect", &source]).await?)?;
+        source_provenance(
+            &volume,
+            &source,
+            &std::env::var("CICD_RUNNER_BASE_REVISION").unwrap_or_default(),
+            &std::env::var("CICD_RUNNER_WORKSPACE_PROJECT").unwrap_or_default(),
+        )?;
+        Ok(source)
+    }
+
     async fn verify_project(&self, project: &str, manifest: &Value, file: &Path) -> io::Result<()> {
