 #[cfg(test)]
 mod tests {
     use super::*;
+    #[test]
+    fn immutable_source_provenance_rejects_missing_or_foreign_storage() {
+        let revision = "a".repeat(40);
+        let volume = json!([{"Name":"owned-sources","Labels":{
+            "sdlc.base-revision":revision,"sdlc.workspace":"sdlc1"}}]);
+        assert!(source_provenance(&volume, "owned-sources", &revision, "sdlc1").is_ok());
+        for (source, revision, workspace) in [
+            ("other-sources", revision.as_str(), "sdlc1"),
+            ("owned-sources", "invalid-revision", "sdlc1"),
+            ("owned-sources", revision.as_str(), "sdlc2"),
+            ("owned-sources", revision.as_str(), "other"),
+        ] {
+            assert!(source_provenance(&volume, source, revision, workspace).is_err());
+        }
+        assert!(source_provenance(&json!([]), "owned-sources", &revision, "sdlc1").is_err());
+        let mut missing_label = volume.clone();
+        missing_label[0]["Labels"]["sdlc.base-revision"] = Value::Null;
+        assert!(source_provenance(&missing_label, "owned-sources", &revision, "sdlc1").is_err());
+    }
+
