diff --git a/frontend/e2e/base-standard-source.spec.ts b/frontend/e2e/base-standard-source.spec.ts
new file mode 100644
index 0000000..160df10
--- /dev/null
+++ b/frontend/e2e/base-standard-source.spec.ts
@@ -0,0 +1,348 @@
+import { generateKeyPairSync, sign } from 'node:crypto'
+import { mkdirSync, writeFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import AxeBuilder from '@axe-core/playwright'
+import { expect, test, type Page, type Route } from '@playwright/test'
+
+const evidence =
+  process.env.SDLC_CICD_SOURCE_EVIDENCE_DIR ??
+  fileURLToPath(new URL('../test-results/source-ui/evidence/', import.meta.url))
+const widths = [375, 767, 768, 1023, 1024, 1279, 1280, 1440, 1920, 2560]
+const actor = 'Участник-аудита-длинное-безопасное-имя-для-проверки-переносов@example.test'
+function json(route: Route, body: unknown, status = 200) {
+  return route.fulfill({ status, contentType: 'application/json', body: JSON.stringify(body) })
+}
+
+async function mocks(page: Page) {
+  const { privateKey, publicKey } = generateKeyPairSync('ec', { namedCurve: 'P-256' })
+  const jwk = { ...publicKey.export({ format: 'jwk' }), kid: 'source-qa', alg: 'ES256', use: 'sig' }
+  let issuer = 'http://localhost:7701'
+  let nonce = ''
+  await page.route('**/oidc/authorize**', async (route) => {
+    const url = new URL(route.request().url())
+    issuer = url.origin
+    nonce = url.searchParams.get('nonce') ?? ''
+    const callback = new URL(url.searchParams.get('redirect_uri')!)
+    callback.searchParams.set('code', 'source-qa-code')
+    callback.searchParams.set('state', url.searchParams.get('state') ?? '')
+    await route.fulfill({ status: 302, headers: { location: callback.toString() }, body: '' })
+  })
+  await page.route('**/oidc/token', async (route) => {
+    const header = Buffer.from(
+      JSON.stringify({ alg: 'ES256', typ: 'JWT', kid: 'source-qa' }),
+    ).toString('base64url')
+    const payload = Buffer.from(
+      JSON.stringify({
+        iss: issuer,
+        aud: 'ci-cd',
+        sub: '00000000-0000-0000-0000-000000000001',
+        name: actor,
+        email: 'safe-source-qa@example.test',
+        nonce,
+        iat: Math.floor(Date.now() / 1000),
+        exp: Math.floor(Date.now() / 1000) + 3600,
+      }),
+    ).toString('base64url')
+    const content = `${header}.${payload}`
+    const signature = sign('sha256', Buffer.from(content), {
+      key: privateKey,
+      dsaEncoding: 'ieee-p1363',
+    }).toString('base64url')
+    return json(route, {
+      access_token: 'source-qa-token',
+      id_token: `${content}.${signature}`,
+      expires_in: 3600,
+    })
+  })
+  await page.route('**/oidc/jwks', (route) => json(route, { keys: [jwk] }))
+  const audit = {
+    status: 200,
+    empty: false,
+    wait: undefined as Promise<void> | undefined,
+    offsets: [] as number[],
+    unexpected: [] as string[],
+  }
+  await page.route('**/api/v1/**', async (route) => {
+    const url = new URL(route.request().url())
+    if (url.pathname === '/api/v1/runners') return json(route, [])
+    if (url.pathname !== '/api/v1/audit-log/page') {
+      audit.unexpected.push(`${route.request().method()} ${url.pathname}`)
+      return json(route, { error: { message: 'Unexpected source fixture endpoint' } }, 500)
+    }
+    if (audit.wait) await audit.wait
+    if (audit.status === 0) return route.abort('failed')
+    if (audit.status !== 200)
+      return json(
+        route,
+        { error: { code: 'controlled', message: 'PRIVATE DIAGNOSTIC ENVELOPE' } },
+        audit.status,
+      )
+    const offset = Number(url.searchParams.get('offset') ?? 0)
+    audit.offsets.push(offset)
+    const q = url.searchParams.get('q') ?? ''
+    const total = audit.empty || q === 'missing' ? 0 : 45
+    const items = Array.from({ length: Math.min(20, Math.max(0, total - offset)) }, (_, index) => ({
+      id: offset + index + 1,
+      action: url.searchParams.get('action') || 'auth.login_success',
+      actor,
+      resource_type: 'user',
+      resource_id: '00000000-0000-0000-0000-000000000001',
+      created_at: '2026-10-01T12:00:00Z',
+    }))
+    return json(route, {
+      items,
+      total,
+      limit: 20,
+      offset,
+      actions: ['auth.login_success', 'auth.login_failed'],
+    })
+  })
+  return audit
+}
+
+async function ready(page: Page, path = '/audit-log') {
+  await page.goto(path)
+  await expect(page.locator('[data-base-shell]')).toBeVisible()
+  await expect(
+    page.getByRole('heading', { level: 1, name: 'Журнал аудита', exact: true }),
+  ).toBeVisible()
+}
+
+test('shared shell and audit geometry across themes and breakpoint boundaries', async ({
+  page,
+}) => {
+  test.setTimeout(240_000)
+  mkdirSync(evidence, { recursive: true })
+  const audit = await mocks(page)
+  const failures: string[] = []
+  page.on('pageerror', (error) => failures.push(error.message))
+  page.on('console', (message) => {
+    if (message.type() === 'error') failures.push(message.text())
+  })
+  page.on('requestfailed', (request) => {
+    if (!request.failure()?.errorText.includes('ERR_ABORTED')) failures.push(request.url())
+  })
+  page.on('response', (response) => {
+    if (response.status() >= 400) failures.push(`${response.status()} ${response.url()}`)
+  })
+  const observations: unknown[] = []
+  for (const theme of ['light', 'gray', 'dark']) {
+    await page.addInitScript((value) => localStorage.setItem('theme', value), theme)
+    await ready(page)
+    await expect(page.getByRole('searchbox')).toBeEnabled()
+    for (const width of widths) {
+      await page.setViewportSize({ width, height: width >= 1440 ? 1080 : 812 })
+      await expect(page.locator('html')).toHaveAttribute('data-theme', theme)
+      const geometry = await page.evaluate(() => {
+        const header = document.querySelector('[data-platform-header]')!.getBoundingClientRect()
+        const sidebar = document.querySelector('.base-shell-sidebar')!.getBoundingClientRect()
+        const frame = document.querySelector('[data-page-layout]')!.getBoundingClientRect()
+        const title = document.querySelector('h1')!.getBoundingClientRect()
+        const controls = [
+          ...document.querySelectorAll<HTMLElement>(
+            'main button,main input,main select,[data-platform-header] button,[data-platform-header] a',
+          ),
+        ]
+          .filter(
+            (element) =>
+              element.getClientRects().length && getComputedStyle(element).visibility !== 'hidden',
+          )
+          .map((element) => {
+            const rect = element.getBoundingClientRect()
+            return { width: rect.width, height: rect.height, x: rect.x, right: rect.right }
+          })
+        return {
+          header: { x: header.x, right: header.right, height: header.height },
+          sidebar: { width: sidebar.width, y: sidebar.y },
+          frame: { x: frame.x, right: frame.right },
+          title: { x: title.x, right: title.right },
+          controls,
+          overflow: document.documentElement.scrollWidth - document.documentElement.clientWidth,
+        }
+      })
+      expect(geometry.overflow).toBeLessThanOrEqual(1)
+      expect(geometry.header).toEqual({ x: 0, right: width, height: 60 })
+      const sidebarWidth = width < 768 ? 0 : width < 1280 ? 72 : 264
+      if (sidebarWidth) expect(geometry.sidebar).toEqual({ width: sidebarWidth, y: 60 })
+      const gutter = Math.min(32, Math.max(16, width * 0.02))
+      expect(geometry.frame.x).toBeCloseTo(sidebarWidth + gutter, 0)
+      expect(geometry.frame.right).toBeCloseTo(width - gutter, 0)
+      expect(geometry.title.x).toBeGreaterThanOrEqual(geometry.frame.x)
+      expect(geometry.title.right).toBeLessThanOrEqual(geometry.frame.right)
+      for (const control of geometry.controls) {
+        expect(control.height).toBeGreaterThanOrEqual(width < 768 ? 44 : 40)
+        expect(control.width).toBeGreaterThanOrEqual(width < 768 ? 44 : 40)
+        expect(control.x).toBeGreaterThanOrEqual(0)
+        expect(control.right).toBeLessThanOrEqual(width)
+      }
+      if ([375, 1920].includes(width)) {
+        const axe = await new AxeBuilder({ page }).include('[data-base-shell]').analyze()
+        expect(
+          axe.violations.filter((item) => item.impact === 'serious' || item.impact === 'critical'),
+        ).toEqual([])
+      }
+      await page.screenshot({
+        path: `${evidence}/audit-${theme}-${width}.png`,
+        fullPage: true,
+        animations: 'disabled',
+      })
+      observations.push({ theme, width, geometry })
+    }
+  }
+  expect(audit.unexpected).toEqual([])
+  expect(failures).toEqual([])
+  writeFileSync(
+    `${evidence}/geometry.json`,
+    JSON.stringify(
+      { scope: 'mocked HTTP/OIDC source QA, not actual-image acceptance', observations },
+      null,
+      2,
+    ),
+  )
+})
+
+test('URL context survives SSO, filters, paging, reload and Back/Forward', async ({ page }) => {
+  await mocks(page)
+  await ready(page, '/audit-log?page=2&context=keep#history')
+  await expect(page.getByRole('searchbox')).toBeEnabled()
+  await expect(page).toHaveURL(/page=2&context=keep#history$/)
+  await page.getByRole('searchbox').fill('participant')
+  await page.getByRole('button', { name: 'Найти', exact: true }).click()
+  await expect(page).toHaveURL(/context=keep&q=participant#history$/)
+  await expect(page.getByRole('searchbox')).toBeEnabled()
+  await page.getByRole('combobox').selectOption('auth.login_failed')
+  await expect(page).toHaveURL(/q=participant&action=auth.login_failed#history$/)
+  await expect(page.getByRole('button', { name: 'Далее', exact: true })).toBeEnabled()
+  await page.getByRole('button', { name: 'Далее', exact: true }).click()
+  await expect(page).toHaveURL(/action=auth.login_failed&page=2#history$/)
+  await page.reload()
+  await expect(page.getByRole('searchbox')).toHaveValue('participant')
+  await expect(page.getByRole('combobox')).toHaveValue('auth.login_failed')
+  await expect(page.getByRole('searchbox')).toBeEnabled()
+  await page.getByRole('button', { name: 'Очистить поиск', exact: true }).click()
+  await expect(page).toHaveURL(/context=keep&action=auth.login_failed#history$/)
+  await page.goBack()
+  await expect(page.getByRole('searchbox')).toHaveValue('participant')
+  await page.goForward()
+  await expect(page.getByRole('searchbox')).toHaveValue('')
+})
+
+test('mobile drawer traps keyboard focus, closes on Escape and resize, and returns focus safely', async ({
+  page,
+}) => {
+  await mocks(page)
+  await page.setViewportSize({ width: 375, height: 812 })
+  await ready(page)
+  const trigger = page.getByRole('button', { name: 'Открыть навигацию', exact: true })
+  await trigger.focus()
+  await page.keyboard.press('Enter')
+  const dialog = page.getByRole('dialog')
+  await expect(dialog).toBeVisible()
+  await page.keyboard.press('Tab')
+  expect(await dialog.evaluate((element) => element.contains(document.activeElement))).toBe(true)
+  await page.keyboard.press('Escape')
+  await expect(dialog).toBeHidden()
+  await expect(trigger).toBeFocused()
+  await trigger.click()
+  await page.setViewportSize({ width: 1280, height: 812 })
+  await expect(dialog).toBeHidden()
+  await expect(page.locator('main')).toBeFocused()
+  expect(
+    await page.locator('body').evaluate((element) => getComputedStyle(element).pointerEvents),
+  ).not.toBe('none')
+})
+
+for (const status of [0, 403, 404, 422, 503])
+  test(`cached HTTP ${status} uses the correct shared state and retry policy`, async ({ page }) => {
+    mkdirSync(evidence, { recursive: true })
+    const audit = await mocks(page)
+    await ready(page)
+    await expect(page.getByRole('searchbox')).toBeEnabled()
+    await page.getByRole('link', { name: 'Раннеры', exact: true }).click()
+    await expect(
+      page.getByRole('heading', { level: 1, name: 'Раннеры', exact: true }),
+    ).toBeVisible()
+    audit.status = status
+    await page.goBack()
+    const main = page.locator('main')
+    if (status === 0 || status === 503) {
+      await expect(main.locator('[data-page-state="partial-error"]')).toBeVisible()
+      await expect(main.getByRole('cell').filter({ hasText: actor }).first()).toBeVisible()
+      await expect(main.getByRole('searchbox')).toBeDisabled()
+      for (const width of [375, 1920]) {
+        await page.setViewportSize({ width, height: width === 1920 ? 1080 : 812 })
+        expect(
+          await page.evaluate(
+            () => document.documentElement.scrollWidth - document.documentElement.clientWidth,
+          ),
+        ).toBeLessThanOrEqual(1)
+        const axe = await new AxeBuilder({ page }).include('main').analyze()
+        expect(
+          axe.violations.filter((item) => item.impact === 'serious' || item.impact === 'critical'),
+        ).toEqual([])
+        await page.screenshot({
+          path: `${evidence}/audit-cached-${status}-${width}.png`,
+          fullPage: true,
+        })
+      }
+      audit.status = 200
+      await main.getByRole('button', { name: 'Повторить', exact: true }).click()
+      await expect(main.locator('[data-page-state="partial-error"]')).toHaveCount(0)
+      await expect(main.getByRole('searchbox')).toBeEnabled()
+    } else {
+      const marker = status === 403 ? 'permission-denied' : status === 404 ? 'not-found' : undefined
+      if (marker) await expect(main.locator(`[data-page-state="${marker}"]`)).toBeVisible()
+      else await expect(main.getByRole('alert')).toBeVisible()
+      await expect(main.getByText(actor, { exact: true })).toHaveCount(0)
+      await expect(main.getByRole('button', { name: 'Повторить', exact: true })).toHaveCount(0)
+      if (marker) await expect(main.getByRole('searchbox')).toHaveCount(0)
+      await expect(main).not.toContainText('Показаны ранее загруженные данные.')
+    }
+    await expect(main).not.toContainText('PRIVATE DIAGNOSTIC')
+    if (status !== 0 && status !== 503)
+      await page.screenshot({ path: `${evidence}/audit-cached-${status}.png`, fullPage: true })
+  })
+
+test('loading and empty states are not interchangeable and empty search remains recoverable', async ({
+  page,
+}) => {
+  mkdirSync(evidence, { recursive: true })
+  const audit = await mocks(page)
+  let release!: () => void
+  audit.wait = new Promise<void>((resolve) => {
+    release = resolve
+  })
+  try {
+    await ready(page)
+    await expect(page.locator('main').getByRole('status', { name: 'Загрузка' })).toBeVisible()
+    await expect(page.locator('main')).not.toContainText('События аудита отсутствуют.')
+    await page.screenshot({ path: `${evidence}/audit-loading.png`, fullPage: true })
+  } finally {
+    audit.wait = undefined
+    release()
+  }
+  await expect(page.getByRole('searchbox')).toBeEnabled()
+  await page.getByRole('searchbox').fill('missing')
+  await page.getByRole('button', { name: 'Найти', exact: true }).click()
+  await expect(page.locator('main').getByRole('status')).toHaveText(
+    'По заданным условиям события не найдены.',
+  )
+  await expect(page.getByRole('searchbox')).toBeEnabled()
+  await page.getByRole('button', { name: 'Очистить поиск', exact: true }).click()
+  await expect(page.getByRole('button', { name: 'Далее', exact: true })).toBeEnabled()
+})
+
+test('unknown addresses keep the shell and URL instead of silently redirecting to dashboard', async ({
+  page,
+}) => {
+  mkdirSync(evidence, { recursive: true })
+  await mocks(page)
+  await page.goto('/missing-section?context=keep#history')
+  await expect(page.locator('[data-base-shell]')).toBeVisible()
+  await expect(page.locator('main [data-page-state="not-found"]')).toBeVisible()
+  await expect(page).toHaveURL(/missing-section\?context=keep#history$/)
+  await expect(
+    page.locator('main').getByRole('button', { name: 'Повторить', exact: true }),
+  ).toHaveCount(0)
+  await page.screenshot({ path: `${evidence}/unknown-route.png`, fullPage: true })
+})
