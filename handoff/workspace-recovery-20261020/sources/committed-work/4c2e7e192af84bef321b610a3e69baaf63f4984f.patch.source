+++ b/frontend/playwright.source-ui.config.ts
@@ -0,0 +1,27 @@
+import { defineConfig, devices } from '@playwright/test'
+
+const baseURL = 'http://127.0.0.1:18866'
+
+export default defineConfig({
+  testDir: './e2e',
+  testMatch: 'base-standard-source.spec.ts',
+  timeout: 90_000,
+  expect: { timeout: 15_000 },
+  workers: 1,
+  fullyParallel: false,
+  reporter: [['list']],
+  outputDir: 'test-results/source-ui',
+  use: { baseURL, locale: 'ru-RU', trace: 'retain-on-failure', screenshot: 'only-on-failure' },
+  projects: [
+    {
+      name: 'chromium',
+      use: { ...devices['Desktop Chrome'], viewport: { width: 1920, height: 1080 } },
+    },
+  ],
+  webServer: {
+    command: 'pnpm exec vite preview --host 127.0.0.1 --port 18866 --strictPort',
+    url: baseURL,
+    reuseExistingServer: false,
+    timeout: 30_000,
+  },
+})
