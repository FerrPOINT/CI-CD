+              <Button
+                type="button"
+                variant="outline"
+                size="icon"
+                aria-label={t('auditLog.previous')}
+                title={t('auditLog.previous')}
+                disabled={page === 1 || filtersDisabled}
+                onClick={() => changeQuery({ page: pageCodec.format(page - 1) })}
+              >
+                <ChevronLeft className="h-4 w-4" aria-hidden />
+              </Button>
+              <span className="min-w-16 text-center text-sm tabular-nums text-text-muted">
+                {page} / {pageCount}
