+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { MemoryRouter, useLocation, useNavigate } from 'react-router'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { AuditLogPage as AuditResult } from '@/api/types'
+import { ApiError } from '@/api/client'
+import { useAuditLog } from '@/api/hooks'
+import { AuditLogPage } from './index'
+
+const state = vi.hoisted(() => ({
+  data: undefined as AuditResult | undefined,
+  error: null as Error | null,
+  isLoading: false,
+  isFetching: false,
+  isPlaceholderData: false,
+  refetch: vi.fn(),
+}))
+vi.mock('@/api/hooks', () => ({ useAuditLog: vi.fn(() => state) }))
+vi.mock('react-i18next', () => ({
+  useTranslation: () => ({
+    t: (key: string, options?: { defaultValue?: string }) => options?.defaultValue ?? key,
+    i18n: { language: 'ru' },
+  }),
+}))
+
+function HistoryProbe() {
+  const location = useLocation()
+  const navigate = useNavigate()
+  return (
+    <>
+      <output data-testid="location">{location.pathname + location.search + location.hash}</output>
+      <button onClick={() => void navigate(-1)}>Back</button>
+      <button onClick={() => void navigate(1)}>Forward</button>
+    </>
+  )
+}
+function mount(path = '/audit-log') {
+  return render(
+    <MemoryRouter initialEntries={[path]}>
+      <AuditLogPage />
+      <HistoryProbe />
+    </MemoryRouter>,
+  )
+}
+function fixture(total = 60, offset = 0): AuditResult {
+  return {
+    total,
+    offset,
+    limit: 20,
+    actions: ['project.create', 'pipeline.trigger'],
+    items: total
+      ? [
+          {
+            id: 1,
+            action: 'project.create',
+            actor: 'Audit participant',
+            resource_type: 'project',
+            resource_id: '00000000-0000-0000-0000-000000000001',
+            created_at: '2026-10-01T12:00:00Z',
+          },
+        ]
+      : [],
+  }
+}
+beforeEach(() => {
+  Object.assign(state, {
+    data: fixture(),
+    error: null,
+    isLoading: false,
+    isFetching: false,
+    isPlaceholderData: false,
+  })
+  state.refetch.mockReset()
+  vi.mocked(useAuditLog).mockClear()
+})
+afterEach(cleanup)
+
+describe('Base audit composition', () => {
+  it('renders one Base header and native filter controls without decorative cards', () => {
+    const { container } = mount()
+    expect(screen.getAllByRole('heading', { level: 1 })).toHaveLength(1)
+    expect(container.querySelector('.base-page-stack .base-page-header')).toBeTruthy()
+    expect(screen.getByRole('combobox', { name: 'auditLog.actionFilter' })).toHaveClass(
+      'base-control',
+    )
+  })
+  it('preserves unknown parameters and hash through filters, paging and Back/Forward', async () => {
+    state.data = fixture(60, 20)
+    mount('/audit-log?page=2&context=project#history')
+    fireEvent.change(screen.getByRole('searchbox'), { target: { value: ' pipeline ' } })
+    fireEvent.submit(screen.getByRole('search'))
+    await waitFor(() =>
+      expect(screen.getByTestId('location')).toHaveTextContent(
+        '/audit-log?context=project&q=pipeline#history',
+      ),
+    )
+    fireEvent.click(screen.getByRole('button', { name: 'Back' }))
+    await waitFor(() =>
+      expect(screen.getByTestId('location')).toHaveTextContent(
+        '/audit-log?page=2&context=project#history',
+      ),
+    )
+    expect(screen.getByRole('searchbox')).toHaveValue('')
+    fireEvent.click(screen.getByRole('button', { name: 'Forward' }))
+    await waitFor(() => expect(screen.getByRole('searchbox')).toHaveValue('pipeline'))
+    fireEvent.change(screen.getByRole('combobox'), { target: { value: 'project.create' } })
+    await waitFor(() =>
+      expect(screen.getByTestId('location')).toHaveTextContent(
+        'context=project&q=pipeline&action=project.create#history',
+      ),
+    )
+    fireEvent.click(screen.getByRole('button', { name: 'auditLog.next' }))
+    await waitFor(() =>
+      expect(screen.getByTestId('location')).toHaveTextContent(
+        'action=project.create&page=2#history',
+      ),
+    )
+    expect(useAuditLog).toHaveBeenLastCalledWith({
+      limit: 20,
+      offset: 20,
+      action: 'project.create',
+      q: 'pipeline',
+    })
+  })
+  it('clears search with a Base icon target and resets pagination without losing context', async () => {
+    mount('/audit-log?page=2&q=test&context=keep#history')
+    fireEvent.click(screen.getByRole('button', { name: 'auditLog.clearSearch' }))
+    await waitFor(() =>
+      expect(screen.getByTestId('location')).toHaveTextContent('/audit-log?context=keep#history'),
+    )
+    expect(screen.getByRole('searchbox')).toHaveValue('')
+  })
+  it.each(['0', '-1', '1.5', 'Infinity', '9007199254740992', '107374184', 'abc'])(
+    'normalizes unsafe page %s before requesting an invalid offset',
+    async (page) => {
+      mount(`/audit-log?page=${page}&context=keep#history`)
+      await waitFor(() =>
+        expect(screen.getByTestId('location')).toHaveTextContent('/audit-log?context=keep#history'),
+      )
+      expect(vi.mocked(useAuditLog).mock.calls.every(([filter]) => filter?.offset === 0)).toBe(true)
+    },
+  )
+  it('permits the maximum documented offset page without resetting it after failed refresh', () => {
+    state.data = fixture(20)
+    state.error = new ApiError({ kind: 'api', status: 503, message: 'technical' })
+    mount('/audit-log?page=107374183#history')
+    expect(useAuditLog).toHaveBeenLastCalledWith({
+      limit: 20,
+      offset: 2147483640,
+      action: undefined,
+      q: undefined,
+    })
+    expect(screen.getByTestId('location')).toHaveTextContent('page=107374183#history')
+  })
+  it('clamps a removed page only after a successful settled read', async () => {
+    state.data = fixture(21, 40)
+    mount('/audit-log?page=3&context=keep#history')
+    await waitFor(() =>
+      expect(screen.getByTestId('location')).toHaveTextContent(
+        '/audit-log?page=2&context=keep#history',
+      ),
+    )
+  })
+  it('keeps filters available on a genuinely empty audit log', () => {
+    state.data = fixture(0)
+    mount()
+    expect(screen.getByText('auditLog.empty')).toBeInTheDocument()
+    expect(screen.getByRole('searchbox')).toBeEnabled()
+    expect(screen.queryByText('Audit participant')).toBeNull()
+  })
+  it('distinguishes empty search results and retains an unknown action from a deep link', () => {
+    state.data = fixture(0)
+    mount('/audit-log?action=custom.action&q=missing')
+    expect(screen.getByText('auditLog.noMatches')).toBeInTheDocument()
+    expect(screen.getByRole('combobox')).toHaveValue('custom.action')
+    expect(screen.getByRole('searchbox')).toHaveValue('missing')
+  })
+  it('does not present previous-filter placeholder rows as results of a new search', () => {
+    state.isPlaceholderData = true
+    state.isFetching = true
+    mount('/audit-log?q=new')
+    expect(screen.getByRole('status', { name: 'common.loading' })).toBeInTheDocument()
+    expect(screen.queryByText('Audit participant')).toBeNull()
+    expect(screen.getByRole('searchbox')).toBeDisabled()
+  })
+  it.each([403, 404, 422])('hides cached data and retry on non-repeatable HTTP %s', (status) => {
+    state.error = new ApiError({ kind: 'api', status, message: 'PRIVATE technical envelope' })
+    mount()
+    expect(screen.queryByText('Audit participant')).toBeNull()
+    expect(screen.queryByRole('button', { name: 'common.retry' })).toBeNull()
+    expect(screen.queryByText(/PRIVATE/)).toBeNull()
+      expect(screen.queryByText('auditLog.refreshFailed')).toBeNull()
+    if (status === 403 || status === 404) expect(screen.queryByRole('searchbox')).toBeNull()
+  })
+  it.each([0, 408, 429, 503])(
+    'retains readonly cached rows and retry after HTTP/transport %s',
+    (status) => {
+      state.error = new ApiError({
+        kind: status === 0 ? 'network' : 'api',
+        status,
+        message: 'technical',
+      })
+      const { container } = mount('/audit-log?page=2#history')
+      expect(container.querySelector('[data-page-state="partial-error"]')).toBeTruthy()
+      expect(screen.getAllByText('Audit participant')).toHaveLength(2)
+      expect(screen.getByRole('searchbox')).toBeDisabled()
+      expect(screen.getByRole('button', { name: 'auditLog.next' })).toBeDisabled()
+      fireEvent.click(screen.getByRole('button', { name: 'common.retry' }))
+      expect(state.refetch).toHaveBeenCalledOnce()
+      expect(screen.getByTestId('location')).toHaveTextContent('page=2#history')
+    },
+  )
+  it('does not misrepresent a cold network error as an empty log', () => {
+    state.data = undefined
+    state.error = new ApiError({ kind: 'network', message: 'technical' })
+    mount()
+    expect(screen.getByRole('alert')).toHaveTextContent('auditLog.loadFailed')
+    expect(screen.queryByText('auditLog.empty')).toBeNull()
+    expect(screen.getByRole('button', { name: 'common.retry' })).toBeInTheDocument()
+  })
+})
