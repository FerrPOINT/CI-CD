+              <Button
+                type="button"
+                variant="outline"
+                size="icon"
+                aria-label={t('auditLog.next')}
+                title={t('auditLog.next')}
+                disabled={page >= pageCount || filtersDisabled}
+                onClick={() => changeQuery({ page: pageCodec.format(page + 1) })}
+              >
+                <ChevronRight className="h-4 w-4" aria-hidden />
+              </Button>
+            </nav>
+          )}
+        </section>
+      )}
+    </AuditLogView>
   )
 }
