diff --git a/frontend/src/shared/auth/protected-route.test.tsx b/frontend/src/shared/auth/protected-route.test.tsx
new file mode 100644
index 0000000..9a80da6
--- /dev/null
+++ b/frontend/src/shared/auth/protected-route.test.tsx
@@ -0,0 +1,48 @@
+import { cleanup, render, screen } from '@testing-library/react'
+import { MemoryRouter, Route, Routes, useLocation } from 'react-router'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { ProtectedRoute } from './protected-route'
+
+const auth = vi.hoisted(() => ({ status: 'anonymous' }))
+vi.mock('./auth-provider', () => ({ useAuth: () => auth }))
+vi.mock('react-i18next', () => ({ useTranslation: () => ({ t: (key: string) => key }) }))
+afterEach(cleanup)
+
+function LoginState() {
+  const location = useLocation()
+  return <output>{location.state?.from}</output>
+}
+function mount() {
+  return render(
+    <MemoryRouter initialEntries={['/audit-log?q=project&page=2#history']}>
+      <Routes>
+        <Route element={<ProtectedRoute />}>
+          <Route path="/audit-log" element={<p>Audit</p>} />
+        </Route>
+        <Route path="/login" element={<LoginState />} />
+      </Routes>
+    </MemoryRouter>,
+  )
+}
+describe('ProtectedRoute', () => {
+  it('preserves the full deep link through authentication', () => {
+    auth.status = 'anonymous'
+    mount()
+    expect(screen.getByRole('status')).toHaveTextContent('/audit-log?q=project&page=2#history')
+    expect(screen.queryByText('Audit')).toBeNull()
+  })
+  it('uses Base loading while session restoration is unresolved', () => {
+    auth.status = 'checking'
+    mount()
+    expect(screen.getByRole('status', { name: 'common.loading' })).toHaveAttribute(
+      'aria-busy',
+      'true',
+    )
+    expect(screen.queryByText('Audit')).toBeNull()
+  })
+  it('shows the protected outlet only after authentication', () => {
+    auth.status = 'authenticated'
+    mount()
+    expect(screen.getByText('Audit')).toBeInTheDocument()
+  })
+})
diff --git a/frontend/src/shared/auth/protected-route.tsx b/frontend/src/shared/auth/protected-route.tsx
index 9bf7cf8..049c0db 100644
--- a/frontend/src/shared/auth/protected-route.tsx
+++ b/frontend/src/shared/auth/protected-route.tsx
@@ -2,16 +2,23 @@
 
 import { Navigate, Outlet, useLocation } from 'react-router'
 import { useAuth } from './auth-provider'
+import { LoadingState } from '@sdlc/ui/ui'
 
 export function ProtectedRoute() {
   const { status } = useAuth()
   const location = useLocation()
 
   if (status === 'checking') {
-    return <div className="flex min-h-screen items-center justify-center text-sm text-text-muted">…</div>
+    return <LoadingState />
   }
   if (status === 'authenticated') {
     return <Outlet />
   }
-  return <Navigate to="/login" replace state={{ from: location.pathname + location.search }} />
+  return (
+    <Navigate
+      to="/login"
+      replace
+      state={{ from: location.pathname + location.search + location.hash }}
+    />
+  )
 }
