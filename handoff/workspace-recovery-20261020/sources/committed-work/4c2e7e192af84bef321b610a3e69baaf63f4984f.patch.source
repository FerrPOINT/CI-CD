+
+  it.each([403, 404, 422])('does not expose cached children or retry after HTTP %s', (status) => {
+    render(
+      <QueryState
+        data={['Private cached data']}
+        isLoading={false}
+        error={new ApiError({ kind: 'api', status, message: 'Technical error' })}
+        onRetry={vi.fn()}
+      >
+        {(items) => <p>{items[0]}</p>}
