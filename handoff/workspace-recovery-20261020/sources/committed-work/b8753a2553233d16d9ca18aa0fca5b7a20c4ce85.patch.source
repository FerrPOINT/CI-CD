+#[tokio::test]
+async fn readiness_does_not_wait_for_a_business_pool_timeout() {
+    let pool = test_pool().await;
+    let bounded = PgPoolOptions::new()
+        .max_connections(1)
+        .acquire_timeout(std::time::Duration::from_secs(30))
+        .connect_with(pool.connect_options().as_ref().clone())
+        .await
+        .unwrap();
+    let held = bounded.acquire().await.unwrap();
+    let start = std::time::Instant::now();
+    let response = tokio::time::timeout(
+        std::time::Duration::from_secs(5),
+        cicd::api::app(Some(bounded.clone())).oneshot(
+            Request::get("/api/v1/readiness")
+                .body(Body::empty())
+                .unwrap(),
+        ),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert_eq!(response.status(), StatusCode::SERVICE_UNAVAILABLE);
+    assert!(start.elapsed() < std::time::Duration::from_secs(4));
+    Uuid::parse_str(response.headers()["x-request-id"].to_str().unwrap()).unwrap();
+    assert_eq!(response_json(response).await["database"], "unavailable");
+    drop(held);
+    bounded.close().await;
+}
+
