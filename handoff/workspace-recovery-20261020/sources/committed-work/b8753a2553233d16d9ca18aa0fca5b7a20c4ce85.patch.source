 mod tests {
     use super::*;
     #[test]
+    fn cleanup_refuses_undeclared_services_and_foreign_resource_owners() {
+        let owner = json!({"sdlc.task":"job-example", "sdlc.job":"example", "sdlc.attempt":"attempt", "sdlc.purpose":"cicd-job"});
+        let manifest = json!({"x-sdlc-ownership-version":2,
+            "services":{"transfer":{"labels":owner}, "job":{"labels":owner}},
+            "volumes":{"workspace":{"labels":owner}}, "networks":{"job":{"labels":owner}}});
+        for (section, field, logical) in [
+            ("services", "com.docker.compose.service", "job"),
+            ("volumes", "com.docker.compose.volume", "workspace"),
+            ("networks", "com.docker.compose.network", "job"),
+        ] {
+            let mut labels = owner.clone();
+            labels["com.docker.compose.project"] = json!("owned");
+            labels[field] = json!(logical);
+            assert!(verify_resource_labels("owned", section, &labels, &manifest).is_ok());
+            labels["sdlc.purpose"] = json!("another-task");
+            assert!(verify_resource_labels("owned", section, &labels, &manifest).is_err());
+            labels["sdlc.purpose"] = json!("cicd-job");
+            labels[field] = json!("unlisted");
+            assert!(verify_resource_labels("owned", section, &labels, &manifest).is_err());
+            labels[field] = json!(logical);
+            labels["com.docker.compose.project"] = json!("foreign");
+            assert!(verify_resource_labels("owned", section, &labels, &manifest).is_err());
+        }
+    }
+    #[test]
+    fn legacy_journals_accept_unlabelled_owned_storage_but_never_another_owner() {
+        let mut manifest = json!({"services":{"transfer":{"labels":{"sdlc.task":"original"}}},
+            "volumes":{"workspace":{}}});
+        let mut labels =
+            json!({"com.docker.compose.project":"owned","com.docker.compose.volume":"workspace"});
+        assert!(verify_resource_labels("owned", "volumes", &labels, &manifest).is_ok());
+        labels["sdlc.task"] = json!("another-task");
+        assert!(verify_resource_labels("owned", "volumes", &labels, &manifest).is_err());
+        labels.as_object_mut().unwrap().remove("sdlc.task");
+        manifest["x-sdlc-ownership-version"] = json!(2);
+        assert!(verify_resource_labels("owned", "volumes", &labels, &manifest).is_err());
+    }
+    #[test]
     fn recovery_distinguishes_dead_process_and_current_owner() {
         #[cfg(target_os = "linux")]
         assert!(owner_alive(&process_owner()));
