diff --git a/backend/src/runner_docker.rs b/backend/src/runner_docker.rs
index 9117cd2..cfca336 100644
--- a/backend/src/runner_docker.rs
+++ b/backend/src/runner_docker.rs
@@ -107,6 +107,92 @@ impl Client {
         self.run(&["image", "inspect", image, "--format", "{{.Id}}"])
             .await
     }
+    async fn verify_project(&self, project: &str, manifest: &Value, file: &Path) -> io::Result<()> {
+        let filter = format!("label=com.docker.compose.project={project}");
+        let ids = self.run(&["ps", "-aq", "--filter", &filter]).await?;
+        for id in ids.lines() {
+            let inspected: Value = serde_json::from_str(&self.run(&["inspect", id]).await?)?;
+            let labels = &inspected[0]["Config"]["Labels"];
+            verify_resource_labels(project, "services", labels, manifest)?;
+            if labels["com.docker.compose.project.config_files"] != file.to_string_lossy().as_ref()
+            {
+                return Err(invalid("foreign Compose manifest blocks job cleanup"));
+            }
+        }
+        for (kind, section, field) in [
+            ("volume", "volumes", "{{.Name}}"),
+            ("network", "networks", "{{.ID}}"),
+        ] {
+            let ids = self
+                .run(&[kind, "ls", "--filter", &filter, "--format", field])
+                .await?;
+            for id in ids.lines() {
+                let inspected: Value =
+                    serde_json::from_str(&self.run(&[kind, "inspect", id]).await?)?;
+                verify_resource_labels(project, section, &inspected[0]["Labels"], manifest)?;
+            }
+        }
+        Ok(())
+    }
+}
+
+fn verify_resource_labels(
+    project: &str,
+    section: &str,
+    labels: &Value,
+    manifest: &Value,
+) -> io::Result<()> {
+    let field = match section {
+        "services" => "com.docker.compose.service",
+        "volumes" => "com.docker.compose.volume",
+        "networks" => "com.docker.compose.network",
+        _ => return Err(invalid("unsupported resource ownership catalog")),
+    };
+    let logical = labels[field]
+        .as_str()
+        .ok_or_else(|| invalid("resource has no Compose owner"))?;
+    let expected = manifest[section]
+        .get(logical)
+        .ok_or_else(|| invalid("undeclared resource blocks job cleanup"))?;
+    if labels["com.docker.compose.project"] != project {
+        return Err(invalid("foreign project blocks job cleanup"));
+    }
+    if expected["external"] == true {
+        return Err(invalid(
+            "external resource collides with disposable job ownership",
+        ));
+    }
+    let expected_labels = expected["labels"].as_object();
+    // Existing version-one journals declared only Compose ownership for storage.
+    // New invocations declare task/job/attempt/purpose on every owned resource.
+    if (section == "services" || manifest["x-sdlc-ownership-version"] == 2)
+        && expected_labels.is_none()
+    {
+        return Err(invalid("protected manifest has no resource owner"));
+    }
+    if let Some(expected_labels) = expected_labels {
+        if expected_labels
+            .iter()
+            .any(|(name, value)| &labels[name] != value)
+        {
+            return Err(invalid("foreign resource blocks job cleanup"));
+        }
+    } else {
+        for name in [
+            "sdlc.task",
+            "sdlc.purpose",
+            "sdlc.job",
+            "sdlc.attempt",
+            "sdlc.control-volume",
+        ] {
+            if labels.get(name).is_some()
+                && labels[name] != manifest["services"]["transfer"]["labels"][name]
+            {
+                return Err(invalid("foreign owner in legacy job storage"));
+            }
+        }
+    }
+    Ok(())
 }
 
