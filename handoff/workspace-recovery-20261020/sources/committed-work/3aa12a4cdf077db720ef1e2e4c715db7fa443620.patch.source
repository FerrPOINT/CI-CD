new file mode 100644
index 0000000..3ac4845
--- /dev/null
+++ b/deploy/pulse-runner.Dockerfile
@@ -0,0 +1,12 @@
+ARG FORGE_IMAGE=pulse-forge-qa-backend:automation
+FROM docker:27-cli AS docker_cli
+
+FROM ${FORGE_IMAGE}
+USER root
+COPY --from=docker_cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
+COPY deploy/service-pulse-demo.compose.yml /opt/pulse-deploy/demo.compose.yml
+COPY deploy/service-pulse-deploy /usr/local/bin/service-pulse-deploy
+RUN chmod 0755 /usr/local/bin/service-pulse-deploy /usr/local/lib/docker/cli-plugins/docker-compose \
+    && mkdir -p /var/lib/pulse-deploy/releases
+ENV CICD_RUNNER_TAGS=deploy
+ENTRYPOINT ["/usr/local/bin/forge-runner"]
diff --git a/deploy/pulse-runner.compose.yml b/deploy/pulse-runner.compose.yml
new file mode 100644
index 0000000..2029610
--- /dev/null
+++ b/deploy/pulse-runner.compose.yml
@@ -0,0 +1,33 @@
+services:
+  pulse-deploy-runner:
+    image: pulse-forge-deploy-runner:local
+    environment:
+      CICD_API_URL: http://cicd-backend:22801
+      CICD_RUNNER_NAME: pulse-deploy-local
+      CICD_RUNNER_TAGS: deploy
+      CICD_RUNNER_REGISTRATION_TOKEN: ${PULSE_DEPLOY_REGISTRATION_TOKEN:?required}
+      CICD_RUNNER_CREDENTIAL_FILE: /var/lib/pulse-deploy/auth/credential
+      CICD_RUNNER_NO_CHECKOUT: "true"
+      CICD_RUNNER_WORK_DIR: /workspaces
+      SERVICE_PULSE_DB_PASSWORD: ${SERVICE_PULSE_DB_PASSWORD:?required}
+    volumes:
+      - /var/run/docker.sock:/var/run/docker.sock
+      - sdlc-demo_cicd_git_repos:/forge-git:ro
+      - ${PULSE_BASE_SOURCE_PATH:?required}:/runner-sources/services-base:ro
+      - pulse_deploy_releases:/var/lib/pulse-deploy/releases
+      - pulse_runner_auth:/var/lib/pulse-deploy/auth
+      - pulse_deploy_workspaces:/workspaces
+    networks:
+      - sdlc-demo_cicd
+    restart: unless-stopped
+
+volumes:
+  sdlc-demo_cicd_git_repos:
+    external: true
+  pulse_deploy_releases:
+  pulse_runner_auth:
+  pulse_deploy_workspaces:
+
+networks:
+  sdlc-demo_cicd:
+    external: true
diff --git a/deploy/service-pulse-demo.compose.yml b/deploy/service-pulse-demo.compose.yml
new file mode 100644
index 0000000..e995c7f
--- /dev/null
+++ b/deploy/service-pulse-demo.compose.yml
@@ -0,0 +1,49 @@
+services:
+  postgres:
+    image: postgres:16-alpine
+    environment:
+      POSTGRES_USER: pulse
+      POSTGRES_PASSWORD: ${SERVICE_PULSE_DB_PASSWORD:?required}
+      POSTGRES_DB: pulse
+    ports:
+      - "127.0.0.1:5442:5432"
+    volumes:
+      - service-pulse-postgres:/var/lib/postgresql/data
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U pulse -d pulse"]
+      interval: 5s
+      timeout: 3s
+      retries: 20
+  api:
+    image: ${API_IMAGE:?required}
+    environment:
+      SERVICE_PULSE_DATABASE_URL: postgres://pulse:${SERVICE_PULSE_DB_PASSWORD:?required}@postgres:5432/pulse
+      SERVICE_PULSE_AUTH__CENTRAL_JWKS_URI: http://host.docker.internal:7701/oidc/jwks
+      SERVICE_PULSE_AUTH__CENTRAL_ISSUER: http://localhost:7701
+      RUST_LOG: service_pulse=info,tower_http=info
+    ports:
+      - "127.0.0.1:7792:7792"
+    extra_hosts:
+      - "host.docker.internal:host-gateway"
+    depends_on:
+      postgres:
+        condition: service_healthy
+    healthcheck:
+      test: ["CMD", "curl", "--fail", "http://127.0.0.1:7792/healthz"]
+      interval: 10s
+      timeout: 3s
+      retries: 20
+  web:
+    image: ${WEB_IMAGE:?required}
+    ports:
+      - "127.0.0.1:7791:80"
+    depends_on:
+      api:
+        condition: service_healthy
+    healthcheck:
+      test: ["CMD", "wget", "--quiet", "--spider", "http://127.0.0.1/"]
+      interval: 10s
+      timeout: 3s
+      retries: 20
+volumes:
+  service-pulse-postgres:
diff --git a/deploy/service-pulse-deploy b/deploy/service-pulse-deploy
new file mode 100644
index 0000000..5eee3fe
--- /dev/null
+++ b/deploy/service-pulse-deploy
@@ -0,0 +1,72 @@
+#!/bin/sh
+set -eu
+
+SHA=${CICD_COMMIT_SHA:?missing commit SHA}
+DEPLOYMENT_ID=${CICD_VAR_DEPLOYMENT_ID:?missing deployment ID}
+ROLLBACK_ID=${CICD_VAR_ROLLBACK_OF_DEPLOYMENT_ID:-}
+STORE=/var/lib/pulse-deploy/releases
+COMPOSE=/opt/pulse-deploy/demo.compose.yml
+BASE_SHA=14abba88ec3000fa2d10f7431a0d5a1182d9eeb5
+BASE_TREE_SHA256=5288796d511b1b1fe5df65b8f5a0e974f73526d77815802cc90b25dbfae3d79d
+
+printf '%s' "$SHA" | grep -Eq '^[0-9a-f]{40}$'
+printf '%s' "$DEPLOYMENT_ID" | grep -Eq '^[0-9a-f-]{36}$'
+if [ -n "$ROLLBACK_ID" ]; then
+  printf '%s' "$ROLLBACK_ID" | grep -Eq '^[0-9a-f-]{36}$'
+fi
+
+PREV_API=$(docker inspect service-pulse-api-1 --format '{{.Image}}' 2>/dev/null || true)
+PREV_WEB=$(docker inspect service-pulse-web-1 --format '{{.Image}}' 2>/dev/null || true)
+
+if [ -n "$ROLLBACK_ID" ]; then
+  TARGET="$STORE/$ROLLBACK_ID.env"
+  [ -f "$TARGET" ] || { echo "rollback target has no verified image manifest" >&2; exit 1; }
+  . "$TARGET"
+  [ "$RELEASE_SHA" = "$SHA" ] || { echo "rollback SHA does not match release manifest" >&2; exit 1; }
+  API_IMAGE=$RELEASE_API_IMAGE
+  WEB_IMAGE=$RELEASE_WEB_IMAGE
+else
+  [ -d /forge-git/service-pulse.git ] || { echo "Pulse bare repository is unavailable" >&2; exit 1; }
+  ACTUAL_BASE_TREE_SHA256=$(find /runner-sources/services-base -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -d ' ' -f 1)
+  [ "$ACTUAL_BASE_TREE_SHA256" = "$BASE_TREE_SHA256" ] || {
+    echo "services-base source differs from the pinned release tree" >&2; exit 1;
+  }
+  mkdir -p source/service-pulse source/services-base
+  git --git-dir=/forge-git/service-pulse.git archive "$SHA" | tar -x -C source/service-pulse
+  cp -a /runner-sources/services-base/. source/services-base/
+  MIGRATIONS=source/service-pulse/backend/migrations
+  [ "$(find "$MIGRATIONS" -maxdepth 1 -name '*.sql' | wc -l)" -eq 2 ] || {
+    echo "schema change requires a backup/restore release procedure" >&2; exit 1;
+  }
+  printf '%s  %s\n' \
+    b31623045f34982eac0a02e5acf77bd96898e15fda752814751cf4769464ff65e8abfe17d195d8676cd3fe520e81ab76 "$MIGRATIONS/0001_service_pulse.sql" \
+    abea8037a10bbf2e5d4605f804f413a35c7d26b33d80ed035959c73a6f2a5754173bf050fd91b0c205aa7dc5bf23e8eb "$MIGRATIONS/0002_availability_incidents.sql" \
+    | sha384sum --check --status || {
+      echo "migration bytes differ from the verified rollback baseline" >&2; exit 1;
+    }
+  printf '%s\n' '.git' 'target' 'node_modules' '.artifacts' > source/.dockerignore
+  docker build --build-arg "SERVICE_PULSE_COMMIT_SHA=$SHA" -f source/service-pulse/backend/Dockerfile -t "service-pulse-api:sha-$SHA" source
+  docker build -f source/service-pulse/frontend/Dockerfile -t "service-pulse-web:sha-$SHA" source
+  API_IMAGE=$(docker image inspect "service-pulse-api:sha-$SHA" --format '{{.Id}}')
+  WEB_IMAGE=$(docker image inspect "service-pulse-web:sha-$SHA" --format '{{.Id}}')
+fi
+
+export API_IMAGE WEB_IMAGE
+if ! docker compose -p service-pulse -f "$COMPOSE" up -d --no-build --wait; then
+  echo "Pulse health failed; restoring the previous images" >&2
+  if [ -n "$PREV_API" ] && [ -n "$PREV_WEB" ]; then
+    API_IMAGE=$PREV_API WEB_IMAGE=$PREV_WEB
+    export API_IMAGE WEB_IMAGE
+    docker compose -p service-pulse -f "$COMPOSE" up -d --no-build --wait || true
+  fi
+  exit 1
+fi
+
+RELEASE_API_IMAGE=$API_IMAGE
+RELEASE_WEB_IMAGE=$WEB_IMAGE
+RELEASE_SHA=$SHA
+printf 'RELEASE_API_IMAGE=%s\nRELEASE_WEB_IMAGE=%s\nRELEASE_SHA=%s\n' \
+  "$RELEASE_API_IMAGE" "$RELEASE_WEB_IMAGE" "$RELEASE_SHA" > "$STORE/$DEPLOYMENT_ID.env"
+printf '{"deployment_id":"%s","commit_sha":"%s","base_sha":"%s","base_tree_sha256":"%s","api_image":"%s","web_image":"%s","rollback_of":"%s","health":"passed"}\n' \
+  "$DEPLOYMENT_ID" "$SHA" "$BASE_SHA" "$BASE_TREE_SHA256" "$API_IMAGE" "$WEB_IMAGE" "$ROLLBACK_ID" > release.json
+cat release.json
diff --git a/docs/API.md b/docs/API.md
index c6f4397..ab14dcf 100644
--- a/docs/API.md
+++ b/docs/API.md
@@ -1094,12 +1094,15 @@ curl -sS "http://127.0.0.1:22801/api/v1/pipelines/$(printf '%s' "$PIPELINE" | jq
 | PATCH | `/environments/{environment_id}` | Обновить окружение |
 | DELETE | `/environments/{environment_id}` | Удалить окружение |
 | GET | `/environments/{environment_id}/deployments` | Список деплоев |
-| POST | `/environments/{environment_id}/deployments` | Создать деплой (git_ref, status) |
+| POST | `/environments/{environment_id}/deployments` | Создать деплой (`git_ref`: точный SHA защищённого `main`, optional UUID `request_key`) |
 | GET | `/deployments/{deployment_id}/approvals` | Append-only решения по protected deployment |
 | POST | `/deployments/{deployment_id}/approvals` | Записать approval decision (`approved`/`rejected`, optional actor/comment) |
 | POST | `/deployments/{deployment_id}/rollback` | Создать отдельную rollback delivery запись |
+| POST | `/deployments/{deployment_id}/cancel` | Отменить pending/running deployment и связанный pipeline |
 
-`Environment` содержит `protected` и `required_approvals`. Для protected environment deployment нельзя сразу создать как terminal `success`/`failed` или связать с уже запущенным pipeline: запись стартует как `pending`, а `POST /deployments/{deployment_id}/approvals` сохраняет immutable decision. При включённой auth-схеме actor берётся из JWT/PAT subject; body `actor` используется только в trusted-network режиме. Когда набрано `required_approvals`, backend запускает pipeline через тот же idempotent trigger helper и связывает его с deployment. Rollback не переписывает исходный deployment: создаётся новая запись с `rollback_of_id`; для обычного окружения pipeline стартует сразу, для protected окружения rollback также ждёт approval.
+`Environment` содержит `protected` и `required_approvals`. Любой новый deployment стартует как `pending`; клиент не может установить terminal status или привязать pipeline. Forge заранее проверяет точный SHA из защищённого `main` Service Pulse. Конфигурация `.forge-deploy.yml` берётся из этого commit; для исторического commit до её появления берётся конфигурация из текущего защищённого `main` и фиксируется вместе с hash в immutable pipeline plan, тогда как код всегда собирается из запрошенного SHA. Для protected environment `POST /deployments/{deployment_id}/approvals` сохраняет immutable decision; после нужного числа approvals запускается отдельный deploy pipeline. Для unprotected environment он запускается сразу. `request_key` идемпотентен внутри environment: повтор тех же параметров возвращает ту же запись, иной SHA или rollback target даёт `409`. Rollback не переписывает исходный deployment, а создаёт новую запись с `rollback_of_id` и optional `request_key`. Статус deployment следует terminal результату связанного deploy pipeline; зелёный push CI не является выпуском.
+
+При обычном push Forge читает только `.forge-ci.yml`, а при явном deployment — только `.forge-deploy.yml`. Последний допускает единственный job с `tags: [deploy]`, командой `service-pulse-deploy`, без `allow_failure`, `manual` и job secrets. Тег `deploy` запрещён в push CI. Выделенный `forge-runner` регистрируется отдельным `CICD_DEPLOY_RUNNER_REGISTRATION_TOKEN`; обычный registration token не может получить этот тег, heartbeat не может изменить его, deploy runner не получает untagged CI jobs. Локальный fixed script и Compose манифест находятся в `deploy/`, вне репозитория Pulse; они проверяют неизменные миграции, собирают образы из SHA с закреплённым Base, ждут API/UI health, сохраняют image ID и восстанавливают предыдущие образы при неуспехе. Тома PostgreSQL не удаляются.
 
 ### Schedules
 
diff --git a/docs/DATA_MODEL.md b/docs/DATA_MODEL.md
index 25331c2..9ba62ee 100644
--- a/docs/DATA_MODEL.md
+++ b/docs/DATA_MODEL.md
@@ -442,7 +442,7 @@ External claim выполняется в транзакции `SERIALIZABLE`: п
 
 ## 5.2 job_leases
 
-Durable ledger владения execution attempt. Текущий MVP использует таблицу для embedded runner и external runner protocol: claim одним SQL statement переводит compatible `job_queue` row в `leased`, `jobs` и `execution_attempts` в `running`, создаёт active lease и фиксирует generation/expiry. Embedded runner закрывает lease при terminal result/cancel, reconciler закрывает expired/missing owner, а external protocol дополнительно хранит hash lease token, ack deadline, ack/renew state и protocol version, плюс проверяет current `shell` executor compatibility перед claim. Unacknowledged external lease после `ack_deadline` закрывается как `expired` delivery, а текущая queue row/attempt возвращается в `queued` для следующей generation. `forge-runner` уже работает как отдельный shell process поверх этой модели, получает declared secrets, держит active-lease heartbeat и загружает declared artifact files через lease-scoped endpoint; stale-runner reconciliation не переводит runner в `offline`, пока за ним есть unexpired active lease. Production chunked artifact sessions, protected tag/pool policy, advanced capability matching, sandbox и расширенная restart/race lost-runner suite остаются target.
+Durable ledger владения execution attempt. Текущий MVP использует таблицу для embedded runner и external runner protocol: claim одним SQL statement переводит compatible `job_queue` row в `leased`, `jobs` и `execution_attempts` в `running`, создаёт active lease и фиксирует generation/expiry. Embedded runner закрывает lease при terminal result/cancel, reconciler закрывает expired/missing owner, а external protocol дополнительно хранит hash lease token, ack deadline, ack/renew state и protocol version, плюс проверяет current `shell` executor compatibility перед claim. Unacknowledged external lease после `ack_deadline` закрывается как `expired` delivery, а текущая queue row/attempt возвращается в `queued` для следующей generation. `forge-runner` уже работает как отдельный shell process поверх этой модели, получает declared secrets, держит active-lease heartbeat и загружает declared artifact files через lease-scoped endpoint; stale-runner reconciliation не переводит runner в `offline`, пока за ним есть unexpired active lease. Специальный тег `deploy` защищён отдельным registration token и не выдаёт untagged jobs. Production chunked artifact sessions, общие protected tag/pool policy, advanced capability matching, sandbox и расширенная restart/race lost-runner suite остаются target.
 
 | Колонка | Тип | Nullable | Default | Описание |
 |---|---|---|---|---|
@@ -657,7 +657,8 @@ Runtime maintenance переводит `status='online'` в `offline`, когд
 | `environment_id` | UUID | NOT NULL | — | FK → `environments(id)` CASCADE |
 | `pipeline_id` | UUID | NULL | — | FK → `pipelines(id)` SET NULL |
 | `rollback_of_id` | UUID | NULL | — | FK → `deployments(id)` SET NULL; исходная delivery-запись для rollback |
-| `git_ref` | TEXT | NOT NULL | — | Деплойимый Git-реф |
+| `request_key` | UUID | NULL | — | Идемпотентность запроса в пределах environment, UNIQUE `(environment_id, request_key)` |
+| `git_ref` | TEXT | NOT NULL | — | Точный commit SHA из защищённого `main` Service Pulse |
 | `status` | TEXT | NOT NULL | `'pending'` | CHECK: `pending`, `running`, `success`, `failed` |
 | `created_at` | TIMESTAMPTZ | NOT NULL | `now()` | — |
 
diff --git a/docs/adr/0017-service-pulse-deployment-boundary.md b/docs/adr/0017-service-pulse-deployment-boundary.md
new file mode 100644
index 0000000..97afb89
--- /dev/null
+++ b/docs/adr/0017-service-pulse-deployment-boundary.md
@@ -0,0 +1,17 @@
+# ADR-0017: отдельная граница выпуска Service Pulse
+
+## Контекст
+
+Push CI выполняется на общих Docker runners. Его зелёный результат не доказывает, что приложение развернуто и отвечает. Прямой доступ таких jobs к Docker host недопустим.
+
+## Решение
+
+- `.forge-ci.yml` читается только для push/API CI. Запрос deployment по точному SHA из защищённого `main` читает `.forge-deploy.yml` из этого commit, а для исторического commit без файла — из текущего защищённого `main`, фиксируя её hash в плане. Fallback template запрещён.
+- Deployment создаётся в `pending`, approval сохраняется в существующем журнале. `success` выставляется только после terminal success выделенного pipeline, чей фиксированный job выполняется runner с защищённым тегом `deploy`.
+- Для deploy runner используется отдельный registration token; обычный runner не может добавить тег через heartbeat. Deploy runner не получает untagged jobs.
+- Команда job фиксирована как `service-pulse-deploy`; скрипт и Compose живут у runner, а не в изменяемом продуктовом checkout. Скрипт собирает и применяет immutable image ID, проверяет health, сохраняет release manifest; при ошибке применяет прошлые ID, не трогая том PostgreSQL.
+- Forge хранит UUID `request_key` для безопасного повтора deployment/rollback после рестарта Fleet. Fleet отдельно проверяет работающие API и UI перед `completed`.
+
+## Ограничение
+
+Это локальный доверенный `demo` стенд. Новые миграции блокируются до отдельного backup/restore и проверки совместимости отката. Production runner pools и release tags не входят в этот проход.
