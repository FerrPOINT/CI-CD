+pub(crate) async fn validate_deployment_target(
+    pool: &PgPool,
+    project_id: Uuid,
+    git_ref: &str,
+    git_root: &FsPath,
+) -> Result<(), ApiError> {
+    let repository_url: String =
+        sqlx::query_scalar("SELECT repository_url FROM projects WHERE id = $1")
+            .bind(project_id)
+            .fetch_optional(pool)
+            .await
+            .map_err(ApiError::internal)?
+            .ok_or_else(ApiError::not_found)?;
+    if extract_repo_name_from_url(&repository_url).as_deref() != Some("service-pulse") {
+        return Err(ApiError::bad_request(
+            "deploy runner is reserved for Service Pulse",
+        ));
+    }
+    if git_ref.len() != 40
+        || !git_ref.bytes().all(|byte| byte.is_ascii_hexdigit())
+        || resolve_commit_sha(Some(&repository_url), git_ref, git_root)
+            .await
+            .as_deref()
+            != Some(git_ref)
+    {
+        return Err(ApiError::bad_request(
+            "deployment requires an exact commit SHA",
+        ));
+    }
+    let protected: Vec<String> =
+        sqlx::query_scalar("SELECT protected_branches FROM projects WHERE id = $1")
+            .bind(project_id)
+            .fetch_one(pool)
+            .await
+            .map_err(ApiError::internal)?;
+    if !protected.iter().any(|branch| branch == "main")
+        || !commit_is_on_main(&repository_url, git_ref, git_root).await
+    {
+        return Err(ApiError::bad_request(
+            "deployment commit must be reachable from protected main",
+        ));
+    }
+    let raw = read_deployment_config(&repository_url, git_ref, git_root)
+        .await
+        .ok_or_else(|| ApiError::bad_request(".forge-deploy.yml is required"))?;
+    let config = parse_pipeline_config(Some(&raw)).map_err(ApiError::bad_request)?;
+    if config.stages.len() != 1
+        || config.stages[0].jobs.len() != 1
+        || config.stages[0].jobs[0].required_tags != ["deploy"]
+        || config.stages[0].jobs[0].command != "set -e\nservice-pulse-deploy"
+        || config.stages[0].jobs[0].allow_failure
+        || config.stages[0].jobs[0].manual
+        || !config.stages[0].jobs[0].required_secrets.is_empty()
+    {
+        return Err(ApiError::bad_request(
+            "deployment config must contain only the protected deploy job",
+        ));
+    }
+    Ok(())
+}
