+async fn read_deployment_config(
+    repository_url: &str,
+    commit_sha: &str,
+    git_root: &FsPath,
+) -> Option<String> {
+    if let Some(config) = read_local_forge_config(
+        Some(repository_url),
+        commit_sha,
+        git_root,
+        ".forge-deploy.yml",
+    )
+    .await
+    {
+        return Some(config);
+    }
+    // Historical commits can predate the config. The current protected-main
+    // config is snapshotted into the pipeline plan; source stays at commit_sha.
+    read_local_forge_config(
+        Some(repository_url),
+        "refs/heads/main",
+        git_root,
+        ".forge-deploy.yml",
+    )
+    .await
+}
+
+async fn commit_is_on_main(repo_url: &str, commit_sha: &str, git_root: &FsPath) -> bool {
+    let Some(name) = extract_repo_name_from_url(repo_url) else {
+        return false;
+    };
+    let bare_path = git_root.join(format!("{name}.git"));
+    if !bare_path.is_dir() {
+        return false;
+    }
+    tokio::process::Command::new("git")
+        .arg(format!("--git-dir={}", bare_path.display()))
+        .args(["merge-base", "--is-ancestor", commit_sha, "refs/heads/main"])
+        .status()
+        .await
+        .is_ok_and(|status| status.success())
+}
