 #[derive(Debug, Deserialize, utoipa::ToSchema)]
 pub(crate) struct RollbackDeployment {
     git_ref: Option<String>,
+    request_key: Option<Uuid>,
+}
+
+#[utoipa::path(post, path = "/api/v1/deployments/{deployment_id}/cancel", tag = "environments", params(("deployment_id" = Uuid, Path)), responses((status = 200, body = Deployment), (status = 404), (status = 409)))]
+async fn cancel_deployment(
+    State(state): State<Arc<AppState>>,
+    Path(deployment_id): Path<Uuid>,
+) -> ApiResult<Deployment> {
+    let db = pool(&state)?;
+    let deployment = fetch_deployment(db, deployment_id).await?;
+    if !matches!(deployment.status.as_str(), "pending" | "running") {
+        return Err(ApiError::conflict("deployment is not active"));
+    }
+    if let Some(pipeline_id) = deployment.pipeline_id {
+        let _ = crate::api::cancel_pipeline(State(state.clone()), Path(pipeline_id)).await?;
+    }
+    sqlx::query("UPDATE deployments SET status = 'failed' WHERE id = $1 AND status IN ('pending', 'running')")
+        .bind(deployment_id)
+        .execute(db)
+        .await
+        .map_err(ApiError::internal)?;
+    audit(db, "deployment.canceled", "deployment", deployment_id, None).await?;
+    Ok(Json(fetch_deployment(db, deployment_id).await?))
 }
 
