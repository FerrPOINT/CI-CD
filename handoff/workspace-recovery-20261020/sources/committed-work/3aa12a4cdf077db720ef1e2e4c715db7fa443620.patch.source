     git_ref: String,
     pipeline_id: Option<Uuid>,
     status: Option<String>,
+    request_key: Option<Uuid>,
+}
+
+async fn insert_or_replay_deployment(
+    db: &PgPool,
+    environment_id: Uuid,
+    git_ref: &str,
+    rollback_of_id: Option<Uuid>,
+    request_key: Option<Uuid>,
+) -> Result<(Uuid, bool), ApiError> {
+    let id = Uuid::new_v4();
+    let inserted: Option<Uuid> = sqlx::query_scalar(
+        "INSERT INTO deployments (id, environment_id, rollback_of_id, git_ref, status, request_key) \
+         VALUES ($1, $2, $3, $4, 'pending', $5) \
+         ON CONFLICT (environment_id, request_key) DO NOTHING RETURNING id",
+    )
+    .bind(id)
+    .bind(environment_id)
+    .bind(rollback_of_id)
+    .bind(git_ref)
+    .bind(request_key)
+    .fetch_optional(db)
+    .await
+    .map_err(ApiError::internal)?;
+    if let Some(id) = inserted {
+        return Ok((id, true));
+    }
+    let existing: (Uuid, String, Option<Uuid>) = sqlx::query_as(
+        "SELECT id, git_ref, rollback_of_id FROM deployments \
+         WHERE environment_id = $1 AND request_key = $2",
+    )
+    .bind(environment_id)
+    .bind(request_key)
+    .fetch_one(db)
+    .await
+    .map_err(ApiError::internal)?;
+    if existing.1 != git_ref || existing.2 != rollback_of_id {
+        return Err(ApiError::conflict(
+            "deployment request key belongs to another release",
+        ));
+    }
+    Ok((existing.0, false))
 }
