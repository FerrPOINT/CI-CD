index 0000000..128a7c7
--- /dev/null
+++ b/backend/src/registered_source.rs
@@ -0,0 +1,275 @@
+//! Source observations behind the existing namespace repository reader, never Git authority.
+use crate::api::{ApiError, AppState};
+use chrono::{DateTime, Utc};
+use pdlc_shared::resource_context::{NamespaceRef, OwnerCommand};
+use serde::{Deserialize, Serialize};
+use sqlx::Row;
+use std::{collections::BTreeSet, path::Path, process::Stdio, time::Duration};
+use tokio::{io::AsyncReadExt, process::Command};
+use uuid::Uuid;
+
+#[derive(Deserialize, utoipa::IntoParams)]
+#[serde(deny_unknown_fields)]
+pub struct RepositoryQuery {
+    pub registry_instance_id: Uuid,
+    pub namespace_id: Uuid,
+    pub offset: Option<u32>,
+    pub base_ref: Option<String>,
+    pub base_commit: Option<String>,
+}
+
+impl RepositoryQuery {
+    pub fn source(&self) -> Result<Option<ExpectedSource>, ApiError> {
+        match (&self.base_ref, &self.base_commit) {
+            (None, None) => Ok(None),
+            (Some(reference), Some(commit)) if full_branch(reference) && sha1(commit) => {
+                Ok(Some(ExpectedSource {
+                    reference: reference.clone(),
+                    commit: commit.clone(),
+                }))
+            }
+            _ => Err(ApiError::bad_request(
+                "Нужны полная ветка base_ref и точный base_commit SHA1",
+            )),
+        }
+    }
+    pub fn namespace(&self) -> NamespaceRef {
+        NamespaceRef {
+            registry_instance_id: self.registry_instance_id,
+            namespace_id: self.namespace_id,
+        }
+    }
+}
+
+pub struct ExpectedSource {
+    reference: String,
+    commit: String,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize, utoipa::ToSchema)]
+#[serde(deny_unknown_fields)]
+pub struct VerifiedSource {
+    pub namespace: NamespaceRef,
+    pub forge_instance_id: Uuid,
+    pub repository_id: Uuid,
+    pub public_name: String,
+    pub base_ref: String,
+    pub base_commit: String,
+    pub default_ref: String,
+    pub protected_refs: Vec<String>,
+    pub observed_at: DateTime<Utc>,
+}
+
+#[derive(Serialize, utoipa::ToSchema)]
+#[serde(untagged)]
+pub enum RepositoryReadback {
+    Catalog(crate::repository_catalog::VerifiedRepository),
+    Source(VerifiedSource),
+}
+
+fn unavailable() -> ApiError {
+    ApiError::service_unavailable("Проверенный источник репозитория недоступен")
+}
+
+fn sha1(value: &str) -> bool {
+    value.len() == 40
+        && value
+            .bytes()
+            .all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c))
+}
+
+// Matches Tracker's portable input contract; native Git still validates/resolves the branch.
+fn full_branch(value: &str) -> bool {
+    value.starts_with("refs/heads/")
+        && value.len() <= 255
+        && !value.ends_with(['/', '.'])
+        && !["..", "@{", "//"].iter().any(|part| value.contains(part))
+        && value
+            .bytes()
+            .all(|c| c.is_ascii_graphic() && !b"~^:?*[\\".contains(&c))
+        && value
+            .split('/')
+            .all(|part| !part.is_empty() && !part.starts_with('.') && !part.ends_with(".lock"))
+}
+
+fn validate_catalog(
+    command: &OwnerCommand,
+    namespace: &NamespaceRef,
+    group: Uuid,
+    kind: &str,
+    ready: bool,
+) -> Result<(), ApiError> {
+    if command.namespace != *namespace
+        || command.resource.resource_id != group
+        || command.state != "active"
+    {
+        return Err(ApiError::forbidden());
+    }
+    if kind != "hosted" || !ready {
+        return Err(unavailable());
+    }
+    Ok(())
+}
+
+fn protected_refs(
+    default: &str,
+    policies: Vec<(String, Vec<String>)>,
+) -> Result<Vec<String>, ApiError> {
+    if !full_branch(default) || policies.len() > 256 {
+        return Err(unavailable());
+    }
+    let mut refs = BTreeSet::from([default.to_owned()]);
+    // Same ALL-linked-project policy as native receive; include even branches absent from Git.
+    for (default, protected) in policies {
+        for branch in std::iter::once(default).chain(protected) {
+            let reference = format!("refs/heads/{branch}");
+            if !full_branch(&reference) {
+                return Err(unavailable());
+            }
+            refs.insert(reference);
+            if refs.len() > 256 {
+                return Err(unavailable());
+            }
+        }
+    }
+    Ok(refs.into_iter().collect())
+}
+
+async fn git_line(path: &Path, args: &[&str]) -> Result<String, ApiError> {
+    let mut child = Command::new("git")
+        .arg("--git-dir")
+        .arg(path)
+        .args(args)
+        .env("GIT_NO_REPLACE_OBJECTS", "1")
+        .env("GIT_NO_LAZY_FETCH", "1")
+        .env("GIT_OPTIONAL_LOCKS", "0")
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .kill_on_drop(true)
+        .spawn()
+        .map_err(|_| unavailable())?;
+    let stdout = child.stdout.take().ok_or_else(unavailable)?;
+    let result = tokio::time::timeout(Duration::from_secs(10), async {
+        let mut bytes = Vec::new();
+        stdout
+            .take(4097)
+            .read_to_end(&mut bytes)
+            .await
+            .map_err(|_| unavailable())?;
+        if bytes.len() > 4096 {
+            return Err(unavailable());
+        }
+        if !child.wait().await.map_err(|_| unavailable())?.success() {
+            return Err(unavailable());
+        }
+        let text = String::from_utf8(bytes).map_err(|_| unavailable())?;
+        let text = text.trim_end_matches(['\r', '\n']);
+        if text.is_empty() || text.contains(['\r', '\n']) {
+            return Err(unavailable());
+        }
+        Ok(text.to_owned())
+    })
+    .await
+    .map_err(|_| unavailable())?;
+    if result.is_err() {
+        let _ = child.kill().await;
+    }
+    result
+}
+
+async fn native_source(
+    path: &Path,
+    expected: &ExpectedSource,
+) -> Result<(String, String), ApiError> {
+    if !full_branch(&expected.reference) || !sha1(&expected.commit) {
+        return Err(ApiError::bad_request("Недопустимый источник Git"));
+    }
+    if git_line(path, &["rev-parse", "--is-bare-repository"]).await? != "true" {
+        return Err(unavailable());
+    }
+    // Reuse the exact branch snapshot used by PR merge: no tag, implicit HEAD or main/master fallback.
+    let snapshot = crate::pulls::branch_snapshot(path, &expected.reference).await?;
+    if snapshot.reference != expected.reference || !sha1(&snapshot.oid) {
+        return Err(unavailable());
+    }
+    if snapshot.oid != expected.commit {
+        return Err(ApiError::conflict("SHA выбранной ветки изменился"));
+    }
+    if git_line(path, &["cat-file", "-t", &snapshot.oid]).await? != "commit" {
+        return Err(unavailable());
+    }
+    let default = git_line(path, &["symbolic-ref", "--quiet", "HEAD"]).await?;
+    if !full_branch(&default) {
+        return Err(unavailable());
+    }
+    Ok((snapshot.oid, default))
+}
+
+pub async fn observe(
+    state: &AppState,
+    repository: Uuid,
+    namespace: NamespaceRef,
+    expected: ExpectedSource,
+) -> Result<VerifiedSource, ApiError> {
+    // Existing reader auth stays on the existing route; this lease closes catalog/namespace relocation.
+    let mut tx = crate::repository_catalog::catalog_write_lease(state, repository).await?;
+    let row = sqlx::query("SELECT r.group_id,r.kind,r.ready,r.storage_name,g.slug||'/'||r.slug AS public_name,b.command
+        FROM repository_catalog r JOIN git_groups g ON g.id=r.group_id
+        JOIN forge_namespace_bindings b ON b.resource_id=g.id WHERE r.id=$1")
+        .bind(repository).fetch_optional(&mut *tx).await.map_err(ApiError::internal)?.ok_or_else(ApiError::not_found)?;
+    let command: OwnerCommand =
+        serde_json::from_value(row.try_get("command").map_err(ApiError::internal)?)
+            .map_err(|_| unavailable())?;
+    crate::namespace::validate_projection(&command)?;
+    validate_catalog(
+        &command,
+        &namespace,
+        row.try_get("group_id").map_err(ApiError::internal)?,
+        &row.try_get::<String, _>("kind")
+            .map_err(ApiError::internal)?,
+        row.try_get("ready").map_err(ApiError::internal)?,
+    )?;
+    let storage: String = row.try_get("storage_name").map_err(ApiError::internal)?;
+    if crate::git_host::validate_repo_name(&storage).map_err(|_| unavailable())? != storage {
+        return Err(unavailable());
+    }
+    let root = tokio::fs::canonicalize(&state.git.root)
+        .await
+        .map_err(|_| unavailable())?;
+    let path = tokio::fs::canonicalize(root.join(format!("{storage}.git")))
+        .await
+        .map_err(|_| unavailable())?;
+    if !path.starts_with(&root) || path == root {
+        return Err(unavailable());
+    }
+    let public_name: String = row.try_get("public_name").map_err(ApiError::internal)?;
+    if public_name.is_empty()
+        || public_name.len() > 512
+        || public_name.chars().any(char::is_control)
+    {
+        return Err(unavailable());
+    }
+    let policies = sqlx::query_as::<_,(String,Vec<String>)>(
+        "SELECT default_branch,protected_branches FROM projects WHERE repository_id=$1 ORDER BY id LIMIT 257")
+        .bind(repository).fetch_all(&mut *tx).await.map_err(ApiError::internal)?;
+    let (commit, default) = native_source(&path, &expected).await?;
+    let protected_refs = protected_refs(&default, policies)?;
+    let observation = VerifiedSource {
+        namespace,
+        forge_instance_id: command.resource.instance_id,
+        repository_id: repository,
+        public_name,
+        base_ref: expected.reference,
+        base_commit: commit,
+        default_ref: default,
+        protected_refs,
+        observed_at: Utc::now(),
+    };
+    tx.commit().await.map_err(ApiError::internal)?;
+    Ok(observation)
+}
+
+#[cfg(test)]
+#[path = "registered_source_tests.rs"]
+mod tests;
diff --git a/backend/src/registered_source_tests.rs b/backend/src/registered_source_tests.rs
new file mode 100644
index 0000000..45ed0dd
--- /dev/null
+++ b/backend/src/registered_source_tests.rs
@@ -0,0 +1,296 @@
+//! Owned synthetic native Git fixtures only; no hosted repository, DB or live auth evidence.
+use super::*;
+use serde_json::json;
+
+fn query() -> RepositoryQuery {
+    serde_json::from_value(
+        json!({"registry_instance_id":Uuid::new_v4(),"namespace_id":Uuid::new_v4()}),
+    )
+    .unwrap()
+}
+
+#[test]
+fn old_reader_query_remains_metadata_only_and_source_requires_both_fields() {
+    let mut query = query();
+    assert!(query.source().unwrap().is_none());
+    query.base_ref = Some("refs/heads/main".into());
+    assert!(query.source().is_err());
+    query.base_commit = Some("a".repeat(40));
+    assert!(query.source().unwrap().is_some());
+    query.base_ref = None;
+    assert!(query.source().is_err());
+}
+
+#[test]
+fn source_query_is_exact_branch_sha_not_a_caller_observation_or_path() {
+    let mut query = query();
+    query.base_ref = Some("refs/heads/main".into());
+    query.base_commit = Some("a".repeat(40));
+    for reference in [
+        "main",
+        "HEAD",
+        "refs/tags/main",
+        "refs/heads/main~1",
+        "refs/heads/../x",
+        "refs/heads/a.lock",
+        "refs/heads/a\nb",
+    ] {
+        query.base_ref = Some(reference.into());
+        assert!(query.source().is_err(), "{reference}");
+    }
+    query.base_ref = Some("refs/heads/main".into());
+    for commit in [
+        "A".repeat(40),
+        "a".repeat(39),
+        "a".repeat(64),
+        "main".into(),
+    ] {
+        query.base_commit = Some(commit);
+        assert!(query.source().is_err());
+    }
+    let raw = json!({"registry_instance_id":Uuid::new_v4(),"namespace_id":Uuid::new_v4()});
+    for field in [
+        "storage_name",
+        "default_ref",
+        "protected_refs",
+        "verified",
+        "source_hash",
+    ] {
+        let mut changed = raw.clone();
+        changed[field] = json!(true);
+        assert!(serde_json::from_value::<RepositoryQuery>(changed).is_err());
+    }
+}
+
+#[test]
+fn all_project_defaults_and_protected_refs_are_retained_without_head_selection() {
+    let refs = protected_refs(
+        "refs/heads/main",
+        vec![
+            ("release".into(), vec!["stable".into(), "main".into()]),
+            (
+                "next".into(),
+                vec!["stable".into(), "future/not-created".into()],
+            ),
+        ],
+    )
+    .unwrap();
+    assert_eq!(
+        refs,
+        vec![
+            "refs/heads/future/not-created",
+            "refs/heads/main",
+            "refs/heads/next",
+            "refs/heads/release",
+            "refs/heads/stable"
+        ]
+    );
+}
+
+#[test]
+fn malformed_or_truncated_policy_never_becomes_an_empty_success() {
+    assert!(protected_refs("HEAD", vec![]).is_err());
+    assert!(protected_refs("refs/heads/main", vec![("bad name".into(), vec![])]).is_err());
+    assert!(
+        protected_refs(
+            "refs/heads/main",
+            vec![("main".into(), vec!["../escape".into()])]
+        )
+        .is_err()
+    );
+    assert!(protected_refs("refs/heads/main", vec![("main".into(), vec![]); 257]).is_err());
+    assert!(
+        protected_refs(
+            "refs/heads/main",
+            vec![(
+                "main".into(),
+                (0..256).map(|n| format!("protected-{n}")).collect()
+            )]
+        )
+        .is_err()
+    );
+}
+
+#[test]
+fn catalog_source_requires_exact_active_namespace_and_ready_hosted_identity() {
+    let namespace = query().namespace();
+    let group = Uuid::new_v4();
+    let command: OwnerCommand =
+        serde_json::from_value(json!({"schema_version":1,"namespace":namespace,
+        "resource":{"kind":"git_group","instance_id":Uuid::new_v4(),"resource_id":group},
+        "operation_id":Uuid::new_v4(),"generation":1,"state":"active"}))
+        .unwrap();
+    validate_catalog(&command, &namespace, group, "hosted", true).unwrap();
+    assert!(validate_catalog(&command, &query().namespace(), group, "hosted", true).is_err());
+    assert!(validate_catalog(&command, &namespace, Uuid::new_v4(), "hosted", true).is_err());
+    assert!(validate_catalog(&command, &namespace, group, "external", true).is_err());
+    assert!(validate_catalog(&command, &namespace, group, "hosted", false).is_err());
+    let mut archived = command;
+    archived.state = "archived".into();
+    assert!(validate_catalog(&archived, &namespace, group, "hosted", true).is_err());
+}
+
+#[test]
+fn old_catalog_wire_shape_is_unchanged_and_source_has_no_git_grant() {
+    let old = crate::repository_catalog::VerifiedRepository {
+        namespace: query().namespace(),
+        forge_instance_id: Uuid::new_v4(),
+        repository_id: Uuid::new_v4(),
+        public_name: "fixture/repo".into(),
+        kind: "hosted".into(),
+    };
+    let raw = serde_json::to_value(&old).unwrap();
+    assert_eq!(
+        raw,
+        serde_json::to_value(RepositoryReadback::Catalog(old)).unwrap()
+    );
+    let source = VerifiedSource {
+        namespace: query().namespace(),
+        forge_instance_id: Uuid::new_v4(),
+        repository_id: Uuid::new_v4(),
+        public_name: "fixture/repo".into(),
+        base_ref: "refs/heads/main".into(),
+        base_commit: "a".repeat(40),
+        default_ref: "refs/heads/main".into(),
+        protected_refs: vec!["refs/heads/main".into()],
+        observed_at: Utc::now(),
+    };
+    let value = serde_json::to_value(RepositoryReadback::Source(source)).unwrap();
+    assert_eq!(value.as_object().unwrap().len(), 9);
+    for field in [
+        "token",
+        "candidate_ref",
+        "git_write",
+        "dispatch_allowed",
+        "effective_admin",
+    ] {
+        assert!(value.get(field).is_none());
+    }
+}
+
+struct BareFixture(std::path::PathBuf);
+impl BareFixture {
+    fn new() -> Self {
+        let path = std::env::temp_dir().join(format!("forge-source-reader-{}", Uuid::new_v4()));
+        std::fs::create_dir(&path).unwrap();
+        let fixture = Self(path);
+        fixture.git(&["init", "--bare", "--quiet", "--initial-branch=main"]);
+        fixture
+    }
+    fn git(&self, args: &[&str]) -> String {
+        let output = std::process::Command::new("git")
+            .arg("--git-dir")
+            .arg(&self.0)
+            .args(args)
+            .env("GIT_AUTHOR_NAME", "Source fixture")
+            .env("GIT_AUTHOR_EMAIL", "fixture@example.invalid")
+            .env("GIT_COMMITTER_NAME", "Source fixture")
+            .env("GIT_COMMITTER_EMAIL", "fixture@example.invalid")
+            .stdin(Stdio::null())
+            .output()
+            .unwrap();
+        assert!(output.status.success());
+        String::from_utf8(output.stdout).unwrap().trim().to_owned()
+    }
+    fn commit(&self) -> String {
+        let tree = self.git(&["hash-object", "-t", "tree", "-w", "--stdin"]);
+        self.git(&["commit-tree", &tree, "-m", "source fixture"])
+    }
+}
+impl Drop for BareFixture {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+#[tokio::test]
+async fn native_exact_branch_ignores_same_named_tag_and_does_not_change_refs() {
+    let fixture = BareFixture::new();
+    let commit = fixture.commit();
+    fixture.git(&["update-ref", "refs/heads/main", &commit]);
+    let other = fixture.git(&["hash-object", "-t", "blob", "-w", "--stdin"]);
+    fixture.git(&["update-ref", "refs/tags/main", &other]);
+    let before = fixture.git(&["for-each-ref", "--format=%(refname) %(objectname)"]);
+    let expected = ExpectedSource {
+        reference: "refs/heads/main".into(),
+        commit: commit.clone(),
+    };
+    let (observed, default) = native_source(&fixture.0, &expected).await.unwrap();
+    assert_eq!(observed, commit);
+    assert_eq!(default, "refs/heads/main");
+    assert_eq!(
+        before,
+        fixture.git(&["for-each-ref", "--format=%(refname) %(objectname)"])
+    );
+}
+
+#[tokio::test]
+async fn native_missing_branch_or_wrong_sha_has_no_head_tag_fallback() {
+    let fixture = BareFixture::new();
+    let commit = fixture.commit();
+    fixture.git(&["update-ref", "refs/heads/main", &commit]);
+    fixture.git(&["update-ref", "refs/tags/release", &commit]);
+    assert!(
+        native_source(
+            &fixture.0,
+            &ExpectedSource {
+                reference: "refs/heads/release".into(),
+                commit: commit.clone()
+            }
+        )
+        .await
+        .is_err()
+    );
+    let error = native_source(
+        &fixture.0,
+        &ExpectedSource {
+            reference: "refs/heads/main".into(),
+            commit: "f".repeat(40),
+        },
+    )
+    .await
+    .err()
+    .unwrap();
+    assert_eq!(error.status, axum::http::StatusCode::CONFLICT);
+}
+
+#[tokio::test]
+async fn native_detached_head_is_not_a_guessed_default() {
+    let fixture = BareFixture::new();
+    let commit = fixture.commit();
+    fixture.git(&["update-ref", "refs/heads/main", &commit]);
+    fixture.git(&["update-ref", "--no-deref", "HEAD", &commit]);
+    assert!(
+        native_source(
+            &fixture.0,
+            &ExpectedSource {
+                reference: "refs/heads/main".into(),
+                commit
+            }
+        )
+        .await
+        .is_err()
+    );
+}
+
+#[tokio::test]
+async fn native_branch_must_be_a_commit_not_just_a_known_object_sha() {
+    let fixture = BareFixture::new();
+    let blob = fixture.git(&["hash-object", "-t", "blob", "-w", "--stdin"]);
+    std::fs::write(
+        fixture.0.join("refs/heads/not-a-commit"),
+        format!("{blob}\n"),
+    )
+    .unwrap();
+    assert!(
+        native_source(
+            &fixture.0,
+            &ExpectedSource {
+                reference: "refs/heads/not-a-commit".into(),
+                commit: blob
+            }
+        )
+        .await
+        .is_err()
+    );
+}
