@@ -25,4 +25,10 @@ describe('pull request navigation', () => {
   it('keeps the pull request context when opening its inline diff', () => {
     expect(buildPrDiffHref(pr)).toBe('/repositories/platform-core/pulls/7?view=diff')
   })
+
+  it('pins merged comparison links to the accepted commit and its first parent', () => {
+    const sha = '28267bbaab74de08109d49057bdd147e4c2f5be6'
+    expect(buildCompareHref({ ...pr, status: 'merged', merge_commit_sha: sha })).toBe(`/repositories/platform-core/compare?from=${sha}%5E1&to=${sha}`)
+    expect(buildCompareHref({ ...pr, status: 'merged' })).toBeNull()
+  })
 })
