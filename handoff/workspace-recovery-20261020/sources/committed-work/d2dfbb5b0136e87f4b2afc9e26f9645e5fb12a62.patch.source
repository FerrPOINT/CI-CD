diff --cc frontend/src/pages/login/login.test.tsx
index 0000000,efaf5e0..956f3dd
mode 000000,100644..100644
--- a/frontend/src/pages/login/login.test.tsx
+++ b/frontend/src/pages/login/login.test.tsx
@@@ -1,0 -1,70 +1,69 @@@
+ import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+ import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+ import { MemoryRouter } from 'react-router'
+ import { SsoLogoutPendingError } from '@sdlc/ui/sso'
+ import { LoginPage } from './'
+ 
+ const beginSso = vi.hoisted(() => vi.fn<(...args: unknown[]) => Promise<void>>(async () => {}))
+ vi.mock('@sdlc/ui/sso', async (importOriginal) => ({
+   ...await importOriginal<typeof import('@sdlc/ui/sso')>(), beginSso,
+ }))
+ vi.mock('@sdlc/ui/ui', async (importOriginal) => ({
+   ...await importOriginal<typeof import('@sdlc/ui/ui')>(),
+   PlatformMark: () => <span>SDLC</span>,
+ }))
+ vi.mock('@/shared/auth/auth-provider', () => ({
+   ssoConfig: { issuer: 'http://localhost:7701', clientId: 'ci-cd' },
+   useAuth: () => ({ status: 'anonymous' }),
+ }))
+ 
+ function renderLogin(path = '/login') {
+   return render(<MemoryRouter initialEntries={[path]}><LoginPage /></MemoryRouter>)
+ }
+ 
+ describe('ci-cd login recovery', () => {
+   beforeEach(() => {
+     beginSso.mockReset().mockResolvedValue(undefined)
+   })
+   afterEach(cleanup)
+ 
+   it('keeps automatic guards non-interactive', async () => {
+     renderLogin()
+     await waitFor(() => expect(beginSso).toHaveBeenCalledWith(
+       expect.objectContaining({ clientId: 'ci-cd' }), '/',
+     ))
+   })
+ 
+   it('requires explicit login after logout and marks it interactive', async () => {
+     renderLogin('/login?logged_out=1')
+     expect(beginSso).not.toHaveBeenCalled()
+     fireEvent.click(screen.getByRole('button', { name: 'Войти через SDLC' }))
+     await waitFor(() => expect(beginSso).toHaveBeenCalledWith(
+       expect.objectContaining({ clientId: 'ci-cd' }), '/', { interactive: true },
+     ))
+   })
+ 
+   it.each([new SsoLogoutPendingError(), new DOMException('Cancelled', 'AbortError')])(
+     'does not report interrupted automatic navigation as auth failure: %s', async (error) => {
+       beginSso.mockRejectedValueOnce(error)
+       renderLogin()
+       await waitFor(() => expect(beginSso).toHaveBeenCalledOnce())
+       fireEvent.click(screen.getByRole('button', { name: 'Войти через SDLC' }))
+       await waitFor(() => expect(beginSso).toHaveBeenCalledTimes(2))
+       expect(screen.queryByRole('alert')).not.toBeInTheDocument()
+       expect(beginSso).toHaveBeenLastCalledWith(
+         expect.objectContaining({ clientId: 'ci-cd' }), '/', { interactive: true },
+       )
+     },
+   )
+ 
+   it('keeps real auth failure visible and clears it after retry', async () => {
+     beginSso.mockRejectedValueOnce(new Error('private auth details'))
+     renderLogin('/login?logged_out=1')
+     fireEvent.click(screen.getByRole('button', { name: 'Войти через SDLC' }))
+     expect(await screen.findByRole('alert')).toHaveTextContent('Central Auth временно недоступен.')
+     expect(screen.queryByText(/private auth details/)).not.toBeInTheDocument()
+     fireEvent.click(screen.getByRole('button', { name: 'Войти через SDLC' }))
+     await waitFor(() => expect(screen.queryByRole('alert')).not.toBeInTheDocument())
+   })
+ })
 -
diff --cc plans/2026-10-02-base-ui-default-reconciliation.md
index 0000000,0000000..bf446f6
new file mode 100644
--- /dev/null
+++ b/plans/2026-10-02-base-ui-default-reconciliation.md
@@@ -1,0 -1,0 +1,63 @@@
++# Сохранение Default Fixes В Base UI-Кандидате
++
++Продолжение утверждённой стандартизации всех семи продуктов. Исходный owned
++CI/CD: `07f6665aee1d0940a84f898b2f7153ae8228be59`, clean, ahead 6 / behind 35
++сохранённого `origin/main=365afd2ba5b414d01a9fd4053d6afc2f2cf5a53d`.
++GitHub/fetch/Actions и canonical runtime не используются.
++
++Merge должен сохранить incoming техническую Base унификацию, recovery SSO
++navigation, session до Central Auth logout, actual-peer rate limit и
++authenticated PostgreSQL policy fixtures. Общий AppShell, page compositions,
++URL/draft/state fixes нашей ветки сохраняются. Product API и schema этим шагом
++не расширяются. Единственный Git conflict — add/add `.base-revision`; он
++разрешается на SHA итогового проверенного Base. Дублирующий packageManager,
++появившийся при auto-merge JSON, удаляется без изменения версии.
++
++Проверки: frozen install/installed fingerprint, frontend tests/lint/build,
++theme/OpenAPI/UI/docs gates; Rust 1.88 fmt/clippy с integration feature,
++workspace tests, real scratch PostgreSQL integration_db/target_policy/CLI
++и release build. Test DB и build containers временные и принадлежат только QA;
++чужие containers/volumes и pinned images не меняются. Результаты предыдущего
++source-кандидата не подтверждают новый merge или фактический image.
++
++Все потребители должны получить один Base snapshot. Operational route/image/
++SSO/role/state/browser acceptance, desktop gallery/provenance, default integration
++и mirror остаются обязательными; Pulse исключён только из каталога и mirror.
++
++Real CLI gate выявил устаревший fixture без auth: текущий protected API требует
++настроенную auth и возвращает 503 при её отсутствии. Fixtures получают JWT
++тестовых учёток; fail-closed API и строгий Base constructor сохраняются. Тесты
++проверяют missing credentials (exit 2), invalid bearer и RBAC (exit 5), not-found
++(exit 4), priority над обоими env tokens и redaction вместо parsing старого
++server stderr. Clippy finding `len() >= 1` исправлен без allow; merge whitespace
++в login test также исправлен. Предварительный anonymous transport не принят
++и удалён до commit: не возвращать auth bypass ради прежнего fixture.
