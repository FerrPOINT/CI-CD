index b0ab6de..d1d26a9 100644
--- a/frontend/nginx.conf
+++ b/frontend/nginx.conf
@@ -4,7 +4,7 @@ server {
   root /usr/share/nginx/html;
 
   # REST API and Git Smart HTTP share the backend service.
-  location /api/ { proxy_pass http://backend:22801; }
-  location /git/ { proxy_pass http://backend:22801; }
+  location /api/ { proxy_pass http://cicd-backend:22801; }
+  location /git/ { proxy_pass http://cicd-backend:22801; }
   location / { try_files $uri $uri/ /index.html; }
 }
