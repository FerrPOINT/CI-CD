+        aliases: [backend]
     ports: !reset []
     environment:
       CICD_AUTH_SECRET: ${CICD_AUTH_SECRET:?set a non-empty value in .env}
       CICD_AUTH_COOKIE_SECURE: "true"
       CICD_CORS_ALLOWED_ORIGINS: https://${CICD_TLS_HOST:?set in .env}:${CICD_TLS_HTTPS_PORT:-22443}
 
-  frontend:
+  cicd-web:
+    networks:
+      default:
+        aliases: [frontend]
     ports: !reset []
 
   caddy:
     image: caddy:2.10.2-alpine@sha256:d8c17a862962def15cde69863a3a463f25a2664942eafd7bdbf050e9c3116b83
     restart: unless-stopped
     depends_on:
-      backend:
+      cicd-backend:
         condition: service_healthy
-      frontend:
+      cicd-web:
         condition: service_started
     environment:
       CICD_TLS_HOST: ${CICD_TLS_HOST:?set in .env}
