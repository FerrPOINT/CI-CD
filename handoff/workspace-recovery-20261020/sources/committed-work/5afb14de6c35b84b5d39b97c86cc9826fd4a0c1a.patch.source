diff --git a/backend/src/api/authz_mw.rs b/backend/src/api/authz_mw.rs
index 1889241..ba67253 100644
--- a/backend/src/api/authz_mw.rs
+++ b/backend/src/api/authz_mw.rs
@@ -20,17 +20,18 @@ pub(crate) async fn request_id_mw(
     req: axum::extract::Request,
     next: axum::middleware::Next,
 ) -> axum::response::Response {
-    let id = req
+    let supplied = req
         .headers()
         .get("x-request-id")
-        .and_then(|v| v.to_str().ok())
-        .and_then(|v| uuid::Uuid::parse_str(v).ok())
-        .unwrap_or_else(uuid::Uuid::new_v4);
+        .and_then(|value| value.to_str().ok())
+        .filter(|value| value.len() == 36)
+        .and_then(|value| Uuid::parse_str(value).ok().map(|id| (id, value.to_owned())));
+    let (id, value) = supplied.unwrap_or_else(|| {
+        let id = Uuid::new_v4();
+        (id, id.to_string())
+    });
     REQUEST_ID
-        .scope(
-            id,
-            sdlc_telemetry::run_with_request_id(req, next, id.to_string()),
-        )
+        .scope(id, sdlc_telemetry::run_with_request_id(req, next, value))
         .await
 }
 
