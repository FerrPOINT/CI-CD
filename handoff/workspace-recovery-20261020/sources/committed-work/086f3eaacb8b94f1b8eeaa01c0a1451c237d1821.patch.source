diff --git a/backend/src/git_host.rs b/backend/src/git_host.rs
index db739b2..def8a12 100644
--- a/backend/src/git_host.rs
+++ b/backend/src/git_host.rs
@@ -543,6 +543,81 @@ fn maybe_gunzip(headers: &HeaderMap, body: Bytes) -> Result<Bytes, ApiError> {
     Ok(out.into())
 }
 
+fn receive_pack_refs(body: &[u8]) -> Result<Vec<&str>, ApiError> {
+    let mut cursor = 0;
+    let mut refs = Vec::new();
+    loop {
+        let header = body
+            .get(cursor..cursor + 4)
+            .ok_or_else(|| ApiError::bad_request("invalid git receive-pack packet"))?;
+        let length = std::str::from_utf8(header)
+            .ok()
+            .and_then(|value| usize::from_str_radix(value, 16).ok())
+            .ok_or_else(|| ApiError::bad_request("invalid git receive-pack packet length"))?;
+        cursor += 4;
+        if length == 0 {
+            break;
+        }
+        if length < 4 || cursor + length - 4 > body.len() {
+            return Err(ApiError::bad_request(
+                "invalid git receive-pack packet length",
+            ));
+        }
+        let packet = &body[cursor..cursor + length - 4];
+        cursor += length - 4;
+        let command = packet.split(|byte| *byte == 0).next().unwrap_or(packet);
+        let command = std::str::from_utf8(command)
+            .map_err(|_| ApiError::bad_request("invalid git receive-pack command"))?;
+        let mut fields = command.split_ascii_whitespace();
+        let (Some(old), Some(new), Some(reference), None) =
+            (fields.next(), fields.next(), fields.next(), fields.next())
+        else {
+            return Err(ApiError::bad_request("invalid git receive-pack command"));
+        };
+        if !is_probable_object_id(old) || !is_probable_object_id(new) {
+            return Err(ApiError::bad_request("invalid git receive-pack object id"));
+        }
+        refs.push(reference);
+    }
+    if refs.is_empty() {
+        return Err(ApiError::bad_request("empty git receive-pack command list"));
+    }
+    Ok(refs)
+}
+
+async fn reject_protected_push(pool: &PgPool, repo: &str, body: &[u8]) -> Result<(), ApiError> {
+    let refs = receive_pack_refs(body)?;
+    let name = validate_repo_name(repo).map_err(ApiError::bad_request)?;
+    let patterns = repository_url_like_patterns(&name);
+    let protected: Vec<Vec<String>> = sqlx::query_scalar(
+        "SELECT protected_branches FROM projects WHERE repository_url ILIKE $1 ESCAPE '\\' OR repository_url ILIKE $2 ESCAPE '\\' OR repository_url ILIKE $3 ESCAPE '\\'",
+    )
+    .bind(&patterns.path)
+    .bind(&patterns.scp)
+    .bind(&patterns.exact)
+    .fetch_all(pool)
+    .await
+    .map_err(ApiError::internal)?;
+    tracing::debug!(repository = %name, ?refs, ?protected, "checking protected push policy");
+    if refs
+        .iter()
+        .any(|reference| protected_ref_match(reference, &protected))
+    {
+        return Err(ApiError::conflict(
+            "direct push to a protected branch is forbidden; use a pull request",
+        ));
+    }
+    Ok(())
+}
+
+fn protected_ref_match(reference: &str, policies: &[Vec<String>]) -> bool {
+    reference.strip_prefix("refs/heads/").is_some_and(|branch| {
+        policies
+            .iter()
+            .any(|branches| branches.iter().any(|item| item == branch))
+    })
+}
+
 async fn run_git_service(
     path: &Path,
     service: &str, // "upload-pack" | "receive-pack"
@@ -625,6 +700,11 @@ pub async fn git_service_endpoint(
         Ok(body) => body,
         Err(e) => return e.into_response(),
     };
+    if operation == GitOperation::Write {
+        if let Err(error) = reject_protected_push(pool, &repo, &body).await {
