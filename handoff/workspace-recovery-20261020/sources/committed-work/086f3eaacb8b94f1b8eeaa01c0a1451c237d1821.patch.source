+        }
+    }
     match run_git_service(path.as_path(), service, body).await {
         Ok(out) => (
             StatusCode::OK,
@@ -881,6 +961,43 @@ mod tests {
         assert!(line.ends_with(b"# service=git-upload-pack\n"));
     }
 
+    #[test]
+    fn receive_pack_reads_every_updated_ref() {
+        let old = "0".repeat(40);
+        let new = "a".repeat(40);
+        let first = format!("{old} {new} refs/heads/feature\0report-status\n");
+        let second = format!("{old} {new} refs/heads/main\n");
+        let mut body = pkt_line(&first);
+        body.extend(pkt_line(&second));
+        body.extend(b"0000PACK");
+        assert_eq!(
+            receive_pack_refs(&body).expect("valid commands"),
+            vec!["refs/heads/feature", "refs/heads/main"]
+        );
+    }
+
+    #[test]
+    fn receive_pack_rejects_truncated_commands() {
+        let old = "0".repeat(40);
+        let new = "a".repeat(40);
+        let body = pkt_line(&format!("{old} {new} refs/heads/main\n"));
+        assert!(receive_pack_refs(&body).is_err());
+        assert!(receive_pack_refs(b"0000").is_err());
+    }
+
+    #[test]
+    fn protected_refs_match_exact_branches_only() {
+        let policies = vec![vec!["main".to_string()]];
+        assert!(protected_ref_match("refs/heads/main", &policies));
+        assert!(!protected_ref_match("refs/heads/main-next", &policies));
+        assert!(!protected_ref_match("refs/tags/main", &policies));
+        let name = validate_repo_name("service-pulse-qa.git").expect("valid repository");
+        assert_eq!(
+            repository_url_like_patterns(&name).path,
+            "%/service-pulse-qa.git"
+        );
+    }
+
