diff --git a/frontend/src/main.notifications.test.tsx b/frontend/src/main.notifications.test.tsx
new file mode 100644
index 0000000..fe9af13
--- /dev/null
+++ b/frontend/src/main.notifications.test.tsx
@@ -0,0 +1,64 @@
+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import type { ReactElement } from 'react'
+import { afterEach, beforeAll, describe, expect, it, vi } from 'vitest'
+import { toast } from 'sonner'
+import { useTheme } from '@sdlc/ui/lib'
+import i18n from './shared/i18n/config'
+
+const bootstrap = vi.hoisted(() => ({ element: null as ReactElement | null }))
+vi.mock('react-dom/client', () => ({
+  createRoot: () => ({
+    render: (element: ReactElement) => {
+      bootstrap.element = element
+    },
+  }),
+}))
+vi.mock('./app/router', () => ({ router: {} }))
+vi.mock('react-router', async (original) => {
+  const actual = await original<typeof import('react-router')>()
+  return {
+    ...actual,
+    RouterProvider: () => {
+      const { setTheme } = useTheme()
+      return <button onClick={() => setTheme('light')}>Fixture theme</button>
+    },
+  }
+})
+import './main'
+
+beforeAll(async () => {
+  await i18n.changeLanguage('ru')
+})
+
+afterEach(() => {
+  toast.dismiss()
+  cleanup()
+  localStorage.clear()
+})
+
+describe('Forge CI/CD bootstrap Base notifications', () => {
+  it.each(['dark', 'gray', 'light'] as const)('uses one shared peer host in %s', async (theme) => {
+    localStorage.setItem('theme', theme)
+    const { container } = render(bootstrap.element!)
+    const trigger = await screen.findByRole('button', { name: 'Fixture theme' })
+    trigger.focus()
+    await act(async () => {
+      toast.message('Fixture only', { duration: Infinity })
+    })
+    await screen.findByText('Fixture only')
+    expect(screen.getAllByRole('region', { name: 'Уведомления' })).toHaveLength(1)
+    const hosts = container.querySelectorAll('[data-sonner-toaster]')
+    expect(hosts).toHaveLength(1)
+    const host = hosts[0]
+    expect(host).toHaveClass('base-toaster')
+    expect(host).toHaveAttribute('data-sonner-theme', theme === 'light' ? 'light' : 'dark')
+    expect(host).toHaveAttribute('data-x-position', 'right')
+    expect(host).toHaveAttribute('data-y-position', 'bottom')
+    expect(trigger).toHaveFocus()
+    fireEvent.click(trigger)
+    expect(container.querySelector('[data-sonner-toaster]')).toBe(host)
+    expect(host).toHaveAttribute('data-sonner-theme', 'light')
+    fireEvent.click(screen.getByRole('button', { name: 'Закрыть уведомление' }))
+    await waitFor(() => expect(screen.queryByText('Fixture only')).not.toBeInTheDocument())
+  })
+})
