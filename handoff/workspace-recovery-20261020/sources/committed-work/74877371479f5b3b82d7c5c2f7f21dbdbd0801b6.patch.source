       if (audit.reportWait) await audit.reportWait
       if (audit.reportStatus === 0) return route.abort('failed')
@@ -139,6 +156,76 @@ async function ready(page: Page, path = '/audit-log') {
   ).toBeVisible()
 }
 
+for (const theme of ['dark', 'gray', 'light']) {
+  for (const width of [375, 1440, 1920, 2560]) {
+    test(`Base notifications: confirmed project create in ${theme} at ${width}`, async ({ page }, testInfo) => {
+      await page.setViewportSize({ width, height: 1080 })
+      await page.addInitScript((value) => localStorage.setItem('theme', value), theme)
+      const fixture = await mocks(page)
+      const errors: string[] = []
+      page.on('pageerror', (error) => errors.push(error.message))
+      page.on('console', (message) => { if (message.type() === 'error') errors.push(message.text()) })
+      await page.goto('/projects?context=keep#notifications')
+      await expect(page.getByRole('heading', { level: 1, name: 'Проекты', exact: true })).toBeVisible()
+      await page.getByRole('button', { name: 'Создать проект', exact: true }).click()
+      const form = page.getByRole('form', { name: 'Создать проект', exact: true })
+      await form.getByLabel('Название', { exact: true }).fill('Безопасный QA проект')
+      await form.getByLabel('URL репозитория', { exact: true }).fill('https://git.example.test/qa/project.git')
+      let release!: () => void
+      fixture.projectWait = new Promise<void>((done) => { release = done })
+      const main = page.locator('main')
+      try {
+        await form.getByRole('button', { name: 'Создать проект', exact: true }).click()
+        await expect.poll(() => fixture.projectWrites).toBe(1)
+        await expect(form.getByRole('button', { name: 'Создать проект', exact: true })).toBeDisabled()
+        await expect(page.getByText('Проект создан', { exact: true })).toHaveCount(0)
+        await main.focus()
+        await expect(main).toBeFocused()
+      } finally {
+        fixture.projectWait = undefined
+        release()
+      }
+      const host = page.locator('[data-sonner-toaster]')
+      await expect(page.getByText('Проект создан', { exact: true })).toBeVisible()
+      await expect(main).toBeFocused()
+      await expect(host).toHaveCount(1)
+      await expect(host).toHaveClass(/base-toaster/)
+      await expect(host).toHaveAttribute('data-x-position', 'right')
+      await expect(host).toHaveAttribute('data-y-position', 'bottom')
+      await expect(host).toHaveAttribute('data-sonner-theme', theme === 'light' ? 'light' : 'dark')
+      await expect(page.locator('html')).toHaveAttribute('data-theme', theme)
+      const dismiss = page.getByRole('button', { name: 'Закрыть уведомление', exact: true })
+      const target = (await dismiss.boundingBox())!
+      const minimum = width < 768 ? 44 : 40
+      expect(target.width).toBeGreaterThanOrEqual(minimum)
+      expect(target.height).toBeGreaterThanOrEqual(minimum)
+      expect(target.x).toBeGreaterThanOrEqual(0)
+      expect(target.x + target.width).toBeLessThanOrEqual(width)
+      expect(await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth)).toBeLessThanOrEqual(1)
+      const capture = testInfo.outputPath('base-notification.png')
+      await page.screenshot({ path: capture, fullPage: true, animations: 'disabled' })
+      const axe = await new AxeBuilder({ page }).include('[data-base-shell]').include('.base-toaster').analyze()
+      expect(axe.violations.filter((item) => item.impact === 'serious' || item.impact === 'critical')).toEqual([])
+      await dismiss.focus()
+      await page.keyboard.press('Enter')
+      await expect(page.getByText('Проект создан', { exact: true })).toHaveCount(0)
+      await expect(page.getByRole('link', { name: 'Открыть пайплайны проекта Безопасный QA проект', exact: true })).toBeVisible()
+      await expect(page).toHaveURL(/\/projects\?context=keep#notifications$/)
+      expect(fixture.projectWrites).toBe(1)
+      expect(fixture.unexpected).toEqual([])
+      expect(errors).toEqual([])
+      await testInfo.attach('base-notification-scope.json', {
+        contentType: 'application/json',
+        body: Buffer.from(JSON.stringify({
+          theme, viewport: { width, height: 1080 }, route: '/projects?context=keep#notifications',
+          writes: fixture.projectWrites, prematureSuccess: false, focusRemainsInPage: true,
+          keyboardDismiss: true, target, fixtureOnly: true, actualImages: false, releaseAcceptance: false,
+        })),
+      })
+    })
+  }
+}
