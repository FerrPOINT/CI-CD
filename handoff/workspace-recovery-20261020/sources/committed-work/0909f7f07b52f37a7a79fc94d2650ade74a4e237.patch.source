+#[tokio::test]
+async fn project_lists_include_protection_for_legacy_member_tokens() {
+    let pool = test_pool().await;
+    let project_id = Uuid::new_v4();
+    let other_id = Uuid::new_v4();
+    for id in [project_id, other_id] {
+        sqlx::query("INSERT INTO projects (id, name, repository_url, protected_branches, max_running_jobs) VALUES ($1, $2, $3, $4, 3)")
+            .bind(id)
+            .bind(format!("member-list-{id}"))
+            .bind(format!("https://example.invalid/{id}.git"))
+            .bind(vec!["main"])
+            .execute(&pool)
+            .await
+            .unwrap();
+    }
+    let app = authenticated_app(pool.clone()).await;
+    let mut results = Vec::new();
+    for role in ["viewer", "developer"] {
+        let user_id = Uuid::new_v4();
+        sqlx::query("INSERT INTO users (id, username, role) VALUES ($1, $2, $3)")
+            .bind(user_id)
+            .bind(format!("member-{user_id}"))
+            .bind(role)
+            .execute(&pool)
+            .await
+            .unwrap();
+        sqlx::query(
+            "INSERT INTO project_memberships (project_id, user_id, role) VALUES ($1, $2, $3)",
+        )
+        .bind(project_id)
+        .bind(user_id)
+        .bind(role)
+        .execute(&pool)
+        .await
+        .unwrap();
+        for scope in [None, Some(project_id)] {
+            let token = format!("cicd_{}", Uuid::new_v4().simple());
+            sqlx::query("INSERT INTO api_tokens (id, name, token_hash, token_hint, user_id, project_id, scopes, expires_at) VALUES ($1, 'member-list', $2, 'fixture', $3, $4, $5, now() + interval '1 day')")
+                .bind(Uuid::new_v4())
+                .bind(cicd::auth::hash_token(&token))
+                .bind(user_id)
+                .bind(scope)
+                .bind(vec!["api:read"])
+                .execute(&pool)
+                .await
+                .unwrap();
+            let response = app
+                .clone()
+                .oneshot(
+                    Request::get("/api/v1/projects?limit=200&offset=0")
+                        .header("authorization", format!("Bearer {token}"))
+                        .body(Body::empty())
+                        .unwrap(),
+                )
+                .await
+                .unwrap();
+            let status = response.status();
+            let body = response_json(response).await;
+            results.push((role, scope.is_some(), status, body));
+            let page = app
+                .clone()
+                .oneshot(
+                    Request::get("/api/v1/projects?limit=1&offset=1")
+                        .header("authorization", format!("Bearer {token}"))
+                        .body(Body::empty())
+                        .unwrap(),
+                )
+                .await
+                .unwrap();
+            assert_eq!(page.status(), StatusCode::OK, "empty page {role} {scope:?}");
+            assert_eq!(response_json(page).await, serde_json::json!([]));
+        }
+    }
+    for (role, scoped, status, body) in results {
+        assert_eq!(status, StatusCode::OK, "{role}, scoped={scoped}: {body}");
+        let projects = body.as_array().unwrap();
+        assert_eq!(projects.len(), 1, "{role}, scoped={scoped}");
+        assert_eq!(projects[0]["id"], project_id.to_string());
+        assert_eq!(
+            projects[0]["protected_branches"],
+            serde_json::json!(["main"])
+        );
+        assert_eq!(projects[0]["max_running_jobs"], 3);
+        assert!(projects.iter().all(|p| p["id"] != other_id.to_string()));
+    }
+}
+
