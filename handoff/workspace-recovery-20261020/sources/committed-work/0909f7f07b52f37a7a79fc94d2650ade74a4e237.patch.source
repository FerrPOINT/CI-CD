+async fn protected_pull_requires_successful_pipeline_on_current_head() {
+    verify_merged_pull_diff(Some(true)).await;
+}
+
+async fn verify_merged_pull_diff(project_protection: Option<bool>) {
+    let pool = test_pool().await;
+    let name = format!("merged-diff-{}", Uuid::new_v4().simple());
+    let root = std::env::temp_dir().join(format!("forge-{name}"));
+    let worktree = root.join("worktree");
+    let work = worktree.to_str().unwrap();
+    let bare = root.join(format!("{name}.git"));
+    let git_dir = format!("--git-dir={}", bare.display());
+    tokio::fs::create_dir_all(&root).await.unwrap();
+    run_git(
+        &["init", "--quiet", "--initial-branch=main"],
+        Some(&worktree),
+    )
+    .await;
+    run_git(&["-C", work, "config", "user.name", "Forge Test"], None).await;
+    run_git(
+        &["-C", work, "config", "user.email", "forge@example.test"],
+        None,
+    )
+    .await;
+    tokio::fs::write(worktree.join("README.md"), b"base\n")
+        .await
+        .unwrap();
+    run_git(&["-C", work, "add", "."], None).await;
+    run_git(&["-C", work, "commit", "--quiet", "-m", "Base"], None).await;
+    run_git(&["-C", work, "checkout", "--quiet", "-b", "feature"], None).await;
+    tokio::fs::write(worktree.join("README.md"), b"base\nrelease_sha\n")
+        .await
+        .unwrap();
+    run_git(&["-C", work, "commit", "--quiet", "-am", "Change"], None).await;
+    run_git(&["clone", "--bare", "--quiet", work], Some(&bare)).await;
+    sqlx::query("INSERT INTO repositories (id, name) VALUES ($1, $2)")
+        .bind(Uuid::new_v4())
+        .bind(&name)
+        .execute(&pool)
+        .await
+        .unwrap();
+    let project_id = Uuid::new_v4();
+    if let Some(protected) = project_protection {
+        sqlx::query("INSERT INTO projects (id, name, repository_url, protected_branches) VALUES ($1, $2, $3, $4)")
+            .bind(project_id)
+            .bind(&name)
+            .bind(format!("http://localhost/git/{name}.git"))
+            .bind(if protected { vec!["main"] } else { vec![] })
+            .execute(&pool)
+            .await
+            .unwrap();
+    }
+    let app = authenticated_app_with_git(
+        pool.clone(),
+        cicd::git_host::GitConfig {
+            root: root.clone(),
+            ..Default::default()
+        },
+    )
+    .await;
+    let created = app
+        .clone()
+        .oneshot(
+            Request::post(format!("/api/v1/repos/{name}/pulls"))
+                .header("content-type", "application/json")
+                .body(Body::from(
+                    serde_json::json!({
+                        "repository_name": name, "title": "Release identity",
+                        "source_branch": "feature", "target_branch": "main"
+                    })
+                    .to_string(),
+                ))
+                .unwrap(),
+        )
+        .await
+        .unwrap();
+    assert_eq!(created.status(), StatusCode::OK);
+    let number = response_json(created).await["number"].as_i64().unwrap();
+    if project_protection == Some(true) {
+        let head = tokio::process::Command::new("git")
+            .args([&git_dir, "rev-parse", "feature"])
+            .output()
+            .await
+            .unwrap();
+        assert!(head.status.success());
+        let head = String::from_utf8(head.stdout).unwrap().trim().to_string();
+        let base = tokio::process::Command::new("git")
+            .args([&git_dir, "rev-parse", "main"])
+            .output()
+            .await
+            .unwrap();
+        assert!(base.status.success());
+        let base = String::from_utf8(base.stdout).unwrap().trim().to_string();
+        for (status, commit) in [("success", &base), ("failed", &head)] {
+            sqlx::query("INSERT INTO pipelines (id, project_id, git_ref, commit_sha, status) VALUES ($1, $2, 'feature', $3, $4)")
+                .bind(Uuid::new_v4())
+                .bind(project_id)
+                .bind(commit)
+                .bind(status)
+                .execute(&pool)
+                .await
+                .unwrap();
+            let denied = app
+                .clone()
+                .oneshot(
+                    Request::post(format!("/api/v1/repos/{name}/pulls/{number}/action"))
+                        .header("content-type", "application/json")
+                        .body(Body::from(r#"{"action":"merge"}"#))
+                        .unwrap(),
+                )
+                .await
+                .unwrap();
+            assert_eq!(denied.status(), StatusCode::CONFLICT, "{status} {commit}");
+            let main = tokio::process::Command::new("git")
+                .args([&git_dir, "rev-parse", "main"])
+                .output()
+                .await
+                .unwrap();
+            assert!(main.status.success());
+            assert_eq!(String::from_utf8(main.stdout).unwrap().trim(), base);
+            let status: String = sqlx::query_scalar(
+                "SELECT status FROM pull_requests WHERE repository_name = $1 AND number = $2",
+            )
+            .bind(&name)
+            .bind(number as i32)
+            .fetch_one(&pool)
+            .await
+            .unwrap();
+            assert_eq!(status, "open");
+        }
+        sqlx::query("INSERT INTO pipelines (id, project_id, git_ref, commit_sha, status) VALUES ($1, $2, 'feature', $3, 'success')")
+            .bind(Uuid::new_v4())
+            .bind(project_id)
+            .bind(&head)
+            .execute(&pool)
+            .await
+            .unwrap();
+    }
+    let merged = app
+        .clone()
+        .oneshot(
+            Request::post(format!("/api/v1/repos/{name}/pulls/{number}/action"))
+                .header("content-type", "application/json")
+                .body(Body::from(r#"{"action":"merge"}"#))
+                .unwrap(),
+        )
+        .await
+        .unwrap();
+    assert_eq!(merged.status(), StatusCode::OK);
+    let merged = response_json(merged).await;
+    let sha = merged["merge_commit_sha"].as_str().unwrap();
+    let parents = tokio::process::Command::new("git")
+        .args([&git_dir, "rev-parse", &format!("{sha}^1")])
+        .output()
+        .await
+        .unwrap();
+    assert!(parents.status.success());
+    let base = String::from_utf8(parents.stdout)
+        .unwrap()
+        .trim()
+        .to_string();
+    assert_ne!(base, sha);
+
+    let mutable = app
+        .clone()
+        .oneshot(
+            Request::get(format!("/api/v1/repos/{name}/compare?from=main&to=feature"))
+                .body(Body::empty())
+                .unwrap(),
+        )
+        .await
+        .unwrap();
+    assert_eq!(mutable.status(), StatusCode::OK);
+    assert!(
+        response_json(mutable).await["files"]
+            .as_array()
+            .unwrap()
+            .is_empty()
+    );
+
+    for state in ["merged", "advanced", "deleted"] {
+        if state == "advanced" {
+            run_git(
+                &[
+                    "-C",
+                    work,
+                    "fetch",
+                    "--quiet",
+                    bare.to_str().unwrap(),
+                    "main",
+                ],
+                None,
+            )
+            .await;
+            run_git(
+                &["-C", work, "checkout", "--quiet", "--detach", "FETCH_HEAD"],
+                None,
+            )
+            .await;
+            tokio::fs::write(worktree.join("later.txt"), b"not in this PR\n")
+                .await
+                .unwrap();
+            run_git(&["-C", work, "add", "."], None).await;
+            run_git(&["-C", work, "commit", "--quiet", "-m", "Later"], None).await;
+            run_git(
+                &[
+                    &git_dir,
+                    "fetch",
+                    "--quiet",
+                    work,
+                    "HEAD:refs/heads/main",
+                    "HEAD:refs/heads/feature",
+                ],
+                None,
+            )
+            .await;
+        } else if state == "deleted" {
+            run_git(&[&git_dir, "update-ref", "-d", "refs/heads/main"], None).await;
+            run_git(&[&git_dir, "update-ref", "-d", "refs/heads/feature"], None).await;
+        }
+        let diff = app
+            .clone()
+            .oneshot(
+                Request::get(format!(
+                    "/api/v1/repos/{name}/compare?from={sha}%5E1&to={sha}"
+                ))
+                .body(Body::empty())
+                .unwrap(),
+            )
+            .await
+            .unwrap();
+        assert_eq!(diff.status(), StatusCode::OK, "{state}");
+        let diff = response_json(diff).await;
+        assert_eq!(diff["merge_base"], base.to_string(), "{state}");
+        assert_eq!(diff["files"].as_array().unwrap().len(), 1, "{state}");
+        assert_eq!(diff["files"][0]["path"], "README.md", "{state}");
+        assert!(
+            diff["patch"].as_str().unwrap().contains("+release_sha"),
+            "{state}"
+        );
+        assert!(
+            !diff["patch"].as_str().unwrap().contains("later.txt"),
+            "{state}"
+        );
+    }
+    let unavailable = app
+        .oneshot(
+            Request::get(format!(
+                "/api/v1/repos/{name}/compare?from={}%5E1&to={}",
+                "0".repeat(40),
+                "0".repeat(40)
+            ))
+            .body(Body::empty())
+            .unwrap(),
+        )
+        .await
+        .unwrap();
+    assert_eq!(unavailable.status(), StatusCode::BAD_REQUEST);
+    tokio::fs::remove_dir_all(root).await.unwrap();
+}
+
 async fn bearer(response: axum::response::Response) -> String {
     let body = String::from_utf8(
         axum::body::to_bytes(response.into_body(), usize::MAX)
