                  FROM projects p \
                  LEFT JOIN project_memberships m ON m.project_id = p.id AND m.user_id = $3 \
                  LEFT JOIN tenant_memberships tm ON tm.user_id = $3 AND tm.tenant_id = p.tenant_id \
