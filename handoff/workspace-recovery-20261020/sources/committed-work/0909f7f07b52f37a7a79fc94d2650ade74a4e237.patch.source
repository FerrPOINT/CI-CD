+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn cli_reports_unconfigured_auth_as_unavailable() {
+    let pool = test_pool().await;
+    let server = ApiServer::start(pool).await;
+    let response = reqwest::Client::new()
+        .get(format!("{}/api/v1/projects", server.base_url))
+        .send()
+        .await
+        .expect("query unconfigured API");
+    assert_eq!(response.status(), reqwest::StatusCode::SERVICE_UNAVAILABLE);
+    let output = tokio::task::block_in_place(|| {
+        Command::new(env!("CARGO_BIN_EXE_cicd-cli"))
+            .env_remove("SDLC_API_TOKEN")
+            .env_remove("CICD_PROFILE")
+            .env("CICD_API_TOKEN", "unconfigured-auth-fixture-token")
+            .args(["--api-url", &server.base_url, "project", "list"])
+            .output()
+            .expect("run CLI against unconfigured API")
+    });
+    assert_eq!(output.status.code(), Some(3));
+    assert!(String::from_utf8_lossy(&output.stderr).contains("service is temporarily unavailable"));
+    assert!(output.stdout.is_empty());
     server.shutdown().await;
 }
 
