 +        await expect.poll(() => fixture.projectWrites).toBe(1)
 +        await expect(form.getByRole('button', { name: 'Создать проект', exact: true })).toBeDisabled()
++        await expect(form).toHaveAttribute('aria-busy', 'true')
++        for (const field of await form.getByRole('textbox').all()) {
