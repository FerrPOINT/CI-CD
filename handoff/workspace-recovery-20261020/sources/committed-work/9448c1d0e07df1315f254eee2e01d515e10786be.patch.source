 +test('shared shell and audit geometry across themes and breakpoint boundaries', async ({
 +  page,
 +}) => {
 +  test.setTimeout(240_000)
 +  mkdirSync(evidence, { recursive: true })
 +  const audit = await mocks(page)
 +  const failures: string[] = []
 +  page.on('pageerror', (error) => failures.push(error.message))
 +  page.on('console', (message) => {
 +    if (message.type() === 'error') failures.push(message.text())
 +  })
 +  page.on('requestfailed', (request) => {
 +    if (!request.failure()?.errorText.includes('ERR_ABORTED')) failures.push(request.url())
 +  })
 +  page.on('response', (response) => {
 +    if (response.status() >= 400) failures.push(`${response.status()} ${response.url()}`)
 +  })
 +  const observations: unknown[] = []
 +  for (const theme of ['light', 'gray', 'dark']) {
 +    await page.addInitScript((value) => localStorage.setItem('theme', value), theme)
 +    await ready(page)
 +    await expect(page.getByRole('searchbox')).toBeEnabled()
 +    for (const width of widths) {
 +      await page.setViewportSize({ width, height: width >= 1440 ? 1080 : 812 })
 +      await expect(page.locator('html')).toHaveAttribute('data-theme', theme)
 +      const geometry = await page.evaluate(() => {
 +        const header = document.querySelector('[data-platform-header]')!.getBoundingClientRect()
 +        const sidebar = document.querySelector('.base-shell-sidebar')!.getBoundingClientRect()
 +        const frame = document.querySelector('[data-page-layout]')!.getBoundingClientRect()
 +        const title = document.querySelector('h1')!.getBoundingClientRect()
 +        const controls = [
 +          ...document.querySelectorAll<HTMLElement>(
 +            'main button,main input,main select,[data-platform-header] button,[data-platform-header] a',
 +          ),
 +        ]
 +          .filter(
 +            (element) =>
 +              element.getClientRects().length && getComputedStyle(element).visibility !== 'hidden',
 +          )
 +          .map((element) => {
 +            const rect = element.getBoundingClientRect()
 +            return { width: rect.width, height: rect.height, x: rect.x, right: rect.right }
 +          })
 +        return {
 +          header: { x: header.x, right: header.right, height: header.height },
 +          sidebar: { width: sidebar.width, y: sidebar.y },
 +          frame: { x: frame.x, right: frame.right },
 +          title: { x: title.x, right: title.right },
 +          controls,
 +          overflow: document.documentElement.scrollWidth - document.documentElement.clientWidth,
 +        }
 +      })
 +      expect(geometry.overflow).toBeLessThanOrEqual(1)
 +      expect(geometry.header).toEqual({ x: 0, right: width, height: 60 })
 +      const sidebarWidth = width < 768 ? 0 : width < 1280 ? 72 : 264
 +      if (sidebarWidth) expect(geometry.sidebar).toEqual({ width: sidebarWidth, y: 60 })
 +      const gutter = Math.min(32, Math.max(16, width * 0.02))
 +      expect(geometry.frame.x).toBeCloseTo(sidebarWidth + gutter, 0)
 +      expect(geometry.frame.right).toBeCloseTo(width - gutter, 0)
 +      expect(geometry.title.x).toBeGreaterThanOrEqual(geometry.frame.x)
 +      expect(geometry.title.right).toBeLessThanOrEqual(geometry.frame.right)
 +      for (const control of geometry.controls) {
 +        expect(control.height).toBeGreaterThanOrEqual(width < 768 ? 44 : 40)
 +        expect(control.width).toBeGreaterThanOrEqual(width < 768 ? 44 : 40)
 +        expect(control.x).toBeGreaterThanOrEqual(0)
 +        expect(control.right).toBeLessThanOrEqual(width)
 +      }
 +      if ([375, 1920].includes(width)) {
 +        const axe = await new AxeBuilder({ page }).include('[data-base-shell]').analyze()
 +        expect(
 +          axe.violations.filter((item) => item.impact === 'serious' || item.impact === 'critical'),
 +        ).toEqual([])
 +      }
 +      await page.screenshot({
 +        path: `${evidence}/audit-${theme}-${width}.png`,
 +        fullPage: true,
 +        animations: 'disabled',
 +      })
 +      observations.push({ theme, width, geometry })
 +    }
 +  }
 +  expect(audit.unexpected).toEqual([])
 +  expect(failures).toEqual([])
 +  writeFileSync(
 +    `${evidence}/geometry.json`,
 +    JSON.stringify(
 +      { scope: 'mocked HTTP/OIDC source QA, not actual-image acceptance', observations },
 +      null,
 +      2,
 +    ),
 +  )
 +})
 +
 +test('URL context survives SSO, filters, paging, reload and Back/Forward', async ({ page }) => {
 +  await mocks(page)
 +  await ready(page, '/audit-log?page=2&context=keep#history')
 +  await expect(page.getByRole('searchbox')).toBeEnabled()
 +  await expect(page).toHaveURL(/page=2&context=keep#history$/)
 +  await page.getByRole('searchbox').fill('participant')
 +  await page.getByRole('button', { name: 'Найти', exact: true }).click()
 +  await expect(page).toHaveURL(/context=keep&q=participant#history$/)
 +  await expect(page.getByRole('searchbox')).toBeEnabled()
 +  await page.getByRole('combobox').selectOption('auth.login_failed')
 +  await expect(page).toHaveURL(/q=participant&action=auth.login_failed#history$/)
 +  await expect(page.getByRole('button', { name: 'Далее', exact: true })).toBeEnabled()
 +  await page.getByRole('button', { name: 'Далее', exact: true }).click()
 +  await expect(page).toHaveURL(/action=auth.login_failed&page=2#history$/)
 +  await page.reload()
 +  await expect(page.getByRole('searchbox')).toHaveValue('participant')
 +  await expect(page.getByRole('combobox')).toHaveValue('auth.login_failed')
 +  await expect(page.getByRole('searchbox')).toBeEnabled()
 +  await page.getByRole('button', { name: 'Очистить поиск', exact: true }).click()
 +  await expect(page).toHaveURL(/context=keep&action=auth.login_failed#history$/)
 +  await page.goBack()
 +  await expect(page.getByRole('searchbox')).toHaveValue('participant')
 +  await page.goForward()
 +  await expect(page.getByRole('searchbox')).toHaveValue('')
 +})
 +
 +test('mobile drawer traps keyboard focus, closes on Escape and resize, and returns focus safely', async ({
 +  page,
 +}) => {
 +  await mocks(page)
 +  await page.setViewportSize({ width: 375, height: 812 })
 +  await ready(page)
 +  const trigger = page.getByRole('button', { name: 'Открыть навигацию', exact: true })
 +  await trigger.focus()
 +  await page.keyboard.press('Enter')
 +  const dialog = page.getByRole('dialog')
 +  await expect(dialog).toBeVisible()
 +  await page.keyboard.press('Tab')
 +  expect(await dialog.evaluate((element) => element.contains(document.activeElement))).toBe(true)
 +  await page.keyboard.press('Escape')
 +  await expect(dialog).toBeHidden()
 +  await expect(trigger).toBeFocused()
 +  await trigger.click()
 +  await page.setViewportSize({ width: 1280, height: 812 })
 +  await expect(dialog).toBeHidden()
 +  await expect(page.locator('main')).toBeFocused()
 +  expect(
 +    await page.locator('body').evaluate((element) => getComputedStyle(element).pointerEvents),
 +  ).not.toBe('none')
 +})
