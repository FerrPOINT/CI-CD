 +      await readyReport(page)
 +      const main = page.locator('main')
 +      const action = main.getByRole('link', { name: 'Открыть запуски', exact: true })
 +      await expect(main.getByRole('img')).toBeVisible()
 +      await expect(action).toHaveCount(1)
 +      await expect(action).toHaveClass(/base-control/)
 +      await expect(page).toHaveURL(
 +        (url) => `${url.pathname}${url.search}${url.hash}` === reportPath,
 +      )
 +      await expect(page.locator('html')).toHaveAttribute('data-theme', theme)
 +      const geometry = await page.evaluate(() => {
 +        const box = (selector: string) => {
 +          const rect = document.querySelector(selector)!.getBoundingClientRect()
 +          return { x: rect.x, right: rect.right, width: rect.width, height: rect.height }
 +        }
 +        return {
 +          frame: box('[data-page-layout]'),
 +          header: box('[data-platform-header]'),
 +          title: box('main h1'),
 +          action: box('main .base-control'),
 +          overflow: document.documentElement.scrollWidth > document.documentElement.clientWidth,
 +          headingCount: document.querySelectorAll('main h1').length,
 +        }
 +      })
 +      expect(geometry.headingCount).toBe(1)
 +      expect(geometry.overflow).toBe(false)
 +      expect(geometry.header).toEqual({ x: 0, right: width, width, height: 60 })
 +      const sidebar = width >= 1280 ? 264 : width >= 768 ? 72 : 0
 +      const gutter = Math.min(32, Math.max(16, width * 0.02))
 +      expect(geometry.frame.x).toBeCloseTo(sidebar + gutter, 0)
 +      expect(geometry.frame.right).toBeCloseTo(width - gutter, 0)
 +      expect(geometry.title.x).toBeGreaterThanOrEqual(geometry.frame.x)
 +      expect(geometry.title.right).toBeLessThanOrEqual(geometry.frame.right)
 +      expect(geometry.action.height).toBeGreaterThanOrEqual(width < 768 ? 44 : 40)
 +      expect(geometry.action.width).toBeGreaterThanOrEqual(width < 768 ? 44 : 40)
 +      expect(geometry.action.right).toBeLessThanOrEqual(geometry.frame.right)
 +      await page.keyboard.press('Tab')
 +      await action.focus()
 +      await expect(action).toBeFocused()
 +      expect(
 +        await action.evaluate(
 +          (node) => node.matches(':focus-visible') && getComputedStyle(node).boxShadow !== 'none',
 +        ),
 +      ).toBe(true)
 +      await page.reload()
 +      await expect(main.getByRole('img')).toBeVisible()
 +      await expect(page).toHaveURL(/context=keep#scope$/)
 +      if ([375, 1920].includes(width)) {
 +        const axe = await new AxeBuilder({ page }).include('[data-base-shell]').analyze()
 +        expect(
 +          axe.violations.filter((item) => ['serious', 'critical'].includes(item.impact!)),
 +        ).toEqual([])
 +      }
 +      await page.screenshot({
 +        path: `${evidence}/report-${theme}-${width}.png`,
 +        fullPage: true,
 +        animations: 'disabled',
 +      })
 +      observations.push({ theme, width, geometry, directOpen: true, reload: true })
 +    }
 +  }
 +  expect(fixture.unexpected).toEqual([])
 +  expect(failures).toEqual([])
 +  writeFileSync(
 +    `${evidence}/report-geometry.json`,
 +    JSON.stringify(
 +      { scope: 'mocked HTTP/OIDC source QA, not actual-image acceptance', observations },
 +      null,
 +      2,
 +    ),
 +  )
 +})
 +
 +for (const status of [0, 403, 404, 422, 503])
 +  test(`report cached ${status} follows Base data and action policy`, async ({ page }) => {
 +    mkdirSync(evidence, { recursive: true })
 +    const fixture = await mocks(page)
 +    await readyReport(page)
 +    await expect(page.locator('main').getByRole('img')).toBeVisible()
 +    await page.getByRole('link', { name: 'Раннеры', exact: true }).click()
 +    await expect(
 +      page.getByRole('heading', { level: 1, name: 'Раннеры', exact: true }),
 +    ).toBeVisible()
 +    fixture.reportStatus = status
 +    await page.goBack()
 +    const main = page.locator('main')
 +    if (status === 0 || status === 503) {
 +      await expect(main.locator('[data-page-state="partial-error"]')).toBeVisible()
 +      await expect(main.getByRole('img')).toBeVisible()
 +      await expect(main.getByRole('link', { name: 'Открыть запуски', exact: true })).toHaveCount(1)
 +    } else {
 +      const marker = status === 403 ? 'permission-denied' : status === 404 ? 'not-found' : undefined
 +      if (marker) await expect(main.locator(`[data-page-state="${marker}"]`)).toBeVisible()
 +      else await expect(main.getByRole('alert')).toBeVisible()
 +      await expect(main.getByRole('img')).toHaveCount(0)
 +      await expect(main.getByRole('link', { name: 'Открыть запуски', exact: true })).toHaveCount(0)
 +      await expect(main.getByRole('button', { name: 'Повторить', exact: true })).toHaveCount(0)
 +    }
 +    await expect(main).not.toContainText('PRIVATE DIAGNOSTIC')
 +    for (const width of [375, 1920]) {
 +      await page.setViewportSize({ width, height: 1080 })
 +      expect(
 +        await page.evaluate(
 +          () => document.documentElement.scrollWidth <= document.documentElement.clientWidth,
 +        ),
 +      ).toBe(true)
 +      const axe = await new AxeBuilder({ page }).include('main').analyze()
 +      expect(
 +        axe.violations.filter((item) => ['serious', 'critical'].includes(item.impact!)),
 +      ).toEqual([])
 +      await page.screenshot({
 +        path: `${evidence}/report-cached-${status}-${width}.png`,
 +        fullPage: true,
 +      })
 +    }
 +    if (status === 0 || status === 503) {
 +      fixture.reportStatus = 200
 +      await main.getByRole('button', { name: 'Повторить', exact: true }).click()
 +      await expect(main.locator('[data-page-state="partial-error"]')).toHaveCount(0)
 +    }
 +    expect(fixture.unexpected).toEqual([])
 +  })
 +
 +test('report loading and empty states never offer duplicate or unavailable actions', async ({
 +  page,
 +}) => {
 +  const fixture = await mocks(page)
 +  let release!: () => void
 +  fixture.reportWait = new Promise<void>((done) => {
 +    release = done
 +  })
 +  try {
 +    await readyReport(page)
 +    await expect(page.locator('main').getByRole('status', { name: 'Загрузка' })).toBeVisible()
 +    await expect(
 +      page.locator('main').getByRole('link', { name: 'Открыть запуски', exact: true }),
 +    ).toHaveCount(0)
 +    await expect(page.locator('main')).not.toContainText('Запусков пока нет.')
 +  } finally {
 +    fixture.reportWait = undefined
 +    fixture.reportEmpty = true
 +    release()
 +  }
 +  await expect(page.locator('main').getByRole('status')).toContainText('Запусков пока нет.')
 +  await expect(
 +    page.locator('main').getByRole('link', { name: 'Открыть запуски', exact: true }),
 +  ).toHaveCount(1)
 +  await expect(page.locator('main').getByRole('img')).toHaveCount(0)
 +  expect(fixture.unexpected).toEqual([])
 +})
