diff --git a/CHANGELOG.md b/CHANGELOG.md
index 4787a82..54f971c 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -9,6 +9,12 @@
 
 ## [Unreleased]
 
+- Repository reference search uses the shared Base label without a local font override.
+- Notification target tests retain strict layout minima and tolerate only subpixel
+  transform rounding in rendered bounds; 40/44 px control sizes are unchanged.
+- Base 7e27713 унифицирует подписи полей (12 px) и SSR-значения (14 px).
+  Геометрия shell, API и принятый runtime не меняются.
+
 - Nginx возвращает 404 для отсутствующих assets; bare `/api` передаётся
   backend без redirect. SPA и Git Smart HTTP сохраняются; runtime не меняется.
 
diff --git a/frontend/e2e/base-standard-source.spec.ts b/frontend/e2e/base-standard-source.spec.ts
index 6ca5671..8f59309 100644
--- a/frontend/e2e/base-standard-source.spec.ts
+++ b/frontend/e2e/base-standard-source.spec.ts
@@ -197,8 +197,15 @@ for (const theme of ['dark', 'gray', 'light']) {
       const dismiss = page.getByRole('button', { name: 'Закрыть уведомление', exact: true })
       const target = (await dismiss.boundingBox())!
       const minimum = width < 768 ? 44 : 40
-      expect(target.width).toBeGreaterThanOrEqual(minimum)
-      expect(target.height).toBeGreaterThanOrEqual(minimum)
+      const layoutSize = await dismiss.evaluate((element) => {
+        const style = getComputedStyle(element)
+        return { width: parseFloat(style.width), height: parseFloat(style.height) }
+      })
+      expect(layoutSize.width).toBeGreaterThanOrEqual(minimum)
+      expect(layoutSize.height).toBeGreaterThanOrEqual(minimum)
+      // Animated transforms can round a 40 px layout box to 39.99994 CSS pixels.
+      expect(target.width).toBeGreaterThanOrEqual(minimum - 0.001)
+      expect(target.height).toBeGreaterThanOrEqual(minimum - 0.001)
       expect(target.x).toBeGreaterThanOrEqual(0)
       expect(target.x + target.width).toBeLessThanOrEqual(width)
       expect(await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth)).toBeLessThanOrEqual(1)
