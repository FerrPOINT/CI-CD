//! Operation-scoped quarantine import into an owner bare repository. No receive-pack,
//! hooks, network, arbitrary refs, caller paths, or unbounded hidden pack objects.
use super::{bug_work_authority::FreshAuthority, files};
use crate::domain::bug_work_publication::*;
use anyhow::{Context, ensure};
use serde::{Deserialize, Serialize};
use std::{
    path::{Path, PathBuf},
    process::Stdio,
    time::Duration,
};
use tokio::io::AsyncReadExt;

const EXPANDED_BYTES: u64 = 512 * 1024 * 1024;
const MAX_OBJECT_BYTES: u64 = 128 * 1024 * 1024;
const MAX_OBJECTS: usize = 100_000;

#[derive(Serialize, Deserialize, PartialEq, Eq)]
#[serde(rename_all = "camelCase", deny_unknown_fields)]
pub(crate) struct ImportedSource {
    pub(crate) schema: String,
    pub(crate) intent_operation_id: uuid::Uuid,
    pub(crate) request_sha256: String,
    pub(crate) candidate_commit_sha: String,
    pub(crate) candidate_tree_id: String,
    pub(crate) candidate_ref: String,
    pub(crate) pack_sha: String,
}

pub(crate) fn canonical_repository(path: &Path) -> anyhow::Result<PathBuf> {
    files::plain(path)?;
    let canonical = path.canonicalize()?;
    ensure!(canonical.is_dir(), "owner bare repository required");
    Ok(canonical)
}

fn bundle_header(bytes: &[u8], request: &BugWorkOperationRequest) -> anyhow::Result<()> {
    ensure!(
        bytes.len() as u64 == request.bundle_size_bytes
            && files::sha(bytes) == request.bundle_sha256,
        "bundle bytes differ from immutable intent"
    );
    let end = bytes
        .windows(2)
        .take(64 * 1024)
        .position(|w| w == b"\n\n")
        .context("bundle header exceeds bound")?;
    let text = std::str::from_utf8(&bytes[..end])?;
    let mut lines = text.lines();
    let version = lines.next().context("bundle version missing")?;
    ensure!(
        matches!(version, "# v2 git bundle" | "# v3 git bundle"),
        "bundle protocol unsupported"
    );
    let mut prerequisite = false;
    let mut head = false;
    let mut format = false;
    for line in lines {
        if let Some(capability) = line.strip_prefix('@') {
            ensure!(
                version == "# v3 git bundle"
                    && !format
                    && capability
                        == format!(
                            "object-format={}",
                            if request.bug_work.candidate_commit_sha.len() == 40 {
                                "sha1"
                            } else {
                                "sha256"
                            }
                        ),
                "bundle capability denied"
            );
            format = true;
        } else if let Some(base) = line.strip_prefix('-') {
            ensure!(
                !prerequisite
                    && base
                        .split_once(' ')
                        .is_some_and(|(sha, _)| sha == request.bug_work.base_commit_sha),
                "bundle prerequisite differs"
            );
            prerequisite = true;
        } else {
            ensure!(
                !head
                    && line
                        == format!(
                            "{} {}",
                            request.bug_work.candidate_commit_sha,
                            request.candidate_ref()
                        ),
                "bundle contains foreign or extra ref"
            );
            head = true;
        }
    }
    ensure!(
        prerequisite && head && (request.bug_work.candidate_commit_sha.len() == 40 || format),
        "bundle must pin exactly original base and candidate"
    );
    Ok(())
}

/// Resource limits apply also to index-pack spawned by bundle unbundle. Capped
/// stdout is drained concurrently with process execution; timeout kills the group.
async fn git(repository: &Path, args: &[&str], cap: u64) -> anyhow::Result<Vec<u8>> {
    let mut command = tokio::process::Command::new("git");
    command
        .env_clear()
        .env("PATH", std::env::var_os("PATH").unwrap_or_default())
        .env("GIT_CONFIG_NOSYSTEM", "1")
        .env("GIT_CONFIG_GLOBAL", "/dev/null")
        .env("GIT_NO_REPLACE_OBJECTS", "1")
        .env("GIT_TERMINAL_PROMPT", "0")
        .args([
            "-c",
            "core.hooksPath=/dev/null",
            "-c",
            "protocol.allow=never",
            "-c",
            "pack.threads=1",
            "-c",
            "pack.windowMemory=64m",
            "-c",
            "pack.deltaCacheSize=64m",
        ])
        .arg(format!("--git-dir={}", repository.display()))
        .args(args)
        .stdin(Stdio::null())
        .stdout(Stdio::piped())
        .stderr(Stdio::null())
        .kill_on_drop(true);
    #[cfg(unix)]
    unsafe {
        command.pre_exec(|| {
            if libc::setpgid(0, 0) != 0 {
                return Err(std::io::Error::last_os_error());
            }
            for (resource, size) in [
                (libc::RLIMIT_AS, 1024 * 1024 * 1024u64),
                (libc::RLIMIT_FSIZE, EXPANDED_BYTES),
                (libc::RLIMIT_CPU, 10),
            ] {
                let bound = libc::rlimit {
                    rlim_cur: size as libc::rlim_t,
                    rlim_max: size as libc::rlim_t,
                };
                if libc::setrlimit(resource, &bound) != 0 {
                    return Err(std::io::Error::last_os_error());
                }
            }
            Ok(())
        });
    }
    #[cfg(not(unix))]
    anyhow::bail!("bounded candidate import requires Unix process/filesystem semantics");
    #[allow(unreachable_code)]
    {
        let mut child = command.spawn().context("bounded Git unavailable")?;
        let pid = child.id();
        struct Group(Option<u32>);
        impl Drop for Group {
            fn drop(&mut self) {
                #[cfg(unix)]
                if let Some(pid) = self.0 {
                    unsafe {
                        libc::kill(-(pid as i32), libc::SIGKILL);
                    }
                }
            }
        }
        let mut group = Group(pid);

        let result = tokio::time::timeout(Duration::from_secs(15), async {
            let mut out = Vec::new();
            child
                .stdout
                .take()
                .context("Git stdout missing")?
                .take(cap + 1)
                .read_to_end(&mut out)
                .await?;
            ensure!(out.len() as u64 <= cap, "Git output exceeds bound");
            ensure!(
                child.wait().await?.success(),
                "Git candidate validation rejected"
            );
            Ok::<_, anyhow::Error>(out)
        })
        .await;
        match result {
            Ok(Ok(out)) => {
                group.0 = None;
                Ok(out)
            }
            other => {
                #[cfg(unix)]
                if let Some(pid) = pid {
                    unsafe {
                        libc::kill(-(pid as i32), libc::SIGKILL);
                    }
                }
                let _ = child.kill().await;
                match other {
                    Ok(Err(error)) => Err(error),
                    _ => anyhow::bail!("bounded Git deadline exceeded"),
                }
            }
        }
    }
}
fn pack_bound(output: &[u8]) -> anyhow::Result<()> {
    let mut count = 0usize;
    let mut total = 0u64;
    for line in std::str::from_utf8(output)?.lines() {
        let columns: Vec<_> = line.split_whitespace().collect();
        if columns.len() < 5 || !commit(columns[0]) {
            continue;
        }
        ensure!(
            matches!(columns[1], "commit" | "tree" | "blob" | "tag"),
            "unknown pack object type"
        );
        let size: u64 = columns[2].parse()?;
        count += 1;
        total = total.checked_add(size).context("expanded pack overflow")?;
        ensure!(
            count <= MAX_OBJECTS && size <= MAX_OBJECT_BYTES && total <= EXPANDED_BYTES,
            "expanded pack objects exceed bound"
        );
    }
    ensure!(count > 0, "pack contains no objects");
    Ok(())
}
fn copy_pack(source: &Path, destination: &Path, max: u64) -> anyhow::Result<()> {
    use std::io::{Read, Write};
    files::plain(source)?;
    let parent = destination.parent().context("pack parent missing")?;
    files::plain(parent)?;
    let mut input = std::fs::File::open(source)?;
    ensure!(
        input.metadata()?.is_file() && input.metadata()?.len() <= max,
        "pack file exceeds bound"
    );
    struct Temp(PathBuf);
    impl Drop for Temp {
        fn drop(&mut self) {
            let _ = std::fs::remove_file(&self.0);
        }
    }
    let staged = Temp(parent.join(format!(".forge-import-{}", uuid::Uuid::new_v4())));
    let mut options = std::fs::OpenOptions::new();
    options.write(true).create_new(true);
    #[cfg(unix)]
    {
        use std::os::unix::fs::OpenOptionsExt;
        options.mode(0o600).custom_flags(libc::O_NOFOLLOW);
    }
    let mut output = options.open(&staged.0)?;
    let copied = std::io::copy(&mut Read::take(&mut input, max + 1), &mut output)?;
    ensure!(copied <= max, "pack changed beyond bound");
    output.flush()?;
    output.sync_all()?;
    drop(output);
    match std::fs::hard_link(&staged.0, destination) {
        Ok(()) => files::sync_dir(parent)?,
        Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => {
            files::plain(destination)?;
            let mut original = std::fs::File::open(destination)?;
            let mut staged_file = std::fs::File::open(&staged.0)?;
            let mut a = [0u8; 65536];
            let mut b = [0u8; 65536];
            loop {
                let n = staged_file.read(&mut a)?;
                let m = original.read(&mut b)?;
                ensure!(n == m && a[..n] == b[..m], "existing pack differs");
                if n == 0 {
                    break;
                }
            }
        }
        Err(e) => return Err(e.into()),
    }
    // A crash can leave only this owned dot-temp, never a partially published pack/index.
    drop(staged);
    files::sync_dir(parent)
}

/// Caller has already COMMITTED the immutable intent and authenticated the exact
/// original producer. Fresh authority is required for both new import and ref CAS.
pub(crate) async fn prepare(
    root: &Path,
    repository: &Path,
    intent: &BugWorkOperationIntent,
    bytes: &[u8],
    authority: &FreshAuthority,
) -> anyhow::Result<PreparedImport> {
    let request = &intent.request;
    request.validate().map_err(anyhow::Error::msg)?;
    authority.require_current(intent.configuration_id, request)?;
    ensure!(
        root.is_absolute() && repository.is_absolute(),
        "explicit owner paths required"
    );
    files::plain(root)?;
    files::plain(repository)?;
    let root = std::fs::canonicalize(root)?;
    let repository = std::fs::canonicalize(repository)?;
    ensure!(
        !root.starts_with(&repository) && !repository.starts_with(&root),
        "controller/repository roots overlap"
    );
    bundle_header(bytes, request)?;
    let operation = root.join(intent.operation_id.to_string());
    files::directory(&operation)?;
    let _lock = files::Lock::acquire(&operation)?;
    let bundle = operation.join("source.bundle");
    files::immutable_bytes(&bundle, bytes)?;
    let quarantine = operation.join("quarantine.git");
    if !quarantine.exists() {
        git(
            &quarantine,
            &[
                "init",
                "--bare",
                if request.bug_work.candidate_commit_sha.len() == 40 {
                    "--object-format=sha1"
                } else {
                    "--object-format=sha256"
                },
            ],
            1024,
        )
        .await?;
    }
    files::plain(&quarantine)?;
    let alternate = quarantine.join("objects/info/alternates");
    let objects = repository.join("objects");
    files::plain(&objects)?;
    let objects = objects.to_str().context("owner objects path is not UTF8")?;
    ensure!(
        !objects.contains(['\n', '\r']),
        "owner alternate path invalid"
    );
    files::immutable_bytes(&alternate, format!("{objects}\n").as_bytes())?;
    git(
        &quarantine,
        &[
            "bundle",
            "unbundle",
            bundle.to_str().context("owner bundle path invalid")?,
        ],
        1024,
    )
    .await?;
    let pack_dir = quarantine.join("objects/pack");
    files::plain(&pack_dir)?;
    let mut packs = Vec::<PathBuf>::new();
    for entry in std::fs::read_dir(&pack_dir)? {
        let path = entry?.path();
        files::plain(&path)?;
        if path.extension().is_some_and(|v| v == "idx") {
            packs.push(path);
        }
    }
    ensure!(packs.len() == 1, "quarantine must retain exactly one pack");
    let index = &packs[0];
    pack_bound(
        &git(
            &quarantine,
            &[
                "verify-pack",
                "-v",
                index.to_str().context("pack path invalid")?,
            ],
            20 * 1024 * 1024,
        )
        .await?,
    )?;
    git(
        &quarantine,
        &[
            "index-pack",
            "--strict",
            "--verify",
            index
                .with_extension("pack")
                .to_str()
                .context("pack path invalid")?,
        ],
        1024,
    )
    .await?;
    git(
        &quarantine,
        &[
            "merge-base",
            "--is-ancestor",
            &request.bug_work.base_commit_sha,
            &request.bug_work.candidate_commit_sha,
        ],
        1024,
    )
    .await?;
    let tree = git(
        &quarantine,
        &[
            "rev-parse",
            "--verify",
            "--end-of-options",
            &format!("{}^{{tree}}", request.bug_work.candidate_commit_sha),
        ],
        128,
    )
    .await?;
    ensure!(
        std::str::from_utf8(&tree)?.trim() == request.candidate_tree_id,
        "candidate tree differs"
    );
    let name = index
        .file_stem()
        .and_then(|v| v.to_str())
        .and_then(|v| v.strip_prefix("pack-"))
        .context("pack name invalid")?;
    ensure!(commit(name), "pack digest invalid");
    let receipt = ImportedSource {
        schema: "forge/bug-work-source-import/v1".into(),
        intent_operation_id: intent.operation_id,
        request_sha256: intent.request_sha256.clone(),
        candidate_commit_sha: request.bug_work.candidate_commit_sha.clone(),
        candidate_tree_id: request.candidate_tree_id.clone(),
        candidate_ref: request.candidate_ref(),
        pack_sha: name.to_owned(),
    };
    Ok(PreparedImport {
        repository,
        operation,
        index: index.clone(),
        configuration_id: intent.configuration_id,
        receipt,
        _lock,
    })
}

/// The lock keeps the original operation stable while the caller performs fresh
/// fixed-owner and local authority checks outside any SQL transaction.
pub(crate) struct PreparedImport {
    repository: PathBuf,
    operation: PathBuf,
    index: PathBuf,
    configuration_id: uuid::Uuid,
    receipt: ImportedSource,
    _lock: files::Lock,
}
impl PreparedImport {
    pub(crate) async fn publish_ref(
        self,
        request: &BugWorkOperationRequest,
        authority: &FreshAuthority,
    ) -> anyhow::Result<ImportedSource> {
        authority.require_current(self.configuration_id, request)?;
        ensure!(
            self.receipt.candidate_commit_sha == request.bug_work.candidate_commit_sha
                && self.receipt.candidate_tree_id == request.candidate_tree_id
                && self.receipt.candidate_ref == request.candidate_ref(),
            "prepared import changed"
        );
        files::plain(&self.repository)?;
        // Serialize this purpose's installs per actual repository. Native Git
        // readers/receive-pack remain safe through no-clobber pack publication
        // and Git's own update-ref CAS lock, not through this advisory flock.
        let _repository_lock = files::Lock::acquire(&self.repository)?;
        let destination = self.repository.join("objects/pack");
        files::directory(&destination)?;
        for (extension, max) in [("pack", EXPANDED_BYTES), ("idx", 16 * 1024 * 1024)] {
            authority.require_current(self.configuration_id, request)?;
            copy_pack(
                &self.index.with_extension(extension),
                &destination.join(format!("pack-{}.{}", self.receipt.pack_sha, extension)),
                max,
            )?;
        }

        let existing = git(
            &self.repository,
            &[
                "for-each-ref",
                "--format=%(objectname)",
                &request.candidate_ref(),
            ],
            128,
        )
        .await?;
        let existing = std::str::from_utf8(&existing)?.trim();
        if existing.is_empty() {
            authority.require_current(self.configuration_id, request)?;
            git(
                &self.repository,
                &[
                    "update-ref",
                    "--no-deref",
                    &request.candidate_ref(),
                    &request.bug_work.candidate_commit_sha,
                    &"0".repeat(request.bug_work.candidate_commit_sha.len()),
                ],
                128,
            )
            .await?;
        } else {
            ensure!(
                existing == request.bug_work.candidate_commit_sha,
                "candidate ref belongs to another commit"
            );
        }
        files::immutable(&self.operation.join("imported.json"), &self.receipt)?;
        Ok(self.receipt)
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    #[test]
    fn expanded_bound_includes_hidden_objects_and_rejects_object_count_and_bomb() {
        let object = "a".repeat(40);
        pack_bound(format!("{object} blob 123 23 1\n").as_bytes()).unwrap();
        assert!(
            pack_bound(format!("{object} blob {} 23 1\n", MAX_OBJECT_BYTES + 1).as_bytes())
                .is_err()
        );
        let hidden = format!("{object} blob {} 23 1\n", MAX_OBJECT_BYTES).repeat(5);
        assert!(pack_bound(hidden.as_bytes()).is_err());
        let many = format!("{object} blob 1 1 1\n").repeat(MAX_OBJECTS + 1);
        assert!(pack_bound(many.as_bytes()).is_err());
    }
    #[cfg(unix)]
    #[tokio::test]
    async fn actual_git_quarantine_then_fresh_publish_keeps_base_and_exact_unknown_replay() {
        struct Scratch(PathBuf);
        impl Drop for Scratch {
            fn drop(&mut self) {
                let _ = std::fs::remove_dir_all(&self.0);
            }
        }
        let scratch = Scratch(
            std::env::temp_dir().join(format!("forge-bug-bundle-{}", uuid::Uuid::new_v4())),
        );
        std::fs::create_dir(&scratch.0).unwrap();
        let work = scratch.0.join("work");
        std::fs::create_dir(&work).unwrap();
        async fn run(path: &Path, args: &[&str]) -> String {
            let out = tokio::process::Command::new("git")
                .current_dir(path)
                .args(args)
                .env("GIT_CONFIG_NOSYSTEM", "1")
                .env("GIT_CONFIG_GLOBAL", "/dev/null")
                .output()
                .await
                .unwrap();
            assert!(
                out.status.success(),
                "Git fixture operation failed: {}",
                String::from_utf8_lossy(&out.stderr)
            );
            String::from_utf8(out.stdout).unwrap().trim().into()
        }
        run(&work, &["init", "-q"]).await;
        run(&work, &["config", "user.name", "Synthetic QA"]).await;
        run(&work, &["config", "user.email", "qa@example.invalid"]).await;
        std::fs::write(work.join("app.txt"), "original A").unwrap();
        run(&work, &["add", "app.txt"]).await;
        run(&work, &["commit", "-qm", "A"]).await;
        let base = run(&work, &["rev-parse", "HEAD"]).await;
        let bare = scratch.0.join("owner.git");
        run(&work, &["clone", "--bare", ".", bare.to_str().unwrap()]).await;
        std::fs::write(work.join("app.txt"), "actual fixed B").unwrap();
        run(&work, &["commit", "-qam", "B"]).await;
        let commit = run(&work, &["rev-parse", "HEAD"]).await;
        let tree = run(&work, &["rev-parse", "HEAD^{tree}"]).await;
        let vector: serde_json::Value = serde_json::from_str(include_str!(
            "../domain/tests/fixtures/bug-work-delivery-v1.json"
        ))
        .unwrap();
        let mut binding: BugWorkPublicationBinding =
            serde_json::from_value(vector["proof"]["bugWork"].clone()).unwrap();
        binding.base_commit_sha = base.clone();
        binding.candidate_commit_sha = commit.clone();
        let mut request = BugWorkOperationRequest {
            contract_version: 1,
            operation_key: "real-bundle".into(),
            project: serde_json::from_value(vector["proof"]["project"].clone()).unwrap(),
            bug_work: binding,
            repository_id: uuid::Uuid::new_v4(),
            candidate_tree_id: tree,
            bundle_sha256: "d".repeat(64),
            bundle_size_bytes: 1,
        };
        run(&work, &["update-ref", &request.candidate_ref(), &commit]).await;
        let bundle = scratch.0.join("candidate.bundle");
        run(
            &work,
            &[
                "bundle",
                "create",
                bundle.to_str().unwrap(),
                &request.candidate_ref(),
                &format!("^{base}"),
            ],
        )
        .await;
        let bytes = std::fs::read(&bundle).unwrap();
        request.bundle_sha256 = files::sha(&bytes);
        request.bundle_size_bytes = bytes.len() as u64;
        let intent = BugWorkOperationIntent {
            schema: "forge/bug-work-operation-intent/v1".into(),
            operation_id: uuid::Uuid::new_v4(),
            configuration_id: uuid::Uuid::new_v4(),
            request_sha256: super::super::bug_work_authority::canonical_hash(
                &serde_json::to_value(&request).unwrap(),
            )
            .unwrap(),
            request,
            recorded_at: chrono::Utc::now(),
        };
        let controller = scratch.0.join("controller");
        std::fs::create_dir(&controller).unwrap();
        let prepared = prepare(
            &controller,
            &bare,
            &intent,
            &bytes,
            &FreshAuthority::for_request(intent.configuration_id, &intent.request),
        )
        .await
        .unwrap();
        assert!(
            !bare.join("refs/fleet/bug-work").exists(),
            "quarantine cannot expose shared refs"
        );
        let packs = std::fs::read_dir(bare.join("objects/pack"))
            .unwrap()
            .count();
        assert_eq!(packs, 0, "quarantine cannot publish shared packs");
        let imported = prepared
            .publish_ref(
                &intent.request,
                &FreshAuthority::for_request(intent.configuration_id, &intent.request),
            )
            .await
            .unwrap();
        assert_eq!(imported.candidate_commit_sha, commit);
        assert_eq!(
            run(
                &work,
                &[
                    "--git-dir",
                    bare.to_str().unwrap(),
                    "rev-parse",
                    &intent.request.candidate_ref()
                ]
            )
            .await,
            commit
        );
        assert_eq!(
            run(
                &work,
                &["--git-dir", bare.to_str().unwrap(), "rev-parse", "HEAD"]
            )
            .await,
            base,
            "feature/default ref unchanged"
        );
        let retry = prepare(
            &controller,
            &bare,
            &intent,
            &bytes,
            &FreshAuthority::for_request(intent.configuration_id, &intent.request),
        )
        .await
        .unwrap()
        .publish_ref(
            &intent.request,
            &FreshAuthority::for_request(intent.configuration_id, &intent.request),
        )
        .await
        .unwrap();
        assert_eq!(
            serde_json::to_value(imported).unwrap(),
            serde_json::to_value(retry).unwrap()
        );
    }
    #[cfg(unix)]
    #[test]
    fn atomic_pack_copy_never_leaves_partial_final_on_bound_failure_and_replays_exact() {
        let root = std::env::temp_dir().join(format!("forge-pack-copy-{}", uuid::Uuid::new_v4()));
        std::fs::create_dir(&root).unwrap();
        let source = root.join("source");
        let target = root.join("pack-a.pack");
        std::fs::write(&source, b"real pack bytes").unwrap();
        assert!(copy_pack(&source, &target, 1).is_err());
        assert!(!target.exists());
        copy_pack(&source, &target, 100).unwrap();
        copy_pack(&source, &target, 100).unwrap();
        assert_eq!(std::fs::read(&target).unwrap(), b"real pack bytes");
        assert_eq!(
            std::fs::read_dir(&root).unwrap().count(),
            2,
            "own staging files cleaned"
        );
        std::fs::remove_dir_all(root).unwrap();
    }
}
