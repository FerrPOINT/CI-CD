//! Existing-Issue candidate/publication identity. No Task/PM surrogate or caller proof flag.
use crate::delivered_target::{DeliveredProjectRef, DeliveredTargetStatus, ServingIdentity};
use chrono::{DateTime, Utc};
use serde::{Deserialize, Serialize};
use uuid::Uuid;

pub const MAX_BUNDLE_BYTES: u64 = 32 * 1024 * 1024;
pub const MAX_SAFE_REVISION: i64 = 9_007_199_254_740_991;
pub fn sha256(v: &str) -> bool {
    hex(v, 64)
}
fn hex(v: &str, n: usize) -> bool {
    v.len() == n
        && v.bytes()
            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
}
pub fn commit(v: &str) -> bool {
    hex(v, 40) || hex(v, 64)
}
pub fn operation_key(v: &str) -> bool {
    !v.is_empty()
        && v.len() <= 128
        && v.bytes()
            .all(|b| b.is_ascii_alphanumeric() || b"_.:-".contains(&b))
}
fn text(v: &str, n: usize) -> bool {
    !v.trim().is_empty() && v.len() <= n && !v.chars().any(char::is_control)
}
fn version(v: i64) -> bool {
    (1..=MAX_SAFE_REVISION).contains(&v)
}

/// Hash fields refer to exact retained owner103/104 JSON, not timestamp-rebuilt DTOs.
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, utoipa::ToSchema)]
#[serde(rename_all = "camelCase", deny_unknown_fields)]
pub struct BugWorkPublicationBinding {
    pub bug_id: Uuid,
    pub assignment_id: Uuid,
    pub assignment_sha256: String,
    pub fence: i64,
    pub owner_subject: String,
    pub runtime_binding_sha256: String,
    pub source_context_sha256: String,
    pub verification_basis_sha256: String,
    pub canonical_basis_sha256: String,
    pub base_commit_sha: String,
    pub candidate_commit_sha: String,
}
impl BugWorkPublicationBinding {
    pub fn validate(&self) -> Result<(), &'static str> {
        if self.bug_id.is_nil()
            || self.assignment_id.is_nil()
            || !version(self.fence)
            || !text(&self.owner_subject, 256)
            || [
                &self.assignment_sha256,
                &self.runtime_binding_sha256,
                &self.source_context_sha256,
                &self.verification_basis_sha256,
                &self.canonical_basis_sha256,
            ]
            .iter()
            .any(|s| !sha256(s))
            || !commit(&self.base_commit_sha)
            || !commit(&self.candidate_commit_sha)
            || self.base_commit_sha == self.candidate_commit_sha
        {
            return Err("invalid exact Bug work candidate identity");
        }
        Ok(())
    }
}
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, utoipa::ToSchema)]
#[serde(rename_all = "camelCase", deny_unknown_fields)]
pub struct BugWorkOperationRequest {
    pub contract_version: u8,
    pub operation_key: String,
    pub project: DeliveredProjectRef,
    pub bug_work: BugWorkPublicationBinding,
    pub repository_id: Uuid,
    pub candidate_tree_id: String,
    pub bundle_sha256: String,
    pub bundle_size_bytes: u64,
}
impl BugWorkOperationRequest {
    pub fn validate(&self) -> Result<(), &'static str> {
        self.bug_work.validate()?;
        if self.contract_version != 1
            || !operation_key(&self.operation_key)
            || self.project.tracker_instance_id.is_nil()
            || self.project.project_id.is_nil()
            || self.repository_id.is_nil()
            || !commit(&self.candidate_tree_id)
            || !sha256(&self.bundle_sha256)
            || !(1..=MAX_BUNDLE_BYTES).contains(&self.bundle_size_bytes)
        {
            return Err("invalid bounded Bug work source operation");
        }
        Ok(())
    }
    pub fn candidate_ref(&self) -> String {
        format!(
            "refs/fleet/bug-work/{}/{}",
            self.bug_work.assignment_id, self.bug_work.candidate_commit_sha
        )
    }
}
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, utoipa::ToSchema)]
#[serde(rename_all = "camelCase", deny_unknown_fields)]
pub struct BugWorkPipelineIdentity {
    pub pipeline_id: Uuid,
    pub config_sha256: String,
    pub plan_sha256: String,
}
#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize, utoipa::ToSchema)]
#[serde(rename_all = "camelCase", deny_unknown_fields)]
pub struct BugWorkOperationIdentity {
    pub operation_id: Uuid,
    pub operation_key: String,
    pub request_sha256: String,
}
#[derive(Clone, Debug, Serialize, Deserialize, utoipa::ToSchema)]
#[serde(rename_all = "camelCase", deny_unknown_fields)]
pub struct BugWorkOperationIntent {
    pub schema: String,
    pub operation_id: Uuid,
    pub configuration_id: Uuid,
    pub request_sha256: String,
    pub request: BugWorkOperationRequest,
    pub recorded_at: DateTime<Utc>,
}
/// Minted only after immutable import + actual pipeline creation, atomically with its DB row.
#[derive(Clone, Debug, Serialize, Deserialize, utoipa::ToSchema)]
#[serde(rename_all = "camelCase", deny_unknown_fields)]
pub struct BugWorkOperationAccepted {
    pub schema: String,
    pub operation: BugWorkOperationIdentity,
    pub intent_operation_id: Uuid,
    pub configuration_id: Uuid,
    pub request: BugWorkOperationRequest,
    pub candidate_ref: String,
    pub pipeline: BugWorkPipelineIdentity,
    pub accepted_at: DateTime<Utc>,
}
impl BugWorkOperationAccepted {
    pub fn validate(&self) -> Result<(), &'static str> {
        self.request.validate()?;
        if self.schema != "forge/bug-work-operation-accepted/v1"
            || self.operation.operation_id.is_nil()
            || self.intent_operation_id.is_nil()
            || self.configuration_id.is_nil()
            || self.operation.operation_key != self.request.operation_key
            || !sha256(&self.operation.request_sha256)
            || self.candidate_ref != self.request.candidate_ref()
            || self.pipeline.pipeline_id.is_nil()
            || !sha256(&self.pipeline.config_sha256)
            || !sha256(&self.pipeline.plan_sha256)
        {
            return Err("invalid actual accepted Bug candidate");
        }
        Ok(())
    }
}
#[derive(Clone, Debug, Serialize, Deserialize, utoipa::ToSchema)]
#[serde(rename_all = "camelCase", deny_unknown_fields)]
pub struct BugWorkOperationReadback {
    pub intent: BugWorkOperationIntent,
    pub accepted: Option<BugWorkOperationAccepted>,
}
#[derive(Clone, Debug, Serialize, Deserialize, utoipa::ToSchema)]
#[serde(rename_all = "camelCase", deny_unknown_fields)]
pub struct BugWorkArtifactIdentity {
    pub artifact_id: Uuid,
