//! Product lifecycle tests run only against the disposable integration stand.
use super::messaging::*;
use axum::{
    Router,
    body::Body,
    http::{Request, StatusCode},
    routing::post,
};
use sdlc_messaging::{Envelope, contracts::PipelineFinished};
use sqlx::PgPool;
use sqlx::postgres::PgPoolOptions;
use std::{sync::Arc, time::Duration};
use tokio::sync::watch;
use tower::ServiceExt;
use uuid::Uuid;

async fn pool() -> PgPool {
    let pool = PgPoolOptions::new()
        .max_connections(8)
        .connect(&std::env::var("MESSAGING_PRODUCT_TEST_DATABASE_URL").unwrap())
        .await
        .unwrap();
    let name: String = sqlx::query_scalar("SELECT current_database()")
        .fetch_one(&pool)
        .await
        .unwrap();
    assert_eq!(name, "cicd_messaging_test");
    pool
}
async fn pipeline(pool: &PgPool, status: &str) -> (Uuid, Uuid, Uuid) {
    let project = Uuid::new_v4();
    let pipeline = Uuid::new_v4();
    let stage = Uuid::new_v4();
    let job = Uuid::new_v4();
    sqlx::query("INSERT INTO projects (id,name,repository_url) VALUES ($1,$2,'https://example.invalid/repo')").bind(project).bind(project.to_string()).execute(pool).await.unwrap();
    sqlx::query(
        "INSERT INTO pipelines (id,project_id,git_ref,status) VALUES ($1,$2,'main','running')",
    )
    .bind(pipeline)
    .bind(project)
    .execute(pool)
    .await
    .unwrap();
    sqlx::query("INSERT INTO stages (id,pipeline_id,name,position,status) VALUES ($1,$2,'test',0,'running')").bind(stage).bind(pipeline).execute(pool).await.unwrap();
    sqlx::query("INSERT INTO jobs (id,stage_id,name,image,command,position,status) VALUES ($1,$2,'test','alpine','true',0,$3)").bind(job).bind(stage).bind(status).execute(pool).await.unwrap();
    sqlx::query("INSERT INTO execution_attempts (id,job_id,attempt_no,status,trigger) VALUES ($1,$2,1,$3,'initial')").bind(Uuid::new_v4()).bind(job).bind(status).execute(pool).await.unwrap();
    let environment = Uuid::new_v4();
    sqlx::query("INSERT INTO environments (id,project_id,name) VALUES ($1,$2,'test')")
        .bind(environment)
        .bind(project)
        .execute(pool)
        .await
        .unwrap();
    sqlx::query("INSERT INTO deployments (id,environment_id,pipeline_id,git_ref,status) VALUES ($1,$2,$3,'main','running')")
        .bind(Uuid::new_v4()).bind(environment).bind(pipeline).execute(pool).await.unwrap();
    sqlx::query("INSERT INTO webhooks (id,project_id,url,enabled) VALUES ($1,$2,'https://example.invalid/hook',true)").bind(Uuid::new_v4()).bind(project).execute(pool).await.unwrap();
    for channel in ["email", "sse", "in_app", "slack_webhook", "generic_webhook"] {
        sqlx::query("INSERT INTO notification_configs (id,project_id,channel,target,enabled) VALUES ($1,$2,$3,$4,true)").bind(Uuid::new_v4()).bind(project).bind(channel).bind(if channel=="email" {"qa@example.invalid"}else{"https://example.invalid/notification"}).execute(pool).await.unwrap();
    }
    (project, pipeline, job)
}
fn lifecycle_app(pool: PgPool) -> Router {
    // Call the real product handlers. Authentication is tested independently.
    let state = Arc::new(crate::api::AppState {
        pool: Some(pool),
        auth_secret: None,
        git: Default::default(),
        config: crate::config::RuntimeConfig::test_default(),
        running_jobs: None,
        rate_limiter: Arc::new(crate::rate_limit::RateLimiter::default()),
    });
    Router::new()
        .route(
            "/cancel/{id}",
            post(crate::api::jobs_routes::cancel_pipeline),
        )
        .route("/retry/{id}", post(crate::api::jobs_routes::retry_pipeline))
        .route("/retry-job/{id}", post(crate::api::jobs_routes::retry_job))
        .with_state(state)
}
async fn request(app: &Router, path: &str) -> StatusCode {
    app.clone()
        .oneshot(Request::post(path).body(Body::empty()).unwrap())
        .await
        .unwrap()
        .status()
}

#[tokio::test]
#[ignore = "disposable product deployment harness only"]
async fn product_deployment_provision() {
    use sdlc_messaging::provisioning::{ProvisionMode, provision_qa as provision};
    let bus = sdlc_messaging::Bus::connect(sdlc_messaging::NatsConfig {
        servers: vec![std::env::var("CICD_MESSAGING_NATS_URLS").unwrap()],
        username: Some("operator".into()),
        password_file: Some("/secrets/operator".into()),
        client_name: "operator".into(),
        require_tls: false,
    })
    .await
    .unwrap();
    provision(&bus, ProvisionMode::Apply).await.unwrap();
    provision(&bus, ProvisionMode::Check).await.unwrap();
    bus.drain().await.unwrap();
}

#[tokio::test]
#[ignore = "disposable product messaging capacity measurement only"]
async fn product_capacity_sample() {
    let pool = pool().await;
    for _ in 0..1000 {
        let event = sdlc_messaging::Envelope::new(
            Uuid::new_v4(),
            chrono::Utc::now(),
            None,
            PipelineFinished {
                project_id: Uuid::new_v4(),
                pipeline_id: Uuid::new_v4(),
                completion_seq: i64::MAX,
                status: sdlc_messaging::contracts::PipelineStatus::Canceled,
                finished_at: chrono::Utc::now(),
            },
        );
        let mut tx = pool.begin().await.unwrap();
        let row = sdlc_messaging::postgres::outbox::enqueue(&mut tx, &event)
            .await
            .unwrap();
        sqlx::query("UPDATE messaging_outbox SET published_at=now(),stream='PLATFORM_EVENTS',stream_sequence=1 WHERE id=$1").bind(row).execute(&mut *tx).await.unwrap();
        tx.commit().await.unwrap();
    }
    let (rows, bytes): (i64, i64) = sqlx::query_as(
        "SELECT count(*),pg_total_relation_size('messaging_outbox') FROM messaging_outbox",
    )
    .fetch_one(&pool)
    .await
    .unwrap();
    println!(
        "CAPACITY_RELATION={}",
        serde_json::json!(["ci-cd.messaging_outbox", rows, bytes, 90])
    );
    // Terminal ledger belongs to the product and outlives the transport outbox.
    let (row,payload):(Uuid,Vec<u8>)=sqlx::query_as("SELECT m.id,m.payload FROM messaging_outbox m JOIN domain_events e ON e.id=m.event_id WHERE m.published_at IS NOT NULL ORDER BY m.created_at LIMIT 1").fetch_one(&pool).await.unwrap();
    let event = Envelope::<PipelineFinished>::decode(&payload).unwrap();
    let sequence: i64 = sqlx::query_scalar("SELECT terminal_event_seq FROM pipelines WHERE id=$1")
        .bind(event.data.pipeline_id)
        .fetch_one(&pool)
        .await
        .unwrap();
    sqlx::query("UPDATE messaging_outbox SET published_at=now()-interval '91 days' WHERE id=$1")
        .bind(row)
        .execute(&pool)
        .await
        .unwrap();
    let scope = sdlc_messaging::postgres::maintenance::Scope::Outbox {
        subject: <PipelineFinished as sdlc_messaging::MessageData>::SUBJECT.into(),
    };
    assert_eq!(
        sdlc_messaging::postgres::maintenance::cleanup(&pool, &scope)
            .await
            .unwrap()
            .published,
        1
    );
    refresh_pipeline(&pool, event.data.pipeline_id)
        .await
        .unwrap();
    let repeated: bool =
        sqlx::query_scalar("SELECT EXISTS(SELECT 1 FROM messaging_outbox WHERE event_id=$1)")
            .bind(event.id)
            .fetch_one(&pool)
            .await
            .unwrap();
    assert!(!repeated);
    let after: i64 = sqlx::query_scalar("SELECT terminal_event_seq FROM pipelines WHERE id=$1")
        .bind(event.data.pipeline_id)
        .fetch_one(&pool)
        .await
        .unwrap();
    assert_eq!(after, sequence);
    pool.close().await;
}

#[tokio::test]
#[ignore = "disposable product deployment harness only"]
async fn product_deployment_seed() {
    let pool = pool().await;
    crate::migrations().await.unwrap().run(&pool).await.unwrap();
    assert_eq!(
        std::env::var("CICD_MESSAGING_ENABLED").as_deref(),
        Ok("true")
    );
    let count: usize = std::env::var("MESSAGING_DEPLOYMENT_COUNT")
        .unwrap()
        .parse()
        .unwrap();
    assert!((1..=1_000).contains(&count));
    let milliseconds: u64 = std::env::var("MESSAGING_DEPLOYMENT_INTERVAL_MS")
        .unwrap_or_else(|_| "1".into())
        .parse()
        .unwrap();
    let before: i64 = sqlx::query_scalar("SELECT count(*) FROM messaging_outbox")
        .fetch_one(&pool)
        .await
        .unwrap();
    let mut interval = tokio::time::interval(Duration::from_millis(milliseconds.max(1)));
    let started = std::time::Instant::now();
    for index in 0..count {
        interval.tick().await;
        let (_, id, _) = pipeline(&pool, ["success", "failed", "canceled"][index % 3]).await;
        let (first, repeat) =
            tokio::join!(refresh_pipeline(&pool, id), refresh_pipeline(&pool, id));
        first.unwrap();
        repeat.unwrap();
    }
    let after: i64 = sqlx::query_scalar("SELECT count(*) FROM messaging_outbox")
        .fetch_one(&pool)
        .await
        .unwrap();
    assert_eq!(after - before, count as i64);
    let maximum: i64 = sqlx::query_scalar("SELECT max(terminal_event_seq) FROM pipelines")
        .fetch_one(&pool)
        .await
        .unwrap();
    assert_eq!(maximum, 1);
    println!(
        "Product terminal facts committed: count={count}, elapsed_ms={}",
        started.elapsed().as_millis()
    );
}

#[tokio::test]
#[ignore = "disposable product messaging harness only"]
async fn product_lifecycle() {
    assert_eq!(
        std::env::var("CICD_MESSAGING_ENABLED").as_deref(),
        Ok("true")
    );
    let pool = pool().await;
    crate::migrations().await.unwrap().run(&pool).await.unwrap();
    let app = lifecycle_app(pool.clone());
    let (_, success, _) = pipeline(&pool, "success").await;
    let (_, failed, failed_job) = pipeline(&pool, "failed").await;
    let (_, canceled, _) = pipeline(&pool, "running").await;
    let (a, b) = tokio::join!(
        refresh_pipeline(&pool, success),
        refresh_pipeline(&pool, success)
    );
    a.unwrap();
    b.unwrap();
    let deployment: String =
        sqlx::query_scalar("SELECT status FROM deployments WHERE pipeline_id=$1")
            .bind(success)
            .fetch_one(&pool)
            .await
            .unwrap();
    assert_eq!(deployment, "success");
    refresh_pipeline(&pool, failed).await.unwrap();
    let cancel_path = format!("/cancel/{canceled}");
    let (cancel, refresh) = tokio::join!(
        request(&app, &cancel_path),
        refresh_pipeline(&pool, canceled)
    );
    assert_eq!(cancel, StatusCode::OK);
    refresh.unwrap();
    assert_eq!(
        request(&app, &format!("/cancel/{canceled}")).await,
        StatusCode::CONFLICT
    );
    assert_eq!(
        request(&app, &format!("/retry/{canceled}")).await,
        StatusCode::OK
    );
    sqlx::query("UPDATE jobs SET status='success' WHERE stage_id IN (SELECT id FROM stages WHERE pipeline_id=$1)").bind(canceled).execute(&pool).await.unwrap();
    refresh_pipeline(&pool, canceled).await.unwrap();
    assert_eq!(
        request(&app, &format!("/retry-job/{failed_job}")).await,
        StatusCode::OK
    );
    sqlx::query("UPDATE jobs SET status='success' WHERE id=$1")
        .bind(failed_job)
        .execute(&pool)
        .await
        .unwrap();
    refresh_pipeline(&pool, failed).await.unwrap();
    for id in [failed, canceled] {
        let seq: i64 = sqlx::query_scalar("SELECT terminal_event_seq FROM pipelines WHERE id=$1")
            .bind(id)
            .fetch_one(&pool)
            .await
            .unwrap();
        assert_eq!(seq, 2);
    }
    let (_, rollback, _) = pipeline(&pool, "failed").await;
    let mut tx = pool.begin().await.unwrap();
    let completion = cicd_infra::pipeline_completion::refresh(&mut tx, rollback)
        .await
        .unwrap()
        .unwrap();
    record(&mut tx, completion).await.unwrap();
    tx.rollback().await.unwrap();
    let deployment: String =
        sqlx::query_scalar("SELECT status FROM deployments WHERE pipeline_id=$1")
            .bind(rollback)
            .fetch_one(&pool)
            .await
            .unwrap();
    assert_eq!(deployment, "running");
    let status: String = sqlx::query_scalar("SELECT status FROM pipelines WHERE id=$1")
        .bind(rollback)
        .fetch_one(&pool)
        .await
        .unwrap();
    assert_eq!(status, "running");
    // Recovery sees committed job results even though no refresh was called.
    assert!(reconcile(&pool).await.unwrap() > 0);
    // Cancellation plus a queued job must also recover after a crash.
    let (_, partial, job) = pipeline(&pool, "canceled").await;
    let stage: Uuid = sqlx::query_scalar("SELECT stage_id FROM jobs WHERE id=$1")
        .bind(job)
        .fetch_one(&pool)
        .await
        .unwrap();
    sqlx::query("INSERT INTO jobs (id,stage_id,name,image,command,position,status) VALUES ($1,$2,'waiting','alpine','true',1,'queued')").bind(Uuid::new_v4()).bind(stage).execute(&pool).await.unwrap();
    reconcile(&pool).await.unwrap();
    let status: String = sqlx::query_scalar("SELECT status FROM pipelines WHERE id=$1")
        .bind(partial)
        .fetch_one(&pool)
        .await
        .unwrap();
    assert_eq!(status, "canceled");
    let facts: Vec<(Uuid, Vec<u8>)> =
        sqlx::query_as("SELECT event_id,payload FROM messaging_outbox ORDER BY created_at,id")
            .fetch_all(&pool)
            .await
            .unwrap();
    assert_eq!(facts.len(), 7);
    for (id, bytes) in &facts {
        let event = Envelope::<PipelineFinished>::decode(bytes).unwrap();
        assert_eq!(event.id, *id);
        let (legacy,webhook):(serde_json::Value,serde_json::Value)=sqlx::query_as("SELECT e.payload,m.payload FROM domain_events e JOIN outbox_messages m ON m.event_id=e.id AND m.channel='webhook' WHERE e.id=$1").bind(id).fetch_one(&pool).await.unwrap();
        assert_eq!(
            legacy["status"],
            serde_json::to_value(event.data.status).unwrap()
        );
        assert_eq!(webhook["pipeline_id"], event.data.pipeline_id.to_string());
        assert!(webhook.get("signed").is_some());
        let channels: Vec<(String, serde_json::Value)> =
            sqlx::query_as("SELECT channel,payload FROM outbox_messages WHERE event_id=$1")
                .bind(id)
                .fetch_all(&pool)
                .await
                .unwrap();
        assert_eq!(channels.len(), 6);
        assert!(
            channels
                .iter()
                .any(|(channel, payload)| channel == "email"
                    && payload["to"] == "qa@example.invalid")
        );
        for channel in ["sse", "in_app"] {
            let (_, payload) = channels
                .iter()
                .find(|(kind, payload)| kind == "notification" && payload["channel"] == channel)
                .unwrap();
            assert_eq!(payload["pipeline_id"], event.data.pipeline_id.to_string());
            assert_eq!(
                payload["event"],
                format!("pipeline.{}", legacy["status"].as_str().unwrap())
            );
        }
    }
    let pending: i64 = sqlx::query_scalar(
        "SELECT count(*) FROM messaging_outbox WHERE published_at IS NULL AND failed_at IS NULL",
    )
    .fetch_one(&pool)
    .await
    .unwrap();
    assert_eq!(pending, 7);
    let diagnostics = status_router(pool.clone(), Arc::new(ProducerRuntime::new(true)));
    for token in [None, Some("invalid")] {
        let mut request = Request::get("/internal/messaging/status");
        if let Some(token) = token {
            request = request.header("authorization", format!("Bearer {token}"));
        }
        assert_eq!(
            diagnostics
                .clone()
                .oneshot(request.body(Body::empty()).unwrap())
                .await
                .unwrap()
                .status(),
            StatusCode::UNAUTHORIZED
        );
    }
    let token =
        tokio::fs::read_to_string(std::env::var("CICD_MESSAGING_STATUS_TOKEN_FILE").unwrap())
            .await
            .unwrap();
    let response = diagnostics
        .oneshot(
            Request::get("/internal/messaging/status")
                .header("authorization", format!("Bearer {}", token.trim()))
                .body(Body::empty())
                .unwrap(),
        )
        .await
        .unwrap();
    assert_eq!(response.status(), StatusCode::OK);
    let body = axum::body::to_bytes(response.into_body(), 16_384)
        .await
        .unwrap();
    let diagnostics: serde_json::Value = serde_json::from_slice(&body).unwrap();
    assert_eq!(diagnostics["outbox"]["pending"], 7);
    assert_eq!(diagnostics["connection"], "pending");
    let ids: Vec<_> = facts.iter().map(|(id, _)| id.to_string()).collect();
    tokio::fs::write("/control/events.json", serde_json::to_vec(&ids).unwrap())
        .await
        .unwrap();
    println!(
        "Product lifecycle: seven facts, three terminal statuses, concurrent refresh/cancel, pipeline/job retry, rollback, recovery and legacy webhook payloads verified"
    );
}

#[tokio::test]
#[ignore = "disposable product messaging harness only"]
async fn product_publisher() {
    let pool = pool().await;
    let config = sdlc_messaging::config::from_env("CICD", "cicd")
        .unwrap()
        .unwrap();
    let (stop, shutdown) = watch::channel(false);
    let state = Arc::new(ProducerRuntime::new(true));
    let work = tokio::spawn(publisher(pool.clone(), state.clone(), config, shutdown));
    tokio::time::sleep(Duration::from_secs(7)).await;
    let pending: i64 = sqlx::query_scalar(
        "SELECT count(*) FROM messaging_outbox WHERE published_at IS NULL AND failed_at IS NULL",
    )
    .fetch_one(&pool)
    .await
    .unwrap();
    assert_eq!(pending, 7, "broker outage must preserve pending facts");
    tokio::fs::write("/control/outage-observed", "ready")
        .await
        .unwrap();
    tokio::time::timeout(Duration::from_secs(60),async {loop {let pending:i64=sqlx::query_scalar("SELECT count(*) FROM messaging_outbox WHERE published_at IS NULL AND failed_at IS NULL").fetch_one(&pool).await.unwrap();if pending==0 {break;}tokio::time::sleep(Duration::from_millis(200)).await;}}).await.unwrap();
    stop.send(true).unwrap();
    tokio::time::timeout(Duration::from_secs(15), work)
        .await
        .unwrap()
        .unwrap();
    assert!(state.bus.read().await.is_none());
    println!(
        "Product publisher: broker outage preserves seven facts; recovery drains the outbox and shutdown completes"
    );
}
