{
  "schema": "base-quality-product/v1",
  "product": "CI-CD",
  "components": {
    "docs": [
      "scripts/verify_docs.py",
      "docs/**",
      "plans/**",
      "*.md",
      "LICENSE"
    ],
    "frontend": [
      "frontend/**",
      "openapi/**",
      ".base-ui-revision",
      ".github/**"
    ],
    "backend": [
      "backend/**",
      "crates/**",
      "Cargo.*",
      "rust-toolchain*",
      ".base-revision",
      ".github/**",
      "openapi/**"
    ],
    "tooling": [
      "scripts/verify_docs.py",
      "scripts/tests/test_verify_docs.py",
      "scripts/tests/test_quality_routes.py",
      "scripts/tests/test_ci_contract_checks.py",
      "scripts/vendor/**",
      ".quality-tooling-revision",
      "justfile",
      "scripts/tests/test_backend_dependency_layers.py",
      "backend/Dockerfile",
      "backend/Dockerfile.umbrella",
      "backend/Dockerfile.dockerignore",
      "backend/Dockerfile.umbrella.dockerignore",
      "backend/Cargo.toml",
      "backend/*/Cargo.toml",
      "scripts/tests/test_bin_test_inputs.py",
      "backend/src/bin/forge-runner.rs",
      "backend/src/bin/tests/forge_runner.rs",
      "scripts/build.py",
      "scripts/select_build.py",
      "scripts/tests/test_build_scope.py"
    ]
  },
  "gates": [
    {
      "id": "tooling:bin-test-inputs",
      "component": "tooling",
      "profiles": [
        "fast",
        "unit",
        "build",
        "integrated",
        "release"
      ],
      "argv": [
        "{python}",
        "-B",
        "-m",
        "unittest",
        "scripts.tests.test_bin_test_inputs",
        "-q"
      ],
      "cwd": ".",
      "inputs": [
        "scripts/tests/test_bin_test_inputs.py",
        "backend/Cargo.toml",
        "backend/src/bin/forge-runner.rs",
        "backend/src/bin/tests/forge_runner.rs",
        "backend/Dockerfile",
        "backend/Dockerfile.umbrella",
        ".quality-gate.json",
        "scripts/vendor/base_quality_selection.py"
      ],
      "cacheable": true,
      "execution_slot": "none",
      "test_tier": "static"
    },
    {
      "id": "tooling:quality-routes",
      "component": "tooling",
      "profiles": [
        "fast",
        "unit",
        "build",
        "integrated",
        "release"
      ],
      "test_tier": "unit",
      "execution_slot": "none",
      "cacheable": false,
      "argv": [
        "{python}",
        "-B",
        "-m",
        "unittest",
        "scripts.tests.test_quality_routes",
        "scripts.tests.test_ci_contract_checks",
        "scripts.tests.test_backend_dependency_layers",
        "scripts.tests.test_verify_docs",
        "scripts.tests.test_build_scope",
        "-q"
      ],
      "inputs": [
        "frontend/scripts/base-generate-openapi.mjs",
        "scripts/verify_docs.py",
        "scripts/tests/test_verify_docs.py",
        "scripts/tests/test_quality_routes.py",
        "scripts/tests/test_ci_contract_checks.py",
        "scripts/vendor/**",
        ".quality-tooling-revision",
        ".quality-gate.json",
        ".github/**",
        "frontend/package.json",
        "frontend/vite.config.ts",
        "frontend/vitest.config.ts",
        "justfile",
        "scripts/tests/test_backend_dependency_layers.py",
        "backend/Dockerfile",
        "backend/Dockerfile.umbrella",
        "backend/Dockerfile.dockerignore",
        "backend/Dockerfile.umbrella.dockerignore",
        "backend/Cargo.toml",
        "backend/*/Cargo.toml",
        "scripts/build.py",
        "scripts/select_build.py",
        "scripts/tests/test_build_scope.py"
      ]
    },
    {
      "id": "docs:contracts",
      "component": "docs",
      "profiles": [
        "fast",
        "integrated",
        "release"
      ],
      "argv": [
        "{python}",
        "-B",
        "scripts/verify_docs.py",
        "--all"
      ],
      "cwd": ".",
      "inputs": [
        "**"
      ],
      "cacheable": true,
      "test_tier": "static"
    },
    {
      "id": "frontend:types",
      "component": "frontend",
      "profiles": [
        "fast",
        "integrated",
        "build",
        "release"
      ],
      "argv": [
        "pnpm",
        "exec",
        "tsc",
        "--noEmit"
      ],
      "cwd": "frontend",
      "inputs": [
        "frontend/**",
        "openapi/**",
        ".base-ui-revision",
        ".gitattributes"
      ],
      "cacheable": true,
      "tools": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "pattern": "^v22\\.20\\.0\\s*$"
        },
        {
          "argv": [
            "pnpm",
            "--version"
          ],
          "pattern": "^10\\.28\\.1\\s*$"
        }
      ],
      "prepare_frontend": "22.20.0",
      "test_tier": "static"
    },
    {
      "id": "frontend:tests",
      "component": "frontend",
      "profiles": [
        "fast",
        "integrated",
        "release",
        "unit",
        "build"
      ],
      "argv": [
        "pnpm",
        "test:unit"
      ],
      "cwd": "frontend",
      "inputs": [
        "frontend/**",
        "openapi/**",
        ".base-ui-revision",
        ".gitattributes"
      ],
      "cacheable": true,
      "tools": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "pattern": "^v22\\.20\\.0\\s*$"
        },
        {
          "argv": [
            "pnpm",
            "--version"
          ],
          "pattern": "^10\\.28\\.1\\s*$"
        }
      ],
      "prepare_frontend": "22.20.0",
      "test_tier": "unit"
    },
    {
      "id": "frontend:lint",
      "component": "frontend",
      "profiles": [
        "integrated",
        "release"
      ],
      "argv": [
        "pnpm",
        "lint"
      ],
      "cwd": "frontend",
      "inputs": [
        "frontend/**",
        "openapi/**",
        ".base-ui-revision",
        ".gitattributes"
      ],
      "cacheable": true,
      "tools": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "pattern": "^v22\\.20\\.0\\s*$"
        },
        {
          "argv": [
            "pnpm",
            "--version"
          ],
          "pattern": "^10\\.28\\.1\\s*$"
        }
      ],
      "prepare_frontend": "22.20.0",
      "test_tier": "static"
    },
    {
      "id": "frontend:build",
      "component": "frontend",
      "profiles": [
        "build"
      ],
      "argv": [
        "pnpm",
        "exec",
        "vite",
        "build"
      ],
      "cwd": "frontend",
      "inputs": [
        "frontend/**",
        "openapi/**",
        ".base-ui-revision",
        ".gitattributes"
      ],
      "cacheable": false,
      "tools": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "pattern": "^v22\\.20\\.0\\s*$"
        },
        {
          "argv": [
            "pnpm",
            "--version"
          ],
          "pattern": "^10\\.28\\.1\\s*$"
        }
      ],
      "prepare_frontend": "22.20.0",
      "outputs": [
        "frontend/dist"
      ],
      "environment_inputs": [
        "VITE_*",
        "NODE_*",
        "BROWSERSLIST*",
        "npm_*",
        "NPM_*",
        "PNPM_*",
        "SOURCE_DATE_EPOCH",
        "HOME",
        "USERPROFILE",
        "TMPDIR",
        "TEMP",
        "TMP"
      ],
      "kind": "artifact",
      "exclude_inputs": [
        "frontend/src/**/*.test.ts",
        "frontend/src/**/*.test.tsx",
        "frontend/src/**/*.spec.ts",
        "frontend/src/**/*.spec.tsx",
        "frontend/src/test-setup.ts",
        "frontend/vitest.config.ts",
        "frontend/scripts/tailwind-source-inputs.test.mjs"
      ],
      "test_tier": "artifact"
    },
    {
      "id": "backend:unit",
      "component": "backend",
      "profiles": [
        "fast",
        "release",
        "unit",
        "build"
      ],
      "argv": [
        "bash",
        "{base}/scripts/run_rust_gate.sh",
        "--",
        "bash",
        "-euo",
        "pipefail",
        "-c",
        "cargo fmt --all -- --check; cargo test --locked -p cicd-domain --lib"
      ],
      "cwd": "backend",
      "inputs": [
        "**"
      ],
      "cacheable": true,
      "platforms": [
        "linux"
      ],
      "tools": [
        {
          "argv": [
            "rustc",
            "--version"
          ],
          "pattern": "^rustc 1\\.88\\.0\\b"
        }
      ],
      "sdk_revision": ".base-revision",
      "test_tier": "unit"
    },
    {
      "id": "backend:quality",
      "component": "backend",
      "profiles": [
        "integration",
        "integrated",
        "release"
      ],
      "argv": [
        "bash",
        "{base}/scripts/run_rust_gate.sh",
        "--",
        "bash",
        "-euo",
        "pipefail",
        "-c",
        "cargo fmt --all -- --check; cargo clippy --locked --workspace --all-targets -- -D warnings; cargo test --locked --workspace"
      ],
      "cwd": "backend",
      "inputs": [
        "**"
      ],
      "cacheable": false,
      "platforms": [
        "linux"
      ],
      "external_state": true,
      "requires_env": [
        "CICD_TEST_DATABASE_URL"
      ],
      "tools": [
        {
          "argv": [
            "rustc",
            "--version"
          ],
          "pattern": "^rustc 1\\.88\\.0\\b"
        }
      ],
      "sdk_revision": ".base-revision",
      "test_tier": "integration"
    },
    {
      "id": "backend:build",
      "component": "backend",
      "profiles": [
        "build"
      ],
      "argv": [
        "bash",
        "{base}/scripts/run_rust_gate.sh",
        "--",
        "bash",
        "-euo",
        "pipefail",
        "-c",
        "cargo build --locked --release -p cicd-server --bin cicd-server --bin forge-runner\nfor binary in cicd-server forge-runner; do\n    test -s \"$CARGO_TARGET_DIR/release/$binary\"\n    test -x \"$CARGO_TARGET_DIR/release/$binary\"\n    cp -- \"$CARGO_TARGET_DIR/release/$binary\" \"$BASE_QUALITY_ARTIFACTS/$binary\"\ndone"
      ],
      "cwd": "backend",
      "inputs": [
        "backend/**",
        ".base-revision",
        ".cargo/**",
        "rust-toolchain*",
        ".gitattributes"
      ],
      "cacheable": false,
      "platforms": [
        "linux"
      ],
      "tools": [
        {
          "argv": [
            "rustc",
            "--version"
          ],
          "pattern": "^rustc 1\\.88\\.0\\b"
        }
      ],
      "sdk_revision": ".base-revision",
      "kind": "artifact",
      "artifact_outputs": [
        "cicd-server",
        "forge-runner"
      ],
      "artifact_toolchain": "pinned-image",
      "environment_inputs": [
        "CARGO_*",
        "RUST*",
        "CC",
        "CC_*",
        "CFLAGS",
        "CFLAGS_*",
        "CXX",
        "CXX_*",
        "CXXFLAGS",
        "AR",
        "AR_*",
        "RANLIB",
        "LD",
        "LD_*",
        "LDFLAGS",
        "PKG_CONFIG*",
        "OPENSSL*",
        "LIBSSL*",
        "SQLX_*",
        "SQLITE*",
        "LIBSQLITE*",
        "VCPKG*",
        "BINDGEN*",
        "LIBCLANG*",
        "ZSTD*",
        "CMAKE*",
        "SOURCE_DATE_EPOCH",
        "HOME",
        "LIBRARY_PATH",
        "LD_LIBRARY_PATH",
        "CPATH",
        "C_INCLUDE_PATH",
        "CPLUS_INCLUDE_PATH"
      ],
      "test_tier": "artifact",
      "exclude_inputs": [
        "backend/src/bin/tests/forge_runner.rs"
      ]
    }
  ],
  "additional_acceptance": "Existing product CI/CONTRIBUTING: MSRV/features, ignored DB, OpenAPI/packed consumer/themes, security and live acceptance remain separate mandatory gates where applicable.",
  "frontend_generated": [
    "src/api/schema.d.ts"
  ],
  "frontend_unit_inputs": [
    "frontend/src/**/*.test.ts",
    "frontend/src/**/*.test.tsx",
    "frontend/src/**/*.spec.ts",
    "frontend/src/**/*.spec.tsx",
    "frontend/src/**/*.test.mjs",
    "frontend/src/**/*.test.cjs",
    "frontend/src/*.test.ts",
    "frontend/src/*.test.tsx",
    "frontend/src/*.spec.ts",
    "frontend/src/*.spec.tsx",
    "frontend/src/*.test.mjs",
    "frontend/src/*.test.cjs",
    "frontend/src/test-setup.ts",
    "frontend/vitest.config.ts",
    "frontend/scripts/tailwind-source-inputs.test.mjs"
  ],
  "test_policy": {
    "automatic": [
      "unit",
      "static",
      "artifact"
    ],
    "manual_release": [
      "integration",
      "slow",
      "live"
    ],
    "release_required": true
  },
  "affected_checks": {
    "tooling": [
      {
        "paths": [
          "scripts/verify_docs.py",
          "scripts/tests/test_verify_docs.py"
        ],
        "gates": [
          "tooling:quality-routes"
        ]
      },
      {
        "paths": [
          "scripts/tests/test_bin_test_inputs.py",
          "backend/src/bin/forge-runner.rs",
          "backend/src/bin/tests/forge_runner.rs"
        ],
        "gates": [
          "tooling:bin-test-inputs"
        ]
      },
      {
        "paths": [
          "scripts/build.py",
          "scripts/select_build.py",
          "scripts/tests/test_build_scope.py"
        ],
        "gates": [
          "tooling:quality-routes"
        ]
      }
    ]
  },
  "container_inputs": {
    "backend": [
      "backend/Dockerfile*"
    ],
    "runner": [
      "backend/Dockerfile*"
    ],
    "frontend": [
      "frontend/Dockerfile*",
      "frontend/nginx.conf"
    ]
  }
}
