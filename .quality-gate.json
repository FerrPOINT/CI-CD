{
  "schema": "base-quality-product/v1",
  "product": "CI-CD",
  "components": {
    "docs": [
      "docs/**",
      "*.md",
      "LICENSE"
    ],
    "frontend": [
      "frontend/**",
      "openapi/**",
      ".base-ui-revision",
      ".github/**",
      ".base-revision",
      ".namespace-base-revision"
    ],
    "backend": [
      "scripts/check_cache_tooling.py",
      "scripts/tests/test_cache_tooling.py",
      "scripts/vendor/base_forge_job_cache.py",
      "scripts/vendor/base-build-cache-policy.json",
      "scripts/vendor/base-forge-cache-tooling.json",
      "backend/**",
      "crates/**",
      "Cargo.*",
      "rust-toolchain*",
      ".base-revision",
      ".namespace-base-revision",
      ".github/**",
      "openapi/**"
    ]
  },
  "gates": [
    {
      "id": "backend:cache-tooling-unit",
      "component": "backend",
      "profiles": ["fast", "unit", "build", "release"],
      "argv": ["{python}", "-B", "-m", "unittest", "discover", "-s", "scripts/tests", "-p", "test_cache_tooling.py", "-q"],
      "cwd": ".",
      "inputs": ["scripts/check_cache_tooling.py", "scripts/tests/test_cache_tooling.py", ".quality-gate.json", "backend/src/runner_cache.rs"],
      "cacheable": true,
      "test_tier": "unit"
    },
    {
      "id": "backend:cache-tooling",
      "component": "backend",
      "profiles": ["fast", "unit", "build", "release"],
      "argv": ["{python}", "-B", "scripts/check_cache_tooling.py"],
      "cwd": ".",
      "inputs": ["scripts/check_cache_tooling.py", "scripts/vendor/base_forge_job_cache.py", "scripts/vendor/base-build-cache-policy.json", "scripts/vendor/base-forge-cache-tooling.json", "backend/src/runner_cache.rs", "backend/Cargo.lock", "backend/Cargo.toml", "backend/tests/cache-protocol/Cargo.toml", ".quality-gate.json"],
      "cacheable": true,
      "test_tier": "static"
    },
    {
      "id": "docs:contracts",
      "component": "docs",
      "profiles": [
        "fast",
        "integrated",
        "release"
      ],
      "argv": [
        "{python}",
        "-B",
        "scripts/verify_docs.py",
        "--all"
      ],
      "cwd": ".",
      "inputs": [
        "**"
      ],
      "cacheable": true,
      "test_tier": "static"
    },
    {
      "id": "frontend:types",
      "component": "frontend",
      "profiles": [
        "fast",
        "integrated",
        "build",
        "release"
      ],
      "argv": [
        "pnpm",
        "exec",
        "tsc",
        "--noEmit"
      ],
      "cwd": "frontend",
      "inputs": [
        "frontend/**",
        "openapi/**",
        ".base-ui-revision",
        ".gitattributes"
      ],
      "cacheable": true,
      "tools": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "pattern": "^v22\\.20\\.0\\s*$"
        },
        {
          "argv": [
            "pnpm",
            "--version"
          ],
          "pattern": "^10\\.28\\.1\\s*$"
        }
      ],
      "prepare_frontend": "22.20.0",
      "test_tier": "static"
    },
    {
      "id": "frontend:tests",
      "component": "frontend",
      "profiles": [
        "fast",
        "integrated",
        "release",
        "unit",
        "build"
      ],
      "argv": [
        "pnpm",
        "test:unit"
      ],
      "cwd": "frontend",
      "inputs": [
        "frontend/**",
        "openapi/**",
        ".base-ui-revision",
        ".gitattributes"
      ],
      "cacheable": true,
      "tools": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "pattern": "^v22\\.20\\.0\\s*$"
        },
        {
          "argv": [
            "pnpm",
            "--version"
          ],
          "pattern": "^10\\.28\\.1\\s*$"
        }
      ],
      "prepare_frontend": "22.20.0",
      "test_tier": "unit"
    },
    {
      "id": "frontend:lint",
      "component": "frontend",
      "profiles": [
        "integrated",
        "release"
      ],
      "argv": [
        "pnpm",
        "lint"
      ],
      "cwd": "frontend",
      "inputs": [
        "frontend/**",
        "openapi/**",
        ".base-ui-revision",
        ".gitattributes"
      ],
      "cacheable": true,
      "tools": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "pattern": "^v22\\.20\\.0\\s*$"
        },
        {
          "argv": [
            "pnpm",
            "--version"
          ],
          "pattern": "^10\\.28\\.1\\s*$"
        }
      ],
      "prepare_frontend": "22.20.0",
      "test_tier": "static"
    },
    {
      "id": "frontend:build",
      "component": "frontend",
      "profiles": [
        "build"
      ],
      "argv": [
        "pnpm",
        "exec",
        "vite",
        "build"
      ],
      "cwd": "frontend",
      "inputs": [
        "frontend/**",
        "openapi/**",
        ".base-ui-revision",
        ".gitattributes"
      ],
      "cacheable": true,
      "tools": [
        {
          "argv": [
            "node",
            "--version"
          ],
          "pattern": "^v22\\.20\\.0\\s*$"
        },
        {
          "argv": [
            "pnpm",
            "--version"
          ],
          "pattern": "^10\\.28\\.1\\s*$"
        }
      ],
      "prepare_frontend": "22.20.0",
      "outputs": [
        "frontend/dist"
      ],
      "environment_inputs": [
        "VITE_*",
        "NODE_*",
        "BROWSERSLIST*",
        "npm_*",
        "NPM_*",
        "PNPM_*",
        "SOURCE_DATE_EPOCH",
        "HOME",
        "USERPROFILE",
        "TMPDIR",
        "TEMP",
        "TMP"
      ],
      "kind": "artifact",
      "exclude_inputs": [
        "frontend/src/**/*.test.ts",
        "frontend/src/**/*.test.tsx",
        "frontend/src/**/*.spec.ts",
        "frontend/src/**/*.spec.tsx",
        "frontend/src/**/*.test.mjs",
        "frontend/src/**/*.test.cjs",
        "frontend/src/*.test.ts",
        "frontend/src/*.test.tsx",
        "frontend/src/*.spec.ts",
        "frontend/src/*.spec.tsx",
        "frontend/src/*.test.mjs",
        "frontend/src/*.test.cjs",
        "frontend/e2e/**",
        "frontend/src/test-setup.ts"
      ],
      "test_tier": "artifact"
    },
    {
      "id": "backend:unit",
      "component": "backend",
      "profiles": [
        "fast",
        "release",
        "unit",
        "build"
      ],
      "argv": [
        "bash",
        "{base}/scripts/run_rust_gate.sh",
        "--",
        "bash",
        "-euo",
        "pipefail",
        "-c",
        "cargo fmt --all -- --check; cargo test --locked -p cicd-domain --lib; cargo test --locked --manifest-path tests/cache-protocol/Cargo.toml --lib"
      ],
      "cwd": "backend",
      "inputs": [
        "**"
      ],
      "cacheable": true,
      "platforms": [
        "linux"
      ],
      "tools": [
        {
          "argv": [
            "rustc",
            "--version"
          ],
          "pattern": "^rustc 1\\.88\\.0\\b"
        }
      ],
      "sdk_revision": ".namespace-base-revision",
      "test_tier": "unit"
    },
    {
      "id": "backend:quality",
      "component": "backend",
      "profiles": [
        "integration",
        "integrated",
        "release"
      ],
      "argv": [
        "bash",
        "{base}/scripts/run_rust_gate.sh",
        "--",
        "bash",
        "-euo",
        "pipefail",
        "-c",
        "cargo fmt --all -- --check; cargo clippy --locked --workspace --all-targets -- -D warnings; cargo test --locked --workspace"
      ],
      "cwd": "backend",
      "inputs": [
        "**"
      ],
      "cacheable": false,
      "platforms": [
        "linux"
      ],
      "external_state": true,
      "requires_env": [
        "CICD_TEST_DATABASE_URL"
      ],
      "tools": [
        {
          "argv": [
            "rustc",
            "--version"
          ],
          "pattern": "^rustc 1\\.88\\.0\\b"
        }
      ],
      "sdk_revision": ".namespace-base-revision",
      "test_tier": "integration"
    },
    {
      "id": "backend:build",
      "component": "backend",
      "profiles": [
        "build"
      ],
      "argv": [
        "bash",
        "{base}/scripts/run_rust_gate.sh",
        "--",
        "bash",
        "-euo",
        "pipefail",
        "-c",
        "cargo build --locked --release --workspace\nfound=false\nwhile IFS= read -r -d '' binary; do\n    cp -- \"$binary\" \"$BASE_QUALITY_ARTIFACTS/\"\n    found=true\ndone < <(find \"$CARGO_TARGET_DIR/release\" -maxdepth 1 -type f -executable -print0)\n[[ \"$found\" == true ]]"
      ],
      "cwd": "backend",
      "inputs": [
        "scripts/vendor/base_forge_job_cache.py",
        "scripts/vendor/base-build-cache-policy.json",
        "scripts/vendor/base-forge-cache-tooling.json",
        "backend/**",
        ".base-revision",
        ".namespace-base-revision",
        ".cargo/**",
        "rust-toolchain*",
        ".gitattributes"
      ],
      "cacheable": true,
      "platforms": [
        "linux"
      ],
      "tools": [
        {
          "argv": [
            "rustc",
            "--version"
          ],
          "pattern": "^rustc 1\\.88\\.0\\b"
        }
      ],
      "sdk_revision": ".namespace-base-revision",
      "kind": "artifact",
      "exclude_inputs": [
        "backend/tests/**",
        "backend/**/tests/**"
      ],
      "artifact_outputs": [
        "."
      ],
      "artifact_toolchain": "pinned-image",
      "environment_inputs": [
        "CARGO_*",
        "RUST*",
        "CC",
        "CC_*",
        "CFLAGS",
        "CFLAGS_*",
        "CXX",
        "CXX_*",
        "CXXFLAGS",
        "AR",
        "AR_*",
        "RANLIB",
        "LD",
        "LD_*",
        "LDFLAGS",
        "PKG_CONFIG*",
        "OPENSSL*",
        "LIBSSL*",
        "SQLX_*",
        "SQLITE*",
        "LIBSQLITE*",
        "VCPKG*",
        "BINDGEN*",
        "LIBCLANG*",
        "ZSTD*",
        "CMAKE*",
        "SOURCE_DATE_EPOCH",
        "HOME",
        "LIBRARY_PATH",
        "LD_LIBRARY_PATH",
        "CPATH",
        "C_INCLUDE_PATH",
        "CPLUS_INCLUDE_PATH"
      ],
      "test_tier": "artifact"
    }
  ],
  "additional_acceptance": "Existing product CI/CONTRIBUTING: MSRV/features, ignored DB, OpenAPI/packed consumer/themes, security and live acceptance remain separate mandatory gates where applicable.",
  "frontend_generated": [
    "src/api/schema.d.ts"
  ],
  "frontend_unit_inputs": [
    "frontend/src/**/*.test.ts",
    "frontend/src/**/*.test.tsx",
    "frontend/src/**/*.spec.ts",
    "frontend/src/**/*.spec.tsx",
    "frontend/src/**/*.test.mjs",
    "frontend/src/**/*.test.cjs",
    "frontend/src/*.test.ts",
    "frontend/src/*.test.tsx",
    "frontend/src/*.spec.ts",
    "frontend/src/*.spec.tsx",
    "frontend/src/*.test.mjs",
    "frontend/src/*.test.cjs",
    "frontend/src/test-setup.ts"
  ],
  "test_policy": {
    "automatic": [
      "unit",
      "static",
      "artifact"
    ],
    "manual_release": [
      "integration",
      "slow",
      "live"
    ],
    "release_required": true
  },
  "backend_unit_inputs": [
    "backend/tests/**",
    "backend/**/tests/**"
  ]
}
