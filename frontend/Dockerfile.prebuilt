# syntax=docker/dockerfile:1.19@sha256:b6afd42430b15f2d2a4c5a02b919e98a525b785b1aaff16747d2f623364e39b6
# Generated from the exact Base quality tooling packet; application compilation stays upstream.
FROM nginx:1.31.4-alpine@sha256:db35bfc6b2951e7f8a72db5db120288c127ffaeeb4a6d4b95a26fead017d5913 AS verified
WORKDIR /checked
COPY --from=tested_frontend / /checked/
ARG FRONTEND_CHECKSUMS_SHA256
RUN test "${#FRONTEND_CHECKSUMS_SHA256}" = 64 \
    && printf '%s  SHA256SUMS\n' "$FRONTEND_CHECKSUMS_SHA256" | sha256sum -c - \
    && test -s dist/index.html \
    && test -z "$(find dist ! -type f ! -type d -print)" \
    && test "$(find dist -type f | wc -l)" -eq "$(( $(wc -l < SHA256SUMS) - 1 ))" \
    && sha256sum -c SHA256SUMS

FROM nginx:1.31.4-alpine@sha256:db35bfc6b2951e7f8a72db5db120288c127ffaeeb4a6d4b95a26fead017d5913
ENV NGINX_ENTRYPOINT_WORKER_PROCESSES_AUTOTUNE=1
ARG VITE_NAMESPACE_ENABLED="false"
LABEL io.pdlc.namespace-ui.enabled=${VITE_NAMESPACE_ENABLED}
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=${SOURCE_REVISION}
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=verified /checked/dist/ /usr/share/nginx/html/
EXPOSE 80
