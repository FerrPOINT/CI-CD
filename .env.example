# Forge CI/CD local development configuration.
# Copy to .env and replace every production/shared secret before exposing the stack.

CICD_DATABASE_USER=cicd
CICD_DATABASE_PASSWORD=cicd_local_only
CICD_DATABASE_NAME=cicd
CICD_DATABASE_PORT=22543
CICD_API_PORT=22801
CICD_WEB_PORT=22802

# Direct backend runs only; Docker Compose derives this URL itself.
# CICD_DATABASE_URL=postgresql://cicd:cicd_local_only@127.0.0.1:22543/cicd
# Optional migration source override; direct cargo runs default to backend/migrations.
# CICD_MIGRATIONS_DIR=./backend/migrations
CICD_BIND=0.0.0.0:22801
CICD_GIT_ROOT=./.forge/git

# Optional in trusted local development; required for shared deployments.
CICD_AUTH_SECRET=
CICD_CORS_ALLOWED_ORIGINS=
CICD_GIT_TOKEN=
CICD_GIT_INTERNAL_TOKEN=

# Required before storing project secrets.
# Generate with: openssl rand -base64 32
CICD_SECRETS_KEY=

# Required only when enabling external runner protocol registration.
# Generate with: openssl rand -hex 32
CICD_RUNNER_REGISTRATION_TOKEN=

# Compose defaults to host mode. Use docker only when executor/socket wiring is deliberate.
CICD_EMBEDDED_RUNNER_ENABLED=true
CICD_RUNNER_MODE=host
CICD_RUNNER_KEEP_WORKSPACE=false
CICD_RUNNER_QUEUE_TIMEOUT_SECONDS=86400

# Optional external forge-runner process.
# For docker compose --profile external-runner, set either CICD_RUNNER_CREDENTIAL
# or CICD_RUNNER_REGISTRATION_TOKEN. Keep embedded runner disabled to avoid
# both executors claiming the same local queue.
CICD_RUNNER_CREDENTIAL=
CICD_RUNNER_NAME=forge-runner
CICD_RUNNER_TAGS=linux,host
CICD_RUNNER_TOTAL_SLOTS=1
CICD_RUNNER_POLL_INTERVAL_SECONDS=5
CICD_RUNNER_NO_CHECKOUT=false
CICD_RUNNER_WORK_DIR=/var/lib/forge/runner-work

# Base URL used by cicd-cli when it runs outside Docker.
CICD_API_URL=http://127.0.0.1:22801

# Directory for local artifact storage outside Docker.
CICD_ARTIFACTS_DIR=/var/lib/forge/artifacts
# New artifacts expire after this many days; backend purges expired local files.
CICD_ARTIFACT_RETENTION_DAYS=30
