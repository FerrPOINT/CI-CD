CICD_DATABASE_USER=cicd
CICD_DATABASE_PASSWORD=change-this-before-shared-deployments
CICD_DATABASE_NAME=cicd
CICD_DATABASE_PORT=22543
CICD_API_PORT=22801
CICD_WEB_PORT=22802
# Direct backend runs only; Docker Compose derives this URL itself.
# CICD_DATABASE_URL=postgresql://cicd:change-this-before-shared-deployments@127.0.0.1:22543/cicd
CICD_BIND=0.0.0.0:22801
CICD_GIT_ROOT=./.forge/git
# Git Smart HTTP and internal post-receive hook. Leave blank only for isolated local development.
CICD_GIT_TOKEN=
CICD_GIT_INTERNAL_TOKEN=change-this-before-shared-deployments
# Embedded executor configuration.
CICD_RUNNER_MODE=docker
CICD_RUNNER_KEEP_WORKSPACE=false
# Base URL used by cicd-cli when it runs outside Docker.
CICD_API_URL=http://127.0.0.1:22801
# Base64-encoded 32-byte key for AES-256-GCM encryption of project secrets at rest.
# Generate with: openssl rand -base64 32
CICD_SECRETS_KEY=
# Directory for local artifact storage (default: /var/lib/forge/artifacts)
CICD_ARTIFACTS_DIR=/var/lib/forge/artifacts
