CICD_DATABASE_USER=cicd
CICD_DATABASE_PASSWORD=change-this-before-shared-deployments
CICD_DATABASE_NAME=cicd
CICD_DATABASE_PORT=22543
CICD_API_PORT=22801
CICD_WEB_PORT=22802
# Base64-encoded 32-byte key for AES-256-GCM encryption of project secrets at rest.
# Generate with: openssl rand -base64 32
CICD_SECRETS_KEY=
# Directory for local artifact storage (default: /var/lib/forge/artifacts)
CICD_ARTIFACTS_DIR=/var/lib/forge/artifacts
